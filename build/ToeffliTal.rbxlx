      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">vehicle</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">StatsCalculator</string>
            <string name="Source"><![CDATA[--!strict
-- StatsCalculator: gemeinsamer, deterministischer Fahrzeugstatistik-Rechner.
-- Versorgt Fahrphysik (Client) und Pruefstand (Server) mit identischen Werten.
-- Rein datengetrieben: nimmt Basiswerte + Teile entgegen, keine Katalog-Imports,
-- keine globalen Variablen, keine Mutation der Eingaben.

local StatsCalculator = {}

-- Slots mit Motorbezug: duerfen nicht an ein Fahrrad verbaut werden.
StatsCalculator.MOTOR_SLOTS = {
	cylinder = true,
	cylinderHead = true,
	carburetor = true,
	exhaust = true,
	airFilter = true,
	intakeManifold = true,
}

-- Slots, in denen hoechstens ein Teil pro Setup sitzen darf (alle bekannten Slots).
-- Unbekannte Slots werden akzeptiert, solange sie nicht doppelt belegt sind.
StatsCalculator.KNOWN_SLOTS = {
	cylinder = true,
	cylinderHead = true,
	carburetor = true,
	exhaust = true,
	airFilter = true,
	intakeManifold = true,
	handlebar = true,
	brakes = true,
	wheels = true,
	rims = true,
	lamp = true,
}

-- Plausible Arcade-Clamps (deterministisch, Dyno + Physik teilen sie).
StatsCalculator.LIMITS = {
	powerKw = { min = 0.1, max = 30 },
	torqueNm = { min = 0, max = 60 },
	topSpeedKmh = { min = 5, max = 120 },
	acceleration = { min = 0.5, max = 15 },
	braking = { min = 1, max = 30 },
	grip = { min = 0.1, max = 3 },
	consumption = { min = 0, max = 10 },
	weightKg = { min = 5, max = 300 },
}

export type TorquePoint = { rpm: number, torqueNm: number }
export type StatDeltas = {
	powerKw: number?,
	torqueNm: number?,
	topSpeedKmh: number?,
	acceleration: number?,
	braking: number?,
	grip: number?,
	consumption: number?,
	weightKg: number?,
}
export type BaseVehicle = {
	id: string,
	modelId: string?,
	powerKw: number,
	torqueNm: number,
	topSpeedKmh: number,
	acceleration: number,
	braking: number,
	grip: number,
	consumption: number,
	weightKg: number?,
}
export type Part = {
	id: string,
	slot: string,
	compatibleModels: { string }?,
	statDeltas: StatDeltas?,
}
export type VehicleStats = {
	vehicleId: string,
	powerKw: number,
	peakTorqueNm: number,
	torqueCurve: { TorquePoint },
	topSpeedKmh: number,
	acceleration: number,
	braking: number,
	grip: number,
	consumptionPer100Km: number,
	weightKg: number,
	partCount: number,
}

local function round3(value: number): number
	if value >= 0 then
		return math.floor(value * 1000 + 0.5) / 1000
	else
		return math.ceil(value * 1000 - 0.5) / 1000
	end
end

local function clamp(value: number, minValue: number, maxValue: number): number
	if value < minValue then
		return minValue
	elseif value > maxValue then
		return maxValue
	else
		return value
	end
end

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function modelKeyOf(base: BaseVehicle): string
	if type(base.modelId) == "string" and (base.modelId :: string) ~= "" then
		return base.modelId :: string
	end
	return base.id
end

local function isBicycle(base: BaseVehicle): boolean
	local key = string.lower(modelKeyOf(base))
	return key == "bicycle" or key == "bike" or key == "fahrrad" or key == "startfahrrad"
end

-- Drehmomentverlauf aus Spitzenleistung/-moment. Fixe 5-Punkt-Kurve,
-- damit Dyno-Anzeige und Physik exakt dieselbe Kurve sehen.
function StatsCalculator.calculateTorqueCurve(powerKw: number, peakTorqueNm: number): { TorquePoint }
	if not isFiniteNumber(powerKw) or not isFiniteNumber(peakTorqueNm) then
		return {}
	end
	if peakTorqueNm <= 0 or powerKw <= 0 then
		return {}
	end
	local shape = {
		{ rpm = 2000, factor = 0.55 },
		{ rpm = 4000, factor = 0.8 },
		{ rpm = 6000, factor = 1.0 },
		{ rpm = 7500, factor = 0.9 },
		{ rpm = 9000, factor = 0.7 },
	}
	local curve: { TorquePoint } = {}
	for _, point in ipairs(shape) do
		table.insert(curve, {
			rpm = point.rpm,
			torqueNm = round3(peakTorqueNm * point.factor),
		})
	end
	return curve
end

-- Prueft nur die Setup-Gueltigkeit (Slots, Kompatibilitaet), ohne zu rechnen.
function StatsCalculator.validateSetup(base: any, parts: any): (boolean, string?)
	if type(base) ~= "table" then
		return false, "base must be a table"
	end
	local baseVehicle = base :: BaseVehicle
	if type(baseVehicle.id) ~= "string" or baseVehicle.id == "" then
		return false, "base.id must be a non-empty string"
	end
	for _, field in ipairs({ "powerKw", "torqueNm", "topSpeedKmh", "acceleration", "braking", "grip", "consumption" }) do
		local value = (baseVehicle :: any)[field]
		if not isFiniteNumber(value) then
			return false, "base." .. field .. " must be a finite number"
		end
	end
	if baseVehicle.powerKw <= 0 then
		return false, "base.powerKw must be positive"
	end
	if baseVehicle.topSpeedKmh <= 0 then
		return false, "base.topSpeedKmh must be positive"
	end
	if parts ~= nil and type(parts) ~= "table" then
		return false, "parts must be an array table or nil"
	end
	local seenSlots: { [string]: boolean } = {}
	local modelKey = modelKeyOf(baseVehicle)
	local bicycle = isBicycle(baseVehicle)
	for index, partAny in ipairs((parts or {}) :: any) do
		if type(partAny) ~= "table" then
			return false, "parts[" .. tostring(index) .. "] must be a table"
		end
		local part = partAny :: Part
		if type(part.id) ~= "string" or part.id == "" then
			return false, "parts[" .. tostring(index) .. "].id must be a non-empty string"
		end
		if type(part.slot) ~= "string" or part.slot == "" then
			return false, "parts[" .. tostring(index) .. "].slot must be a non-empty string"
		end
		if seenSlots[part.slot] then
			return false, "duplicate slot: " .. part.slot
		end
		seenSlots[part.slot] = true
		if bicycle and StatsCalculator.MOTOR_SLOTS[part.slot] then
			return false, "bicycle has no motor slot: " .. part.slot
		end
		if part.compatibleModels ~= nil then
			if type(part.compatibleModels) ~= "table" then
				return false, "parts[" .. tostring(index) .. "].compatibleModels must be an array"
			end
			local compatible = false
			for _, model in ipairs(part.compatibleModels) do
				if model == modelKey or model == baseVehicle.id then
					compatible = true
					break
				end
			end
			if not compatible then
				return false, "part " .. part.id .. " incompatible with " .. modelKey
			end
		end
		if part.statDeltas ~= nil then
			if type(part.statDeltas) ~= "table" then
				return false, "parts[" .. tostring(index) .. "].statDeltas must be a table"
			end
			for deltaKey, deltaValue in pairs(part.statDeltas :: any) do
				if deltaValue ~= nil and not isFiniteNumber(deltaValue) then
					return false,
						"parts["
							.. tostring(index)
							.. "].statDeltas."
							.. tostring(deltaKey)
							.. " must be a finite number"
				end
			end
		end
	end
	return true, nil
end

-- Hauptfunktion: Basis + Teile -> abgeleitete Stats. Gibt (nil, Fehler) bei
-- ungueltigen oder inkompatiblen Setups zurueck; sonst (Stats, nil).
function StatsCalculator.calculate(base: any, parts: any): (VehicleStats?, string?)
	local ok, err = StatsCalculator.validateSetup(base, parts)
	if not ok then
		return nil, err
	end
	local baseVehicle = base :: BaseVehicle
	local partList: { Part } = (parts or {}) :: { Part }

	local sumPower = 0
	local sumTorque = 0
	local sumTopSpeed = 0
	local sumAccel = 0
	local sumBraking = 0
	local sumGrip = 0
	local sumConsumption = 0
	local sumWeight = 0
	for _, part in ipairs(partList) do
		local deltas: any = part.statDeltas or {}
		if deltas.powerKw ~= nil then
			sumPower += deltas.powerKw
		end
		if deltas.torqueNm ~= nil then
			sumTorque += deltas.torqueNm
		end
		if deltas.topSpeedKmh ~= nil then
			sumTopSpeed += deltas.topSpeedKmh
		end
		if deltas.acceleration ~= nil then
			sumAccel += deltas.acceleration
		end
		if deltas.braking ~= nil then
			sumBraking += deltas.braking
		end
		if deltas.grip ~= nil then
			sumGrip += deltas.grip
		end
		if deltas.consumption ~= nil then
			sumConsumption += deltas.consumption
		end
		if deltas.weightKg ~= nil then
			sumWeight += deltas.weightKg
		end
	end

	local limits = StatsCalculator.LIMITS
	local power = baseVehicle.powerKw + sumPower
	local torque = baseVehicle.torqueNm + sumTorque
	local topSpeed = baseVehicle.topSpeedKmh + sumTopSpeed
	local accel = baseVehicle.acceleration + sumAccel
	local braking = baseVehicle.braking + sumBraking
	local grip = baseVehicle.grip + sumGrip
	local consumption = baseVehicle.consumption + sumConsumption
	local baseWeight = baseVehicle.weightKg or 80
	if not isFiniteNumber(baseWeight) then
		return nil, "base.weightKg must be a finite number"
	end
	local weight = baseWeight + sumWeight

	-- Harte Ablehnung vor dem Clampen: physikalisch unsinnige Ergebnisse.
	if power <= 0 then
		return nil, "resulting power must be positive"
	end
	if topSpeed <= 0 then
		return nil, "resulting topSpeed must be positive"
	end
	if torque < 0 or braking <= 0 or grip <= 0 or weight <= 0 then
		return nil, "resulting stats implausible"
	end
	if consumption < 0 then
		return nil, "resulting consumption must not be negative"
	end
	-- Fahrrad: kein Treibstoff, kein Motordrehmoment.
	if isBicycle(baseVehicle) then
		if consumption ~= 0 then
			return nil, "bicycle must not consume fuel"
		end
		if torque ~= 0 then
			return nil, "bicycle has no engine torque"
		end
	end

	power = clamp(power, limits.powerKw.min, limits.powerKw.max)
	torque = clamp(torque, limits.torqueNm.min, limits.torqueNm.max)
	topSpeed = clamp(topSpeed, limits.topSpeedKmh.min, limits.topSpeedKmh.max)
	accel = clamp(accel, limits.acceleration.min, limits.acceleration.max)
	braking = clamp(braking, limits.braking.min, limits.braking.max)
	grip = clamp(grip, limits.grip.min, limits.grip.max)
	consumption = clamp(consumption, limits.consumption.min, limits.consumption.max)
	weight = clamp(weight, limits.weightKg.min, limits.weightKg.max)

	local stats: VehicleStats = {
		vehicleId = baseVehicle.id,
		powerKw = round3(power),
		peakTorqueNm = round3(torque),
		torqueCurve = StatsCalculator.calculateTorqueCurve(power, torque),
		topSpeedKmh = round3(topSpeed),
		acceleration = round3(accel),
		braking = round3(braking),
		grip = round3(grip),
		consumptionPer100Km = round3(consumption),
		weightKg = round3(weight),
		partCount = #partList,
	}
	return stats, nil
end

return StatsCalculator
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="13">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- ToeffliTal Server Bootstrap: integriert alle Gameplay-Systeme.
-- Reihenfolge: Config/Protokoll -> Remotes -> Profile -> Services ->
-- Router -> Welt -> Spielerbeitritt/Spawn -> Herunterfahren.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local DataStoreService = game:GetService("DataStoreService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ServicesFolder = ServerScriptService:WaitForChild("Services")

local GameConfig = require(Shared:WaitForChild("GameConfig"))
local PlayerDataSchema = require(Shared:WaitForChild("data"):WaitForChild("PlayerDataSchema"))
local VehicleCatalog = require(Shared:WaitForChild("data"):WaitForChild("VehicleCatalog"))
local PartsCatalog = require(Shared:WaitForChild("data"):WaitForChild("PartsCatalog"))
local RemoteProtocol = require(Shared:WaitForChild("net"):WaitForChild("RemoteProtocol"))

local ServerRoot = script.Parent
local ProfileService = require(ServerRoot:WaitForChild("services"):WaitForChild("ProfileService"))
local ProfileAdapter = require(ServerRoot:WaitForChild("services"):WaitForChild("ProfileAdapter"))
local PlayerStore = require(ServerRoot:WaitForChild("services"):WaitForChild("PlayerStore"))
local GameplayHandlers = require(ServerRoot:WaitForChild("services"):WaitForChild("GameplayHandlers"))
local RequestRouter = require(ServerRoot:WaitForChild("net"):WaitForChild("RequestRouter"))
local PlayerIds = require(ServerRoot:WaitForChild("net"):WaitForChild("PlayerIds"))
local EconomyService = require(ServerRoot:WaitForChild("services"):WaitForChild("EconomyService"))
local VehicleService = require(ServerRoot:WaitForChild("services"):WaitForChild("VehicleService"))
local MissionService = require(ServerRoot:WaitForChild("services"):WaitForChild("MissionService"))
local DeliveryService = require(ServerRoot:WaitForChild("services"):WaitForChild("DeliveryService"))
local GarageService = require(ServerRoot:WaitForChild("services"):WaitForChild("GarageService"))
local WorkshopService = require(ServerRoot:WaitForChild("services"):WaitForChild("WorkshopService"))
local ShopService = require(ServerRoot:WaitForChild("services"):WaitForChild("ShopService"))
local DynoService = require(ServerRoot:WaitForChild("services"):WaitForChild("DynoService"))
local FuelService = require(ServerRoot:WaitForChild("services"):WaitForChild("FuelService"))
local ValleyWorld = require(ServerRoot:WaitForChild("world"):WaitForChild("ValleyWorld"))
local WorldLayout = require(ServerRoot:WaitForChild("world"):WaitForChild("WorldLayout"))
local BicycleSpawner = require(ServerRoot:WaitForChild("vehicle"):WaitForChild("BicycleSpawner"))

-- ServicesFolder/GameConfig werden für Rojo-Mapping und Balancing-Checks referenziert.
local _Anchor: Instance? = ServicesFolder
local _MaxPlayers: number = GameConfig.MAX_PLAYERS :: any

local remotes: { [string]: Instance } = {}
local connections: { RBXScriptConnection } = {}
local shuttingDown = false
-- Studio-Mehrclient vergibt negative UserIds (-1..-8). Nur in Studio werden
-- sie auf einen reservierten positiven Bereich abgebildet; der Live-Server
-- bleibt bei der strengen Pruefung. Alle Services und der Router erhalten
-- dieselbe kanonische ID.
local allowSimulatedPlayers = RunService:IsStudio()
-- Echte Service-Instanzen (nicht die Module), damit Profile, Guthaben und
-- Spielerzustand serverseitig zusammenlaufen.
local economyService: any = nil
local profileService: any = nil
local playerStore: any = nil
local vehicleServiceInst: any = nil
local fuelServiceInst: any = nil
local dynoServiceInst: any = nil
local transactionCounter = 0

local function canonicalUserId(player: Player): number?
	return PlayerIds.canonical(player.UserId, allowSimulatedPlayers)
end

-- Fuer Services, die nur die UserId benoetigen (z. B. GarageService).
local function servicePlayer(player: Player): any
	local userId = canonicalUserId(player)
	if userId == nil then
		return player
	end
	return { UserId = userId }
end

local function getModuleFn(module: any, name: string): any
	local fn = (module :: any)[name]
	if typeof(fn) == "function" then
		return fn
	end
	return nil
end

local function callOptional(module: any, name: string, ...: any): any
	local fn = getModuleFn(module, name)
	if fn then
		return (fn :: any)(module, ...)
	end
	return nil
end

-- 15 Weltanker (Garage_01..Garage_15) aus dem Layout: identische Quelle wie
-- GarageWorldBuilder. Der Service erhaelt damit exakt die gebauten Anker,
-- bevor Spieler beitreten. Es gibt keine Besitzerfarben und keine
-- clientseitige Berechtigungspruefung.
local function collectGarageAnchorIds(): { string }
	local anchors: { string } = {}
	for _, anchor in WorldLayout.getGarageAnchors() do
		if type(anchor) == "table" and type(anchor.id) == "string" then
			table.insert(anchors, anchor.id)
		end
	end
	return anchors
end

-- 1-2. Remotes aus dem versionierten Protokoll erzeugen.
local function setupRemotes(): Folder
	local folder = ReplicatedStorage:FindFirstChild("ToeffliTalRemotes")
	local netFolder: Folder
	if folder and folder:IsA("Folder") then
		netFolder = folder
	else
		netFolder = Instance.new("Folder")
		netFolder.Name = "ToeffliTalRemotes"
		netFolder.Parent = ReplicatedStorage
	end
	local names: { string } = {}
	local listFn = getModuleFn(RemoteProtocol, "listRemoteNames")
	if listFn then
		local ok, result = pcall(listFn, RemoteProtocol)
		if ok and typeof(result) == "table" then
			names = result :: { string }
		end
	end
	if #names == 0 then
		names = {
			"EconomyGet",
			"EconomyTransfer",
			"VehicleBuy",
			"VehicleSelect",
			"MissionProgress",
			"DeliveryOrder",
			"DeliveryPickup",
			"DeliveryDeliver",
			"GarageEnter",
			"WorkshopInstall",
			"WorkshopPaint",
			"ShopCatalog",
			"ShopBuy",
			"DynoRun",
			"FuelRefill",
		}
	end
	for _, remoteName in names do
		local existing = netFolder:FindFirstChild(remoteName)
		if existing == nil then
			local remote = Instance.new("RemoteFunction")
			remote.Name = remoteName
			remote.Parent = netFolder
			remotes[remoteName] = remote
		else
			remotes[remoteName] = existing
		end
	end
	return netFolder
end

-- Produktion: DataStore. Studio/Test: In-Memory, damit Play Solo ohne
-- API-Zugriff deterministisch bleibt. Fehler fallen auf In-Memory zurueck.
local function buildProfileAdapter(): any
	if RunService:IsStudio() then
		return ProfileAdapter.memory()
	end
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore("ToeffliTalProfiles_v1")
	end)
	if not ok or store == nil then
		warn("[ToeffliTal][Server] DataStore nicht verfuegbar; Profile bleiben session-lokal")
		return ProfileAdapter.memory()
	end
	return ProfileAdapter.dataStore(store)
end

local function playerPosition(userId: number): Vector3?
	local player = Players:GetPlayerByUserId(userId)
	if player == nil or player.Character == nil then
		return nil
	end
	local root = player.Character:FindFirstChild("HumanoidRootPart")
	if root ~= nil and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

local function garageAnchorPosition(garageId: string): Vector3?
	for _, anchor in WorldLayout.getGarageAnchors() do
		if anchor.id == garageId then
			local point = anchor.position
			return Vector3.new(point.x, point.y, point.z)
		end
	end
	return nil
end

-- Echte serverseitige Naehekontrolle fuer die eigene Garage. Kein Clientwert.
local function isNearOwnGarage(userId: any): boolean
	local numericId = tonumber(userId)
	if numericId == nil then
		return false
	end
	local garageId = GarageService.getGarage(numericId)
	if garageId == nil then
		return false
	end
	local anchor = garageAnchorPosition(garageId)
	local position = playerPosition(numericId)
	if anchor == nil or position == nil then
		return false
	end
	return (position - anchor).Magnitude <= 24
end

local function isNearStore(_userId: any): boolean
	-- Es gibt noch kein gebautes Toeffli-Ladengebaeude; Bestellungen laufen
	-- deshalb ausschliesslich ueber das Laptop-Terminal. Kein Clientwert.
	return false
end

local function isOwnerOfVehicleKey(userId: any, vehicleKey: any): boolean
	if type(vehicleKey) ~= "string" then
		return false
	end
	local prefix = tostring(userId) .. ":"
	if string.sub(vehicleKey, 1, #prefix) ~= prefix then
		return false
	end
	local vehicleId = string.sub(vehicleKey, #prefix + 1)
	if playerStore == nil then
		return false
	end
	return playerStore:owns(userId, vehicleId)
end

local function nextTransactionId(userId: number, kind: string): string
	transactionCounter += 1
	return string.format("%s:%s:%d:%d", kind, tostring(userId), os.time(), transactionCounter)
end

local function registerVehicle(userId: number, vehicleId: string): ()
	if playerStore == nil or fuelServiceInst == nil or dynoServiceInst == nil then
		return
	end
	local definition = VehicleCatalog.get(vehicleId)
	if definition == nil then
		return
	end
	local vehicleKey = playerStore:vehicleKey(userId, vehicleId)
	fuelServiceInst:RegisterVehicle(vehicleKey, userId, {
		modelId = vehicleId,
		kind = definition.Class,
		hasEngine = definition.Fuel.HasEngine,
		tankVolume = definition.Fuel.TankLiters,
	})
	local record = playerStore:workshopVehicle(userId, vehicleId)
	local parts: any = {}
	if record ~= nil then
		parts = record.parts
	end
	dynoServiceInst:RegisterVehicle(vehicleKey, userId, {
		id = vehicleId,
		modelId = vehicleId,
		kind = definition.Class,
		hasEngine = definition.Fuel.HasEngine,
		physics = definition.Physics,
	}, parts)
end

local function registerOwnedVehicles(userId: number): ()
	for _, vehicleId in ipairs(playerStore:owned(userId)) do
		registerVehicle(userId, vehicleId)
	end
end

-- 3-5. Services in Abhängigkeitsreihenfolge initialisieren und Router verdrahten.
local function setupServices(netFolder: Folder): ()
	profileService = ProfileService.new(buildProfileAdapter(), PlayerDataSchema)
	economyService = EconomyService.new()

	local garageAnchors = collectGarageAnchorIds()
	assert(
		#garageAnchors == 15,
		string.format("GarageService erwartet 15 Weltanker, gefunden: %d", #garageAnchors)
	)
	GarageService.init({ anchors = garageAnchors })

	playerStore = PlayerStore.new({ profiles = profileService, economy = economyService })

	-- Preise kommen ausschliesslich aus den Serverkatalogen.
	vehicleServiceInst = VehicleService.new()
	local shopCatalog: { [string]: any } = {}
	local workshopParts: { [string]: any } = {}
	for _, part in PartsCatalog.Parts do
		shopCatalog[part.id] = {
			id = part.id,
			price = part.price,
			slot = part.slot,
			models = part.compatibleModels,
		}
		workshopParts[part.id] = { slot = part.slot, models = part.compatibleModels }
	end
	local shopServiceInst = ShopService.new({
		catalog = shopCatalog,
		profiles = playerStore:getVehicleProfiles(),
		isNearStore = isNearStore,
	})
	local workshopServiceInst = WorkshopService.new({
		profiles = playerStore:getWorkshopProfiles(),
		parts = workshopParts,
		isWorkshopActive = isNearOwnGarage,
	})
	fuelServiceInst = FuelService.new({
		isOwner = isOwnerOfVehicleKey,
		isAtGasStation = function(_userId: any, _vehicleKey: any): boolean
			-- Es gibt noch keine Tankstelle in der Welt; ehrliche Ablehnung.
			return false
		end,
		debit = function(userId: any, amount: number, transactionId: string?): (boolean, string?)
			-- EconomyService rechnet in ganzen CHF; Tankkosten sind gerundet.
			local tx = transactionId
			if type(tx) ~= "string" or tx == "" then
				transactionCounter += 1
				tx = string.format("fuel:%s:%d:%d", tostring(userId), os.time(), transactionCounter)
			end
			local ok, result = economyService:debit(userId, math.ceil(amount), tx :: string)
			if not ok then
				return false, tostring(result)
			end
			return true, nil
		end,
	})
	dynoServiceInst = DynoService.new({ isOwner = isOwnerOfVehicleKey })
	local missionServiceInst = MissionService.new()

	-- Der Router erwartet eine tabellenbasierte Spielerzuordnung; echte Player
	-- sind userdata. Darum läuft pro kanonischer UserId genau eine
	-- Aufzeichnung mit den serverseitig bekannten Werten (UserId, Character).
	local requestPlayers: { [number]: any } = {}
	local function requestPlayer(player: Player): any
		local userId = canonicalUserId(player)
		if userId == nil then
			-- Ungueltige IDs bleiben unveraendert; der Router weist sie mit
			-- `invalid_player` ab, statt sie stillschweigend abzubilden.
			return { UserId = player.UserId, Character = player.Character }
		end
		local record = requestPlayers[userId]
		if record == nil then
			record = { UserId = userId, Character = player.Character }
			requestPlayers[userId] = record
		else
			record.Character = player.Character
		end
		return record
	end

	-- Generischer Router als echte Instanz. Nicht registrierte Aktionen
	-- antworten sofort mit `unknown_action`, statt den Client hängen zu lassen.
	local genericRouter = RequestRouter.new()
	GameplayHandlers.register(genericRouter, {
		playerStore = playerStore,
		vehicleService = vehicleServiceInst,
		shopService = shopServiceInst,
		workshopService = workshopServiceInst,
		garageService = GarageService,
		dynoService = dynoServiceInst,
		fuelService = fuelServiceInst,
		missionService = missionServiceInst,
		economy = economyService,
		onVehicleOwned = registerVehicle,
		nextTransactionId = nextTransactionId,
	})

	-- Alle generischen Remotes an den Router binden; die drei Delivery-Aktionen
	-- bleiben dem dedizierten Delivery-Router vorbehalten.
	local deliveryActions = {
		[RemoteProtocol.ACTIONS.DELIVERY_ORDER] = true,
		[RemoteProtocol.ACTIONS.DELIVERY_PICKUP] = true,
		[RemoteProtocol.ACTIONS.DELIVERY_DELIVER] = true,
	}
	for remoteName, remote in remotes do
		if deliveryActions[remoteName] ~= true and remote:IsA("RemoteFunction") then
			(remote :: RemoteFunction).OnServerInvoke = function(player: Player, payload: any): any
				return genericRouter:handle(requestPlayer(player), remoteName, payload)
			end
		end
	end

	-- Lieferaufträge: ausschliesslich die drei versionierten Delivery-Aktionen
	-- laufen über einen eigenen Router, der Spieler, Payload und Rate prüft und
	-- danach an den DeliveryService delegiert. Distanz, Fahrzeugtyp, Zieladresse,
	-- Zustandswechsel und Auszahlung bleiben vollständig serverseitig.
	local deliveryRouter = RequestRouter.new()
	local deliveryBindings = {
		{ action = RemoteProtocol.ACTIONS.DELIVERY_ORDER, handler = DeliveryService.handleOrder },
		{ action = RemoteProtocol.ACTIONS.DELIVERY_PICKUP, handler = DeliveryService.handlePickup },
		{ action = RemoteProtocol.ACTIONS.DELIVERY_DELIVER, handler = DeliveryService.handleDeliver },
	}
	for _, binding in deliveryBindings do
		deliveryRouter:register(binding.action, function(player: any, payload: any): any
			return binding.handler(player, payload)
		end)
		pcall(function()
			deliveryRouter:setRateLimit(binding.action, 10, 1)
		end)
	end
	for _, binding in deliveryBindings do
		local remote = netFolder:FindFirstChild(binding.action)
		if remote ~= nil and remote:IsA("RemoteFunction") then
			(remote :: RemoteFunction).OnServerInvoke = function(player: Player, payload: any): any
				return deliveryRouter:handle(requestPlayer(player), binding.action, payload)
			end
		end
	end
end

local function spawnPlayer(player: Player): ()
	local character: Model? = player.Character
	if character == nil then
		local ok, _ = pcall(function()
			player:LoadCharacter()
		end)
		if not ok then
			return
		end
	end
	callOptional(VehicleService, "onPlayerSpawned", player)
	callOptional(FuelService, "onPlayerSpawned", player)
	BicycleSpawner.createForPlayer(player, CFrame.new(0, 5, 0))
end

local function onPlayerAdded(player: Player): ()
	if shuttingDown then
		return
	end
	local userId = canonicalUserId(player)
	if userId == nil then
		warn(string.format("[ToeffliTal][Server] Ungueltige UserId: %s", tostring(player.UserId)))
		return
	end
	local loaded, err = pcall(function()
		playerStore:load(userId)
	end)
	if not loaded then
		warn(string.format("[ToeffliTal][Server] Profil konnte nicht geladen werden: %s", tostring(err)))
	end
	callOptional(GarageService, "assignGarage", servicePlayer(player))
	registerOwnedVehicles(userId)
	spawnPlayer(player)
end

local function onPlayerRemoving(player: Player): ()
	local userId = canonicalUserId(player)
	callOptional(GarageService, "releaseGarage", servicePlayer(player))
	BicycleSpawner.releaseForPlayer(player)
	if userId ~= nil and playerStore ~= nil then
		local ok, err = playerStore:release(userId)
		if not ok then
			warn(string.format("[ToeffliTal][Server] Profil konnte nicht gespeichert werden: %s", tostring(err)))
		end
	end
end

local function shutdown(): ()
	if shuttingDown then
		return
	end
	shuttingDown = true
	for _, conn in connections do
		conn:Disconnect()
	end
	table.clear(connections)
	-- Persistenz vor Welt-Abbau: kein Datenverlust beim Herunterfahren.
	if playerStore ~= nil then
		local saved, failed = playerStore:saveAll()
		print(string.format("[ToeffliTal][Server] Profile gespeichert: %d, fehlgeschlagen: %d", saved, failed))
	end
	callOptional(ValleyWorld, "cleanup")
	print("[ToeffliTal][Server] Shutdown complete")
end

local function init(): ()
	local netFolder = setupRemotes()
	setupServices(netFolder)
	-- 6. Welt erst nach Services bauen, damit Lieferpunkte/Garagenanker existieren.
	ValleyWorld.build(workspace)
	-- 6b. Lieferpunkte entstehen mit der Welt: DeliveryService danach konfigurieren.
	DeliveryService.init({
		profiles = profileService,
		economy = economyService,
		world = ValleyWorld,
		-- Der Vertical Slice startet nur mit dem Fahrrad. Alle aktuellen
		-- Lieferrouten (Dörfer ~450 Studs vom Dönerladen) gelten daher als
		-- Startlieferung; die Serverseite bleibt alleinige Quelle der Distanz.
		starterMaxDistance = 700,
	})
	-- 7. Spielerbeitritt, Spawn und Verlassen verdrahten.
	table.insert(connections, Players.PlayerAdded:Connect(onPlayerAdded))
	table.insert(connections, Players.PlayerRemoving:Connect(onPlayerRemoving))
	-- Studio-Play-Solo: bereits verbundene Spieler nachträglich einhängen.
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	game:BindToClose(shutdown)
	print("[ToeffliTal][Server] Bootstrap ready: systems integrated")
end

init()
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">net</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">PlayerIds</string>
            <string name="Source"><![CDATA[--!strict
-- PlayerIds: kanonische serverseitige Spieler-IDs.
-- Studio-Mehrclient vergibt negative UserIds (-1..-8). Alle Services arbeiten
-- mit positiven Ganzzahlen; darum werden simulierte IDs ausschliesslich in
-- Studio auf einen reservierten positiven Bereich abgebildet. Keine
-- Roblox-Laufzeit, damit die Logik mit `lune run` testbar bleibt.
-- Keine globalen Variablen.

local PlayerIds = {}

-- Reservierter Bereich oberhalb realistischer Roblox-UserIds.
PlayerIds.SIMULATED_OFFSET = 9_000_000_000

local function isInteger(value: any): boolean
	if type(value) ~= "number" then
		return false
	end
	local number = value :: number
	if number ~= number then
		return false
	end
	if number == math.huge or number == -math.huge then
		return false
	end
	return math.floor(number) == number
end

-- Simulierte Studio-Clients erkennt man an der negativen UserId.
function PlayerIds.isSimulated(userId: any): boolean
	return isInteger(userId) and (userId :: number) < 0
end

-- `allowSimulated` darf nur in Studio (`RunService:IsStudio()`) true sein.
-- Liefert `nil` fuer IDs, die serverseitig nicht zulaessig sind.
function PlayerIds.canonical(userId: any, allowSimulated: boolean?): number?
	if not isInteger(userId) then
		return nil
	end
	local number = userId :: number
	if number > 0 then
		return number
	end
	if number < 0 and allowSimulated == true then
		return PlayerIds.SIMULATED_OFFSET + math.abs(number)
	end
	return nil
end

return PlayerIds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">RequestRouter</string>
            <string name="Source"><![CDATA[-- RequestRouter: serverseitiger Router mit Handler-Registrierung,
-- Typpruefung, Spielerzuordnung und sicheren Fehlerantworten.
-- Keine globalen Variablen.

local RemoteProtocol = require("../../shared/net/RemoteProtocol")
local RateLimiter = require("../../shared/net/RateLimiter")

type Handler = (player: any, payload: any) -> any

local RequestRouter = {}
RequestRouter.__index = RequestRouter

export type Router = typeof(setmetatable(
	{} :: { _handlers: { [string]: Handler }, _limiter: any },
	RequestRouter
))

local function invalidPlayer(player: any): boolean
	if type(player) ~= "table" then
		return true
	end
	local userId = (player :: any).UserId
	if type(userId) ~= "number" then
		return true
	end
	if userId <= 0 or userId ~= userId then
		return true
	end
	return false
end

local function fail(code: string): { ok: boolean, code: string, message: string }
	local message = "request rejected"
	if code == "unknown_action" then
		message = "unknown action"
	elseif code == "invalid_payload" then
		message = "invalid payload"
	elseif code == "invalid_player" then
		message = "invalid player"
	elseif code == "handler_error" then
		message = "handler failed"
	elseif code == "rate_limited" then
		message = "too many requests"
	elseif code == "busy" then
		message = "request in progress"
	end
	return { ok = false, code = code, message = message }
end

function RequestRouter.new(limiter: any?): Router
	local activeLimiter = limiter
	if activeLimiter == nil then
		activeLimiter = RateLimiter.new()
	end
	local self = setmetatable({ _handlers = {}, _limiter = activeLimiter }, RequestRouter)
	return self :: any
end

function RequestRouter:setRateLimiter(limiter: any): boolean
	if type(limiter) ~= "table" then
		error("setRateLimiter: limiter must be a table")
	end
	if type((limiter :: any).check) ~= "function" then
		error("setRateLimiter: limiter must provide check()")
	end
	if type((limiter :: any).acquire) ~= "function" then
		error("setRateLimiter: limiter must provide acquire()")
	end
	if type((limiter :: any).release) ~= "function" then
		error("setRateLimiter: limiter must provide release()")
	end
	self._limiter = limiter
	return true
end

function RequestRouter:getRateLimiter(): any
	return self._limiter
end

function RequestRouter:setRateLimit(action: string, limit: number, window: number): boolean
	if self._limiter == nil or type((self._limiter :: any).setLimit) ~= "function" then
		error("setRateLimit: active limiter does not support setLimit()")
	end
	local anyLimiter: any = self._limiter
	anyLimiter:setLimit(action, limit, window)
	return true
end

function RequestRouter:register(action: string, handler: Handler): boolean
	if type(action) ~= "string" or action == "" then
		error("register: action must be a non-empty string")
	end
	if type(handler) ~= "function" then
		error("register: handler must be a function")
	end
	if self._handlers[action] ~= nil then
		error("register: handler already registered")
	end
	self._handlers[action] = handler
	return true
end

function RequestRouter:unregister(action: string): boolean
	if type(action) ~= "string" then
		return false
	end
	if self._handlers[action] == nil then
		return false
	end
	self._handlers[action] = nil
	return true
end

function RequestRouter:hasHandler(action: any): boolean
	if type(action) ~= "string" then
		return false
	end
	return self._handlers[action] ~= nil
end

function RequestRouter:handle(player: any, action: any, payload: any): any
	if invalidPlayer(player) then
		return fail("invalid_player")
	end
	if type(action) ~= "string" or self._handlers[action] == nil then
		return fail("unknown_action")
	end
	if type(payload) ~= "table" then
		return fail("invalid_payload")
	end
	if RemoteProtocol.isKnownAction(action) then
		local valid, _ = RemoteProtocol.validatePayload(action, payload)
		if not valid then
			return fail("invalid_payload")
		end
	end
	local handler = self._handlers[action]
	local limiter = self._limiter
	if limiter ~= nil then
		local allowed = false
		local acquireOk = false
		local checkOk, checkResult = pcall(function()
			return (limiter :: any):check(player, action)
		end)
		allowed = checkOk and checkResult == true
		if not allowed then
			return fail("rate_limited")
		end
		local acquireCallOk, acquireResult = pcall(function()
			return (limiter :: any):acquire(player, action)
		end)
		acquireOk = acquireCallOk and acquireResult == true
		if not acquireOk then
			return fail("busy")
		end
		local ok, result = pcall(handler, player, payload)
		local anyLimiter: any = limiter
		pcall(function()
			anyLimiter:release(player, action)
		end)
		if not ok then
			return fail("handler_error")
		end
		return { ok = true, data = result }
	end
	local ok, result = pcall(handler, player, payload)
	if not ok then
		return fail("handler_error")
	end
	return { ok = true, data = result }
end

return RequestRouter
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">services</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">DeliveryService</string>
            <string name="Source"><![CDATA[--!strict
-- DeliveryService: Döner-Lieferaufträge (Annahme, Abholung, Auslieferung).
-- Rein serverseitig, ohne globale Variablen. Distanz- und Zustandsprüfung
-- erfolgen anhand der übergebenen Spielerpositionen.

export type Position = { x: number, y: number, z: number }
export type AddressEntry = { id: string, position: Position }
export type EconomyAdapter = {
	addBalance: (playerId: string, amount: number, transactionId: string) -> boolean,
}
export type ServiceConfig = {
	shopPosition: Position,
	addresses: { AddressEntry },
	starterMaxDistance: number?,
	pickupRadius: number?,
	deliverRadius: number?,
	starterPayout: number?,
	standardPayout: number?,
	economy: EconomyAdapter?,
	randomIndex: ((n: number) -> number)?,
}
export type Job = {
	jobId: string,
	playerId: string,
	addressId: string,
	state: string,
	starter: boolean,
	payout: number,
	vehicleType: string,
}
export type RuntimeConfig = {
	profiles: any?,
	economy: any?,
	world: any?,
	shopPosition: Position?,
	addresses: { AddressEntry }?,
	getPlayerPosition: ((player: any) -> any)?,
	starterMaxDistance: number?,
	pickupRadius: number?,
	deliverRadius: number?,
	starterPayout: number?,
	standardPayout: number?,
}
export type DeliveryResponse = {
	ok: boolean,
	code: string?,
	orderId: string?,
	addressId: string?,
	state: string?,
	starter: boolean?,
	payout: number?,
	vehicleType: string?,
}

local DeliveryService = {}
DeliveryService.__index = DeliveryService

local STATE_ACCEPTED = "accepted"
local STATE_PICKED_UP = "pickedUp"
local STATE_DELIVERED = "delivered"

local function isPosition(value: any): boolean
	if type(value) ~= "table" then
		return false
	end
	local pos = value :: Position
	return type(pos.x) == "number" and type(pos.y) == "number" and type(pos.z) == "number"
end

local function distance(a: Position, b: Position): number
	local dx = a.x - b.x
	local dy = a.y - b.y
	local dz = a.z - b.z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function findAddress(addresses: { AddressEntry }, addressId: string): AddressEntry?
	for _, entry in ipairs(addresses) do
		if entry.id == addressId then
			return entry
		end
	end
	return nil
end

function DeliveryService.new(config: ServiceConfig)
	assert(type(config) == "table", "configRequired")
	assert(isPosition(config.shopPosition), "shopPositionRequired")
	assert(type(config.addresses) == "table" and #config.addresses > 0, "addressesRequired")
	for _, entry in ipairs(config.addresses) do
		assert(type(entry.id) == "string" and #entry.id > 0, "addressIdRequired")
		assert(isPosition(entry.position), "addressPositionRequired")
	end
	if config.economy ~= nil then
		assert(type(config.economy.addBalance) == "function", "economyAdapterInvalid")
	end

	local self = setmetatable({}, DeliveryService)
	self._shopPosition = config.shopPosition
	self._addresses = config.addresses
	self._starterMaxDistance = config.starterMaxDistance or 150
	self._pickupRadius = config.pickupRadius or 12
	self._deliverRadius = config.deliverRadius or 12
	self._starterPayout = config.starterPayout or 25
	self._standardPayout = config.standardPayout or 60
	self._economy = config.economy
	self._randomIndex = config.randomIndex
	self._jobsById = {} :: { [string]: Job }
	self._activeByPlayer = {} :: { [string]: string }
	self._counter = 0
	return self
end

function DeliveryService:_pickAddressIndex(): number
	local count = #self._addresses
	if self._randomIndex ~= nil then
		local picked = (self._randomIndex :: (n: number) -> number)(count)
		assert(type(picked) == "number" and picked >= 1 and picked <= count, "randomIndexOutOfRange")
		return picked
	end
	return math.random(1, count)
end

function DeliveryService:getActiveJob(playerId: string): Job?
	local jobId = self._activeByPlayer[playerId]
	if jobId == nil then
		return nil
	end
	return self._jobsById[jobId]
end

-- Auftragsannahme: genau ein aktiver Auftrag pro Spieler. Kurze
-- Startlieferungen sind mit dem Fahrrad erlaubt, weite nur mit Mofa.
function DeliveryService:acceptJob(playerId: string, vehicleType: string): (Job?, string?)
	if type(playerId) ~= "string" or #playerId == 0 then
		return nil, "invalidPlayer"
	end
	if vehicleType ~= "bicycle" and vehicleType ~= "moped" then
		return nil, "invalidVehicle"
	end
	if self._activeByPlayer[playerId] ~= nil then
		return nil, "jobAlreadyActive"
	end

	local entry = self._addresses[self:_pickAddressIndex()]
	local routeLength = distance(self._shopPosition, entry.position)
	local starter = routeLength <= self._starterMaxDistance
	if starter == false and vehicleType == "bicycle" then
		return nil, "bicycleOnlyForStarter"
	end

	self._counter += 1
	local jobId = string.format("%s-%d", playerId, self._counter)
	local payout = self._standardPayout
	if starter then
		payout = self._starterPayout
	end
	local job: Job = {
		jobId = jobId,
		playerId = playerId,
		addressId = entry.id,
		state = STATE_ACCEPTED,
		starter = starter,
		payout = payout,
		vehicleType = vehicleType,
	}
	self._jobsById[jobId] = job
	self._activeByPlayer[playerId] = jobId
	return job, nil
end

-- Abholung: nur im Zustand "accepted" und nahe am Dönerladen.
function DeliveryService:pickup(playerId: string, jobId: string, playerPos: Position): (boolean, string?)
	local job = self._jobsById[jobId]
	if job == nil then
		return false, "unknownJob"
	end
	if job.playerId ~= playerId then
		return false, "notYourJob"
	end
	if job.state ~= STATE_ACCEPTED then
		return false, "invalidState"
	end
	if not isPosition(playerPos) then
		return false, "invalidPosition"
	end
	if distance(playerPos, self._shopPosition) > self._pickupRadius then
		return false, "tooFarFromShop"
	end
	job.state = STATE_PICKED_UP
	return true, nil
end

-- Auslieferung: nur im Zustand "pickedUp" und nahe an der Wohnadresse.
-- Jede Lieferung wird genau einmal ausgezahlt.
function DeliveryService:deliver(playerId: string, jobId: string, playerPos: Position): (number?, string?)
	local job = self._jobsById[jobId]
	if job == nil then
		return nil, "unknownJob"
	end
	if job.playerId ~= playerId then
		return nil, "notYourJob"
	end
	if job.state == STATE_DELIVERED then
		return nil, "alreadyDelivered"
	end
	if job.state ~= STATE_PICKED_UP then
		return nil, "invalidState"
	end
	if not isPosition(playerPos) then
		return nil, "invalidPosition"
	end
	local entry = findAddress(self._addresses, job.addressId)
	if entry == nil then
		return nil, "unknownAddress"
	end
	if distance(playerPos, entry.position) > self._deliverRadius then
		return nil, "tooFarFromAddress"
	end

	job.state = STATE_DELIVERED
	if self._activeByPlayer[playerId] == jobId then
		self._activeByPlayer[playerId] = nil
	end
	if self._economy ~= nil then
		local ok = (self._economy :: EconomyAdapter).addBalance(playerId, job.payout, "delivery:" .. jobId)
		if ok == false then
			return nil, "payoutFailed"
		end
	end
	return job.payout, nil
end

-- ---------------------------------------------------------------------------
-- Router-Verdrahtung: genau eine Laufzeitinstanz pro Server.
-- Der Service bleibt die einzige Zustandsmaschine; diese Funktionen prüfen nur
-- Spielerzuordnung und leiten an `acceptJob`, `pickup` und `deliver` weiter.
-- ---------------------------------------------------------------------------

local runtimeConfig: RuntimeConfig = {}
local runtime: any = nil

local function readField(value: any, key: string): any
	if value == nil then
		return nil
	end
	local ok, result = pcall(function()
		return (value :: any)[key]
	end)
	if ok then
		return result
	end
	return nil
end

local function toPosition(value: any): Position?
	if value == nil then
		return nil
	end
	-- Roblox-`Vector3` meldet in neueren Luau-Versionen `type == "vector"`;
	-- ältere Versionen liefern `userdata`. Beides muss akzeptiert werden.
	local valueType = type(value)
	if valueType ~= "table" and valueType ~= "userdata" and valueType ~= "vector" then
		return nil
	end
	local x = readField(value, "x")
	local y = readField(value, "y")
	local z = readField(value, "z")
	if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then
		x = readField(value, "X")
		y = readField(value, "Y")
		z = readField(value, "Z")
	end
	if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then
		return nil
	end
	return { x = x, y = y, z = z }
end

-- Adapter, damit der Service die Economy-Signatur unverändert aufrufen kann.
-- Bevorzugt `credit` (EconomyService-Instanz, Doppelpunkt-Signatur), fällt
-- danach auf `addBalance` zurück.
local function makeEconomyAdapter(economy: any): EconomyAdapter?
	if type(economy) ~= "table" then
		return nil
	end
	local credit = readField(economy, "credit")
	if type(credit) == "function" then
		return {
			addBalance = function(playerId: string, amount: number, transactionId: string): boolean
				local ok, result = pcall(function()
					return credit(economy, playerId, amount, transactionId)
				end)
				if not ok then
					ok, result = pcall(function()
						return credit(playerId, amount, transactionId)
					end)
				end
				if not ok then
					return false
				end
				return result ~= false
			end,
		}
	end
	local addBalance = readField(economy, "addBalance")
	if type(addBalance) ~= "function" then
		return nil
	end
	return {
		addBalance = function(playerId: string, amount: number, transactionId: string): boolean
			local ok, result = pcall(function()
				return addBalance(economy, playerId, amount, transactionId)
			end)
			if not ok then
				ok, result = pcall(function()
					return addBalance(playerId, amount, transactionId)
				end)
			end
			return ok and result ~= false
		end,
	}
end

local function entryName(entry: any): string?
	local name = readField(entry, "Name")
		or readField(entry, "name")
		or readField(entry, "id")
		or readField(entry, "Id")
	if type(name) == "string" and #name > 0 then
		return name
	end
	return nil
end

local function isPickupName(name: string): boolean
	local lower = string.lower(name)
	return string.find(lower, "doner", 1, true) ~= nil
		or string.find(lower, "pickup", 1, true) ~= nil
end

-- Lieferpunkte stammen ausschliesslich aus der Welt. Ohne gültige Weltdaten
-- bleibt der Dienst gesperrt, statt Punkte oder Distanzen zu erfinden.
local function resolveWorldPoints(): (Position?, { AddressEntry })
	local world = runtimeConfig.world
	if type(world) ~= "table" then
		return nil, {}
	end
	local pointsFn = readField(world, "getDeliveryPoints")
	if type(pointsFn) ~= "function" then
		return nil, {}
	end
	local ok, points = pcall(pointsFn, world)
	if not ok or type(points) ~= "table" then
		return nil, {}
	end

	local shop = toPosition(readField(points, "shopPosition"))
		or toPosition(readField(points, "shop"))
		or toPosition(readField(points, "donerPosition"))
	if shop == nil then
		shop = toPosition(readField(readField(points, "doner"), "position"))
	end

	local addresses: { AddressEntry } = {}
	local rawAddresses = readField(points, "addresses")
	if type(rawAddresses) == "table" then
		for _, entry in ipairs(rawAddresses) do
			local id = readField(entry, "id")
			local position = toPosition(readField(entry, "position")) or toPosition(entry)
			if type(id) == "string" and #id > 0 and position ~= nil then
				table.insert(addresses, { id = id, position = position })
			end
		end
	end

	-- Array-Format (z. B. ValleyWorld.getDeliveryPoints): { { Name, Position } }.
	-- Der Abholpunkt heisst "Delivery_DonerPickup", alle übrigen Punkte sind
	-- Wohnadressen. Das Format bleibt rückwärtskompatibel zur strukturierten Form.
	if shop == nil or #addresses == 0 then
		local arrayShop: Position? = nil
		local arrayAddresses: { AddressEntry } = {}
		for _, entry in ipairs(points) do
			local name = entryName(entry)
			local position = toPosition(readField(entry, "Position"))
				or toPosition(readField(entry, "position"))
				or toPosition(entry)
			if name ~= nil and position ~= nil then
				if isPickupName(name) then
					if arrayShop == nil then
						arrayShop = position
					end
				else
					table.insert(arrayAddresses, { id = name, position = position })
				end
			end
		end
		if shop == nil then
			shop = arrayShop
		end
		if #addresses == 0 then
			addresses = arrayAddresses
		end
	end

	return shop, addresses
end

local function buildRuntime(): any
	if runtime ~= nil then
		return runtime
	end
	local shop = runtimeConfig.shopPosition
	local addresses = runtimeConfig.addresses
	if shop == nil or addresses == nil or #addresses == 0 then
		local worldShop, worldAddresses = resolveWorldPoints()
		if shop == nil then
			shop = worldShop
		end
		if addresses == nil or #addresses == 0 then
			addresses = worldAddresses
		end
	end
	if shop == nil or addresses == nil or #addresses == 0 then
		return nil
	end
	runtime = DeliveryService.new({
		shopPosition = shop,
		addresses = addresses,
		starterMaxDistance = runtimeConfig.starterMaxDistance,
		pickupRadius = runtimeConfig.pickupRadius,
		deliverRadius = runtimeConfig.deliverRadius,
		starterPayout = runtimeConfig.starterPayout,
		standardPayout = runtimeConfig.standardPayout,
		economy = makeEconomyAdapter(runtimeConfig.economy),
	})
	return runtime
end

local function reject(code: string): DeliveryResponse
	return { ok = false, code = code }
end

local function playerIdOf(player: any): string?
	local userId = readField(player, "UserId")
	if type(userId) ~= "number" or userId <= 0 then
		return nil
	end
	return tostring(userId)
end

-- Position kommt aus dem Charakter des Spielers, nie aus dem Payload.
local function playerPositionOf(player: any): Position?
	local resolver = runtimeConfig.getPlayerPosition
	if type(resolver) == "function" then
		local ok, result = pcall(resolver, player)
		if not ok then
			return nil
		end
		return toPosition(result)
	end
	local character = readField(player, "Character")
	local root = readField(character, "HumanoidRootPart")
	return toPosition(readField(root, "Position"))
end

local function resolveOrderId(service: any, playerId: string, payload: any): (string?, string?)
	local requested = readField(payload, "orderId")
	if requested ~= nil then
		if type(requested) ~= "string" or #requested == 0 then
			return nil, "invalidPayload"
		end
		return requested, nil
	end
	local active = service:getActiveJob(playerId)
	if active == nil then
		return nil, "noActiveJob"
	end
	return active.jobId, nil
end

function DeliveryService.init(config: RuntimeConfig?): ()
	if config ~= nil and type(config) ~= "table" then
		error("init: config must be a table")
	end
	runtimeConfig = config or {}
	runtime = nil
end

function DeliveryService.handleOrder(player: any, payload: any): DeliveryResponse
	local service = buildRuntime()
	if service == nil then
		return reject("deliveryUnavailable")
	end
	local playerId = playerIdOf(player)
	if playerId == nil then
		return reject("invalidPlayer")
	end

	local vehicleType = "bicycle"
	local requested = readField(payload, "vehicleType")
	if requested ~= nil then
		if type(requested) ~= "string" then
			return reject("invalidPayload")
		end
		vehicleType = requested
	end

	local job, err = service:acceptJob(playerId, vehicleType)
	if job == nil then
		return reject(err or "orderFailed")
	end
	return {
		ok = true,
		orderId = job.jobId,
		addressId = job.addressId,
		state = job.state,
		starter = job.starter,
		payout = job.payout,
		vehicleType = job.vehicleType,
	}
end

function DeliveryService.handlePickup(player: any, payload: any): DeliveryResponse
	local service = buildRuntime()
	if service == nil then
		return reject("deliveryUnavailable")
	end
	local playerId = playerIdOf(player)
	if playerId == nil then
		return reject("invalidPlayer")
	end
	local orderId, idErr = resolveOrderId(service, playerId, payload)
	if orderId == nil then
		return reject(idErr or "unknownJob")
	end
	local position = playerPositionOf(player)
	if position == nil then
		return reject("positionUnavailable")
	end
	local ok, err = service:pickup(playerId, orderId, position)
	if not ok then
		return reject(err or "pickupFailed")
	end
	return { ok = true, orderId = orderId, state = STATE_PICKED_UP }
end

function DeliveryService.handleDeliver(player: any, payload: any): DeliveryResponse
	local service = buildRuntime()
	if service == nil then
		return reject("deliveryUnavailable")
	end
	local playerId = playerIdOf(player)
	if playerId == nil then
		return reject("invalidPlayer")
	end
	local orderId, idErr = resolveOrderId(service, playerId, payload)
	if orderId == nil then
		return reject(idErr or "unknownJob")
	end
	local position = playerPositionOf(player)
	if position == nil then
		return reject("positionUnavailable")
	end
	local payout, err = service:deliver(playerId, orderId, position)
	if payout == nil then
		return reject(err or "deliverFailed")
	end
	return { ok = true, orderId = orderId, state = STATE_DELIVERED, payout = payout }
end

return DeliveryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">DynoService</string>
            <string name="Source"><![CDATA[--!strict
-- DynoService: server-validated dynamometer (Pruefstand) runs.
-- Only the owner's correctly mounted moped inside the shop may run.
-- Stats always come from the shared StatsCalculator; client values are never trusted.
-- Stores the last result per vehicle.

local DynoService = {}
DynoService.__index = DynoService

export type VehicleBase = { [string]: any }
export type DynoState = { [string]: any }
export type DynoResult = { [string]: any }

local SharedCalculator: any = nil
do
	local ok, mod = pcall(function()
		-- From src/server/services/ -> src/shared/vehicle/StatsCalculator
		return require("../../shared/vehicle/StatsCalculator")
	end)
	if ok and mod ~= nil then
		SharedCalculator = mod
	end
end

local function isNonEmptyString(value: any): boolean
	return type(value) == "string" and value ~= ""
end

local function isBicycleBase(base: any): boolean
	if type(base) ~= "table" then
		return false
	end
	local idFields = { base.id, base.vehicleId, base.modelId, base.name }
	for _, field in ipairs(idFields) do
		if type(field) == "string" then
			local lower = string.lower(field)
			if lower == "bicycle" or lower == "fahrrad" or lower == "bike" then
				return true
			end
			if string.find(lower, "bicycle", 1, true) ~= nil then
				return true
			end
			if string.find(lower, "fahrrad", 1, true) ~= nil then
				return true
			end
		end
	end
	if base.kind == "bicycle" or base.kind == "bike" or base.category == "bicycle" then
		return true
	end
	if base.motorized == false or base.isMotorized == false or base.hasMotor == false or base.hasEngine == false then
		return true
	end
	return false
end

local function resolveCalculate(explicit: any): ((any, any) -> any)?
	if type(explicit) == "function" then
		return explicit
	end
	if type(explicit) == "table" then
		for _, key in ipairs({ "calculate", "calculateStats", "compute", "computeStats", "getStats" }) do
			if type(explicit[key]) == "function" then
				local fn = explicit[key]
				return function(base: any, parts: any): any
					return fn(explicit, base, parts)
				end
			end
		end
		local mt = getmetatable(explicit)
		if mt ~= nil and type(mt.__call) == "function" then
			return function(base: any, parts: any): any
				return explicit(base, parts)
			end
		end
	end
	if SharedCalculator ~= nil then
		if type(SharedCalculator) == "function" then
			return SharedCalculator
		end
		if type(SharedCalculator) == "table" then
			for _, key in ipairs({ "calculate", "calculateStats", "compute", "computeStats", "getStats" }) do
				local fn = SharedCalculator[key]
				if type(fn) == "function" then
					return function(base: any, parts: any): any
						return fn(SharedCalculator, base, parts)
					end
				end
			end
			local mt = getmetatable(SharedCalculator)
			if mt ~= nil and type(mt.__call) == "function" then
				return function(base: any, parts: any): any
					return SharedCalculator(base, parts)
				end
			end
		end
	end
	return nil
end

local function shallowCopy(input: any): any
	if type(input) ~= "table" then
		return input
	end
	return table.clone(input)
end

function DynoService.new(deps: any?)
	local self: any = setmetatable({}, DynoService)
	deps = deps or {}
	self._explicitCalculate = deps.calculate
	self._explicitCalculator = deps.statsCalculator or deps.calculator
	self._isOwner = deps.isOwner
	self._getSetupFn = deps.getSetup
	self._getDynoStateFn = deps.getDynoState
	self._clock = deps.clock
	self._vehicles = {}
	self._dynoStates = {}
	self._lastResults = {}
	self._busy = {}
	return self
end

function DynoService:RegisterVehicle(vehicleId: string, ownerId: any, base: VehicleBase, parts: any)
	assert(isNonEmptyString(vehicleId), "RegisterVehicle: vehicleId must be a non-empty string")
	assert(ownerId ~= nil, "RegisterVehicle: ownerId required")
	assert(type(base) == "table", "RegisterVehicle: base must be a table")
	self._vehicles[vehicleId] = {
		ownerId = ownerId,
		base = base,
		parts = parts,
	}
end

function DynoService:SetDynoState(vehicleId: string, state: DynoState)
	assert(isNonEmptyString(vehicleId), "SetDynoState: vehicleId must be a non-empty string")
	assert(type(state) == "table", "SetDynoState: state must be a table")
	self._dynoStates[vehicleId] = shallowCopy(state)
end

function DynoService:_checkOwner(playerId: any, vehicleId: string): boolean
	if type(self._isOwner) == "function" then
		local ok, result = pcall(self._isOwner, playerId, vehicleId)
		return ok and result == true
	end
	local entry = self._vehicles[vehicleId]
	if entry == nil then
		return false
	end
	return entry.ownerId == playerId
end

function DynoService:_getSetup(vehicleId: string): (any?, string?)
	if type(self._getSetupFn) == "function" then
		local ok, setup = pcall(self._getSetupFn, vehicleId)
		if ok and type(setup) == "table" then
			return setup, ""
		end
		return nil, "UnknownVehicle"
	end
	local entry = self._vehicles[vehicleId]
	if entry == nil then
		return nil, "UnknownVehicle"
	end
	return { base = entry.base, parts = entry.parts }, ""
end

function DynoService:_getState(vehicleId: string): any
	if type(self._getDynoStateFn) == "function" then
		local ok, state = pcall(self._getDynoStateFn, vehicleId)
		if ok and type(state) == "table" then
			return state
		end
		return nil
	end
	return self._dynoStates[vehicleId]
end

local function stateFlag(state: any, keys: { string }): boolean?
	for _, key in ipairs(keys) do
		if state[key] ~= nil then
			return state[key] == true
		end
	end
	return nil
end

function DynoService:_checkDynoReady(vehicleId: string): (boolean, string)
	local state = self:_getState(vehicleId)
	if type(state) ~= "table" then
		return false, "NotOnDyno"
	end
	-- Must be inside the shop / at the dyno.
	local inShop = stateFlag(state, { "inShop", "insideShop", "atShop", "inStore" })
	if inShop == false then
		return false, "NotInShop"
	end
	if inShop == nil then
		-- Fall back to explicit shop dyno flag.
		local onDyno = stateFlag(state, { "onDyno", "isOnDyno", "mounted", "isMounted", "jackedUp", "aufgebockt" })
		if onDyno ~= true then
			return false, "NotInShop"
		end
	end
	local onDyno = stateFlag(state, { "onDyno", "isOnDyno", "mounted", "isMounted", "jackedUp", "aufgebockt" })
	if onDyno == false then
		return false, "NotOnDyno"
	end
	if onDyno == nil then
		return false, "NotOnDyno"
	end
	local stationary = stateFlag(state, { "stationary", "isStationary", "standing", "parked" })
	if stationary == false then
		return false, "VehicleMoving"
	end
	local engineOff = stateFlag(state, { "engineOff", "isEngineOff", "motorOff", "motorAus" })
	if engineOff == false then
		-- Engine must be off before the run starts; the dyno run itself
		-- controls the engine afterwards.
		return false, "EngineRunning"
	end
	local rider = stateFlag(state, { "hasRider", "isOccupied", "occupied", "driverPresent" })
	if rider == true then
		return false, "Occupied"
	end
	if inShop == nil and onDyno == true then
		-- onDyno implies shop dyno; accept.
		return true, ""
	end
	if inShop == true and onDyno == true then
		return true, ""
	end
	return false, "NotOnDyno"
end

function DynoService:_now(): number
	if type(self._clock) == "function" then
		local ok, value = pcall(self._clock)
		if ok and type(value) == "number" then
			return value
		end
	end
	return os.clock()
end

-- Starts a dyno run. Only IDs are accepted; any client-supplied stats
-- argument is ignored to prevent manipulation.
function DynoService:StartRun(playerId: any, vehicleId: string, _clientStats: any?): (boolean, any)
	if playerId == nil or (type(playerId) ~= "string" and type(playerId) ~= "number") then
		return false, "InvalidPlayer"
	end
	if type(playerId) == "string" and playerId == "" then
		return false, "InvalidPlayer"
	end
	if not isNonEmptyString(vehicleId) then
		return false, "InvalidVehicle"
	end
	if self._busy[vehicleId] == true then
		return false, "Busy"
	end
	if not self:_checkOwner(playerId, vehicleId) then
		return false, "NotOwner"
	end
	local setup, setupErr = self:_getSetup(vehicleId)
	if setup == nil then
		return false, setupErr or "UnknownVehicle"
	end
	local base = setup.base
	local parts = setup.parts
	if type(base) ~= "table" then
		return false, "UnknownVehicle"
	end
	if isBicycleBase(base) then
		return false, "BicycleNotAllowed"
	end
	local ready, reason = self:_checkDynoReady(vehicleId)
	if not ready then
		return false, reason
	end
	local calculate = resolveCalculate(self._explicitCalculate) or resolveCalculate(self._explicitCalculator)
	if calculate == nil then
		return false, "NoCalculator"
	end
	self._busy[vehicleId] = true
	local ok, stats = pcall(calculate, base, parts)
	self._busy[vehicleId] = nil
	if not ok then
		return false, "CalculatorFailed"
	end
	if type(stats) ~= "table" then
		return false, "CalculatorFailed"
	end
	local result: { [string]: any } = shallowCopy(stats)
	result.vehicleId = vehicleId
	result.measuredAt = self:_now()
	self._lastResults[vehicleId] = shallowCopy(result)
	return true, shallowCopy(result)
end

function DynoService:GetLastResult(vehicleId: string): any?
	if not isNonEmptyString(vehicleId) then
		return nil
	end
	local stored = self._lastResults[vehicleId]
	if stored == nil then
		return nil
	end
	return shallowCopy(stored)
end

function DynoService:ClearResult(vehicleId: string)
	if isNonEmptyString(vehicleId) then
		self._lastResults[vehicleId] = nil
	end
end

return DynoService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
-- EconomyService: server-authoritative Guthabenverwaltung.
-- Nur fuer den Server. Clients erhalten Zugriff ausschliesslich ueber
-- validierte Router-Handler, die Requestor und Ziel abgleichen.

local EconomyService = {}
EconomyService.__index = EconomyService

export type EconomyService = typeof(setmetatable(
	{} :: {
		_balances: { [string]: number },
		_processed: { [string]: { [string]: { kind: string, amount: number, balance: number } } },
	},
	EconomyService
))

local function normalizeUserId(userId: any): string?
	if typeof(userId) == "number" then
		if userId ~= math.floor(userId) or userId <= 0 then
			return nil
		end
		return tostring(userId)
	elseif typeof(userId) == "string" then
		if #userId == 0 then
			return nil
		end
		return userId
	end
	return nil
end

local function isValidAmount(amount: any): boolean
	if typeof(amount) ~= "number" then
		return false
	end
	if amount ~= amount then
		return false
	end
	if amount == math.huge or amount == -math.huge then
		return false
	end
	if math.floor(amount) ~= amount then
		return false
	end
	if amount <= 0 then
		return false
	end
	return true
end

local function isValidTransactionId(transactionId: any): boolean
	if typeof(transactionId) ~= "string" then
		return false
	end
	if #transactionId == 0 then
		return false
	end
	return true
end

function EconomyService.new(): EconomyService
	local self = setmetatable({
		_balances = {},
		_processed = {},
	}, EconomyService)
	return (self :: any) :: EconomyService
end

function EconomyService:getBalance(userId: number | string): number
	local key = normalizeUserId(userId)
	assert(key ~= nil, "invalid userId")
	local balance = self._balances[(key :: any) :: string]
	if balance == nil then
		return 0
	end
	return balance
end

function EconomyService:getBalanceFor(requestorUserId: number | string, targetUserId: number | string): (number?, string?)
	local requestorKey = normalizeUserId(requestorUserId)
	local targetKey = normalizeUserId(targetUserId)
	if requestorKey == nil or targetKey == nil then
		return nil, "invalid_user"
	end
	if requestorKey ~= targetKey then
		return nil, "access_denied"
	end
	return self:getBalance(targetKey), nil
end

function EconomyService:setBalance(userId: number | string, amount: number): number
	local key = normalizeUserId(userId)
	assert(key ~= nil, "invalid userId")
	assert(typeof(amount) == "number", "invalid amount")
	assert(amount == math.floor(amount), "amount must be an integer")
	assert(amount >= 0, "balance must not be negative")
	assert(amount ~= math.huge, "amount out of range")
	local resolved = key :: string
	self._balances[resolved] = amount
	return amount
end

function EconomyService:hasProcessed(userId: number | string, transactionId: string): boolean
	local key = normalizeUserId(userId)
	if key == nil then
		return false
	end
	local perUser = self._processed[key]
	if perUser == nil then
		return false
	end
	return perUser[transactionId] ~= nil
end

function EconomyService:credit(userId: number | string, amount: number, transactionId: string): (boolean, number | string)
	local key = normalizeUserId(userId)
	if key == nil then
		return false, "invalid_user"
	end
	if not isValidAmount(amount) then
		return false, "invalid_amount"
	end
	if not isValidTransactionId(transactionId) then
		return false, "invalid_transaction_id"
	end
	local resolved = key :: string

	local perUser = self._processed[resolved]
	if perUser == nil then
		perUser = {}
		self._processed[resolved] = perUser
	end

	local existing = perUser[transactionId]
	if existing ~= nil then
		if existing.kind == "credit" and existing.amount == amount then
			return true, existing.balance
		end
		return false, "duplicate_transaction_id"
	end

	local current = self._balances[resolved]
	if current == nil then
		current = 0
	end
	local nextBalance = current + amount
	self._balances[resolved] = nextBalance
	perUser[transactionId] = { kind = "credit", amount = amount, balance = nextBalance }
	return true, nextBalance
end

function EconomyService:debit(userId: number | string, amount: number, transactionId: string): (boolean, number | string)
	local key = normalizeUserId(userId)
	if key == nil then
		return false, "invalid_user"
	end
	if not isValidAmount(amount) then
		return false, "invalid_amount"
	end
	if not isValidTransactionId(transactionId) then
		return false, "invalid_transaction_id"
	end
	local resolved = key :: string

	local perUser = self._processed[resolved]
	if perUser == nil then
		perUser = {}
		self._processed[resolved] = perUser
	end

	local existing = perUser[transactionId]
	if existing ~= nil then
		if existing.kind == "debit" and existing.amount == amount then
			return true, existing.balance
		end
		return false, "duplicate_transaction_id"
	end

	local current = self._balances[resolved]
	if current == nil then
		current = 0
	end
	if current < amount then
		return false, "insufficient_funds"
	end
	local nextBalance = current - amount
	self._balances[resolved] = nextBalance
	perUser[transactionId] = { kind = "debit", amount = amount, balance = nextBalance }
	return true, nextBalance
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">FuelService</string>
            <string name="Source"><![CDATA[--!strict
-- FuelService: server-authoritative fuel for motorized vehicles.
-- Tracks tank content per vehicle, applies load-dependent consumption,
-- refuels only at gas stations with server-side charging, and offers a
-- fair anti-stranding rescue refill. Bicycles never consume or hold fuel.

local FuelService = {}
FuelService.__index = FuelService

export type VehicleEntry = { [string]: any }
export type RefuelResult = { [string]: any }

local function isNonEmptyString(value: any): boolean
	return type(value) == "string" and value ~= ""
end

local function isValidPlayerId(playerId: any): boolean
	if playerId == nil then
		return false
	end
	if type(playerId) == "number" then
		return true
	end
	return isNonEmptyString(playerId)
end

local function clamp01(value: any, fallback: number): number
	if type(value) ~= "number" or value ~= value then
		return fallback
	end
	if value < 0 then
		return 0
	end
	if value > 1 then
		return 1
	end
	return value
end

local function isBicycleModel(modelId: any, flags: any): boolean
	if type(flags) == "table" then
		if flags.isMotorized == false or flags.motorized == false then
			return true
		end
		if flags.hasMotor == false or flags.hasEngine == false then
			return true
		end
		if flags.kind == "bicycle" or flags.kind == "bike" or flags.category == "bicycle" then
			return true
		end
	end
	if type(modelId) == "string" then
		local lower = string.lower(modelId)
		if lower == "bicycle" or lower == "fahrrad" or lower == "bike" then
			return true
		end
		if string.find(lower, "bicycle", 1, true) ~= nil then
			return true
		end
		if string.find(lower, "fahrrad", 1, true) ~= nil then
			return true
		end
		if lower == "bike" or string.find(lower, "bike", 1, true) ~= nil then
			-- "bike" alone means bicycle; motorized models use distinct ids.
			if lower == "bike" or lower == "city-bike" or lower == "citybike" then
				return true
			end
		end
	end
	return false
end

local function roundToCents(value: number): number
	return math.floor(value * 100 + 0.5) / 100
end

local function shallowCopy(input: any): any
	if type(input) ~= "table" then
		return input
	end
	return table.clone(input)
end

function FuelService.new(deps: any?)
	local self: any = setmetatable({}, FuelService)
	deps = deps or {}
	self._pricePerLiter = deps.pricePerLiter
	if type(self._pricePerLiter) ~= "number" or self._pricePerLiter < 0 then
		self._pricePerLiter = 2.0
	end
	self._defaultTankVolume = deps.defaultTankVolume
	if type(self._defaultTankVolume) ~= "number" or self._defaultTankVolume <= 0 then
		self._defaultTankVolume = 3.0
	end
	self._baseConsumptionRate = deps.baseConsumptionRate
	if type(self._baseConsumptionRate) ~= "number" or self._baseConsumptionRate <= 0 then
		self._baseConsumptionRate = 0.005
	end
	self._rescueLiters = deps.rescueLiters
	if type(self._rescueLiters) ~= "number" or self._rescueLiters <= 0 then
		self._rescueLiters = 0.3
	end
	self._rescueCooldownSec = deps.rescueCooldownSec
	if type(self._rescueCooldownSec) ~= "number" or self._rescueCooldownSec < 0 then
		self._rescueCooldownSec = 300
	end
	self._strandedEpsilon = deps.strandedEpsilon
	if type(self._strandedEpsilon) ~= "number" or self._strandedEpsilon < 0 then
		self._strandedEpsilon = 0.05
	end
	self._isOwner = deps.isOwner
	self._isAtGasStation = deps.isAtGasStation
	self._debit = deps.debit
	self._balances = deps.balances
	self._clock = deps.clock
	self._vehicles = {}
	self._atStation = {}
	self._busy = {}
	self._processedTx = {}
	self._lastRescue = {}
	return self
end

function FuelService:RegisterVehicle(vehicleId: string, ownerId: any, opts: any?)
	assert(isNonEmptyString(vehicleId), "RegisterVehicle: vehicleId must be a non-empty string")
	assert(ownerId ~= nil, "RegisterVehicle: ownerId required")
	opts = opts or {}
	local modelId: any = opts.modelId or opts.vehicleModel or opts.id or "puch-maxi-s"
	local bicycle = isBicycleModel(modelId, opts)
	local capacity: number
	if bicycle then
		capacity = 0
	elseif type(opts.tankVolume) == "number" and opts.tankVolume > 0 then
		capacity = opts.tankVolume
	elseif type(opts.capacity) == "number" and opts.capacity > 0 then
		capacity = opts.capacity
	else
		capacity = self._defaultTankVolume
	end
	local rate: number = self._baseConsumptionRate
	if type(opts.consumptionRate) == "number" and opts.consumptionRate > 0 then
		rate = opts.consumptionRate
	end
	local fuel: number = capacity
	if type(opts.fuel) == "number" and opts.fuel == opts.fuel then
		fuel = math.clamp(opts.fuel, 0, capacity)
	end
	if bicycle then
		fuel = 0
	end
	self._vehicles[vehicleId] = {
		ownerId = ownerId,
		modelId = modelId,
		capacity = capacity,
		fuel = fuel,
		consumptionRate = rate,
		isBicycle = bicycle,
	}
end

function FuelService:SetAtGasStation(vehicleId: string, atStation: boolean)
	assert(isNonEmptyString(vehicleId), "SetAtGasStation: vehicleId must be a non-empty string")
	self._atStation[vehicleId] = atStation == true
end

-- Server-only helper for spawn/restore; never exposed to clients directly.
function FuelService:SetFuel(vehicleId: string, amount: number): boolean
	local entry = self._vehicles[vehicleId]
	if entry == nil then
		return false
	end
	if type(amount) ~= "number" or amount ~= amount then
		return false
	end
	entry.fuel = math.clamp(amount, 0, entry.capacity)
	return true
end

function FuelService:GetFuel(vehicleId: string): number?
	local entry = self._vehicles[vehicleId]
	if entry == nil then
		return nil
	end
	return entry.fuel
end

function FuelService:GetCapacity(vehicleId: string): number?
	local entry = self._vehicles[vehicleId]
	if entry == nil then
		return nil
	end
	return entry.capacity
end

function FuelService:GetPricePerLiter(): number
	return self._pricePerLiter
end

function FuelService:IsBicycleVehicle(vehicleId: string): boolean
	local entry = self._vehicles[vehicleId]
	if entry == nil then
		return false
	end
	return entry.isBicycle == true
end

function FuelService:IsEmpty(vehicleId: string): boolean
	local entry = self._vehicles[vehicleId]
	if entry == nil then
		return true
	end
	if entry.isBicycle == true then
		return true
	end
	return entry.fuel <= self._strandedEpsilon
end

function FuelService:_now(): number
	if type(self._clock) == "function" then
		local ok, value = pcall(self._clock)
		if ok and type(value) == "number" then
			return value
		end
	end
	return os.clock()
end

function FuelService:_checkOwner(playerId: any, vehicleId: string): boolean
	if type(self._isOwner) == "function" then
		local ok, result = pcall(self._isOwner, playerId, vehicleId)
		return ok and result == true
	end
	local entry = self._vehicles[vehicleId]
	if entry == nil then
		return false
	end
	return entry.ownerId == playerId
end

function FuelService:_checkStation(playerId: any, vehicleId: string): boolean
	if type(self._isAtGasStation) == "function" then
		local ok, result = pcall(self._isAtGasStation, playerId, vehicleId)
		return ok and result == true
	end
	return self._atStation[vehicleId] == true
end

function FuelService:_applyDebit(playerId: any, amount: number, transactionId: string?): (boolean, string?)
	if type(self._debit) == "function" then
		local ok, success, err = pcall(self._debit, playerId, amount, transactionId)
		if not ok then
			return false, "EconomyFailed"
		end
		if success == true then
			return true, nil
		end
		if type(err) == "string" and err ~= "" then
			return false, err
		end
		return false, "InsufficientFunds"
	end
	if type(self._balances) == "table" then
		local current = self._balances[playerId]
		if type(current) ~= "number" then
			return false, "UnknownPlayer"
		end
		if current < amount then
			return false, "InsufficientFunds"
		end
		self._balances[playerId] = roundToCents(current - amount)
		return true, nil
	end
	return false, "NoEconomy"
end

-- Applies load-dependent consumption. load01: 0 = idle, 1 = full load.
-- Returns consumed liters and remaining fuel. Bicycles always return 0.
function FuelService:Consume(vehicleId: string, dtSeconds: number, load01: number?): (number, number?)
	local entry = self._vehicles[vehicleId]
	if entry == nil then
		return 0, nil
	end
	if entry.isBicycle == true then
		return 0, 0
	end
	if type(dtSeconds) ~= "number" or dtSeconds ~= dtSeconds or dtSeconds <= 0 then
		return 0, entry.fuel
	end
	local load = clamp01(load01, 0.5)
	local rate: number = entry.consumptionRate
	if type(rate) ~= "number" or rate <= 0 then
		rate = self._baseConsumptionRate
	end
	local perSecond = rate * (0.4 + 1.6 * load)
	local wanted = perSecond * dtSeconds
	local consumed = math.min(wanted, entry.fuel)
	entry.fuel = entry.fuel - consumed
	if entry.fuel < 0 then
		entry.fuel = 0
	end
	return consumed, entry.fuel
end

-- Server-side refuel at a gas station. Only the filled amount is charged.
function FuelService:Refuel(playerId: any, vehicleId: string, litersRequested: number, opts: any?): (boolean, any)
	if not isValidPlayerId(playerId) then
		return false, "InvalidPlayer"
	end
	if not isNonEmptyString(vehicleId) then
		return false, "InvalidVehicle"
	end
	local entry = self._vehicles[vehicleId]
	if entry == nil then
		return false, "UnknownVehicle"
	end
	if entry.isBicycle == true then
		return false, "BicycleHasNoFuel"
	end
	if type(litersRequested) ~= "number" or litersRequested ~= litersRequested or litersRequested <= 0 then
		return false, "InvalidAmount"
	end
	if self._busy[vehicleId] == true then
		return false, "Busy"
	end
	if not self:_checkOwner(playerId, vehicleId) then
		return false, "NotOwner"
	end
	if not self:_checkStation(playerId, vehicleId) then
		return false, "NotAtGasStation"
	end
	local freeSpace = entry.capacity - entry.fuel
	if freeSpace <= 1e-9 then
		return false, "TankFull"
	end
	local fill = math.min(litersRequested, freeSpace)
	local cost = roundToCents(fill * self._pricePerLiter)
	local transactionId: string? = nil
	if type(opts) == "table" and isNonEmptyString(opts.transactionId) then
		transactionId = opts.transactionId
		local cached = self._processedTx[transactionId]
		if cached ~= nil then
			return true, shallowCopy(cached)
		end
	end
	self._busy[vehicleId] = true
	local debitOk, debitErr = self:_applyDebit(playerId, cost, transactionId)
	self._busy[vehicleId] = nil
	if not debitOk then
		return false, debitErr or "InsufficientFunds"
	end
	entry.fuel = math.min(entry.capacity, entry.fuel + fill)
	local result = {
		filled = fill,
		cost = cost,
		fuel = entry.fuel,
		capacity = entry.capacity,
	}
	if transactionId ~= nil then
		self._processedTx[transactionId] = shallowCopy(result)
	end
	return true, shallowCopy(result)
end

-- Fair solution against permanent stranding: a small free emergency refill
-- when the tank is (near-)empty. Cooldown prevents abuse; no station needed.
function FuelService:RescueRefill(playerId: any, vehicleId: string): (boolean, any)
	if not isValidPlayerId(playerId) then
		return false, "InvalidPlayer"
	end
	if not isNonEmptyString(vehicleId) then
		return false, "InvalidVehicle"
	end
	local entry = self._vehicles[vehicleId]
	if entry == nil then
		return false, "UnknownVehicle"
	end
	if entry.isBicycle == true then
		return false, "BicycleHasNoFuel"
	end
	if not self:_checkOwner(playerId, vehicleId) then
		return false, "NotOwner"
	end
	if entry.fuel > self._strandedEpsilon then
		return false, "NotStranded"
	end
	local now = self:_now()
	local last = self._lastRescue[vehicleId]
	if type(last) == "number" and now - last < self._rescueCooldownSec then
		return false, "RescueCooldown"
	end
	local fill = math.min(self._rescueLiters, entry.capacity - entry.fuel)
	if fill <= 0 then
		return false, "TankFull"
	end
	entry.fuel = entry.fuel + fill
	self._lastRescue[vehicleId] = now
	return true,
		shallowCopy({
			filled = fill,
			cost = 0,
			fuel = entry.fuel,
			capacity = entry.capacity,
			rescue = true,
		})
end

return FuelService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">GameplayHandlers</string>
            <string name="Source"><![CDATA[--!strict
-- GameplayHandlers: registriert die generischen Remotes am RequestRouter.
-- Alle Preise, Rabatte, Besitzpruefungen, Distanzen und Zustaende stammen aus
-- den Services; Payloads liefern nur IDs und optional harmlose Quellen.
-- Keine Roblox-Laufzeit, damit die Handler mit `lune run` testbar bleiben.
-- Keine globalen Variablen.

local PartsCatalog = require("../../shared/data/PartsCatalog")

local GameplayHandlers = {}

-- Modul-lokaler Fallback, falls der Bootstrap keinen Transaktionszaehler
-- injiziert. Keine globalen Variablen.
local fallbackTransactionCounter = 0

export type Deps = {
	playerStore: any,
	vehicleService: any,
	shopService: any,
	workshopService: any,
	garageService: any,
	dynoService: any,
	fuelService: any,
	missionService: any,
	economy: any,
	onVehicleOwned: ((userId: number, vehicleId: string) -> ())?,
	nextTransactionId: ((userId: number, kind: string) -> string)?,
}

local function reply(payload: any?): any
	local result: any = { ok = true }
	if payload ~= nil then
		for key, value in pairs(payload) do
			result[key] = value
		end
	end
	return result
end

local function reject(code: any?): any
	if type(code) == "string" and code ~= "" then
		return { ok = false, code = code }
	end
	return { ok = false, code = "failed" }
end

local function catalogList(shopService: any): { any }
	local list: { any } = {}
	for _, entry in ipairs(shopService:getCatalog()) do
		local part = PartsCatalog.getPartById(entry.id)
		table.insert(list, {
			id = entry.id,
			name = if part ~= nil then part.name else entry.id,
			category = if part ~= nil then part.slot elseif entry.slot ~= nil then entry.slot else "misc",
			price = entry.price,
			compatibleModels = if part ~= nil then part.compatibleModels else {},
			mountPoint = if part ~= nil then part.mountPoint else nil,
		})
	end
	return list
end

function GameplayHandlers.register(router: any, deps: Deps): ()
	local playerStore = deps.playerStore
	local economy = deps.economy

	local function transactionId(userId: number, kind: string): string
		if deps.nextTransactionId ~= nil then
			return deps.nextTransactionId(userId, kind)
		end
		fallbackTransactionCounter += 1
		return string.format("%s:%s:%d", kind, tostring(userId), fallbackTransactionCounter)
	end

	local function prepare(userId: number): any
		local view = playerStore:ensure(userId)
		playerStore:refreshMoney(userId)
		return view
	end

	local function persist(userId: number): ()
		playerStore:sync(userId)
		playerStore:save(userId)
	end

	local function vehicleSelect(_player: any, _payload: any): any
		local userId = _player.UserId
		prepare(userId)
		local view = playerStore:view(userId)
		return reply({
			selected = view.selectedVehicle,
			owned = playerStore:owned(userId),
			cash = view.money,
		})
	end

	local function economyGet(player: any, _payload: any): any
		prepare(player.UserId)
		return reply({ cash = economy:getBalance(player.UserId) })
	end

	local function vehicleBuy(player: any, payload: any): any
		local userId = player.UserId
		prepare(userId)
		local view = playerStore:view(userId)
		local purchased, outcome = deps.vehicleService:purchase(view, payload.vehicleId, userId)
		if not purchased then
			return reject(outcome)
		end
		playerStore:commitMoney(userId)
		playerStore:sync(userId)
		if deps.onVehicleOwned ~= nil then
			deps.onVehicleOwned(userId, payload.vehicleId)
		end
		persist(userId)
		return reply({
			receipt = outcome,
			selected = view.selectedVehicle,
			owned = playerStore:owned(userId),
			cash = view.money,
		})
	end

	local function missionProgress(player: any, payload: any): any
		local userId = player.UserId
		prepare(userId)
		local claimInfo: any = nil
		if payload.claim == true then
			if type(payload.missionKey) ~= "string" or payload.missionKey == "" then
				return reject("invalid_mission")
			end
			local missionKey = payload.missionKey :: string
			local claimed, info = deps.missionService:claimReward(userId, missionKey, function(reward: number)
				local creditOk, creditErr = economy:credit(
					userId,
					reward,
					string.format("mission:%s:%s", tostring(userId), missionKey)
				)
				if not creditOk then
					error(creditErr or "credit_failed")
				end
			end)
			if not claimed then
				local reason: any = info
				if type(reason) == "table" then
					return reject(reason.reason)
				end
				return reject("claim_failed")
			end
			claimInfo = info
			playerStore:refreshMoney(userId)
			persist(userId)
		end
		return reply({
			missions = deps.missionService.getMissions(),
			state = deps.missionService:getState(userId),
			claim = claimInfo,
			cash = playerStore:cash(userId),
		})
	end

	local function garageEnter(player: any, _payload: any): any
		local userId = player.UserId
		prepare(userId)
		local garageId = deps.garageService.getGarage(userId)
		if garageId == nil then
			return reject("no_garage")
		end
		return reply({
			garage = garageId,
			cash = playerStore:cash(userId),
		})
	end

	local function workshopInstall(player: any, payload: any): any
		local userId = player.UserId
		prepare(userId)
		local installed, code = deps.workshopService:installPart(
			tostring(userId),
			payload.vehicleId,
			payload.partId,
			{ source = "workshop" }
		)
		if not installed then
			return reject(code)
		end
		local record = playerStore:workshopVehicle(userId, payload.vehicleId)
		persist(userId)
		return reply({
			vehicleId = payload.vehicleId,
			parts = if record ~= nil then record.parts else {},
			inventory = playerStore:view(userId).inventory,
		})
	end

	local function workshopPaint(player: any, payload: any): any
		local userId = player.UserId
		prepare(userId)
		local painted, code = deps.workshopService:paint(
			tostring(userId),
			payload.vehicleId,
			{ surface = payload.surface, color = payload.color },
			{ source = "workshop" }
		)
		if not painted then
			return reject(code)
		end
		local record = playerStore:workshopVehicle(userId, payload.vehicleId)
		persist(userId)
		return reply({
			vehicleId = payload.vehicleId,
			colors = if record ~= nil then record.colors else {},
		})
	end

	local function shopCatalog(player: any, _payload: any): any
		prepare(player.UserId)
		return reply({ parts = catalogList(deps.shopService) })
	end

	local function shopBuy(player: any, payload: any): any
		local userId = player.UserId
		prepare(userId)
		local key = tostring(userId)
		local tx = transactionId(userId, "shop")
		local bought: boolean
		local code: string
		if payload.source == "store" then
			bought, code = deps.shopService:buyFromStore(key, payload.partId, tx)
		else
			bought, code = deps.shopService:orderPart(key, payload.partId, tx)
		end
		if not bought then
			return reject(code)
		end
		playerStore:commitMoney(userId)
		persist(userId)
		return reply({
			partId = payload.partId,
			inventory = deps.shopService:getInventory(key),
			cash = playerStore:cash(userId),
		})
	end

	local function dynoRun(player: any, payload: any): any
		local userId = player.UserId
		prepare(userId)
		local vehicleKey = playerStore:vehicleKey(userId, payload.vehicleId)
		local started, result = deps.dynoService:StartRun(userId, vehicleKey)
		if not started then
			return reject(result)
		end
		return reply({ result = result, cash = playerStore:cash(userId) })
	end

	local function fuelRefill(player: any, payload: any): any
		local userId = player.UserId
		prepare(userId)
		if payload.action == "requestRescue" then
			local vehicleId: any = payload.vehicleId
			if type(vehicleId) ~= "string" or vehicleId == "" then
				vehicleId = playerStore:selected(userId)
			end
			if type(vehicleId) ~= "string" or vehicleId == "" then
				return reject("no_vehicle")
			end
			local vehicleKey = playerStore:vehicleKey(userId, vehicleId)
			local refilled, result = deps.fuelService:RescueRefill(userId, vehicleKey)
			if not refilled then
				return reject(result)
			end
			playerStore:refreshMoney(userId)
			persist(userId)
			return reply({ refuel = result, cash = playerStore:cash(userId) })
		end
		local vehicleId: any = payload.vehicleId
		if type(vehicleId) ~= "string" or vehicleId == "" then
			return reject("invalid_vehicle")
		end
		if type(payload.liters) ~= "number" then
			return reject("invalid_amount")
		end
		local vehicleKey = playerStore:vehicleKey(userId, vehicleId)
		local refilled, result = deps.fuelService:Refuel(userId, vehicleKey, payload.liters, {
			transactionId = transactionId(userId, "fuel"),
		})
		if not refilled then
			return reject(result)
		end
		playerStore:refreshMoney(userId)
		persist(userId)
		return reply({ refuel = result, cash = playerStore:cash(userId) })
	end

	local function economyTransfer(player: any, payload: any): any
		local userId = player.UserId
		prepare(userId)
		if payload.targetUserId ~= nil and tostring(payload.targetUserId) ~= tostring(userId) then
			return reject("access_denied")
		end
		return reply({ cash = economy:getBalance(userId) })
	end

	local handlers: { [string]: any } = {
		VehicleSelect = vehicleSelect,
		EconomyGet = economyGet,
		VehicleBuy = vehicleBuy,
		MissionProgress = missionProgress,
		GarageEnter = garageEnter,
		WorkshopInstall = workshopInstall,
		WorkshopPaint = workshopPaint,
		ShopCatalog = shopCatalog,
		ShopBuy = shopBuy,
		DynoRun = dynoRun,
		FuelRefill = fuelRefill,
		EconomyTransfer = economyTransfer,
	}
	local limits: { [string]: { number } } = {
		VehicleBuy = { 5, 1 },
		ShopBuy = { 10, 1 },
		WorkshopInstall = { 10, 1 },
		WorkshopPaint = { 10, 1 },
		DynoRun = { 5, 1 },
		FuelRefill = { 10, 1 },
		MissionProgress = { 20, 1 },
		EconomyTransfer = { 10, 1 },
	}
	for action, handler in pairs(handlers) do
		router:register(action, handler)
		local limit = limits[action]
		if limit ~= nil then
			pcall(function()
				router:setRateLimit(action, limit[1], limit[2])
			end)
		end
	end
end

return GameplayHandlers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">GarageService</string>
            <string name="Source"><![CDATA[--!strict
-- GarageService: private Garagen innerhalb desselben Servers plus
-- Hebebuehnen-Pruefung fuer den Werkstattzustand.
-- Keine Reserved Servers: Jeder Spieler erhaelt eine eigene Garage-Instanz
-- (Anker-ID). Der Werkstattzustand ist nur aktiv, wenn das eigene Mofa
-- stillsteht, der Motor aus ist, niemand faehrt und das Fahrzeug auf der
-- Hebebuehne oder dem markierten Werkstattplatz steht.
--
-- Task 27: Der Bootstrap initialisiert genau eine Serverinstanz mit den 15
-- Weltankern aus WorldLayout.GARAGES. Oeffentliche Funktionen akzeptieren
-- sowohl Player-Objekte (UserId) als auch reine UserIds, damit Servercode
-- ohne clientseitige Berechtigungspruefung arbeitet. Jede Zuweisung ist
-- eindeutig; beim Verlassen wird der Anker wieder freigegeben.

export type GarageOptions = {
	anchors: { any }?,
	prefix: string?,
	capacity: number?,
	profiles: any?,
	world: any?,
}

export type WorkshopState = {
	userId: any,
	vehicleOwnerId: any?,
	vehicleId: string?,
	vehicleKind: string?,
	speed: number?,
	engineOn: boolean?,
	riderUserId: any?,
	occupantCount: number?,
	onLift: boolean?,
	onWorkshopPad: boolean?,
	garageId: string?,
}

export type GarageService = {
	_byPlayer: { [string]: string },
	_byGarage: { [string]: string },
	_anchors: { string },
}

local GarageService = {}
GarageService.__index = GarageService

GarageService.MAX_WORKSHOP_SPEED = 0.5
GarageService.DEFAULT_CAPACITY = 15
GarageService.BICYCLE_IDS = {
	bicycle = true,
	bike = true,
	fahrrad = true,
	startfahrrad = true,
}

local defaultInstance: GarageService? = nil

-- Liefert die UserId eines Player-Objekts oder die unveraenderte UserId.
local function extractUserId(value: any): any
	if type(value) == "table" then
		local userId = (value :: any).UserId
		if type(userId) == "number" then
			return userId
		end
	elseif type(value) == "userdata" then
		local ok, userId = pcall(function()
			return (value :: any).UserId
		end)
		if ok and type(userId) == "number" then
			return userId
		end
	end
	return value
end

local function keyOf(value: any): string?
	local userId = extractUserId(value)
	if type(userId) == "number" then
		return tostring(userId)
	elseif type(userId) == "string" and (userId :: string) ~= "" then
		return userId :: string
	end
	return nil
end

local function isBicycle(vehicleId: any, vehicleKind: any): boolean
	if type(vehicleKind) == "string" and string.lower(vehicleKind :: string) == "bicycle" then
		return true
	end
	if type(vehicleId) == "string" then
		return GarageService.BICYCLE_IDS[string.lower(vehicleId :: string)] == true
	end
	return false
end

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Akzeptiert sowohl Anker-IDs als auch Anker-Records aus WorldLayout.
local function resolveAnchorList(source: any): { string }?
	if type(source) ~= "table" then
		return nil
	end
	local anchors: { string } = {}
	for _, entry in ipairs(source) do
		if type(entry) == "string" and entry ~= "" then
			table.insert(anchors, entry)
		elseif type(entry) == "table" then
			local id = (entry :: any).id
			if type(id) == "string" and id ~= "" then
				table.insert(anchors, id)
			end
		end
	end
	if #anchors == 0 then
		return nil
	end
	return anchors
end

local function defaultAnchors(prefix: string, capacity: number): { string }
	local anchors: { string } = {}
	for index = 1, capacity do
		table.insert(anchors, string.format("%s_%02d", prefix, index))
	end
	return anchors
end

local function copyAnchors(source: { string }): { string }
	local out: { string } = {}
	for _, anchor in ipairs(source) do
		table.insert(out, anchor)
	end
	return out
end

-- Weltanker kommen aus einem Modul mit getGarageAnchors (z. B. WorldLayout
-- oder ValleyWorld), ohne dass der Service selbst Weltcode laden muss.
local function anchorsFromWorld(world: any): { string }?
	if type(world) ~= "table" then
		return nil
	end
	local getter = (world :: any).getGarageAnchors
	if type(getter) ~= "function" then
		return nil
	end
	local ok, result = pcall(getter, world)
	if not ok or type(result) ~= "table" then
		local okDirect, direct = pcall(getter)
		if not okDirect then
			return nil
		end
		result = direct
	end
	return resolveAnchorList(result)
end

local function isInstance(value: any): boolean
	if type(value) ~= "table" or getmetatable(value) ~= GarageService then
		return false
	end
	return rawget(value, "_byPlayer") ~= nil
		and rawget(value, "_byGarage") ~= nil
		and rawget(value, "_anchors") ~= nil
end

-- Loest Methodenaufrufe auf Instanz, Modul (Singleton) oder statische Aufrufe
-- auf. callOptional(module, name, ...) ruft fn(module, ...) auf, daher wird
-- das Modul als erster Parameter erkannt.
local function resolveCall(a: any, b: any, c: any): (GarageService?, any, any, any)
	if a == GarageService then
		return defaultInstance, b, c, nil
	elseif isInstance(a) then
		return a :: GarageService, b, c, nil
	end
	return defaultInstance, a, b, c
end

local function ensureDefault(): GarageService
	if defaultInstance == nil then
		defaultInstance = GarageService.new()
	end
	return defaultInstance :: GarageService
end

local function instanceOr(instance: GarageService?): GarageService
	if instance ~= nil then
		return instance
	end
	return ensureDefault()
end

function GarageService.new(options: GarageOptions?): GarageService
	local opts: GarageOptions = options or {}
	local capacity = opts.capacity or GarageService.DEFAULT_CAPACITY
	if type(capacity) ~= "number" or capacity < 1 then
		capacity = GarageService.DEFAULT_CAPACITY
	end
	capacity = math.floor(capacity)
	local prefix = opts.prefix or "Garage"
	if type(prefix) ~= "string" or prefix == "" then
		prefix = "Garage"
	end
	local anchors = resolveAnchorList(opts.anchors)
	if anchors == nil then
		anchors = defaultAnchors(prefix, capacity)
	end
	local self: GarageService = setmetatable({}, GarageService) :: any
	self._byPlayer = {}
	self._byGarage = {}
	self._anchors = anchors
	return self
end

-- Erzeugt die serverseitige Singleton-Instanz aus den 15 Weltankern.
-- Signatur unterstuetzt init(options) und callOptional(module, "init", options).
function GarageService.init(a: any, b: any?): GarageService
	local options: any = a
	if a == GarageService then
		options = b
	end
	if type(options) ~= "table" then
		options = {}
	end
	local anchors = resolveAnchorList((options :: any).anchors)
	if anchors == nil then
		anchors = anchorsFromWorld((options :: any).world)
	end
	defaultInstance = GarageService.new({
		anchors = anchors,
		prefix = (options :: any).prefix,
		capacity = (options :: any).capacity,
	})
	return defaultInstance
end

local function anchorsOn(instance: GarageService): { string }
	return copyAnchors(instance._anchors)
end

local function getGarageOn(instance: GarageService, playerUserId: any): string?
	local key = keyOf(playerUserId)
	if key == nil then
		return nil
	end
	return instance._byPlayer[key]
end

local function getOwnerOn(instance: GarageService, garageId: any): string?
	if type(garageId) ~= "string" then
		return nil
	end
	return instance._byGarage[garageId]
end

local function hasAccessOn(instance: GarageService, playerUserId: any, garageId: any): boolean
	if type(garageId) ~= "string" or garageId == "" then
		return false
	end
	local key = keyOf(playerUserId)
	if key == nil then
		return false
	end
	return instance._byPlayer[key] == garageId and instance._byGarage[garageId] == key
end

local function assignOn(instance: GarageService, playerUserId: any): (string?, string?)
	local key = keyOf(playerUserId)
	if key == nil then
		return nil, "invalid_player"
	end
	local existing = instance._byPlayer[key]
	if existing ~= nil then
		return existing, nil
	end
	for _, anchor in ipairs(instance._anchors) do
		if instance._byGarage[anchor] == nil then
			instance._byPlayer[key] = anchor
			instance._byGarage[anchor] = key
			return anchor, nil
		end
	end
	return nil, "no_free_garage"
end

local function releaseOn(instance: GarageService, playerUserId: any): boolean
	local key = keyOf(playerUserId)
	if key == nil then
		return false
	end
	local garageId = instance._byPlayer[key]
	if garageId == nil then
		return false
	end
	instance._byPlayer[key] = nil
	if instance._byGarage[garageId] == key then
		instance._byGarage[garageId] = nil
	end
	return true
end

local function countOn(instance: GarageService): number
	local count = 0
	for _ in pairs(instance._byPlayer) do
		count += 1
	end
	return count
end

-- Prueft den Werkstattzustand. Gibt (true, nil) nur zurueck, wenn alle
-- Bedingungen gleichzeitig gelten: eigenes Mofa (kein Fahrrad), Stillstand,
-- Motor aus, niemand faehrt, auf Hebebuehne oder Werkstattplatz.
-- Bei gesetzter garageId muss der Spieler Zugriff auf diese Garage haben.
local function validateOn(instance: GarageService, state: any): (boolean, string?)
	if type(state) ~= "table" then
		return false, "invalid_state"
	end
	local current = state :: WorkshopState
	local userKey = keyOf(current.userId)
	if userKey == nil then
		return false, "invalid_player"
	end
	if current.garageId ~= nil then
		if type(current.garageId) ~= "string" or not hasAccessOn(instance, current.userId, current.garageId) then
			return false, "no_garage_access"
		end
	end
	if type(current.vehicleId) ~= "string" or (current.vehicleId :: string) == "" then
		return false, "no_vehicle"
	end
	if isBicycle(current.vehicleId, current.vehicleKind) then
		return false, "bicycle_no_workshop"
	end
	local ownerKey = keyOf(current.vehicleOwnerId)
	if ownerKey == nil or ownerKey ~= userKey then
		return false, "not_owner"
	end
	if current.engineOn == true then
		return false, "engine_on"
	end
	if not isFiniteNumber(current.speed) then
		return false, "invalid_speed"
	end
	if math.abs(current.speed :: number) > GarageService.MAX_WORKSHOP_SPEED then
		return false, "vehicle_moving"
	end
	if current.riderUserId ~= nil then
		return false, "occupied"
	end
	if current.occupantCount ~= nil then
		if not isFiniteNumber(current.occupantCount) then
			return false, "invalid_occupants"
		end
		if (current.occupantCount :: number) > 0 then
			return false, "occupied"
		end
	end
	if current.onLift ~= true and current.onWorkshopPad ~= true then
		return false, "not_on_lift_or_pad"
	end
	return true, nil
end

function GarageService.getAnchors(a: any, b: any?): { string }
	local instance = resolveCall(a, b, nil)
	return anchorsOn(instanceOr(instance))
end

function GarageService.getGarage(a: any, b: any?): string?
	local instance, player = resolveCall(a, b, nil)
	return getGarageOn(instanceOr(instance), player)
end

function GarageService.getOwner(a: any, b: any?): string?
	local instance, garageId = resolveCall(a, b, nil)
	return getOwnerOn(instanceOr(instance), garageId)
end

function GarageService.hasAccess(a: any, b: any, c: any?): boolean
	local instance, player, garageId = resolveCall(a, b, c)
	return hasAccessOn(instanceOr(instance), player, garageId)
end

function GarageService.assignGarage(a: any, b: any?): (string?, string?)
	local instance, player = resolveCall(a, b, nil)
	return assignOn(instanceOr(instance), player)
end

function GarageService.releaseGarage(a: any, b: any?): boolean
	local instance, player = resolveCall(a, b, nil)
	return releaseOn(instanceOr(instance), player)
end

function GarageService.getAssignmentCount(a: any): number
	local instance = resolveCall(a, nil, nil)
	return countOn(instanceOr(instance))
end

function GarageService.validateWorkshopState(a: any, b: any?): (boolean, string?)
	local instance, state = resolveCall(a, b, nil)
	return validateOn(instanceOr(instance), state)
end

function GarageService.isWorkshopActive(a: any, b: any?): boolean
	local instance, state = resolveCall(a, b, nil)
	local ok, _ = validateOn(instanceOr(instance), state)
	return ok
end

return GarageService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">MissionService</string>
            <string name="Source"><![CDATA[--!strict
-- MissionService: Start- und Distanzmissionen mit fairer Fortschrittszählung.
-- Zählt Strecke nur bei plausibler Fahrt im eigenen Fahrzeug, lehnt
-- Teleport-Sprünge ab und zahlt jede Mission pro Spieler nur einmal aus.

local MissionService = {}
MissionService.__index = MissionService

export type MissionDefinition = {
	key: string,
	label: string,
	requiredDistance: number,
	reward: number,
	vehicleScope: string,
}

export type ProgressContext = {
	vehicleId: string?,
	isOwnVehicle: boolean?,
	speedKmh: number?,
	teleported: boolean?,
}

export type PlayerMissionState = {
	totalDistance: number,
	progress: { [string]: number },
	completed: { [string]: boolean },
	claimed: { [string]: boolean },
}

export type MissionServiceInstance = typeof(setmetatable(
	{} :: {
		_states: { [string]: PlayerMissionState },
	},
	MissionService
))

local MAX_SINGLE_DELTA = 250
local MAX_PLAUSIBLE_SPEED_KMH = 70
local MIN_PLAUSIBLE_SPEED_KMH = 0.5

local MISSIONS: { MissionDefinition } = {
	{
		key = "bike_starter_500m",
		label = "Erste Runde mit dem Fahrrad",
		requiredDistance = 500,
		reward = 50,
		vehicleScope = "bicycle",
	},
	{
		key = "moped_starter_2km",
		label = "Erste Runde mit dem Mofa",
		requiredDistance = 2000,
		reward = 150,
		vehicleScope = "moped",
	},
	{
		key = "distance_10km",
		label = "10 km auf eigenen Rädern",
		requiredDistance = 10000,
		reward = 300,
		vehicleScope = "any",
	},
	{
		key = "distance_50km",
		label = "50 km Töffli-Legende",
		requiredDistance = 50000,
		reward = 1200,
		vehicleScope = "any",
	},
}

local function toKey(userId: string | number): string
	return tostring(userId)
end

local function findDefinition(missionKey: string): MissionDefinition?
	for _, def in ipairs(MISSIONS) do
		if def.key == missionKey then
			return def
		end
	end
	return nil
end

local function matchesScope(def: MissionDefinition, vehicleId: string?): boolean
	if def.vehicleScope == "any" then
		return true
	end
	if vehicleId == nil then
		return false
	end
	if def.vehicleScope == "bicycle" then
		return vehicleId == "bicycle"
	end
	if def.vehicleScope == "moped" then
		return vehicleId == "moped" or vehicleId == "puch_maxi_s" or vehicleId == "piaggio_ciao"
	end
	return false
end

function MissionService.new(): MissionServiceInstance
	local self = {
		_states = {},
	}
	return setmetatable(self, MissionService)
end

function MissionService.getMissions(): { MissionDefinition }
	local copy: { MissionDefinition } = {}
	for i, def in ipairs(MISSIONS) do
		copy[i] = {
			key = def.key,
			label = def.label,
			requiredDistance = def.requiredDistance,
			reward = def.reward,
			vehicleScope = def.vehicleScope,
		}
	end
	return copy
end

function MissionService.getDefinition(missionKey: string): MissionDefinition?
	return findDefinition(missionKey)
end

function MissionService._getState(self: MissionServiceInstance, userId: string | number): PlayerMissionState
	local key = toKey(userId)
	local state = self._states[key]
	if state == nil then
		state = {
			totalDistance = 0,
			progress = {},
			completed = {},
			claimed = {},
		}
		for _, def in ipairs(MISSIONS) do
			state.progress[def.key] = 0
		end
		self._states[key] = state
	end
	return state
end

function MissionService.getState(self: MissionServiceInstance, userId: string | number): PlayerMissionState
	local state = self:_getState(userId)
	local snapshot: PlayerMissionState = {
		totalDistance = state.totalDistance,
		progress = {},
		completed = {},
		claimed = {},
	}
	for k, v in pairs(state.progress) do
		snapshot.progress[k] = v
	end
	for k, v in pairs(state.completed) do
		snapshot.completed[k] = v
	end
	for k, v in pairs(state.claimed) do
		snapshot.claimed[k] = v
	end
	return snapshot
end

-- Zählt eine gefahrene Teilstrecke. Gibt (accepted, reason) zurück.
function MissionService.addDistance(
	self: MissionServiceInstance,
	userId: string | number,
	deltaMeters: number,
	context: ProgressContext?
): (boolean, string)
	if type(deltaMeters) ~= "number" then
		return false, "invalid_delta"
	end
	if deltaMeters ~= deltaMeters or deltaMeters == math.huge or deltaMeters == -math.huge then
		return false, "invalid_delta"
	end
	if deltaMeters <= 0 then
		return false, "invalid_delta"
	end
	if deltaMeters > MAX_SINGLE_DELTA then
		return false, "teleport_rejected"
	end

	local ctx: ProgressContext = context or {}
	if ctx.teleported == true then
		return false, "teleport_rejected"
	end
	if ctx.isOwnVehicle ~= true then
		return false, "foreign_vehicle"
	end

	local vehicleId: string? = ctx.vehicleId
	if vehicleId == nil or vehicleId == "" then
		return false, "missing_vehicle"
	end

	local speed = ctx.speedKmh
	if speed ~= nil then
		if type(speed) ~= "number" then
			return false, "implausible_speed"
		end
		if speed ~= speed or speed == math.huge or speed == -math.huge then
			return false, "implausible_speed"
		end
		if speed < MIN_PLAUSIBLE_SPEED_KMH or speed > MAX_PLAUSIBLE_SPEED_KMH then
			return false, "implausible_speed"
		end
	end

	local state = self:_getState(userId)
	state.totalDistance += deltaMeters

	for _, def in ipairs(MISSIONS) do
		if matchesScope(def, vehicleId) then
			local current = state.progress[def.key] or 0
			local nextValue = current + deltaMeters
			if nextValue > def.requiredDistance then
				nextValue = def.requiredDistance
			end
			state.progress[def.key] = nextValue
			if nextValue >= def.requiredDistance then
				state.completed[def.key] = true
			end
		end
	end

	return true, "accepted"
end

function MissionService.isCompleted(self: MissionServiceInstance, userId: string | number, missionKey: string): boolean
	local state = self:_getState(userId)
	return state.completed[missionKey] == true
end

function MissionService.isClaimed(self: MissionServiceInstance, userId: string | number, missionKey: string): boolean
	local state = self:_getState(userId)
	return state.claimed[missionKey] == true
end

-- Zahlt eine abgeschlossene Mission genau einmal aus.
-- addFunds(reward) ist ein optionaler Auszahlungshook (z.B. EconomyService).
-- Gibt (ok, info) zurück; info enthält reward oder reason.
function MissionService.claimReward(
	self: MissionServiceInstance,
	userId: string | number,
	missionKey: string,
	addFunds: ((amount: number) -> ())?
): (boolean, { reward: number } | { reason: string })
	local def = findDefinition(missionKey)
	if def == nil then
		return false, { reason = "unknown_mission" }
	end

	local state = self:_getState(userId)
	if state.claimed[missionKey] == true then
		return false, { reason = "already_claimed" }
	end
	if state.completed[missionKey] ~= true then
		return false, { reason = "not_completed" }
	end

	if addFunds ~= nil then
		local ok, err = pcall(addFunds, def.reward)
		if not ok then
			return false, { reason = "payout_failed" }
		end
		_ = err
	end

	state.claimed[missionKey] = true
	return true, { reward = def.reward }
end

return MissionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">PlayerStore</string>
            <string name="Source"><![CDATA[--!strict
-- PlayerStore: Bruecke zwischen dem persistierten PlayerDataSchema und den
-- Service-Sichten. `PlayerDataSchema` bleibt das Speicherformat (`cash`,
-- `vehicles.owned`, `vehicles.selected`); VehicleService und ShopService
-- erhalten eine Sicht mit `money`, `inventory`, `vehicles` und
-- `selectedVehicle`, WorkshopService eine Sicht mit Fahrzeug-Records.
-- `EconomyService` bleibt waehrend einer Session die Geldquelle; beim Laden
-- wird `cash` uebernommen, beim Speichern zurueckgeschrieben.
-- Keine Roblox-Laufzeit, keine globalen Variablen.

local PlayerDataSchema = require("../../shared/data/PlayerDataSchema")

local PlayerStore = {}
PlayerStore.__index = PlayerStore

export type Options = {
	profiles: any,
	economy: any,
	schema: any?,
}

local function toKey(userId: any): string
	return tostring(userId)
end

local function copyMap(source: { [string]: any }?): { [string]: any }
	local copy: { [string]: any } = {}
	if source ~= nil then
		for key, value in pairs(source) do
			copy[key] = value
		end
	end
	return copy
end

local function copyList(source: { string }?): { string }
	local copy: { string } = {}
	if source ~= nil then
		for _, value in ipairs(source) do
			table.insert(copy, value)
		end
	end
	return copy
end

local function defaultView(profile: any): any
	return {
		money = profile.cash,
		inventory = profile.inventory,
		vehicles = copyList(profile.vehicles.owned),
		selectedVehicle = profile.vehicles.selected,
		starterDiscountUsed = profile.starterDiscountUsed == true,
	}
end

function PlayerStore.new(options: Options)
	assert(type(options) == "table", "PlayerStore.new needs options")
	assert(type(options.profiles) == "table", "PlayerStore needs a ProfileService instance")
	assert(type(options.economy) == "table", "PlayerStore needs an EconomyService instance")
	local self = setmetatable({}, PlayerStore)
	self._profiles = options.profiles
	self._economy = options.economy
	self._schema = options.schema or PlayerDataSchema
	self._views = {}
	self._workshopProfiles = {}
	self._workshopVehicles = {}
	return self
end

function PlayerStore:getVehicleProfiles(): { [string]: any }
	return self._views
end

function PlayerStore:getWorkshopProfiles(): { [string]: any }
	return self._workshopProfiles
end

local function buildWorkshopProfile(profile: any, view: any, records: { [string]: any }): any
	local vehicles: { [string]: any } = {}
	local stored = profile.parts.byVehicle
	for _, vehicleId in ipairs(view.vehicles) do
		local data: any = nil
		if type(stored) == "table" then
			data = (stored :: any)[vehicleId]
		end
		local fallbackInstalled = vehicleId == profile.vehicles.selected and type(profile.parts.installed) == "table"
		local fallbackPaints = vehicleId == profile.vehicles.selected and type(profile.paints) == "table"
		local record = {
			modelId = vehicleId,
			parts = if type(data) == "table" and type(data.parts) == "table"
				then copyMap(data.parts)
				elseif fallbackInstalled then copyMap(profile.parts.installed)
				else {},
			colors = if type(data) == "table" and type(data.colors) == "table"
				then copyMap(data.colors)
				elseif fallbackPaints then copyMap(profile.paints)
				else {},
		}
		vehicles[vehicleId] = record
		records[vehicleId] = record
	end
	return {
		inventory = view.inventory,
		vehicles = vehicles,
	}
end

-- Laedt das Schema-Profil und baut beide Service-Sichten. Ist der Spieler
-- bereits geladen, wird die vorhandene Sicht zurueckgegeben.
function PlayerStore:load(userId: any): any
	local key = toKey(userId)
	local existing = self._views[key]
	if existing ~= nil then
		return existing
	end
	local profile = self._profiles:load(userId)
	self._schema.migrate(profile)
	if type(profile.cash) ~= "number" then
		profile.cash = 0
	end
	local view = defaultView(profile)
	view.schema = profile
	self._views[key] = view
	local records: { [string]: any } = {}
	self._workshopProfiles[key] = buildWorkshopProfile(profile, view, records)
	self._workshopVehicles[key] = records
	self._economy:setBalance(userId, view.money)
	return view
end

function PlayerStore:ensure(userId: any): any
	return self:load(userId)
end

function PlayerStore:get(userId: any): any?
	return self._views[toKey(userId)]
end

function PlayerStore:view(userId: any): any?
	return self._views[toKey(userId)]
end

function PlayerStore:workshopVehicle(userId: any, vehicleId: string): any?
	local records = self._workshopVehicles[toKey(userId)]
	if records == nil then
		return nil
	end
	return records[vehicleId]
end

function PlayerStore:owns(userId: any, vehicleId: string): boolean
	local view = self._views[toKey(userId)]
	if view == nil then
		return false
	end
	for _, ownedId in ipairs(view.vehicles) do
		if ownedId == vehicleId then
			return true
		end
	end
	return false
end

function PlayerStore:owned(userId: any): { string }
	local view = self._views[toKey(userId)]
	if view == nil then
		return {}
	end
	local owned: { string } = {}
	for _, vehicleId in ipairs(view.vehicles) do
		table.insert(owned, vehicleId)
	end
	table.sort(owned)
	return owned
end

function PlayerStore:selected(userId: any): string?
	local view = self._views[toKey(userId)]
	if view == nil then
		return nil
	end
	return view.selectedVehicle
end

function PlayerStore:cash(userId: any): number
	local view = self._views[toKey(userId)]
	if view == nil then
		return 0
	end
	return view.money
end

-- Eindeutiger Schluessel pro Spieler und Fahrzeug, weil mehrere Spieler
-- dasselbe Modell besitzen koennen (FuelService/DynoService keyen nur nach ID).
function PlayerStore:vehicleKey(userId: any, vehicleId: string): string
	return string.format("%s:%s", toKey(userId), vehicleId)
end

function PlayerStore:refreshMoney(userId: any): number
	local view = self._views[toKey(userId)]
	if view == nil then
		return 0
	end
	view.money = self._economy:getBalance(userId)
	return view.money
end

function PlayerStore:commitMoney(userId: any): number
	local view = self._views[toKey(userId)]
	if view == nil then
		return 0
	end
	view.money = math.max(0, math.floor(view.money))
	view.schema.cash = view.money
	self._economy:setBalance(userId, view.money)
	return view.money
end

-- Schreibt beide Service-Sichten ins Schema zurueck.
function PlayerStore:sync(userId: any): any?
	local key = toKey(userId)
	local view = self._views[key]
	if view == nil then
		return nil
	end
	local profile = view.schema
	profile.cash = math.max(0, math.floor(view.money))
	profile.inventory = view.inventory
	profile.vehicles.owned = view.vehicles
	profile.starterDiscountUsed = view.starterDiscountUsed == true
	if type(view.selectedVehicle) == "string" and view.selectedVehicle ~= "" then
		profile.vehicles.selected = view.selectedVehicle
	elseif profile.vehicles.selected == nil or profile.vehicles.selected == "" then
		profile.vehicles.selected = view.vehicles[1] or "bicycle"
	end
	local records = self._workshopVehicles[key]
	if records == nil then
		records = {}
		self._workshopVehicles[key] = records
	end
	local workshop = self._workshopProfiles[key]
	if workshop == nil then
		workshop = { inventory = view.inventory, vehicles = {} }
		self._workshopProfiles[key] = workshop
	end
	-- Neukaeufe erhalten einen Werkstatt-Record, damit Einbau/Lackierung
	-- sofort moeglich sind.
	for _, vehicleId in ipairs(view.vehicles) do
		if records[vehicleId] == nil then
			local record = { modelId = vehicleId, parts = {}, colors = {} }
			records[vehicleId] = record
			workshop.vehicles[vehicleId] = record
		end
	end
	local byVehicle: { [string]: any } = {}
	for vehicleId, record in pairs(records) do
		byVehicle[vehicleId] = {
			parts = copyMap(record.parts),
			colors = copyMap(record.colors),
		}
	end
	profile.parts.byVehicle = byVehicle
	local selectedRecord = records[profile.vehicles.selected]
	if selectedRecord ~= nil then
		profile.parts.installed = selectedRecord.parts
		profile.paints = selectedRecord.colors
	end
	self._economy:setBalance(userId, profile.cash)
	return profile
end

function PlayerStore:save(userId: any): (boolean, string?)
	local profile = self:sync(userId)
	if profile == nil then
		return false, "not loaded"
	end
	return self._profiles:save(userId)
end

function PlayerStore:saveAll(): (number, number)
	local saved = 0
	local failed = 0
	for key in pairs(self._views) do
		local ok = self:save(key)
		if ok then
			saved += 1
		else
			failed += 1
		end
	end
	return saved, failed
end

function PlayerStore:release(userId: any): (boolean, string?)
	local key = toKey(userId)
	if self._views[key] == nil then
		return true, nil
	end
	self:sync(userId)
	local ok, err = self._profiles:release(userId)
	if not ok then
		return false, err
	end
	self._views[key] = nil
	self._workshopProfiles[key] = nil
	self._workshopVehicles[key] = nil
	return true, nil
end

function PlayerStore:loadedCount(): number
	local count = 0
	for _key in pairs(self._views) do
		count += 1
	end
	return count
end

return PlayerStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ProfileAdapter</string>
            <string name="Source"><![CDATA[--!strict
-- ProfileAdapter: injizierbare Persistenz-Adapter fuer ProfileService.
-- Produktion nutzt DataStore (GetAsync/SetAsync), Studio und Tests einen
-- In-Memory-Adapter. Keine Roblox-Laufzeit in `memory()`, damit die
-- Profilkette mit `lune run` testbar bleibt. Keine globalen Variablen.

local ProfileAdapter = {}

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy: { [any]: any } = {}
	for key, item in pairs(value) do
		copy[deepCopy(key)] = deepCopy(item)
	end
	return copy
end

-- In-Memory-Adapter; `Set` liefert true wie ein erfolgreicher DataStore-Write.
function ProfileAdapter.memory(initial: { [string]: any }?)
	local store: { [string]: any } = {}
	if initial ~= nil then
		for key, value in pairs(initial) do
			store[key] = deepCopy(value)
		end
	end
	local adapter: any = {}
	function adapter:Get(key: string): any?
		local value = store[key]
		if value == nil then
			return nil
		end
		return deepCopy(value)
	end
	function adapter:Set(key: string, value: any): boolean
		store[key] = deepCopy(value)
		return true
	end
	function adapter:snapshot(): { [string]: any }
		return store
	end
	return adapter
end

-- DataStore-Adapter; Fehler werden von ProfileService per pcall abgefangen.
function ProfileAdapter.dataStore(dataStore: any, options: any?)
	assert(type(dataStore) == "table" or type(dataStore) == "userdata", "dataStore required")
	local opts = options or {}
	local prefix: string = "player_"
	if type(opts.keyPrefix) == "string" and opts.keyPrefix ~= "" then
		prefix = opts.keyPrefix
	end
	local adapter: any = {}
	function adapter:GetAsync(key: string): any?
		return dataStore:GetAsync(prefix .. key)
	end
	function adapter:SetAsync(key: string, value: any): boolean
		dataStore:SetAsync(prefix .. key, value)
		return true
	end
	return adapter
end

return ProfileAdapter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">ProfileService</string>
            <string name="Source"><![CDATA[--!strict
-- Töffli Tal: serverseitige Profilpersistenz.
-- Server-modul: Laden, Autosave, Migration, Speichern beim Verlassen.
-- Persistenz läuft ausschliesslich über einen injizierbaren DataStore-Adapter,
-- damit der Client niemals DataStore-Aufrufe tätigt.
-- Adaptervertrag (Methoden mit Doppelpunkt aufrufen):
--   adapter:Get(userKey: string): any?
--   adapter:Set(userKey: string, profile: any): ()
-- Alternativ werden GetAsync/SetAsync akzeptiert. Fehler (throw oder
-- explizites `false` bei Set) werden als Fehlschlag zurückgegeben, der
-- Cache bleibt zur Vermeidung von Datenverlust erhalten.

local FallbackSchema = require("../../shared/data/PlayerDataSchema")

local ProfileService = {}

local function deepCopy(value: any, seen: { [any]: any }?): any
	local seenMap: { [any]: any } = seen or {}
	if type(value) ~= "table" then
		return value
	end
	if seenMap[value] ~= nil then
		return seenMap[value]
	end
	local copy: { [any]: any } = {}
	seenMap[value] = copy
	for key, item in pairs(value) do
		copy[deepCopy(key, seenMap)] = deepCopy(item, seenMap)
	end
	return copy
end

function ProfileService.new(adapter: any, schemaOverride: any?): any
	assert(type(adapter) == "table", "adapter must be a table")
	local schema: any = schemaOverride or FallbackSchema
	assert(type(schema.createDefault) == "function", "schema needs createDefault")
	assert(type(schema.validate) == "function", "schema needs validate")
	assert(type(schema.migrate) == "function", "schema needs migrate")

	local profiles: { [string]: any } = {}
	local saving: { [string]: boolean } = {}

	local function toKey(userId: any): string
		return tostring(userId)
	end

	local function fetchRaw(key: string): any
		if type(adapter.Get) == "function" then
			return adapter:Get(key)
		elseif type(adapter.GetAsync) == "function" then
			return adapter:GetAsync(key)
		else
			error("adapter needs a Get or GetAsync method")
		end
	end

	local function storeRaw(key: string, snapshot: any): any
		if type(adapter.Set) == "function" then
			return adapter:Set(key, snapshot)
		elseif type(adapter.SetAsync) == "function" then
			return adapter:SetAsync(key, snapshot)
		else
			error("adapter needs a Set or SetAsync method")
		end
	end

	local service: any = {}

	function service.load(userId: any): any
		local key = toKey(userId)
		if profiles[key] ~= nil then
			return profiles[key]
		end
		local raw: any = nil
		local fetchOk: boolean, fetched: any = pcall(function(): any
			return fetchRaw(key)
		end)
		if fetchOk then
			raw = fetched
		else
			raw = nil
		end
		local profile: any = nil
		if raw == nil then
			profile = schema.createDefault()
		else
			local migrateOk: boolean, migrated: any = pcall(function(): any
				return schema.migrate(raw)
			end)
			if migrateOk and type(migrated) == "table" then
				profile = migrated
			else
				profile = schema.createDefault()
			end
			local valid: boolean = schema.validate(profile)
			if not valid then
				profile = schema.createDefault()
			end
		end
		profiles[key] = profile
		return profile
	end

	function service.get(userId: any): any?
		return profiles[toKey(userId)]
	end

	function service.isLoaded(userId: any): boolean
		return profiles[toKey(userId)] ~= nil
	end

	function service.loadedCount(): number
		local count = 0
		for _key in pairs(profiles) do
			count += 1
		end
		return count
	end

	function service.save(userId: any): (boolean, string?)
		local key = toKey(userId)
		local profile: any = profiles[key]
		if profile == nil then
			return false, "not loaded"
		end
		if saving[key] then
			return false, "already saving"
		end
		saving[key] = true
		local snapshot: any = deepCopy(profile)
		local storeOk: boolean, storeResult: any = pcall(function(): any
			return storeRaw(key, snapshot)
		end)
		saving[key] = false
		if not storeOk then
			return false, "store failed"
		end
		if storeResult == false then
			return false, "store rejected"
		end
		return true, nil
	end

	function service.saveAll(): (number, number)
		local saved = 0
		local failed = 0
		for key in pairs(profiles) do
			local ok: boolean = service.save(key)
			if ok then
				saved += 1
			else
				failed += 1
			end
		end
		return saved, failed
	end

	function service.release(userId: any): (boolean, string?)
		local key = toKey(userId)
		if profiles[key] == nil then
			return true, nil
		end
		local ok: boolean, err: string? = service.save(userId)
		if not ok then
			return false, err
		end
		profiles[key] = nil
		saving[key] = nil
		return true, nil
	end

	function service.clear(): ()
		for key in pairs(profiles) do
			profiles[key] = nil
		end
		for key in pairs(saving) do
			saving[key] = nil
		end
	end

	function service.tick(): (number, number)
		return service.saveAll()
	end

	function service.startAutosave(intervalSeconds: number): () -> ()
		assert(type(intervalSeconds) == "number" and intervalSeconds > 0, "interval must be positive")
		local running = { value = true }
		task.spawn(function()
			while running.value do
				task.wait(intervalSeconds)
				if not running.value then
					break
				end
				service.saveAll()
			end
		end)
		return function()
			running.value = false
		end
	end

	return service
end

return ProfileService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
-- ShopService: Laptop-Bestellung und Ladenkauf (server-autoritativ).
-- Katalogabruf, Bestellung per Laptop und Direktkauf im Toeffli-Laden.
-- Preise stammen immer vom Serverkatalog. Bestellungen landen nur im
-- Inventar. Einbau, Ausbau, Lackierung und Tuning werden hier bewusst
-- nicht ausgeloest (dafuer ist WorkshopService zustaendig).

export type PartEntry = {
	id: string,
	price: number,
	slot: string?,
	models: { string }?,
}

export type Profile = {
	money: number,
	inventory: { [string]: number },
}

export type ShopOptions = {
	catalog: { [string]: PartEntry }?,
	profiles: { [number | string]: Profile }?,
	isNearStore: ((userId: number | string) -> boolean)?,
}

local ShopService = {}
ShopService.__index = ShopService

export type Shop = typeof(setmetatable(
	{} :: {
		_catalog: { [string]: PartEntry },
		_profiles: { [number | string]: Profile },
		_isNearStore: (userId: number | string) -> boolean,
		_processed: { [string]: boolean },
	},
	ShopService
))

local function defaultIsNearStore(_userId: number | string): boolean
	return false
end

local function copyPart(entry: PartEntry): PartEntry
	local modelsCopy: { string }? = nil
	if entry.models ~= nil then
		modelsCopy = {}
		for i, modelId in ipairs(entry.models :: { string }) do
			(modelsCopy :: { string })[i] = modelId
		end
	end
	return {
		id = entry.id,
		price = entry.price,
		slot = entry.slot,
		models = modelsCopy,
	}
end

function ShopService.new(options: ShopOptions?): Shop
	local opts = options or {}
	local catalog: { [string]: PartEntry } = {}
	if opts.catalog ~= nil then
		for partId, entry in pairs(opts.catalog :: { [string]: PartEntry }) do
			if type(partId) == "string" and type(entry) == "table" then
				catalog[partId] = copyPart(entry :: PartEntry)
			end
		end
	end
	local self = setmetatable({
		_catalog = catalog,
		_profiles = if opts.profiles ~= nil then opts.profiles else {},
		_isNearStore = if opts.isNearStore ~= nil then opts.isNearStore else defaultIsNearStore,
		_processed = {},
	}, ShopService)
	return (self :: any) :: Shop
end

function ShopService.getPart(self: Shop, partId: string): PartEntry?
	if type(partId) ~= "string" then
		return nil
	end
	local entry = self._catalog[partId]
	if entry == nil then
		return nil
	end
	return copyPart(entry)
end

function ShopService.getPrice(self: Shop, partId: string): number?
	local entry = self._catalog[partId]
	if entry == nil then
		return nil
	end
	return entry.price
end

function ShopService.getCatalog(self: Shop): { PartEntry }
	local list: { PartEntry } = {}
	for _, entry in pairs(self._catalog) do
		table.insert(list, copyPart(entry))
	end
	table.sort(list, function(a: PartEntry, b: PartEntry): boolean
		return a.id < b.id
	end)
	return list
end

function ShopService.isCompatibleWith(self: Shop, partId: string, vehicleId: string): boolean
	local entry = self._catalog[partId]
	if entry == nil then
		return false
	end
	if entry.models == nil or #(entry.models :: { string }) == 0 then
		return true
	end
	for _, modelId in ipairs(entry.models :: { string }) do
		if modelId == vehicleId then
			return true
		end
	end
	return false
end

function ShopService.getInventory(self: Shop, userId: number | string): { [string]: number }
	local profile = self._profiles[userId]
	if profile == nil then
		return {}
	end
	local copy: { [string]: number } = {}
	if profile.inventory ~= nil then
		for partId, count in pairs(profile.inventory) do
			copy[partId] = count
		end
	end
	return copy
end

local function claimTransaction(self: Shop, txId: string?): boolean
	if txId == nil or txId == "" then
		return false
	end
	if self._processed[txId :: string] == true then
		return true
	end
	self._processed[txId :: string] = true
	return false
end

local function buyInternal(
	self: Shop,
	userId: number | string,
	partId: string,
	txId: string?,
	requireStore: boolean
): (boolean, string)
	if type(partId) ~= "string" or partId == "" then
		return false, "unknown_part"
	end
	local entry = self._catalog[partId]
	if entry == nil then
		return false, "unknown_part"
	end
	if type(entry.price) ~= "number" or entry.price < 0 then
		return false, "invalid_price"
	end
	local profile = self._profiles[userId]
	if profile == nil then
		return false, "unknown_profile"
	end
	if requireStore then
		local ok, near = pcall(self._isNearStore, userId)
		if not ok or near ~= true then
			return false, "not_near_store"
		end
	end
	if txId ~= nil and txId ~= "" and self._processed[txId :: string] == true then
		return false, "duplicate_transaction"
	end
	if type(profile.money) ~= "number" then
		return false, "invalid_profile"
	end
	if profile.money < entry.price then
		return false, "insufficient_funds"
	end
	claimTransaction(self, txId)
	profile.money -= entry.price
	if profile.inventory == nil then
		profile.inventory = {}
	end
	profile.inventory[partId] = (profile.inventory[partId] or 0) + 1
	return true, "ok"
end

-- Laptop-Bestellung: keine Naehenpruefung, landet im Inventar.
function ShopService.orderPart(self: Shop, userId: number | string, partId: string, txId: string?): (boolean, string)
	return buyInternal(self, userId, partId, txId, false)
end

-- Direktkauf im Toeffli-Laden: nur in Ladennähe, landet im Inventar.
function ShopService.buyFromStore(self: Shop, userId: number | string, partId: string, txId: string?): (boolean, string)
	return buyInternal(self, userId, partId, txId, true)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">VehicleService</string>
            <string name="Source"><![CDATA[--!strict
-- VehicleService: Kauf, Besitzprüfung und Auswahl von Fahrzeugen.
-- Der einmalige Startrabatt gilt nur für das erste Mofa und wird
-- serverseitig atomar mit dem Kauf verbraucht (rejoin- und parallelfest).

export type CatalogEntry = {
	price: number,
	starterPrice: number?,
	discountPrice: number?,
	starterDiscountPrice: number?,
	kind: string?,
}

export type Catalog = { [string]: CatalogEntry }

export type Profile = { [string]: any }

export type Receipt = {
	vehicleId: string,
	pricePaid: number,
	discountApplied: boolean,
}

export type VehicleService = {
	_catalog: Catalog,
	_locks: { [any]: boolean },
}

local VehicleService = {}
VehicleService.__index = VehicleService

local STARTER_BIKE_ID = "bicycle"

local DEFAULT_CATALOG: Catalog = {
	bicycle = { price = 0, kind = "bicycle" },
	puch_maxi_s = { price = 1499, starterPrice = 799, kind = "moped" },
	piaggio_ciao = { price = 1399, starterPrice = 749, kind = "moped" },
}

local function copyCatalog(source: Catalog): Catalog
	local out: Catalog = {}
	for id, entry in pairs(source) do
		out[id] = {
			price = entry.price,
			starterPrice = entry.starterPrice,
			discountPrice = entry.discountPrice,
			starterDiscountPrice = entry.starterDiscountPrice,
			kind = entry.kind,
		}
	end
	return out
end

local function isMopedId(catalog: Catalog, vehicleId: string): boolean
	local entry = catalog[vehicleId]
	if entry then
		if entry.kind ~= nil then
			return entry.kind == "moped"
		end
	end
	return vehicleId == "puch_maxi_s" or vehicleId == "piaggio_ciao"
end

local function starterPriceFor(entry: CatalogEntry): number?
	if entry.starterPrice ~= nil then
		return entry.starterPrice
	end
	if entry.starterDiscountPrice ~= nil then
		return entry.starterDiscountPrice
	end
	if entry.discountPrice ~= nil then
		return entry.discountPrice
	end
	return nil
end

local function vehiclesMap(profile: Profile): { [string]: boolean }
	local owned: { [string]: boolean } = {}
	local raw = profile["vehicles"]
	if type(raw) == "table" then
		-- Unterstützt Dict-Form { [id] = true } und Array-Form { [n] = id }.
		for key, value in pairs(raw :: any) do
			if type(key) == "string" and value == true then
				owned[key] = true
			elseif type(value) == "string" then
				owned[value] = true
			end
		end
	end
	return owned
end

local function writeOwnership(profile: Profile, vehicleId: string)
	local raw = profile["vehicles"]
	if type(raw) == "table" then
		-- Bevorzugt Dict-Form; Array-Form wird erkannt und ergänzt.
		local isArray = true
		for key, _ in pairs(raw :: any) do
			if type(key) ~= "number" then
				isArray = false
				break
			end
		end
		if isArray then
			for _, existing in ipairs(raw :: any) do
				if existing == vehicleId then
					return
				end
			end
			table.insert(raw :: any, vehicleId)
			return
		else
			(raw :: any)[vehicleId] = true
			return
		end
	end
	profile["vehicles"] = { [vehicleId] = true }
end

local function ownsAnyMoped(self: VehicleService, profile: Profile): boolean
	local owned = vehiclesMap(profile)
	for id, _ in pairs(owned) do
		if isMopedId(self._catalog, id) then
			return true
		end
	end
	return false
end

function VehicleService.new(catalog: Catalog?): VehicleService
	local self: VehicleService = setmetatable({}, VehicleService) :: any
	self._catalog = copyCatalog(catalog or DEFAULT_CATALOG)
	self._locks = {}
	return self
end

function VehicleService.hasStarterDiscountAvailable(self: VehicleService, profile: Profile): boolean
	if profile["starterDiscountUsed"] == true then
		return false
	end
	if ownsAnyMoped(self, profile) then
		return false
	end
	return true
end

function VehicleService.owns(_self: VehicleService, profile: Profile, vehicleId: string): boolean
	return vehiclesMap(profile)[vehicleId] == true
end

function VehicleService.getOwned(_self: VehicleService, profile: Profile): { string }
	local owned = vehiclesMap(profile)
	local list: { string } = {}
	for id, _ in pairs(owned) do
		table.insert(list, id)
	end
	table.sort(list)
	return list
end

function VehicleService.getSelected(_self: VehicleService, profile: Profile): string?
	local selected = profile["selectedVehicle"]
	if type(selected) == "string" then
		return selected
	end
	return nil
end

function VehicleService.getPrice(self: VehicleService, profile: Profile, vehicleId: string): (number?, boolean, string?)
	local entry = self._catalog[vehicleId]
	if entry == nil then
		return nil, false, "unknown_vehicle"
	end
	if type(entry.price) ~= "number" then
		return nil, false, "invalid_catalog"
	end
	local discountEligible = isMopedId(self._catalog, vehicleId)
		and profile["starterDiscountUsed"] ~= true
		and not ownsAnyMoped(self, profile)
		and starterPriceFor(entry) ~= nil
	if discountEligible then
		return starterPriceFor(entry) :: number, true, nil
	end
	return entry.price, false, nil
end

function VehicleService.ensureStarterBike(_self: VehicleService, profile: Profile): boolean
	if next(vehiclesMap(profile)) ~= nil then
		if profile["selectedVehicle"] == nil then
			-- Bestehender Besitz ohne Auswahl: erstes Fahrzeug wählen.
			local owned = vehiclesMap(profile)
			local first: string? = nil
			for id, _ in pairs(owned) do
				if first == nil or id < (first :: string) then
					first = id
				end
			end
			profile["selectedVehicle"] = first
		end
		return false
	end
	profile["vehicles"] = { [STARTER_BIKE_ID] = true }
	profile["selectedVehicle"] = STARTER_BIKE_ID
	if type(profile["money"]) ~= "number" then
		profile["money"] = 0
	end
	return true
end

local function lockKeyFor(profile: Profile, userId: any): any
	if userId ~= nil then
		return userId
	end
	return profile
end

function VehicleService.isLocked(self: VehicleService, profile: Profile, userId: any?): boolean
	return self._locks[lockKeyFor(profile, userId)] == true
end

function VehicleService.unlock(self: VehicleService, profile: Profile, userId: any?)
	self._locks[lockKeyFor(profile, userId)] = nil
end

function VehicleService.purchase(
	self: VehicleService,
	profile: Profile,
	vehicleId: string,
	userId: any?
): (boolean, any)
	if type(vehicleId) ~= "string" or vehicleId == "" then
		return false, "invalid_vehicle"
	end
	local entry = self._catalog[vehicleId]
	if entry == nil then
		return false, "unknown_vehicle"
	end
	if type(entry.price) ~= "number" or entry.price < 0 then
		return false, "invalid_catalog"
	end

	local key = lockKeyFor(profile, userId)
	if self._locks[key] == true then
		return false, "busy"
	end
	self._locks[key] = true

	-- Atomarer Block: alle Prüfungen nach Lock erneut auswerten, dann
	-- Geld, Besitz und Rabattverbrauch in einem Schritt anwenden.
	local ok = false
	local result: any = "failed"
	if vehiclesMap(profile)[vehicleId] == true then
		result = "already_owned"
	else
		local discountEligible = isMopedId(self._catalog, vehicleId)
			and profile["starterDiscountUsed"] ~= true
			and not ownsAnyMoped(self, profile)
		local price = entry.price
		local discountApplied = false
		local reduced = starterPriceFor(entry)
		if discountEligible and reduced ~= nil then
			price = reduced :: number
			discountApplied = true
		end
		if type(price) ~= "number" or price < 0 then
			result = "invalid_catalog"
		else
			local money = profile["money"]
			if type(money) ~= "number" then
				result = "invalid_profile"
			elseif money < price then
				result = "insufficient_funds"
			else
				profile["money"] = money - price
				writeOwnership(profile, vehicleId)
				if discountApplied then
					profile["starterDiscountUsed"] = true
				end
				profile["selectedVehicle"] = vehicleId
				ok = true
				local receipt: Receipt = {
					vehicleId = vehicleId,
					pricePaid = price,
					discountApplied = discountApplied,
				}
				result = receipt
			end
		end
	end

	self._locks[key] = nil
	return ok, result
end

function VehicleService.select(self: VehicleService, profile: Profile, vehicleId: string): (boolean, string?)
	if type(vehicleId) ~= "string" or vehicleId == "" then
		return false, "invalid_vehicle"
	end
	if self._catalog[vehicleId] == nil then
		return false, "unknown_vehicle"
	end
	if vehiclesMap(profile)[vehicleId] ~= true then
		return false, "not_owned"
	end
	profile["selectedVehicle"] = vehicleId
	return true, nil
end

return VehicleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">WorkshopService</string>
            <string name="Source"><![CDATA[--!strict
-- WorkshopService: Server-validierte Werkstattaktionen (Einbau, Ausbau, Lackierung).
-- Nur bei aktivem Werkstattzustand. Laptop-Quellen werden grundsaetzlich abgewiesen.

export type VehicleRecord = {
	modelId: string,
	parts: { [string]: string },
	colors: { [string]: string },
	stats: any?,
}

export type ProfileRecord = {
	vehicles: { [string]: VehicleRecord },
	inventory: { [string]: number },
}

export type PartInfo = {
	slot: string,
	models: { string }?,
}

export type WorkshopDeps = {
	profiles: { [string]: ProfileRecord },
	parts: { [string]: PartInfo }?,
	isWorkshopActive: ((playerId: string) -> boolean)?,
	computeStats: ((modelId: string, parts: { [string]: string }) -> any)?,
}

local WorkshopService = {}
WorkshopService.__index = WorkshopService

export type WorkshopService = typeof(setmetatable(
	{} :: {
		_profiles: { [string]: ProfileRecord },
		_parts: { [string]: PartInfo },
		_isWorkshopActive: (playerId: string) -> boolean,
		_computeStats: ((modelId: string, parts: { [string]: string }) -> any)?,
	},
	WorkshopService
))

local function defaultInactive(_playerId: string): boolean
	return false
end

function WorkshopService.new(deps: WorkshopDeps)
	local self = setmetatable({}, WorkshopService)
	self._profiles = deps.profiles
	self._parts = deps.parts or ({} :: { [string]: PartInfo })
	if deps.isWorkshopActive ~= nil then
		self._isWorkshopActive = deps.isWorkshopActive :: (playerId: string) -> boolean
	else
		self._isWorkshopActive = defaultInactive
	end
	self._computeStats = deps.computeStats
	return self
end

function WorkshopService:_checkSource(source: string?): (boolean, string?)
	if source == "laptop" then
		return false, "LaptopNotAllowed"
	end
	return true, nil
end

function WorkshopService:_checkWorkshop(playerId: string): (boolean, string?)
	local ok, _err = self:_checkSource(nil)
	if not ok then
		return false, _err
	end
	local active = self._isWorkshopActive(playerId)
	if not active then
		return false, "WorkshopInactive"
	end
	return true, nil
end

function WorkshopService:_getVehicle(playerId: string, vehicleId: string): (ProfileRecord?, VehicleRecord?, string?)
	local profile = self._profiles[playerId]
	if profile == nil then
		return nil, nil, "ProfileNotFound"
	end
	local vehicle = profile.vehicles[vehicleId]
	if vehicle == nil then
		return profile, nil, "VehicleNotOwned"
	end
	return profile, vehicle, nil
end

local function isModelAllowed(part: PartInfo, modelId: string): boolean
	if part.models == nil then
		return true
	end
	local models = part.models :: { string }
	if #models == 0 then
		return true
	end
	for _, m in models do
		if m == modelId then
			return true
		end
	end
	return false
end

function WorkshopService:_refreshStats(vehicle: VehicleRecord)
	if self._computeStats ~= nil then
		local fn = self._computeStats :: (modelId: string, parts: { [string]: string }) -> any
		vehicle.stats = fn(vehicle.modelId, vehicle.parts)
	end
end

-- Baut ein Teil aus dem Inventar in das Fahrzeug ein.
-- opts: { source: string? } ("workshop" erwartet, "laptop" wird abgewiesen)
function WorkshopService:installPart(playerId: string, vehicleId: string, partId: string, opts: { source: string? }?): (boolean, string?)
	local source: string? = nil
	if opts ~= nil then
		source = opts.source
	end
	local okSource, errSource = self:_checkSource(source)
	if not okSource then
		return false, errSource
	end
	local okShop, errShop = self:_checkWorkshop(playerId)
	if not okShop then
		return false, errShop
	end
	local profile, vehicle, errVehicle = self:_getVehicle(playerId, vehicleId)
	if errVehicle ~= nil then
		return false, errVehicle
	end
	local part = self._parts[partId]
	if part == nil then
		return false, "PartNotFound"
	end
	local ownedVehicle = vehicle :: VehicleRecord
	if not isModelAllowed(part, ownedVehicle.modelId) then
		return false, "IncompatiblePart"
	end
	local ownedProfile = profile :: ProfileRecord
	local count = ownedProfile.inventory[partId] or 0
	if count <= 0 then
		return false, "PartNotInInventory"
	end
	-- Atomares Update: erst hier mutieren.
	ownedProfile.inventory[partId] = count - 1
	ownedVehicle.parts[part.slot] = partId
	self:_refreshStats(ownedVehicle)
	return true, nil
end

-- Baut ein Teil aus und legt es ins Inventar zurueck.
function WorkshopService:removePart(playerId: string, vehicleId: string, slot: string, opts: { source: string? }?): (boolean, string?)
	local source: string? = nil
	if opts ~= nil then
		source = opts.source
	end
	local okSource, errSource = self:_checkSource(source)
	if not okSource then
		return false, errSource
	end
	local okShop, errShop = self:_checkWorkshop(playerId)
	if not okShop then
		return false, errShop
	end
	local profile, vehicle, errVehicle = self:_getVehicle(playerId, vehicleId)
	if errVehicle ~= nil then
		return false, errVehicle
	end
	local ownedVehicle = vehicle :: VehicleRecord
	local installed = ownedVehicle.parts[slot]
	if installed == nil then
		return false, "SlotEmpty"
	end
	local ownedProfile = profile :: ProfileRecord
	-- Atomares Update.
	ownedVehicle.parts[slot] = nil
	ownedProfile.inventory[installed] = (ownedProfile.inventory[installed] or 0) + 1
	self:_refreshStats(ownedVehicle)
	return true, nil
end

local function isHexColor(value: string): boolean
	if #value ~= 7 then
		return false
	end
	if string.sub(value, 1, 1) ~= "#" then
		return false
	end
	local hex = string.sub(value, 2, 7)
	return string.match(hex, "^%x%x%x%x%x%x$") ~= nil
end

-- Lackiert eine Flaeche des Fahrzeugs.
-- paint: { surface: string, color: string } mit Hex-Farbe wie "#FF0000".
function WorkshopService:paint(
	playerId: string,
	vehicleId: string,
	paint: { surface: string, color: string },
	opts: { source: string? }?
): (boolean, string?)
	local source: string? = nil
	if opts ~= nil then
		source = opts.source
	end
	local okSource, errSource = self:_checkSource(source)
	if not okSource then
		return false, errSource
	end
	local okShop, errShop = self:_checkWorkshop(playerId)
	if not okShop then
		return false, errShop
	end
	local _profile, vehicle, errVehicle = self:_getVehicle(playerId, vehicleId)
	if errVehicle ~= nil then
		return false, errVehicle
	end
	if paint.surface == "" then
		return false, "InvalidSurface"
	end
	if not isHexColor(paint.color) then
		return false, "InvalidColor"
	end
	local ownedVehicle = vehicle :: VehicleRecord
	-- Atomares Update.
	ownedVehicle.colors[paint.surface] = paint.color
	self:_refreshStats(ownedVehicle)
	return true, nil
end

return WorkshopService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="32">
        <Properties>
          <string name="Name">vehicle</string>
        </Properties>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">BicycleSpawner</string>
            <string name="Source"><![CDATA[--!strict
-- BicycleSpawner: erzeugt pro Spieler genau ein kostenloses Startfahrrad.
-- Kein Motor, kein Treibstoff, kein Tuning, keine Preise, keine Gameplay-Logik.

local CollectionService = game:GetService("CollectionService")

local BicycleSpawner = {}

local FOLDER_NAME = "ToeffliTalVehicles"
local TAG_NAME = "ToeffliBicycle"
local DEFAULT_SPAWN = CFrame.new(0, 5, 0)

local function getFolder(): Folder
	local existing = workspace:FindFirstChild(FOLDER_NAME)
	if existing ~= nil and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = workspace
	return folder
end

local function makePart(className: string, name: string, size: Vector3, color: Color3): BasePart
	local part = Instance.new(className) :: BasePart
	part.Name = name
	part.Size = size
	part.Color = color
	part.Anchored = true
	part.CanCollide = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local function weldTo(main: BasePart, other: BasePart, parent: Model): ()
	if other == main then
		return
	end
	local weld = Instance.new("WeldConstraint")
	weld.Name = string.format("Weld_%s", other.Name)
	weld.Part0 = main
	weld.Part1 = other
	weld.Parent = parent
end

function BicycleSpawner.createForPlayer(player: Player, spawnCFrame: CFrame?): Model
	BicycleSpawner.releaseForPlayer(player)

	local base = spawnCFrame or DEFAULT_SPAWN
	local folder = getFolder()

	local model = Instance.new("Model")
	model.Name = string.format("StarterBicycle_%d", player.UserId)

	local drive = makePart("Part", "Drive", Vector3.new(1.2, 0.4, 3.2), Color3.fromRGB(180, 180, 180))
	drive.CFrame = base * CFrame.new(0, 1.0, 0)

	local seat = makePart("Seat", "Seat", Vector3.new(1.0, 0.5, 1.0), Color3.fromRGB(40, 40, 40))
	seat.CanCollide = false
	seat.CFrame = base * CFrame.new(0, 1.6, -0.6)

	local wheelFront = makePart("Part", "WheelFront", Vector3.new(0.4, 1.4, 1.4), Color3.fromRGB(25, 25, 25))
	wheelFront.Shape = Enum.PartType.Cylinder
	wheelFront.CFrame = base * CFrame.new(0, 0.7, 1.6)

	local wheelRear = makePart("Part", "WheelRear", Vector3.new(0.4, 1.4, 1.4), Color3.fromRGB(25, 25, 25))
	wheelRear.Shape = Enum.PartType.Cylinder
	wheelRear.CFrame = base * CFrame.new(0, 0.7, -1.6)

	-- Lenker.
	local handlebar = makePart("Part", "Handlebar", Vector3.new(1.2, 0.3, 0.3), Color3.fromRGB(90, 90, 90))
	handlebar.CanCollide = false
	handlebar.CFrame = base * CFrame.new(0, 1.7, 1.2)

	for _, part in { drive, seat, wheelFront, wheelRear, handlebar } do
		part.Parent = model
	end
	model.PrimaryPart = drive

	for _, part in { seat, wheelFront, wheelRear, handlebar } do
		weldTo(drive, part, model)
	end

	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("IsStarterBicycle", true)
	CollectionService:AddTag(model, TAG_NAME)

	model.Parent = folder
	model:PivotTo(base)

	return model
end

function BicycleSpawner.releaseForPlayer(player: Player): ()
	local folder = workspace:FindFirstChild(FOLDER_NAME)
	if folder == nil then
		return
	end
	for _, child in folder:GetChildren() do
		local matchesAttribute = child:GetAttribute("OwnerUserId") == player.UserId
		local matchesName = child.Name == string.format("StarterBicycle_%d", player.UserId)
		if matchesAttribute or matchesName then
			child:Destroy()
		end
	end
end

return BicycleSpawner
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="34">
        <Properties>
          <string name="Name">world</string>
        </Properties>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">AtmosphereBuilder</string>
            <string name="Source">--!strict
-- AtmosphereBuilder: freundliche Tagesbeleuchtung mit Sonne, Wolken und Atmosphaere.
-- Kein Tag/Nacht-Kreislauf, keine Ueberblendung, keine Gameplay-Aenderungen.
-- Keine globalen Variablen, keine externen Assets.

local AtmosphereBuilder = {}

local function clearChildrenOfType(parent: Instance, className: string): ()
	for _, child in parent:GetChildren() do
		if child.ClassName == className then
			child:Destroy()
		end
	end
end

function AtmosphereBuilder.apply(): ()
	local Lighting = game:GetService("Lighting")

	-- Feste, freundliche Tageszeit: kein automatischer Tag/Nacht-Kreislauf.
	Lighting.ClockTime = 14
	Lighting.GeographicLatitude = 46.8
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(145, 155, 170)
	Lighting.OutdoorAmbient = Color3.fromRGB(175, 185, 200)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 248, 235)
	Lighting.ColorShift_Bottom = Color3.fromRGB(190, 210, 230)
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.4

	-- Weicher, nicht uebermaessiger Nebel fuer Lesbarkeit in der Ferne.
	Lighting.FogColor = Color3.fromRGB(205, 220, 235)
	Lighting.FogStart = 600
	Lighting.FogEnd = 2200

	-- Atmosphaere: sanfter Dunst, geringe Blendung.
	clearChildrenOfType(Lighting, "Atmosphere")
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.22
	atmosphere.Color = Color3.fromRGB(205, 225, 255)
	atmosphere.Decay = Color3.fromRGB(190, 210, 240)
	atmosphere.Glare = 0.12
	atmosphere.Haze = 0.45
	atmosphere.Parent = Lighting

	-- Sanfte Sonnenstrahlen, ohne Ueberblendung.
	clearChildrenOfType(Lighting, "SunRaysEffect")
	local sunRays = Instance.new("SunRaysEffect")
	sunRays.Intensity = 0.12
	sunRays.Spread = 0.55
	sunRays.Parent = Lighting

	-- Wolken ueber dem Terrain (sichtbar, aber nicht zu dicht).
	local terrain = workspace:FindFirstChild("Terrain")
	if terrain ~= nil then
		clearChildrenOfType(terrain, "Clouds")
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.38
		clouds.Density = 0.55
		clouds.Color = Color3.fromRGB(255, 255, 255)
		clouds.Parent = terrain
	end
end

return AtmosphereBuilder</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">BridgeBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- BridgeBuilder: flache Bruecken an allen Wasserquerungen (BRIDGE_CROSSINGS).
-- Jede Bruecke verbindet die Fahrbahn stufenlos, besitzt sichtbare seitliche
-- Begrenzungen und liegt vollstaendig ueber dem Wasser. Das Deck ist horizontal
-- (nur Yaw), damit Auffahrten mit Fahrrad und Mofa flach befahrbar bleiben.
-- Keine Schilder, keine Kollision mit Bachufern.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldZones = requireSibling("WorldZones")
local TerrainHeight = requireSibling("TerrainHeight")

local BridgeBuilder = {}

local DECK_THICKNESS = 1
local DECK_Y_OFFSET = 0.6
local RAIL_WIDTH = 0.6
local RAIL_HEIGHT = 1.2
local DECK_COLOR = Color3.fromRGB(70, 70, 75)
local RAIL_COLOR = Color3.fromRGB(180, 180, 185)

local function makePart(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	canCollide: boolean
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = canCollide
	part.CanQuery = false
	part.CanTouch = false
	part.Parent = parent
	return part
end

-- Erzeugt alle Bruecken unter `parent` und gibt den Ordner zurueck.
function BridgeBuilder.build(parent: Instance): Folder
	local root = Instance.new("Folder")
	root.Name = "Bridges"

	for _, crossing in WorldZones.BRIDGE_CROSSINGS do
		local position = crossing.position
		local yaw = math.rad(crossing.yaw)
		local deckY = TerrainHeight.heightAt(position.x, position.z) + DECK_Y_OFFSET
		local base = CFrame.new(Vector3.new(position.x, deckY, position.z)) * CFrame.Angles(0, yaw, 0)

		local deck = makePart(
			root,
			crossing.id,
			Vector3.new(crossing.width, DECK_THICKNESS, crossing.length),
			base,
			DECK_COLOR,
			true
		)
		deck:SetAttribute("BridgeId", crossing.id)
		deck:SetAttribute("RoadId", crossing.roadId)
		deck:SetAttribute("WaterId", crossing.waterId)

		local railOffsetX = crossing.width / 2 - RAIL_WIDTH / 2
		local railLift = DECK_THICKNESS / 2 + RAIL_HEIGHT / 2
		for _, side in { -1, 1 } do
			local rail = makePart(
				root,
				string.format("%s_Rail_%s", crossing.id, if side < 0 then "A" else "B"),
				Vector3.new(RAIL_WIDTH, RAIL_HEIGHT, crossing.length),
				base * CFrame.new(railOffsetX * side, railLift, 0),
				RAIL_COLOR,
				true
			)
			rail:SetAttribute("BridgeId", crossing.id)
			rail:SetAttribute("RoadId", crossing.roadId)
			rail:SetAttribute("WaterId", crossing.waterId)
		end
	end

	root.Parent = parent
	return root
end

return BridgeBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">BuildingFactory</string>
            <string name="Source"><![CDATA[--!strict
-- BuildingFactory: erzeugt ein einzelnes Low-Poly-Haus aus einer Katalogdefinition.
-- Reine Fabrik ohne globale Variablen. Das Model steht lokal am Ursprung mit
-- Bodenbasis Y=0 (Front = -Z); die Positionierung uebernimmt VillageBuilder.
-- Jedes Haus besitzt sichtbare Eingangstuer, Fenster und eindeutige Dekoration.

local BuildingFactory = {}

local function pickString(definition: { [string]: any }, keys: { string }, fallback: string): string
	local value: any = nil
	for _, key in keys do
		if definition[key] ~= nil then
			value = definition[key]
			break
		end
	end
	if type(value) == "string" and value ~= "" then
		return value
	end
	return fallback
end

local function pickNumber(definition: { [string]: any }, keys: { string }, fallback: number): number
	for _, key in keys do
		local value = definition[key]
		if type(value) == "number" then
			return value
		end
	end
	return fallback
end

local function footprintOf(definition: { [string]: any }): { x: number, z: number }
	local candidates = {
		definition.FootprintSize,
		definition.footprintSize,
		definition.Size,
		definition.size,
	}
	for _, candidate in candidates do
		if type(candidate) == "table" then
			local x = candidate.x or candidate.X
			local z = candidate.z or candidate.Z
			if type(x) == "number" and type(z) == "number" and x > 0 and z > 0 then
				return { x = x, z = z }
			end
		end
	end
	return { x = 20, z = 16 }
end

local function colorsOf(definition: { [string]: any }): { string }
	local candidates = {
		definition.FacadeColors,
		definition.facadeColors,
		definition.Colors,
		definition.colors,
		definition.Fassadenfarben,
		definition.fassadenfarben,
	}
	for _, candidate in candidates do
		if type(candidate) == "table" and type(candidate[1]) == "string" then
			return candidate
		end
	end
	local single = pickString(definition, { "FacadeColor", "facadeColor" }, "white")
	return { single }
end

local FACADE_COLORS: { [string]: Color3 } = {
	white = Color3.fromRGB(245, 245, 240),
	cream = Color3.fromRGB(245, 235, 200),
	yellow = Color3.fromRGB(240, 210, 120),
	gray = Color3.fromRGB(170, 170, 170),
	brown = Color3.fromRGB(150, 110, 70),
}

local ROOF_COLORS: { [string]: Color3 } = {
	gable = Color3.fromRGB(150, 60, 50),
	hip = Color3.fromRGB(90, 90, 95),
	flat = Color3.fromRGB(180, 180, 180),
	mansard = Color3.fromRGB(120, 80, 50),
}

local function facadeColor(name: string): Color3
	local found = FACADE_COLORS[string.lower(name)]
	if found ~= nil then
		return found
	end
	return Color3.fromRGB(235, 235, 230)
end

local function roofColor(roof: string): Color3
	local found = ROOF_COLORS[string.lower(roof)]
	if found ~= nil then
		return found
	end
	return Color3.fromRGB(130, 70, 60)
end

local function trimColor(colors: { string }): Color3
	if #colors >= 2 and type(colors[2]) == "string" then
		return facadeColor(colors[2])
	end
	return Color3.fromRGB(80, 80, 85)
end

local function makePart(
	model: Model,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	canCollide: boolean
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = canCollide
	part.Parent = model
	return part
end

local function doorXFor(doorSide: string, sizeX: number): number
	local side = string.lower(doorSide)
	if side == "left" then
		return -sizeX / 4
	elseif side == "right" then
		return sizeX / 4
	else
		return 0
	end
end

function BuildingFactory.create(definition: { [string]: any }): Model
	local id = pickString(definition, { "Id", "id" }, "House_Unknown")
	local villageId = pickString(definition, { "VillageId", "villageId" }, "")
	local footprint = footprintOf(definition)
	local sizeX: number = footprint.x
	local sizeZ: number = footprint.z
	local height: number = pickNumber(definition, { "Height", "height", "Hoehe", "hoehe" }, 7)
	if height < 5 then
		height = 5
	end
	local roof = pickString(definition, { "RoofShape", "roofShape", "RoofType", "roofType", "Roof", "roof", "Dachform", "dachform" }, "gable")
	local colorNames = colorsOf(definition)
	local baseColor = facadeColor(colorNames[1])
	local trim = trimColor(colorNames)
	local windowStyle = pickString(definition, { "WindowStyle", "windowStyle", "Windows", "windows", "Fensterstil", "fensterstil" }, "plain")
	local doorSide = pickString(definition, { "DoorSide", "doorSide", "DoorDirection", "doorDirection", "Door", "door", "Tuerseite", "tuerseite" }, "front")
	local decoration = pickString(definition, { "Decoration", "decoration", "DecorationSignature", "decorationSignature", "Dekorationssignatur", "dekorationssignatur" }, "none")
	local signature = pickString(definition, { "Signature", "signature", "DesignSignature", "designSignature", "Gestaltungssignatur", "gestaltungssignatur", "Signatur", "signatur" }, "")

	local model = Instance.new("Model")
	model.Name = id

	-- Hauptkörper, Basis bei Y=0.
	local body = makePart(
		model,
		"Body",
		Vector3.new(sizeX, height, sizeZ),
		CFrame.new(0, height / 2, 0),
		baseColor,
		Enum.Material.SmoothPlastic,
		true
	)
	model.PrimaryPart = body

	-- Dach je Dachform.
	local roofMat = roofColor(roof)
	local roofKey = string.lower(roof)
	if roofKey == "flat" then
		makePart(model, "Roof", Vector3.new(sizeX + 1, 0.8, sizeZ + 1), CFrame.new(0, height + 0.4, 0), roofMat, Enum.Material.SmoothPlastic, true)
	elseif roofKey == "hip" then
		makePart(model, "RoofBase", Vector3.new(sizeX + 1, 0.6, sizeZ + 1), CFrame.new(0, height + 0.3, 0), roofMat, Enum.Material.SmoothPlastic, true)
		makePart(model, "RoofTop", Vector3.new(sizeX * 0.5, 1.6, sizeZ * 0.5), CFrame.new(0, height + 1.4, 0), roofMat, Enum.Material.SmoothPlastic, true)
	elseif roofKey == "mansard" then
		makePart(model, "RoofBase", Vector3.new(sizeX + 1.4, 2.0, sizeZ + 1.4), CFrame.new(0, height + 1.0, 0), roofMat, Enum.Material.SmoothPlastic, true)
		makePart(model, "RoofTop", Vector3.new(sizeX * 0.7, 0.6, sizeZ * 0.7), CFrame.new(0, height + 2.3, 0), trim, Enum.Material.SmoothPlastic, true)
	else
		-- Giebeldach: zwei geneigte Platten plus Firstbalken.
		local slope = math.rad(30)
		makePart(model, "RoofFront", Vector3.new(sizeX + 1.2, 0.6, sizeZ / 2 + 1.2), CFrame.new(0, height + 1.5, -sizeZ / 4) * CFrame.Angles(-slope, 0, 0), roofMat, Enum.Material.SmoothPlastic, true)
		makePart(model, "RoofBack", Vector3.new(sizeX + 1.2, 0.6, sizeZ / 2 + 1.2), CFrame.new(0, height + 1.5, sizeZ / 4) * CFrame.Angles(slope, 0, 0), roofMat, Enum.Material.SmoothPlastic, true)
		makePart(model, "RoofRidge", Vector3.new(sizeX + 1.2, 0.6, 0.8), CFrame.new(0, height + 3.0, 0), trim, Enum.Material.SmoothPlastic, true)
	end

	-- Eingangstür auf der Frontseite (-Z), Boden bündig bei Y=0, leicht vor der Wand.
	local frontZ = -sizeZ / 2
	local dx = doorXFor(doorSide, sizeX)
	local door = makePart(model, "Entrance", Vector3.new(3, 5, 0.6), CFrame.new(dx, 2.5, frontZ - 0.35), Color3.fromRGB(90, 60, 40), Enum.Material.WoodPlanks, false)
	door:SetAttribute("IsEntrance", true)
	makePart(model, "Doorstep", Vector3.new(4, 0.4, 2), CFrame.new(dx, 0.2, frontZ - 1.5), Color3.fromRGB(160, 160, 155), Enum.Material.Concrete, false)

	-- Fenster: zwei auf der Front plus je eines an den Seiten.
	local windowY = math.min(4.4, height * 0.55)
	if windowY < 3.2 then
		windowY = 3.2
	end
	local styleKey = string.lower(windowStyle)
	local glass = Color3.fromRGB(180, 220, 240)
	local frontOffsets = { -sizeX / 2 + 3, sizeX / 2 - 3 }
	local windowIndex = 0
	for _, xOffset in frontOffsets do
		if math.abs(xOffset - dx) < 3.2 then
			continue
		end
		windowIndex += 1
		if styleKey == "bay" then
			makePart(model, "Window_Front_" .. tostring(windowIndex), Vector3.new(3.0, 2.4, 1.4), CFrame.new(xOffset, windowY, frontZ - 0.7), glass, Enum.Material.Glass, false)
		else
			makePart(model, "Window_Front_" .. tostring(windowIndex), Vector3.new(2.6, 2.2, 0.4), CFrame.new(xOffset, windowY, frontZ - 0.2), glass, Enum.Material.Glass, false)
			if styleKey == "shuttered" then
				makePart(model, "Shutter_Front_" .. tostring(windowIndex) .. "_L", Vector3.new(0.8, 2.2, 0.3), CFrame.new(xOffset - 1.8, windowY, frontZ - 0.2), trim, Enum.Material.Wood, false)
				makePart(model, "Shutter_Front_" .. tostring(windowIndex) .. "_R", Vector3.new(0.8, 2.2, 0.3), CFrame.new(xOffset + 1.8, windowY, frontZ - 0.2), trim, Enum.Material.Wood, false)
			elseif styleKey == "arched" then
				makePart(model, "WindowArch_Front_" .. tostring(windowIndex), Vector3.new(3.4, 0.6, 0.5), CFrame.new(xOffset, windowY + 1.4, frontZ - 0.2), trim, Enum.Material.SmoothPlastic, false)
			end
		end
	end
	if windowIndex == 0 then
		-- Fallback: mindestens ein Frontfenster oberhalb der Tür, damit jedes Haus Fenster zeigt.
		makePart(model, "Window_Front_Top", Vector3.new(2.6, 1.6, 0.4), CFrame.new(dx, height - 1.2, frontZ - 0.2), glass, Enum.Material.Glass, false)
	end
	makePart(model, "Window_Side_L", Vector3.new(0.4, 2.2, 2.6), CFrame.new(-sizeX / 2 - 0.2, windowY, 0), glass, Enum.Material.Glass, false)
	makePart(model, "Window_Side_R", Vector3.new(0.4, 2.2, 2.6), CFrame.new(sizeX / 2 + 0.2, windowY, 0), glass, Enum.Material.Glass, false)

	-- Eindeutige Dekoration, Türkorridor (|x - dx| < 2.2, vor der Front) bleibt frei.
	local decorKey = string.lower(decoration)
	if decorKey == "flowers" then
		for _, side in { -1, 1 } do
			local px = dx + side * 4.2
			makePart(model, "Decor_FlowerPot_" .. tostring(side), Vector3.new(1, 1, 1), CFrame.new(px, 0.5, frontZ - 1.5), Color3.fromRGB(120, 70, 40), Enum.Material.Concrete, false)
			makePart(model, "Decor_Flower_" .. tostring(side), Vector3.new(0.8, 0.8, 0.8), CFrame.new(px, 1.3, frontZ - 1.5), Color3.fromRGB(220, 80, 90), Enum.Material.SmoothPlastic, false)
		end
	elseif decorKey == "balcony" then
		local balconyY = math.min(5.8, height - 0.6)
		makePart(model, "Decor_Balcony", Vector3.new(5, 0.5, 2), CFrame.new(dx, balconyY, frontZ - 1.0), trim, Enum.Material.WoodPlanks, true)
		for _, offset in { -2.2, 0, 2.2 } do
			makePart(model, "Decor_BalconyPost_" .. tostring(offset), Vector3.new(0.3, 1.2, 0.3), CFrame.new(dx + offset, balconyY + 0.8, frontZ - 1.9), trim, Enum.Material.Wood, false)
		end
	elseif decorKey == "shutters" then
		makePart(model, "Decor_Shutter_L", Vector3.new(0.3, 2.2, 0.9), CFrame.new(-sizeX / 2 - 0.35, windowY, -1.8), trim, Enum.Material.Wood, false)
		makePart(model, "Decor_Shutter_R", Vector3.new(0.3, 2.2, 0.9), CFrame.new(sizeX / 2 + 0.35, windowY, -1.8), trim, Enum.Material.Wood, false)
		makePart(model, "Decor_Shutter_L2", Vector3.new(0.3, 2.2, 0.9), CFrame.new(-sizeX / 2 - 0.35, windowY, 1.8), trim, Enum.Material.Wood, false)
		makePart(model, "Decor_Shutter_R2", Vector3.new(0.3, 2.2, 0.9), CFrame.new(sizeX / 2 + 0.35, windowY, 1.8), trim, Enum.Material.Wood, false)
	elseif decorKey == "garden" then
		local gx = sizeX / 2 + 4.5
		makePart(model, "Decor_GardenBed", Vector3.new(6, 0.3, 5), CFrame.new(gx, 0.15, 2), Color3.fromRGB(90, 160, 80), Enum.Material.Grass, false)
		for _, offset in { -2.5, 2.5 } do
			makePart(model, "Decor_GardenPost_" .. tostring(offset), Vector3.new(0.4, 1.4, 0.4), CFrame.new(gx + offset, 0.7, -0.5), Color3.fromRGB(110, 75, 45), Enum.Material.Wood, false)
		end
	else
		makePart(model, "Decor_Trim", Vector3.new(sizeX + 0.2, 0.5, sizeZ + 0.2), CFrame.new(0, height - 0.3, 0), trim, Enum.Material.SmoothPlastic, false)
	end

	model:SetAttribute("HouseId", id)
	model:SetAttribute("VillageId", villageId)
	if signature ~= "" then
		model:SetAttribute("DesignSignature", signature)
	end

	return model
end

return BuildingFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">ChurchBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- ChurchBuilder: genau eine dekorierte Dorfkirche.
-- Position, Drehung und Grundflaeche stammen aus WorldLayout.CHURCH,
-- die Bodenhoehe aus TerrainHeight. Keine globalen Variablen.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldLayout = requireSibling("WorldLayout")
local TerrainHeight = requireSibling("TerrainHeight")

local ChurchBuilder = {}

local WALL_COLOR = Color3.fromRGB(235, 230, 220)
local ROOF_COLOR = Color3.fromRGB(140, 60, 50)
local TRIM_COLOR = Color3.fromRGB(170, 170, 165)
local DOOR_COLOR = Color3.fromRGB(110, 70, 40)
local WINDOW_COLOR = Color3.fromRGB(170, 210, 230)
local CROSS_COLOR = Color3.fromRGB(210, 180, 80)

local function makePart(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	canCollide: boolean
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = canCollide
	part.Parent = parent
	return part
end

-- Erzeugt genau ein Kirchen-Model an der vorgesehenen Position.
function ChurchBuilder.build(parent: Instance): Model
	local church = WorldLayout.CHURCH
	local groundY = TerrainHeight.heightAt(church.position.x, church.position.z)
	local base = CFrame.new(Vector3.new(church.position.x, groundY, church.position.z))
		* CFrame.Angles(0, math.rad(church.yaw), 0)

	local model = Instance.new("Model")
	model.Name = church.id

	-- Hauptschiff (12 x 7 x 20), leicht nach hinten versetzt fuer den Turm.
	local nave = makePart(model, "Nave", Vector3.new(12, 7, 20), base * CFrame.new(0, 3.5, 2), WALL_COLOR, true)

	-- Eigenstaendiges Satteldach: zwei geneigte Platten plus Firstbalken.
	local roofAngle = math.rad(35)
	makePart(model, "RoofLeft", Vector3.new(7, 0.4, 21), base * (CFrame.new(-2.9, 8.7, 2) * CFrame.Angles(0, 0, roofAngle)), ROOF_COLOR, true)
	makePart(model, "RoofRight", Vector3.new(7, 0.4, 21), base * (CFrame.new(2.9, 8.7, 2) * CFrame.Angles(0, 0, -roofAngle)), ROOF_COLOR, true)
	makePart(model, "RoofRidge", Vector3.new(0.6, 0.6, 21), base * CFrame.new(0, 10.3, 2), ROOF_COLOR, true)

	-- Turm an der Vorderseite mit eigenstaendigem Zeltdach.
	makePart(model, "Tower", Vector3.new(6, 14, 6), base * CFrame.new(0, 7, -10), WALL_COLOR, true)
	makePart(model, "TowerRoof", Vector3.new(7, 2.5, 7), base * CFrame.new(0, 15.2, -10), ROOF_COLOR, true)
	makePart(model, "TowerSpire", Vector3.new(4, 2, 4), base * CFrame.new(0, 17.4, -10), ROOF_COLOR, true)

	-- Zurueckhaltender Fassadenschmuck: goldenes Kreuz auf der Spitze.
	makePart(model, "CrossVertical", Vector3.new(0.4, 2.2, 0.4), base * CFrame.new(0, 19.5, -10), CROSS_COLOR, false)
	makePart(model, "CrossHorizontal", Vector3.new(1.4, 0.4, 0.4), base * CFrame.new(0, 19.7, -10), CROSS_COLOR, false)

	-- Klar erkennbares Portal: Pfosten, Sturz, Stufe und Eingangstuer.
	makePart(model, "PortalFrameLeft", Vector3.new(1, 6, 1), base * CFrame.new(-2, 3, -13), TRIM_COLOR, true)
	makePart(model, "PortalFrameRight", Vector3.new(1, 6, 1), base * CFrame.new(2, 3, -13), TRIM_COLOR, true)
	makePart(model, "PortalLintel", Vector3.new(5, 1, 1), base * CFrame.new(0, 6, -13), TRIM_COLOR, true)
	makePart(model, "PortalSteps", Vector3.new(6, 0.4, 3), base * CFrame.new(0, 0.2, -14.5), TRIM_COLOR, true)
	local door = makePart(model, "EntranceDoor", Vector3.new(3, 5, 0.6), base * CFrame.new(0, 2.5, -13), DOOR_COLOR, false)
	door:SetAttribute("IsChurchEntrance", true)

	-- Zurueckhaltende Fenster: Rosette ueber dem Portal, je zwei Seitenfenster.
	makePart(model, "RoseWindow", Vector3.new(2.4, 2.4, 0.4), base * CFrame.new(0, 8.5, -13.1), WINDOW_COLOR, false)
	makePart(model, "WindowLeft1", Vector3.new(0.4, 2.5, 2), base * CFrame.new(-6.1, 4, -2), WINDOW_COLOR, false)
	makePart(model, "WindowLeft2", Vector3.new(0.4, 2.5, 2), base * CFrame.new(-6.1, 4, 5), WINDOW_COLOR, false)
	makePart(model, "WindowRight1", Vector3.new(0.4, 2.5, 2), base * CFrame.new(6.1, 4, -2), WINDOW_COLOR, false)
	makePart(model, "WindowRight2", Vector3.new(0.4, 2.5, 2), base * CFrame.new(6.1, 4, 5), WINDOW_COLOR, false)

	model:SetAttribute("IsChurch", true)
	model:SetAttribute("ChurchId", church.id)
	model:SetAttribute("PoiKind", "church")
	model.PrimaryPart = nave
	model.Parent = parent
	return model
end

return ChurchBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">ConiferFactory</string>
            <string name="Source">--!strict
-- ConiferFactory: spitzige Low-Poly-Tannen aus einfachen Roblox-Parts.
-- Keine Instanzen ausserhalb des Models, keine Skripte, keine externen Mesh-IDs.
-- Deterministisch aus `seed`; `scale` ist optional (Standard 1).

local ConiferFactory = {}

local function makePart(name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, canCollide: boolean): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = canCollide
	return part
end

function ConiferFactory.create(seed: number, scale: number?): Model
	local rng = Random.new(seed)
	local s = if scale == nil then 1 else scale
	if s &lt;= 0 then
		s = 1
	end

	local model = Instance.new("Model")
	model.Name = "Conifer"

	-- Stamm: schlank, braun, leicht variiert.
	local trunkHeight = (7 + rng:NextNumber() * 5) * s
	local trunkDiameter = (0.5 + rng:NextNumber() * 0.35) * s
	local trunkColor = Color3.fromRGB(
		85 + math.floor(rng:NextNumber() * 25),
		50 + math.floor(rng:NextNumber() * 20),
		25 + math.floor(rng:NextNumber() * 15)
	)
	local trunk = makePart(
		"Trunk",
		Vector3.new(trunkHeight, trunkDiameter, trunkDiameter),
		CFrame.new(0, trunkHeight / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		trunkColor,
		Enum.Material.Wood,
		true
	)
	trunk.Parent = model

	-- Kronen: mehrere gestaffelte, spitz zulaufende Stufen.
	local crownCount = 3 + math.floor(rng:NextNumber() * 2) -- 3 oder 4
	local baseRadius = (1.9 + rng:NextNumber() * 1.1) * s

	for c = 0, crownCount - 1 do
		local t = if crownCount &gt; 1 then c / (crownCount - 1) else 0
		local crownBaseY = trunkHeight * (0.32 + 0.42 * t)
		local crownRadius = baseRadius * (1.05 - 0.62 * t) * (0.88 + rng:NextNumber() * 0.24)
		local tiers = 3 + math.floor(rng:NextNumber() * 2) -- 3 oder 4
		local tierHeight = (0.55 + rng:NextNumber() * 0.3) * s

		for i = 0, tiers - 1 do
			local frac = if tiers &gt; 1 then i / (tiers - 1) else 0
			local halfExtent = crownRadius * (1 - frac * 0.88)
			if halfExtent &lt; 0.15 * s then
				halfExtent = 0.15 * s
			end
			local y = crownBaseY + i * tierHeight
			local rotation = math.rad((i % 2) * 45 + math.floor(rng:NextNumber() * 12))
			local green = Color3.fromRGB(
				28 + math.floor(rng:NextNumber() * 22),
				88 + math.floor(rng:NextNumber() * 52),
				22 + math.floor(rng:NextNumber() * 18)
			)
			local crownPart = makePart(
				"Crown",
				Vector3.new(halfExtent * 2, tierHeight, halfExtent * 2),
				CFrame.new(0, y, 0) * CFrame.Angles(0, rotation, 0),
				green,
				Enum.Material.SmoothPlastic,
				false
			)
			crownPart.Parent = model
		end
	end

	model.PrimaryPart = trunk
	return model
end

return ConiferFactory</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">DonerShopBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- DonerShopBuilder: zentraler Doener Laden am Doenerplatz.
-- Reine Bau-Funktion ohne Preise, Belohen oder Gameplaylogik.
-- Position und Abholpunkt stammen aus WorldLayout, Hoehen aus TerrainHeight.
-- Keine globalen Variablen, keine externen Assets.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldLayout = requireSibling("WorldLayout")
local TerrainHeight = requireSibling("TerrainHeight")

local DonerShopBuilder = {}

local SHOP_NAME = "DonerShop"
local SIGN_TEXT = "Döner Laden"
local PICKUP_NAME = "Delivery_Doner_Pickup"

local function makePart(
	parent: Instance,
	name: string,
	size: Vector3,
	position: Vector3,
	color: Color3,
	canCollide: boolean,
	transparency: number?,
	material: Enum.Material?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Position = position
	part.Color = color
	if material ~= nil then
		part.Material = material
	else
		part.Material = Enum.Material.SmoothPlastic
	end
	if transparency ~= nil then
		part.Transparency = transparency
	end
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = canCollide
	part.Parent = parent
	return part
end

local function makeSignGui(face: Enum.NormalId, adornee: Part): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = "DonerSignGui"
	gui.Face = face
	gui.CanvasSize = Vector2.new(800, 150)
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Name = "DonerSignLabel"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.4
	label.Text = SIGN_TEXT
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(120, 0, 0)
	stroke.Parent = label
	gui.Parent = adornee
	return gui
end

-- Erzeugt den Doener Laden am zentralen Doenerplatz und gibt das Model zurueck.
-- Enthaelt Eingangstuer, Schaufenster, Beleuchtung, lesbares Schild und einen
-- kompatiblen Abholpunkt fuer Lieferungen (IsDeliveryPoint-Attribut).
function DonerShopBuilder.build(parent: Instance): Model
	local donerCenter: any = WorldLayout.DONER.position
	local pickup: any = WorldLayout.DONER.pickupPosition
	local centerX: number = donerCenter.x
	local centerZ: number = donerCenter.z
	local pickupX: number = pickup.x
	local pickupZ: number = pickup.z

	local groundY = TerrainHeight.heightAt(centerX, centerZ)
	local pickupGroundY = TerrainHeight.heightAt(pickupX, pickupZ)

	local model = Instance.new("Model")
	model.Name = SHOP_NAME
	model:SetAttribute("PoiKind", "Doner")
	model:SetAttribute("IsDonerShop", true)

	local wallColor = Color3.fromRGB(235, 220, 190)
	local trimColor = Color3.fromRGB(150, 30, 30)
	local roofColor = Color3.fromRGB(120, 25, 25)
	local floorColor = Color3.fromRGB(170, 165, 155)
	local doorColor = Color3.fromRGB(110, 70, 40)
	local glassColor = Color3.fromRGB(170, 220, 240)
	local lightFixtureColor = Color3.fromRGB(255, 250, 220)

	local wallHeight = 7
	local halfWidth = 10
	local halfDepth = 7
	local wallThickness = 1

	-- Fundamentplatte, Oberkante ist der Ladenboden.
	local floorPart = makePart(
		model,
		"Floor",
		Vector3.new(22, 1, 16),
		Vector3.new(centerX, groundY + 0.5, centerZ),
		floorColor,
		true
	)
	local floorTop = groundY + 1
	local wallCenterY = floorTop + wallHeight / 2
	local frontZ = centerZ + halfDepth - wallThickness / 2
	local backZ = centerZ - halfDepth + wallThickness / 2

	-- Rueckwand und Seitenwaende (geschlossen).
	makePart(
		model,
		"Wall_Back",
		Vector3.new(halfWidth * 2, wallHeight, wallThickness),
		Vector3.new(centerX, wallCenterY, backZ),
		wallColor,
		true
	)
	makePart(
		model,
		"Wall_Left",
		Vector3.new(wallThickness, wallHeight, halfDepth * 2),
		Vector3.new(centerX - halfWidth + wallThickness / 2, wallCenterY, centerZ),
		wallColor,
		true
	)
	makePart(
		model,
		"Wall_Right",
		Vector3.new(wallThickness, wallHeight, halfDepth * 2),
		Vector3.new(centerX + halfWidth - wallThickness / 2, wallCenterY, centerZ),
		wallColor,
		true
	)

	-- Vorderwand mit Türoeffnung (4 breit, 5.5 hoch, mittig).
	local doorWidth = 4
	local doorHeight = 5.5
	local sideWidth = (halfWidth * 2 - doorWidth) / 2
	makePart(
		model,
		"Wall_FrontLeft",
		Vector3.new(sideWidth, wallHeight, wallThickness),
		Vector3.new(centerX - doorWidth / 2 - sideWidth / 2, wallCenterY, frontZ),
		wallColor,
		true
	)
	makePart(
		model,
		"Wall_FrontRight",
		Vector3.new(sideWidth, wallHeight, wallThickness),
		Vector3.new(centerX + doorWidth / 2 + sideWidth / 2, wallCenterY, frontZ),
		wallColor,
		true
	)
	makePart(
		model,
		"Wall_FrontLintel",
		Vector3.new(doorWidth, wallHeight - doorHeight, wallThickness),
		Vector3.new(centerX, floorTop + doorHeight + (wallHeight - doorHeight) / 2, frontZ),
		wallColor,
		true
	)

	-- Klare Eingangstuer (begehbar: CanCollide false, frei erreichbar).
	makePart(
		model,
		"EntranceDoor",
		Vector3.new(doorWidth, doorHeight, 0.5),
		Vector3.new(centerX, floorTop + doorHeight / 2, frontZ),
		doorColor,
		false,
		0.15,
		Enum.Material.WoodPlanks
	)
	-- Tuerrahmen.
	makePart(
		model,
		"DoorFrame_Left",
		Vector3.new(0.5, doorHeight, 1.2),
		Vector3.new(centerX - doorWidth / 2, floorTop + doorHeight / 2, frontZ),
		trimColor,
		true
	)
	makePart(
		model,
		"DoorFrame_Right",
		Vector3.new(0.5, doorHeight, 1.2),
		Vector3.new(centerX + doorWidth / 2, floorTop + doorHeight / 2, frontZ),
		trimColor,
		true
	)

	-- Schaufenster links und rechts der Tuer (Glas, gut sichtbar).
	local windowY = floorTop + 3
	makePart(
		model,
		"ShopWindow_Left",
		Vector3.new(5, 3, 0.4),
		Vector3.new(centerX - doorWidth / 2 - sideWidth / 2, windowY, frontZ + 0.2),
		glassColor,
		true,
		0.35,
		Enum.Material.Glass
	)
	makePart(
		model,
		"ShopWindow_Right",
		Vector3.new(5, 3, 0.4),
		Vector3.new(centerX + doorWidth / 2 + sideWidth / 2, windowY, frontZ + 0.2),
		glassColor,
		true,
		0.35,
		Enum.Material.Glass
	)
	-- Fensterrahmen als Blenden ueber dem Glas.
	makePart(
		model,
		"WindowTrim_Left",
		Vector3.new(5.6, 0.5, 0.5),
		Vector3.new(centerX - doorWidth / 2 - sideWidth / 2, windowY + 1.75, frontZ + 0.2),
		trimColor,
		false
	)
	makePart(
		model,
		"WindowTrim_Right",
		Vector3.new(5.6, 0.5, 0.5),
		Vector3.new(centerX + doorWidth / 2 + sideWidth / 2, windowY + 1.75, frontZ + 0.2),
		trimColor,
		false
	)

	-- Dach mit Ueberstand und Dachkante.
	makePart(
		model,
		"Roof",
		Vector3.new(22, 1, 16),
		Vector3.new(centerX, floorTop + wallHeight + 0.5, centerZ),
		roofColor,
		true
	)
	makePart(
		model,
		"RoofTrim",
		Vector3.new(22.4, 0.5, 16.4),
		Vector3.new(centerX, floorTop + wallHeight + 0.1, centerZ),
		trimColor,
		false
	)

	-- Beleuchtung: Deckenleuchte innen und Aussenlampe ueber dem Eingang.
	local ceilingLightPart = makePart(
		model,
		"CeilingLight",
		Vector3.new(4, 0.4, 2),
		Vector3.new(centerX, floorTop + wallHeight - 0.3, centerZ),
		lightFixtureColor,
		false,
		0,
		Enum.Material.Neon
	)
	local ceilingLight = Instance.new("PointLight")
	ceilingLight.Name = "InteriorLight"
	ceilingLight.Brightness = 2
	ceilingLight.Range = 45
	ceilingLight.Color = Color3.fromRGB(255, 245, 220)
	ceilingLight.Parent = ceilingLightPart

	local porchLightPart = makePart(
		model,
		"PorchLight",
		Vector3.new(2, 0.4, 0.6),
		Vector3.new(centerX, floorTop + doorHeight + 0.6, frontZ + 0.8),
		lightFixtureColor,
		false,
		0,
		Enum.Material.Neon
	)
	local porchLight = Instance.new("PointLight")
	porchLight.Name = "EntranceLight"
	porchLight.Brightness = 2
	porchLight.Range = 30
	porchLight.Color = Color3.fromRGB(255, 240, 200)
	porchLight.Parent = porchLightPart

	-- Grosses lesbares Schild mit exakt "Döner Laden" zur Abholseite (+Z).
	local signPart = makePart(
		model,
		"ShopSign",
		Vector3.new(16, 2.5, 0.6),
		Vector3.new(centerX, floorTop + wallHeight - 0.6, frontZ + 0.8),
		trimColor,
		false
	)
	makeSignGui(Enum.NormalId.Back, signPart)
	makeSignGui(Enum.NormalId.Front, signPart)

	-- Kompatibler Abholpunkt fuer Lieferungen (keine Preise, keine Logik).
	local pickupPad = makePart(
		model,
		PICKUP_NAME,
		Vector3.new(6, 0.4, 6),
		Vector3.new(pickupX, pickupGroundY + 0.2, pickupZ),
		Color3.fromRGB(220, 150, 60),
		false
	)
	pickupPad:SetAttribute("IsDeliveryPoint", true)
	pickupPad:SetAttribute("PickupKind", "doner")

	model.PrimaryPart = floorPart
	model.Parent = parent
	return model
end

return DonerShopBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">GarageFactory</string>
            <string name="Source">--!strict
-- GarageFactory: einzige, strikt identische Garagenvorlage fuer alle 15 Garagen.
-- Keine Besitzerfarbe, keine Tuninglogik, keine individuellen Groessen.
-- Nur Name und Anker-Attribut variieren; alle Abmessungen, Materialien, Farben
-- und die Teilezahl sind deterministisch identisch.

local GarageFactory = {}

local FLOOR_COLOR = Color3.fromRGB(145, 145, 150)
local WALL_COLOR = Color3.fromRGB(205, 205, 212)
local ROOF_COLOR = Color3.fromRGB(72, 74, 82)
local TRIM_COLOR = Color3.fromRGB(55, 57, 64)
local DOOR_COLOR = Color3.fromRGB(58, 60, 68)
local WINDOW_COLOR = Color3.fromRGB(175, 215, 235)
local FRAME_COLOR = Color3.fromRGB(120, 122, 130)
local LIFT_COLOR = Color3.fromRGB(210, 165, 55)
local LIFT_DARK = Color3.fromRGB(95, 95, 100)
local WORKSHOP_COLOR = Color3.fromRGB(60, 190, 110)
local LIGHT_COLOR = Color3.fromRGB(255, 245, 210)
local SIGN_COLOR = Color3.fromRGB(240, 240, 245)

local function makePart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	canCollide: boolean,
	transparency: number?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = canCollide
	if transparency ~= nil then
		part.Transparency = transparency :: number
	end
	return part
end

local function makeSurfaceText(parent: Part, text: string, color: Color3): ()
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignText"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(400, 120)
	gui.Parent = parent

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
end

function GarageFactory.create(anchorName: string): Model
	local name = if type(anchorName) == "string" and anchorName ~= "" then anchorName else "Garage"

	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("AnchorName", name)
	model:SetAttribute("GarageAnchor", name)
	model:SetAttribute("IsGarage", true)

	local halfW = 12
	local halfD = 10
	local wallH = 10
	local floorT = 1

	-- Bodenplatte.
	local floor = makePart("Floor", Vector3.new(halfW * 2, floorT, halfD * 2), CFrame.new(0, floorT / 2, 0), FLOOR_COLOR, Enum.Material.Concrete, true, nil)
	floor.Parent = model

	-- Seitenwaende (links/rechts).
	local leftWall = makePart("WallLeft", Vector3.new(1, wallH, halfD * 2), CFrame.new(-halfW + 0.5, floorT + wallH / 2, 0), WALL_COLOR, Enum.Material.SmoothPlastic, true, nil)
	leftWall.Parent = model
	local rightWall = makePart("WallRight", Vector3.new(1, wallH, halfD * 2), CFrame.new(halfW - 0.5, floorT + wallH / 2, 0), WALL_COLOR, Enum.Material.SmoothPlastic, true, nil)
	rightWall.Parent = model

	-- Rueckwand (mit Personeneingang).
	local backDoorW = 3
	local backSegW = (halfW * 2 - backDoorW) / 2
	local backLeft = makePart("WallBackLeft", Vector3.new(backSegW, wallH, 1), CFrame.new(-halfW + backSegW / 2 + 0.5, floorT + wallH / 2, -halfD + 0.5), WALL_COLOR, Enum.Material.SmoothPlastic, true, nil)
	backLeft.Parent = model
	local backRight = makePart("WallBackRight", Vector3.new(backSegW, wallH, 1), CFrame.new(halfW - backSegW / 2 - 0.5, floorT + wallH / 2, -halfD + 0.5), WALL_COLOR, Enum.Material.SmoothPlastic, true, nil)
	backRight.Parent = model
	local backLintel = makePart("WallBackLintel", Vector3.new(backDoorW, wallH - 7, 1), CFrame.new(0, floorT + 7 + (wallH - 7) / 2, -halfD + 0.5), WALL_COLOR, Enum.Material.SmoothPlastic, true, nil)
	backLintel.Parent = model

	-- Vorderwand (mit grossem Fahrzeugtor).
	local doorW = 10
	local frontSegW = (halfW * 2 - doorW) / 2
	local frontLeft = makePart("WallFrontLeft", Vector3.new(frontSegW, wallH, 1), CFrame.new(-halfW + frontSegW / 2 + 0.5, floorT + wallH / 2, halfD - 0.5), WALL_COLOR, Enum.Material.SmoothPlastic, true, nil)
	frontLeft.Parent = model
	local frontRight = makePart("WallFrontRight", Vector3.new(frontSegW, wallH, 1), CFrame.new(halfW - frontSegW / 2 - 0.5, floorT + wallH / 2, halfD - 0.5), WALL_COLOR, Enum.Material.SmoothPlastic, true, nil)
	frontRight.Parent = model
	local frontLintel = makePart("WallFrontLintel", Vector3.new(doorW, wallH - 8, 1), CFrame.new(0, floorT + 8 + (wallH - 8) / 2, halfD - 0.5), WALL_COLOR, Enum.Material.SmoothPlastic, true, nil)
	frontLintel.Parent = model

	-- Dachplatte mit Ueberstand.
	local roof = makePart("Roof", Vector3.new(halfW * 2 + 2, 1, halfD * 2 + 2), CFrame.new(0, floorT + wallH + 0.5, 0), ROOF_COLOR, Enum.Material.SmoothPlastic, true, nil)
	roof.Parent = model

	-- Dachkante.
	local trimFront = makePart("RoofTrimFront", Vector3.new(halfW * 2 + 2, 0.6, 0.6), CFrame.new(0, floorT + wallH + 1.0, halfD + 1.0), TRIM_COLOR, Enum.Material.SmoothPlastic, true, nil)
	trimFront.Parent = model
	local trimBack = makePart("RoofTrimBack", Vector3.new(halfW * 2 + 2, 0.6, 0.6), CFrame.new(0, floorT + wallH + 1.0, -halfD - 1.0), TRIM_COLOR, Enum.Material.SmoothPlastic, true, nil)
	trimBack.Parent = model
	local trimLeft = makePart("RoofTrimLeft", Vector3.new(0.6, 0.6, halfD * 2 + 2), CFrame.new(-halfW - 1.0, floorT + wallH + 1.0, 0), TRIM_COLOR, Enum.Material.SmoothPlastic, true, nil)
	trimLeft.Parent = model
	local trimRight = makePart("RoofTrimRight", Vector3.new(0.6, 0.6, halfD * 2 + 2), CFrame.new(halfW + 1.0, floorT + wallH + 1.0, 0), TRIM_COLOR, Enum.Material.SmoothPlastic, true, nil)
	trimRight.Parent = model

	-- Grosses Fahrzeugtor (Panel + Rahmen).
	local doorFrameLeft = makePart("VehicleDoorFrameLeft", Vector3.new(0.3, 8, 0.6), CFrame.new(-doorW / 2 - 0.15, floorT + 4, halfD - 0.2), FRAME_COLOR, Enum.Material.SmoothPlastic, true, nil)
	doorFrameLeft.Parent = model
	local doorFrameRight = makePart("VehicleDoorFrameRight", Vector3.new(0.3, 8, 0.6), CFrame.new(doorW / 2 + 0.15, floorT + 4, halfD - 0.2), FRAME_COLOR, Enum.Material.SmoothPlastic, true, nil)
	doorFrameRight.Parent = model
	local doorFrameTop = makePart("VehicleDoorFrameTop", Vector3.new(doorW + 0.6, 0.3, 0.6), CFrame.new(0, floorT + 8.15, halfD - 0.2), FRAME_COLOR, Enum.Material.SmoothPlastic, true, nil)
	doorFrameTop.Parent = model
	local vehicleDoor = makePart("VehicleDoor", Vector3.new(doorW, 8, 0.4), CFrame.new(0, floorT + 4, halfD - 0.05), DOOR_COLOR, Enum.Material.Metal, true, nil)
	vehicleDoor.Parent = model

	-- Separater Personeneingang (Panel + Rahmen).
	local personDoorW = backDoorW
	local personDoorH = 7
	local personFrameLeft = makePart("PersonDoorFrameLeft", Vector3.new(0.25, personDoorH, 0.6), CFrame.new(-personDoorW / 2 - 0.125, floorT + personDoorH / 2, -halfD + 0.2), FRAME_COLOR, Enum.Material.SmoothPlastic, true, nil)
	personFrameLeft.Parent = model
	local personFrameRight = makePart("PersonDoorFrameRight", Vector3.new(0.25, personDoorH, 0.6), CFrame.new(personDoorW / 2 + 0.125, floorT + personDoorH / 2, -halfD + 0.2), FRAME_COLOR, Enum.Material.SmoothPlastic, true, nil)
	personFrameRight.Parent = model
	local personFrameTop = makePart("PersonDoorFrameTop", Vector3.new(personDoorW + 0.5, 0.25, 0.6), CFrame.new(0, floorT + personDoorH + 0.125, -halfD + 0.2), FRAME_COLOR, Enum.Material.SmoothPlastic, true, nil)
	personFrameTop.Parent = model
	local personDoor = makePart("PersonDoor", Vector3.new(personDoorW, personDoorH, 0.35), CFrame.new(0, floorT + personDoorH / 2, -halfD + 0.05), DOOR_COLOR, Enum.Material.Metal, true, nil)
	personDoor.Parent = model
	local doorHandle = makePart("PersonDoorHandle", Vector3.new(0.15, 0.6, 0.15), CFrame.new(personDoorW / 2 - 0.35, floorT + personDoorH / 2, -halfD + 0.3), Color3.fromRGB(200, 180, 90), Enum.Material.Metal, true, nil)
	doorHandle.Parent = model

	-- Fenster (links und rechts), je Glas + Rahmen.
	local function addWindow(sideSign: number, namePrefix: string)
		local x = sideSign * (halfW - 0.6)
		local w = 4
		local h = 3
		local cy = floorT + 6
		local cz = 0
		local glass = makePart(namePrefix .. "Glass", Vector3.new(0.25, h, w), CFrame.new(x, cy, cz), WINDOW_COLOR, Enum.Material.Glass, false, 0.35)
		glass.Parent = model
		local ft = makePart(namePrefix .. "FrameTop", Vector3.new(0.3, 0.25, w + 0.5), CFrame.new(x, cy + h / 2 + 0.125, cz), FRAME_COLOR, Enum.Material.SmoothPlastic, true, nil)
		ft.Parent = model
		local fb = makePart(namePrefix .. "FrameBottom", Vector3.new(0.3, 0.25, w + 0.5), CFrame.new(x, cy - h / 2 - 0.125, cz), FRAME_COLOR, Enum.Material.SmoothPlastic, true, nil)
		fb.Parent = model
		local fl = makePart(namePrefix .. "FrameLeft", Vector3.new(0.3, h + 0.5, 0.25), CFrame.new(x, cy, cz - w / 2 - 0.125), FRAME_COLOR, Enum.Material.SmoothPlastic, true, nil)
		fl.Parent = model
		local fr = makePart(namePrefix .. "FrameRight", Vector3.new(0.3, h + 0.5, 0.25), CFrame.new(x, cy, cz + w / 2 + 0.125), FRAME_COLOR, Enum.Material.SmoothPlastic, true, nil)
		fr.Parent = model
	end
	addWindow(-1, "WindowLeft")
	addWindow(1, "WindowRight")

	-- Beleuchtung (2 Deckenleuchten).
	for i = 0, 1 do
		local z = if i == 0 then -4 else 4
		local housing = makePart("CeilingLight" .. tostring(i + 1) .. "Housing", Vector3.new(1.6, 0.25, 1.0), CFrame.new(0, floorT + wallH - 0.4, z), FRAME_COLOR, Enum.Material.SmoothPlastic, true, nil)
		housing.Parent = model
		local bulb = makePart("CeilingLight" .. tostring(i + 1) .. "Bulb", Vector3.new(1.2, 0.15, 0.7), CFrame.new(0, floorT + wallH - 0.7, z), LIGHT_COLOR, Enum.Material.Neon, false, 0.05)
		bulb.Parent = model
		local light = Instance.new("PointLight")
		light.Name = "Light"
		light.Color = LIGHT_COLOR
		light.Brightness = 2
		light.Range = 24
		light.Parent = bulb
	end

	-- Dekoration: Werkbank.
	local benchTop = makePart("WorkbenchTop", Vector3.new(6, 0.4, 2), CFrame.new(-7, floorT + 3.4, -7), Color3.fromRGB(170, 130, 85), Enum.Material.Wood, true, nil)
	benchTop.Parent = model
	local benchLegL = makePart("WorkbenchLegLeft", Vector3.new(0.3, 3.0, 0.3), CFrame.new(-9.7, floorT + 1.5, -7), Color3.fromRGB(110, 80, 50), Enum.Material.Wood, true, nil)
	benchLegL.Parent = model
	local benchLegR = makePart("WorkbenchLegRight", Vector3.new(0.3, 3.0, 0.3), CFrame.new(-4.3, floorT + 1.5, -7), Color3.fromRGB(110, 80, 50), Enum.Material.Wood, true, nil)
	benchLegR.Parent = model

	-- Dekoration: Werkzeugschrank.
	local cabinet = makePart("ToolCabinet", Vector3.new(2.2, 4.0, 1.6), CFrame.new(7, floorT + 2.0, -7), Color3.fromRGB(70, 95, 130), Enum.Material.Metal, true, nil)
	cabinet.Parent = model

	-- Dekoration: Feuerloescher.
	local extinguisher = makePart("FireExtinguisher", Vector3.new(0.5, 1.6, 0.5), CFrame.new(halfW - 1.0, floorT + 0.8, -2), Color3.fromRGB(210, 50, 45), Enum.Material.SmoothPlastic, true, nil)
	extinguisher.Parent = model

	-- Schild ueber dem Fahrzeugtor.
	local sign = makePart("GarageSign", Vector3.new(doorW, 2, 0.3), CFrame.new(0, floorT + wallH + 1.6, halfD - 0.2), SIGN_COLOR, Enum.Material.SmoothPlastic, true, nil)
	sign.Parent = model
	makeSurfaceText(sign, "GARAGE", Color3.fromRGB(40, 40, 45))

	-- Hebebuehne (Lift).
	local liftBase = makePart("LiftBase", Vector3.new(8, 0.3, 4), CFrame.new(0, 0.15, 2), LIFT_DARK, Enum.Material.Metal, true, nil)
	liftBase.Parent = model
	local pillarOffsets = { Vector3.new(-3.5, 0, -1.5), Vector3.new(3.5, 0, -1.5), Vector3.new(-3.5, 0, 1.5), Vector3.new(3.5, 0, 1.5) }
	for i, off in pillarOffsets do
		local pillar = makePart("LiftPillar" .. tostring(i), Vector3.new(0.4, 1.2, 0.4), CFrame.new(off.X, 0.15 + 0.3 + 0.6, off.Z + 2), LIFT_COLOR, Enum.Material.Metal, true, nil)
		pillar.Parent = model
	end
	local platform = makePart("LiftPlatform", Vector3.new(8, 0.5, 4), CFrame.new(0, 0.15 + 0.3 + 1.2 + 0.25, 2), LIFT_COLOR, Enum.Material.DiamondPlate, true, nil)
	platform.Parent = model
	local railLeft = makePart("LiftRailLeft", Vector3.new(0.2, 1.0, 4), CFrame.new(-4.1, 0.15 + 0.3 + 1.2 + 0.75, 2), LIFT_COLOR, Enum.Material.Metal, true, nil)
	railLeft.Parent = model
	local railRight = makePart("LiftRailRight", Vector3.new(0.2, 1.0, 4), CFrame.new(4.1, 0.15 + 0.3 + 1.2 + 0.75, 2), LIFT_COLOR, Enum.Material.Metal, true, nil)
	railRight.Parent = model
	local rampFront = makePart("LiftRampFront", Vector3.new(3, 0.25, 1.5), CFrame.new(0, 0.15 + 0.125, 2 + 2.75), LIFT_DARK, Enum.Material.Metal, true, nil)
	rampFront.Parent = model
	local rampBack = makePart("LiftRampBack", Vector3.new(3, 0.25, 1.5), CFrame.new(0, 0.15 + 0.125, 2 - 2.75), LIFT_DARK, Enum.Material.Metal, true, nil)
	rampBack.Parent = model

	-- Markierter Werkstattanker.
	local workshopAnchor = makePart("WorkshopAnchor", Vector3.new(2, 0.3, 2), CFrame.new(0, 0.15, 2), WORKSHOP_COLOR, Enum.Material.Neon, false, 0)
	workshopAnchor.Parent = model
	workshopAnchor:SetAttribute("IsWorkshopAnchor", true)
	workshopAnchor:SetAttribute("WorkshopAnchor", true)

	model.PrimaryPart = floor

	return model
end

return GarageFactory</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">GarageWorldBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- GarageWorldBuilder: platziert exakt 15 identische Garagen aus GarageFactory
-- an den Ankern aus WorldLayout.GARAGES. Die reine Platzierungsfunktion
-- `calculatePlacements` liefert Daten ohne Roblox-Instanzen und ist damit in
-- Studio und Lune testbar. Die Modelle entstehen erst in `build`.
-- Alle Garagen teilen denselben Doenerabstand und halten Mindestabstand zu
-- Strassen, Wasser und Gebaeuden ein. Keine unterschiedlichen Groessen,
-- Farben oder Zusatzvorteile; keine globalen Variablen.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldLayout = requireSibling("WorldLayout")
local TerrainHeight = requireSibling("TerrainHeight")

local GarageWorldBuilder = {}

export type PlacementPosition = { x: number, y: number, z: number }

export type Placement = {
	id: string,
	name: string,
	anchorName: string,
	position: PlacementPosition,
	yaw: number,
	angleDegrees: number,
}

-- Exakt 15 Garagen, ein Platz je Spieler bei maximal 15 Spielern.
GarageWorldBuilder.COUNT = 15
GarageWorldBuilder.FOLDER_NAME = "Garages"

-- Die Garage steht mit ihrer Bodenplatte (Dicke 1) auf dem Gelaende.
GarageWorldBuilder.FLOOR_THICKNESS = 1

-- Reine Platzierungsdaten: deterministisch, ohne Roblox-Instanzen.
function GarageWorldBuilder.calculatePlacements(): { Placement }
	local garages = WorldLayout.GARAGES
	assert(
		#garages == GarageWorldBuilder.COUNT,
		string.format("GarageWorldBuilder erwartet %d Garagen, gefunden: %d", GarageWorldBuilder.COUNT, #garages)
	)

	local placements: { Placement } = {}
	for _, garage in garages do
		local x = garage.position.x
		local z = garage.position.z
		placements[#placements + 1] = {
			id = garage.id,
			name = garage.name,
			anchorName = garage.id,
			position = {
				x = x,
				y = TerrainHeight.heightAt(x, z),
				z = z,
			},
			yaw = garage.yaw,
			angleDegrees = garage.angleDegrees,
		}
	end
	return placements
end

-- Erzeugt alle Garagen unter einem benannten Ordner und gibt ihn zurueck.
function GarageWorldBuilder.build(parent: Instance): Folder
	-- GarageFactory verwendet Roblox-Datentypen auf Modulebene; der Require
	-- erfolgt deshalb erst beim tatsaechlichen Bau.
	local GarageFactory = requireSibling("GarageFactory")

	local folder = Instance.new("Folder")
	folder.Name = GarageWorldBuilder.FOLDER_NAME

	local floorOffset = GarageWorldBuilder.FLOOR_THICKNESS / 2

	for index, placement in GarageWorldBuilder.calculatePlacements() do
		local model = GarageFactory.create(placement.anchorName)
		model.Name = placement.id
		model:SetAttribute("GarageId", placement.id)
		model:SetAttribute("GarageIndex", index)
		model:SetAttribute("AnchorName", placement.anchorName)
		model:SetAttribute("AngleDegrees", placement.angleDegrees)
		model:PivotTo(
			CFrame.new(placement.position.x, placement.position.y + floorOffset, placement.position.z)
				* CFrame.Angles(0, math.rad(placement.yaw), 0)
		)
		model.Parent = folder
	end

	folder.Parent = parent
	return folder
end

return GarageWorldBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">GrassFieldBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- GrassFieldBuilder: deterministische, serverseitige Grasbueschel.
-- Die reine Platzierungsfunktion `calculateGrassClumps` liefert Daten ohne
-- Roblox-Instanzen und ist damit in Studio und Lune testbar. Die Modelle
-- entstehen erst in `build`.
-- Gras steht nur ausserhalb von Strassen, Wasser, Gebaeuden, Garagen und
-- Lieferpunkten mit Sicherheitsabstand. Die Gesamtzahl ist fuer 15 Spieler
-- begrenzt; jede Gruppe traegt den CollectionService-Tag `ToeffliGrass` und
-- eine Chunk-ID. Keine Animation, keine globalen Variablen.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldLayout = requireSibling("WorldLayout")
local WorldZones = requireSibling("WorldZones")
local TerrainHeight = requireSibling("TerrainHeight")

local GrassFieldBuilder = {}

export type ClumpPosition = { x: number, y: number, z: number }

export type GrassClump = {
	position: ClumpPosition,
	chunkId: string,
	yaw: number,
	scale: number,
	seed: number,
}

-- Obergrenze fuer 15 Spieler: begrenzt Teilezahl und Streaming-Last.
GrassFieldBuilder.MAX_CLUMPS = 1500
-- Kantenlaenge eines Gras-Chunks (Studs). Die Chunk-ID gruppiert spaetere
-- clientseitige Bewegung, ohne dass Server-CFrames veraendert werden.
GrassFieldBuilder.CHUNK_SIZE = 40
-- Mindestabstand zwischen zwei Grasbuescheln (Studs).
GrassFieldBuilder.MIN_SPACING = 2.5
-- Sicherheitsabstand zu Fahrbahnen, Wasser, Gebaeuden, Garagen und
-- Lieferpunkten (Studs).
GrassFieldBuilder.CLEARANCE = 5
-- Zusaetzlicher Abstand zu Lieferpads, damit der Loop frei bleibt (Studs).
GrassFieldBuilder.DELIVERY_CLEARANCE = 8
-- Gras waechst nur auf flachen bis leicht geneigten Talflaechen.
GrassFieldBuilder.MAX_SLOPE = 0.6
-- Kurze Halme: maximale Halmhoehe inklusive Skalierung (Studs).
GrassFieldBuilder.BLADE_HEIGHT = 0.7
GrassFieldBuilder.MIN_SCALE = 0.75
GrassFieldBuilder.MAX_SCALE = 1.25
GrassFieldBuilder.TAG_NAME = "ToeffliGrass"
GrassFieldBuilder.FOLDER_NAME = "GrassFields"

-- Deterministischer Pseudozufall (Lehmer-LCG), unabhaengig von Roblox.
local function createRandom(seed: number): () -> number
	local state = seed % 2147483647
	if state <= 0 then
		state += 2147483646
	end
	return function(): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
end

local function distance2D(ax: number, az: number, bx: number, bz: number): number
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end

-- Punkt in einem gedrehten Rechteck (yaw um die Y-Achse in Grad).
local function rectContains(
	px: number,
	pz: number,
	center: ClumpPosition,
	sizeX: number,
	sizeZ: number,
	yawDegrees: number,
	margin: number
): boolean
	local yaw = math.rad(yawDegrees)
	local cosYaw = math.cos(yaw)
	local sinYaw = math.sin(yaw)
	local dx = px - center.x
	local dz = pz - center.z
	local localX = dx * cosYaw + dz * sinYaw
	local localZ = -dx * sinYaw + dz * cosYaw
	return math.abs(localX) <= sizeX / 2 + margin and math.abs(localZ) <= sizeZ / 2 + margin
end

-- Wasser hat keine Margin-API: Kandidat plus acht Randpunkte pruefen.
local function waterNear(px: number, pz: number, margin: number): boolean
	if WorldZones.containsWater({ x = px, y = 0, z = pz }) then
		return true
	end
	for angleIndex = 0, 7 do
		local angle = math.rad(angleIndex * 45)
		local x = px + math.cos(angle) * margin
		local z = pz + math.sin(angle) * margin
		if WorldZones.containsWater({ x = x, y = 0, z = z }) then
			return true
		end
	end
	return false
end

-- Ausschlusszonen: Strassen, Wasser, Gebaeude (Haus-Slots, Kirche,
-- Doenerplatz), Garagen und Lieferpunkte. Waelder und Weiden bleiben
-- bewusst begehbar und duerfen Gras tragen.
local function isExcluded(px: number, pz: number, margin: number): boolean
	local point = { x = px, y = 0, z = pz }

	if WorldZones.isRoad(point, margin) then
		return true
	end
	if waterNear(px, pz, margin) then
		return true
	end

	for _, village in WorldLayout.VILLAGES do
		for _, slot in village.slots do
			if rectContains(px, pz, slot.position, slot.footprint.x, slot.footprint.z, slot.yaw, margin) then
				return true
			end
		end
	end

	local church = WorldLayout.CHURCH
	if rectContains(px, pz, church.position, church.footprint.x, church.footprint.z, church.yaw, margin) then
		return true
	end

	local doner = WorldLayout.DONER
	if distance2D(px, pz, doner.position.x, doner.position.z) <= doner.radius + margin then
		return true
	end

	for _, garage in WorldLayout.GARAGES do
		if distance2D(px, pz, garage.position.x, garage.position.z) <= WorldZones.GARAGE_RADIUS + margin then
			return true
		end
	end

	for _, deliveryPoint in WorldLayout.getDeliveryPoints() do
		local deliveryPosition = deliveryPoint.position
		if distance2D(px, pz, deliveryPosition.x, deliveryPosition.z) <= GrassFieldBuilder.DELIVERY_CLEARANCE then
			return true
		end
	end

	return false
end

local function tooClose(clumps: { GrassClump }, px: number, pz: number, spacing: number): boolean
	for _, clump in clumps do
		if distance2D(px, pz, clump.position.x, clump.position.z) < spacing then
			return true
		end
	end
	return false
end

local function chunkIdFor(px: number, pz: number): string
	local chunkX = math.floor(px / GrassFieldBuilder.CHUNK_SIZE)
	local chunkZ = math.floor(pz / GrassFieldBuilder.CHUNK_SIZE)
	return string.format("GrassChunk_%d_%d", chunkX, chunkZ)
end

-- Reine Platzierungsdaten: deterministisch, ohne Roblox-Instanzen.
function GrassFieldBuilder.calculateGrassClumps(): { GrassClump }
	local clumps: { GrassClump } = {}

	local bounds = WorldZones.BOUNDS
	local chunkSize = GrassFieldBuilder.CHUNK_SIZE
	local minChunkX = math.floor(bounds.minX / chunkSize)
	local maxChunkX = math.floor(bounds.maxX / chunkSize)
	local minChunkZ = math.floor(bounds.minZ / chunkSize)
	local maxChunkZ = math.floor(bounds.maxZ / chunkSize)
	local targetPerChunk = 3
	local maxAttempts = targetPerChunk * 8

	for chunkX = minChunkX, maxChunkX do
		for chunkZ = minChunkZ, maxChunkZ do
			-- Eigener Zufallsstrom je Chunk: reproduzierbar und unabhaengig
			-- von der Reihenfolge anderer Chunks.
			local random = createRandom(
				WorldZones.SEED + chunkX * 73856093 + chunkZ * 19349663
			)
			local placed = 0
			local attempts = 0

			while placed < targetPerChunk and attempts < maxAttempts do
				attempts += 1
				local px = chunkX * chunkSize + random() * chunkSize
				local pz = chunkZ * chunkSize + random() * chunkSize

				if
					px >= bounds.minX
					and px <= bounds.maxX
					and pz >= bounds.minZ
					and pz <= bounds.maxZ
					and not isExcluded(px, pz, GrassFieldBuilder.CLEARANCE)
					and TerrainHeight.slopeAt(px, pz) <= GrassFieldBuilder.MAX_SLOPE
					and not tooClose(clumps, px, pz, GrassFieldBuilder.MIN_SPACING)
				then
					local scale = GrassFieldBuilder.MIN_SCALE
						+ random() * (GrassFieldBuilder.MAX_SCALE - GrassFieldBuilder.MIN_SCALE)
					clumps[#clumps + 1] = {
						position = {
							x = px,
							y = TerrainHeight.heightAt(px, pz),
							z = pz,
						},
						chunkId = chunkIdFor(px, pz),
						yaw = random() * 360,
						scale = scale,
						seed = 9000 + (#clumps + 1) * 37,
					}
					placed += 1
				end
			end
		end
	end

	-- Gleichmaessig ueber das Tal verteilen, falls mehr Kandidaten als das
	-- Budget fuer 15 Spieler entstanden sind.
	if #clumps > GrassFieldBuilder.MAX_CLUMPS then
		local random = createRandom(WorldZones.SEED + 424242)
		for index = #clumps, 2, -1 do
			local swapIndex = 1 + math.floor(random() * index)
			clumps[index], clumps[swapIndex] = clumps[swapIndex], clumps[index]
		end
		for index = #clumps, GrassFieldBuilder.MAX_CLUMPS + 1, -1 do
			clumps[index] = nil
		end
	end

	return clumps
end

-- Erzeugt ein kurzes Grasbueschel aus drei gekreuzten Halmen.
local function buildClumpModel(clump: GrassClump): Model
	local model = Instance.new("Model")
	model.Name = "GrassClump"

	local random = createRandom(clump.seed)
	local baseYaw = math.rad(clump.yaw)
	local height = GrassFieldBuilder.BLADE_HEIGHT * clump.scale
	local green = 110 + math.floor(random() * 50)
	local color = Color3.fromRGB(
		60 + math.floor(random() * 20),
		green,
		55 + math.floor(random() * 20)
	)

	local firstBlade: Part? = nil

	for bladeIndex = 1, 3 do
		local bladeHeight = height * (0.8 + random() * 0.4)
		local angle = baseYaw + (bladeIndex - 1) * (math.pi / 3)
		local tilt = (random() * 2 - 1) * 0.12
		local blade = Instance.new("Part")
		blade.Name = string.format("Blade_%d", bladeIndex)
		blade.Size = Vector3.new(0.14, bladeHeight, 0.5)
		blade.CFrame = CFrame.new(clump.position.x, clump.position.y + bladeHeight / 2 - 0.03, clump.position.z)
			* CFrame.Angles(0, angle, tilt)
		blade.Color = color
		blade.Material = Enum.Material.SmoothPlastic
		blade.Anchored = true
		blade.CanCollide = false
		blade.CanTouch = false
		blade.CanQuery = false
		blade.CastShadow = false
		blade.TopSurface = Enum.SurfaceType.Smooth
		blade.BottomSurface = Enum.SurfaceType.Smooth
		blade.Parent = model

		if firstBlade == nil then
			firstBlade = blade
		end
	end

	model.PrimaryPart = firstBlade
	model:SetAttribute("IsGrass", true)
	model:SetAttribute("ChunkId", clump.chunkId)
	model:SetAttribute("GrassSeed", clump.seed)
	model:SetAttribute("GrassScale", clump.scale)
	return model
end

-- Erzeugt alle Grasbueschel unter einem benannten Ordner und gibt ihn zurueck.
function GrassFieldBuilder.build(parent: Instance): Folder
	-- CollectionService erst beim tatsaechlichen Bau holen, damit das Modul
	-- auch ohne Roblox-Laufzeit (Lune-Tests) geladen werden kann.
	local CollectionService = game:GetService("CollectionService")

	local folder = Instance.new("Folder")
	folder.Name = GrassFieldBuilder.FOLDER_NAME

	for index, clump in GrassFieldBuilder.calculateGrassClumps() do
		local model = buildClumpModel(clump)
		model.Name = string.format("GrassClump_%04d", index)
		CollectionService:AddTag(model, GrassFieldBuilder.TAG_NAME)
		model.Parent = folder
	end

	folder.Parent = parent
	return folder
end

return GrassFieldBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">IntersectionBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- IntersectionBuilder: Stopstrassen mit Haltelinie sowie flache, befahrbare Kreisel.
-- Baut alle Stopstrassen (STOP_ROADS) und Kreisel (ROUNDABOUTS) aus WorldZones.
-- Stopstrassen folgen dem Terrain und besitzen eine gut sichtbare Haltelinie.
-- Kreisel sind flach (eine Hoehe), befahrbar und enthalten keinen Mittelstreifen.
-- Keine Bruecken, keine Verkehrszeichen.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldZones = requireSibling("WorldZones")
local TerrainHeight = requireSibling("TerrainHeight")

local IntersectionBuilder = {}

local ROAD_COLOR = Color3.fromRGB(70, 70, 75)
local LINE_COLOR = Color3.fromRGB(240, 240, 240)
local ROAD_THICKNESS = 1
local ROAD_Y_OFFSET = 0.6
local STOP_LINE_WIDTH_FACTOR = 0.8
local STOP_LINE_LENGTH = 1.2
local STOP_LINE_THICKNESS = 0.12
local STOP_LINE_LIFT = 0.08
local STEP_LENGTH = 12
local MAX_STEPS = 64
local JOINT_OVERLAP = 0.6

local function makePart(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	canCollide: boolean
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = canCollide
	part.CanQuery = false
	part.CanTouch = false
	part.Parent = parent
	return part
end

local function buildStopRoad(folder: Instance, road: any)
	local fromX: number = road.from.x
	local fromZ: number = road.from.z
	local toX: number = road.to.x
	local toZ: number = road.to.z
	local width: number = road.width
	local dx = toX - fromX
	local dz = toZ - fromZ
	local length2D = math.sqrt(dx * dx + dz * dz)
	if length2D < 0.1 then
		return
	end
	local steps = math.clamp(math.ceil(length2D / STEP_LENGTH), 1, MAX_STEPS)
	for i = 0, steps - 1 do
		local t0 = i / steps
		local t1 = (i + 1) / steps
		local x0 = fromX + dx * t0
		local z0 = fromZ + dz * t0
		local x1 = fromX + dx * t1
		local z1 = fromZ + dz * t1
		local h0 = TerrainHeight.heightAt(x0, z0) + ROAD_Y_OFFSET
		local h1 = TerrainHeight.heightAt(x1, z1) + ROAD_Y_OFFSET
		local p0 = Vector3.new(x0, h0, z0)
		local p1 = Vector3.new(x1, h1, z1)
		local delta = p1 - p0
		local segLength = delta.Magnitude
		if segLength < 0.1 then
			segLength = 0.1
		end
		local center = (p0 + p1) / 2
		local look = CFrame.lookAt(center, p1)
		makePart(
			folder,
			string.format("%s_%02d", road.id, i + 1),
			Vector3.new(width, ROAD_THICKNESS, segLength + JOINT_OVERLAP),
			look,
			ROAD_COLOR,
			true
		)
	end

	-- Haltelinie quer zur Fahrtrichtung, gut sichtbar, nicht kollidierbar.
	local stopPos: any = road.stopLinePosition
	if stopPos ~= nil then
		local sx: number = stopPos.x
		local sz: number = stopPos.z
		local roadY = TerrainHeight.heightAt(sx, sz) + ROAD_Y_OFFSET
		local lineY = roadY + ROAD_THICKNESS / 2 + STOP_LINE_LIFT
		local stopCenter = Vector3.new(sx, lineY, sz)
		local direction = Vector3.new(dx, 0, dz)
		if direction.Magnitude < 0.01 then
			direction = Vector3.new(0, 0, 1)
		end
		local lineCFrame = CFrame.lookAt(stopCenter, stopCenter + direction)
		makePart(
			folder,
			string.format("%s_StopLine", road.id),
			Vector3.new(width * STOP_LINE_WIDTH_FACTOR, STOP_LINE_THICKNESS, STOP_LINE_LENGTH),
			lineCFrame,
			LINE_COLOR,
			false
		)
	end
end

local function buildRoundabout(folder: Instance, roundabout: any)
	local cx: number = roundabout.center.x
	local cz: number = roundabout.center.z
	local radius: number = roundabout.radius
	local height = TerrainHeight.heightAt(cx, cz) + ROAD_Y_OFFSET
	local diameter = radius * 2
	local disc = Instance.new("Part")
	disc.Name = roundabout.id
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = Vector3.new(ROAD_THICKNESS, diameter, diameter)
	disc.CFrame = CFrame.new(Vector3.new(cx, height, cz)) * CFrame.Angles(0, 0, math.pi / 2)
	disc.Color = ROAD_COLOR
	disc.Material = Enum.Material.SmoothPlastic
	disc.TopSurface = Enum.SurfaceType.Smooth
	disc.BottomSurface = Enum.SurfaceType.Smooth
	disc.Anchored = true
	disc.CanCollide = true
	disc.CanQuery = false
	disc.CanTouch = false
	disc.Parent = folder
end

-- Erzeugt alle Stopstrassen und Kreisel unter `parent` und gibt den Ordner zurueck.
function IntersectionBuilder.build(parent: Instance): Folder
	local root = Instance.new("Folder")
	root.Name = "Intersections"
	for _, road in WorldZones.STOP_ROADS do
		buildStopRoad(root, road)
	end
	for _, roundabout in WorldZones.ROUNDABOUTS do
		buildRoundabout(root, roundabout)
	end
	root.Parent = parent
	return root
end

return IntersectionBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">PastureBuilder</string>
            <string name="Source">--!strict
-- PastureBuilder: umzaeunte Kuhweiden ohne Kuehe.
-- Baut fuer jede Weide aus WorldZones.PASTURES einen gruenen Boden mit
-- vollstaendiger Umzaeunung und erkennbarem Tor. Keine Tiere, keine Strassen-
-- blockade, keine Zaeune in Wasser, Gebaeuden oder Garagenzufahrten.
-- Keine globalen Variablen, keine externen Assets.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldZones = requireSibling("WorldZones")
local TerrainHeight = requireSibling("TerrainHeight")

local PastureBuilder = {}

local FENCE_HEIGHT = 1.2
local FENCE_THICKNESS = 0.4
local GATE_WIDTH = 4
local PASTURE_FLOOR_THICKNESS = 0.4

local GRASS_COLOR = Color3.fromRGB(92, 168, 72)
local FENCE_COLOR = Color3.fromRGB(139, 92, 46)
local GATE_COLOR = Color3.fromRGB(105, 68, 34)
local POST_COLOR = Color3.fromRGB(95, 62, 30)

local function makePart(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	canCollide: boolean,
	material: Enum.Material?,
	transparency: number?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	if material ~= nil then
		part.Material = material
	else
		part.Material = Enum.Material.SmoothPlastic
	end
	if transparency ~= nil then
		part.Transparency = transparency
	end
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = canCollide
	part.Parent = parent
	return part
end

-- Erzeugt eine vollstaendig umzaeunte Weide mit Tor und gibt das Model zurueck.
local function buildPasture(pasture: any): Model
	local center = pasture.center
	local size = pasture.size
	local yaw = pasture.yaw or 0

	local groundY = TerrainHeight.heightAt(center.x, center.z)

	local base = CFrame.new(Vector3.new(center.x, groundY, center.z))
		* CFrame.Angles(0, math.rad(yaw), 0)

	local model = Instance.new("Model")
	model.Name = "Pasture_" .. tostring(pasture.id)
	model:SetAttribute("PastureId", pasture.id)
	model:SetAttribute("IsPasture", true)

	-- Gruener Boden ohne braune Stellen.
	local floorPart = makePart(
		model,
		"PastureFloor",
		Vector3.new(size.x, PASTURE_FLOOR_THICKNESS, size.z),
		base * CFrame.new(0, PASTURE_FLOOR_THICKNESS / 2, 0),
		GRASS_COLOR,
		true,
		Enum.Material.Grass
	)
	model.PrimaryPart = floorPart

	local halfX = size.x / 2
	local halfZ = size.z / 2
	local fenceY = FENCE_HEIGHT / 2
	local postHeight = FENCE_HEIGHT + 0.3

	-- Nordseite (vollstaendig).
	makePart(
		model,
		"Fence_North",
		Vector3.new(size.x, FENCE_HEIGHT, FENCE_THICKNESS),
		base * CFrame.new(0, fenceY, -halfZ),
		FENCE_COLOR,
		true,
		Enum.Material.Wood
	)

	-- Suedseite: zwei Zaunteile mit Toroeffnung in der Mitte.
	local sideWidth = (size.x - GATE_WIDTH) / 2
	if sideWidth &gt; 0 then
		makePart(
			model,
			"Fence_SouthLeft",
			Vector3.new(sideWidth, FENCE_HEIGHT, FENCE_THICKNESS),
			base * CFrame.new(-(GATE_WIDTH / 2 + sideWidth / 2), fenceY, halfZ),
			FENCE_COLOR,
			true,
			Enum.Material.Wood
		)
		makePart(
			model,
			"Fence_SouthRight",
			Vector3.new(sideWidth, FENCE_HEIGHT, FENCE_THICKNESS),
			base * CFrame.new(GATE_WIDTH / 2 + sideWidth / 2, fenceY, halfZ),
			FENCE_COLOR,
			true,
			Enum.Material.Wood
		)
	end

	-- Ost- und Westseite (vollstaendig).
	makePart(
		model,
		"Fence_East",
		Vector3.new(FENCE_THICKNESS, FENCE_HEIGHT, size.z),
		base * CFrame.new(halfX, fenceY, 0),
		FENCE_COLOR,
		true,
		Enum.Material.Wood
	)
	makePart(
		model,
		"Fence_West",
		Vector3.new(FENCE_THICKNESS, FENCE_HEIGHT, size.z),
		base * CFrame.new(-halfX, fenceY, 0),
		FENCE_COLOR,
		true,
		Enum.Material.Wood
	)

	-- Tor: Pfosten, Querbalken und geschlossenes Torgatter in der Oeffnung.
	makePart(
		model,
		"GatePost_Left",
		Vector3.new(FENCE_THICKNESS, postHeight, FENCE_THICKNESS),
		base * CFrame.new(-GATE_WIDTH / 2, postHeight / 2, halfZ),
		POST_COLOR,
		true,
		Enum.Material.Wood
	)
	makePart(
		model,
		"GatePost_Right",
		Vector3.new(FENCE_THICKNESS, postHeight, FENCE_THICKNESS),
		base * CFrame.new(GATE_WIDTH / 2, postHeight / 2, halfZ),
		POST_COLOR,
		true,
		Enum.Material.Wood
	)
	makePart(
		model,
		"GateLintel",
		Vector3.new(GATE_WIDTH + FENCE_THICKNESS * 2, 0.3, FENCE_THICKNESS),
		base * CFrame.new(0, postHeight, halfZ),
		POST_COLOR,
		true,
		Enum.Material.Wood
	)
	local gate = makePart(
		model,
		"Gate",
		Vector3.new(GATE_WIDTH - 0.4, FENCE_HEIGHT - 0.2, 0.2),
		base * CFrame.new(0, (FENCE_HEIGHT - 0.2) / 2, halfZ - 0.1),
		GATE_COLOR,
		true,
		Enum.Material.Wood
	)
	gate:SetAttribute("IsPastureGate", true)

	return model
end

-- Erzeugt fuer alle Weiden aus WorldZones einen Ordner und gibt ihn zurueck.
function PastureBuilder.build(parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = "Pastures"

	for _, pasture in WorldZones.PASTURES do
		local model = buildPasture(pasture)
		model.Parent = folder
	end

	folder.Parent = parent
	return folder
end

return PastureBuilder</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">RoadBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- RoadBuilder: zweispurige Hauptstrassen mit durchgehendem Mittelstreifen.
-- Baut alle Hauptstrassen aus WorldZones (ROAD_SEGMENTS: Ring, Zufahrt, Seestrasse).
-- Jede Fahrbahn folgt dem Terrain (TerrainHeight), Markierungen sind duenn,
-- nicht kollidierbar und ueberhoehen die Fahrbahn nicht.
-- Keine Stopstrassen, keine Kreisel, keine Bruecken, keine Schilder.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldZones = requireSibling("WorldZones")
local TerrainHeight = requireSibling("TerrainHeight")

local RoadBuilder = {}

local ROAD_COLOR = Color3.fromRGB(70, 70, 75)
local CENTER_COLOR = Color3.fromRGB(240, 240, 240)
local ROAD_THICKNESS = 1
local ROAD_Y_OFFSET = 0.6
local CENTER_WIDTH = 0.4
local CENTER_THICKNESS = 0.12
local CENTER_LIFT = 0.08
local STEP_LENGTH = 12
local MAX_STEPS = 64
local JOINT_OVERLAP = 0.6

local function makePart(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	canCollide: boolean
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = canCollide
	part.CanQuery = false
	part.CanTouch = false
	part.Parent = parent
	return part
end

local function buildSegment(folder: Instance, id: string, from: any, to: any, width: number)
	local fromX: number = from.x
	local fromZ: number = from.z
	local toX: number = to.x
	local toZ: number = to.z
	local dx = toX - fromX
	local dz = toZ - fromZ
	local length2D = math.sqrt(dx * dx + dz * dz)
	if length2D < 0.1 then
		return
	end
	local steps = math.clamp(math.ceil(length2D / STEP_LENGTH), 1, MAX_STEPS)
	for i = 0, steps - 1 do
		local t0 = i / steps
		local t1 = (i + 1) / steps
		local x0 = fromX + dx * t0
		local z0 = fromZ + dz * t0
		local x1 = fromX + dx * t1
		local z1 = fromZ + dz * t1
		local h0 = TerrainHeight.heightAt(x0, z0) + ROAD_Y_OFFSET
		local h1 = TerrainHeight.heightAt(x1, z1) + ROAD_Y_OFFSET
		local p0 = Vector3.new(x0, h0, z0)
		local p1 = Vector3.new(x1, h1, z1)
		local delta = p1 - p0
		local segLength = delta.Magnitude
		if segLength < 0.1 then
			segLength = 0.1
		end
		local center = (p0 + p1) / 2
		local look = CFrame.lookAt(center, p1)
		makePart(
			folder,
			string.format("%s_%02d", id, i + 1),
			Vector3.new(width, ROAD_THICKNESS, segLength + JOINT_OVERLAP),
			look,
			ROAD_COLOR,
			true
		)
		local lineCFrame = look * CFrame.new(0, ROAD_THICKNESS / 2 + CENTER_LIFT, 0)
		makePart(
			folder,
			string.format("%s_Center_%02d", id, i + 1),
			Vector3.new(CENTER_WIDTH, CENTER_THICKNESS, segLength + JOINT_OVERLAP),
			lineCFrame,
			CENTER_COLOR,
			false
		)
	end
end

-- Erzeugt alle Hauptstrassen unter `parent` und gibt den Ordner zurueck.
function RoadBuilder.build(parent: Instance): Folder
	local root = Instance.new("Folder")
	root.Name = "Roads"
	for _, segment in WorldZones.ROAD_SEGMENTS do
		buildSegment(root, segment.id, segment.from, segment.to, segment.width)
	end
	root.Parent = parent
	return root
end

return RoadBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">TerrainBuilder</string>
            <string name="Source">--!strict
-- TerrainBuilder: begrenztes Gras-Terrain entlang TerrainHeight, mit sanften
-- Randbergen, See- und Bachbetten. Nutzt die Roblox-Terrain-API (keine Parts
-- als Bodenplatte). Keine braunen Materialien, kein Sand, keine offenen
-- unendlichen Flächen, keine globalen Variablen.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldLayout = requireSibling("WorldLayout")
local TerrainHeight = requireSibling("TerrainHeight")

local TerrainBuilder = {}

-- Rasterzelle in Studs (Roblox-Terrain-Voxelraster).
local CELL_SIZE = 4
-- Untere Basis, ab der Terrain-Säulen gefüllt werden.
local BASE_Y = -12

function TerrainBuilder.build(parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = "Terrain"

	local terrain = workspace.Terrain

	local bounds = WorldLayout.BOUNDS
	local minX = bounds.minX
	local maxX = bounds.maxX
	local minZ = bounds.minZ
	local maxZ = bounds.maxZ

	-- Altes Terrain im Zielbereich entfernen, damit der Aufbau reproduzierbar ist.
	terrain:Clear()

	-- Säulenweise Füllung entlang des Höhenmodells.
	local x = minX
	while x &lt; maxX do
		local cx = x + CELL_SIZE / 2
		local z = minZ
		while z &lt; maxZ do
			local cz = z + CELL_SIZE / 2
			local h = TerrainHeight.heightAt(cx, cz)
			local columnHeight = h - BASE_Y
			if columnHeight &gt; 0.1 then
				local center = Vector3.new(cx, BASE_Y + columnHeight / 2, cz)
				local size = Vector3.new(CELL_SIZE, columnHeight, CELL_SIZE)
				terrain:FillBlock(CFrame.new(center), size, Enum.Material.Grass)
			end
			z += CELL_SIZE
		end
		x += CELL_SIZE
	end

	folder.Parent = parent
	return folder
end

return TerrainBuilder</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">TerrainHeight</string>
            <string name="Source"><![CDATA[--!strict
-- TerrainHeight: sanftes, deterministisches Hoehenmodell fuer das Toeffli-Tal.
-- Reine Mathematik ohne Roblox-Instanzen. Berge an den Raendern liefern die
-- Wasserquellen, Tal, Seeufer und Brueckenauffahrten bleiben flach.
-- Strassen-, Dorf-, Doener- und Garagenflaechen werden auf eine gemeinsame
-- lokale Hoehe abgeflacht. Keine Bodenmaterialien, kein Sand und keine
-- Mutation der Layoutdaten.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldLayout = requireSibling("WorldLayout")
local WorldZones = requireSibling("WorldZones")

local TerrainHeight = {}

TerrainHeight.SEED = WorldLayout.SEED

-- Konstanten -------------------------------------------------------------

local MOUNTAIN_HEIGHT = 110
local MOUNTAIN_START = 380
local MOUNTAIN_FULL = 600
local LAKE_BOTTOM = -5
local PAD_FEATHER = 20
local ROAD_FLAT = 8
local ROAD_FEATHER = 20

-- Helfer (rein, deterministisch) ------------------------------------------

local function clamp01(value: number): number
	if value < 0 then
		return 0
	end
	if value > 1 then
		return 1
	end
	return value
end

local function smoothstep(edge0: number, edge1: number, value: number): number
	local t = clamp01((value - edge0) / (edge1 - edge0))
	return t * t * (3 - 2 * t)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function distance2D(ax: number, az: number, bx: number, bz: number): number
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end

-- Sanfte Talwellen, Amplitude wenige Studs, deterministisch und endlich.
local function valleyHeight(x: number, z: number): number
	return 2.5 * math.sin(x * 0.01) * math.cos(z * 0.012)
		+ 1.5 * math.sin(x * 0.023 + 1.7) * math.sin(z * 0.019 + 0.6)
		+ 1.0 * math.sin((x + z) * 0.007 + 0.3)
end

local function mountainRise(x: number, z: number): number
	local edge = math.max(math.abs(x), math.abs(z))
	return MOUNTAIN_HEIGHT * smoothstep(MOUNTAIN_START, MOUNTAIN_FULL, edge)
end

-- See ---------------------------------------------------------------------

local lakeCenterX: number = WorldZones.LAKE.center.x
local lakeCenterZ: number = WorldZones.LAKE.center.z
local lakeRadius: number = WorldZones.LAKE.radius
local SHORE_HEIGHT: number = valleyHeight(lakeCenterX, lakeCenterZ + lakeRadius + 12)

local function naturalHeight(x: number, z: number): number
	local valley = valleyHeight(x, z)
	local lakeDistance = distance2D(x, z, lakeCenterX, lakeCenterZ)
	-- Berge werden in Seenähe unterdrückt, damit der See im Tal liegt.
	local lakeMask = 1 - smoothstep(lakeRadius + 20, lakeRadius + 80, lakeDistance)
	local base = valley + mountainRise(x, z) * (1 - lakeMask)
	if lakeDistance < lakeRadius - 25 then
		return LAKE_BOTTOM
	elseif lakeDistance < lakeRadius then
		return lerp(LAKE_BOTTOM, SHORE_HEIGHT, smoothstep(lakeRadius - 25, lakeRadius, lakeDistance))
	elseif lakeDistance <= lakeRadius + 25 then
		return SHORE_HEIGHT
	elseif lakeDistance <= lakeRadius + 45 then
		return lerp(SHORE_HEIGHT, base, smoothstep(lakeRadius + 25, lakeRadius + 45, lakeDistance))
	else
		return base
	end
end

-- Abgeflachte Zonen --------------------------------------------------------

type DiscPad = { x: number, z: number, radius: number, target: number }
type Corridor = { ax: number, az: number, bx: number, bz: number, halfWidth: number }

local discPads: { DiscPad } = {}

local function addDisc(x: number, z: number, radius: number, target: number)
	table.insert(discPads, { x = x, z = z, radius = radius, target = target })
end

local donerPosition = WorldLayout.DONER.position
local donerRadius: number = WorldLayout.DONER.radius
addDisc(donerPosition.x, donerPosition.z, donerRadius, valleyHeight(donerPosition.x, donerPosition.z))

for _, village in WorldLayout.VILLAGES do
	local center = village.center
	local villageTarget = valleyHeight(center.x, center.z)
	addDisc(center.x, center.z, village.radius, villageTarget)
	for _, slot in village.slots do
		addDisc(slot.position.x, slot.position.z, 18, villageTarget)
	end
end

local churchPosition = WorldLayout.CHURCH.position
addDisc(churchPosition.x, churchPosition.z, 26, valleyHeight(churchPosition.x, churchPosition.z))

for _, garage in WorldLayout.GARAGES do
	addDisc(garage.position.x, garage.position.z, 20, valleyHeight(garage.position.x, garage.position.z))
end

for _, roundabout in WorldZones.ROUNDABOUTS do
	addDisc(
		roundabout.center.x,
		roundabout.center.z,
		roundabout.radius + 8,
		valleyHeight(roundabout.center.x, roundabout.center.z)
	)
end

for _, bridge in WorldZones.BRIDGE_CROSSINGS do
	addDisc(
		bridge.position.x,
		bridge.position.z,
		bridge.length / 2 + 8,
		valleyHeight(bridge.position.x, bridge.position.z)
	)
end

local corridors: { Corridor } = {}

local function addCorridor(from: any, to: any, width: number)
	table.insert(corridors, {
		ax = from.x,
		az = from.z,
		bx = to.x,
		bz = to.z,
		halfWidth = width / 2,
	})
end

for _, road in WorldZones.ROAD_SEGMENTS do
	addCorridor(road.from, road.to, road.width)
end
for _, road in WorldZones.STOP_ROADS do
	addCorridor(road.from, road.to, road.width)
end

local function projectOnSegment(x: number, z: number, corridor: Corridor): (number, number, number)
	local dx = corridor.bx - corridor.ax
	local dz = corridor.bz - corridor.az
	local lengthSquared = dx * dx + dz * dz
	if lengthSquared == 0 then
		return corridor.ax, corridor.az, distance2D(x, z, corridor.ax, corridor.az)
	end
	local t = ((x - corridor.ax) * dx + (z - corridor.az) * dz) / lengthSquared
	if t < 0 then
		t = 0
	elseif t > 1 then
		t = 1
	end
	local px = corridor.ax + dx * t
	local pz = corridor.az + dz * t
	return px, pz, distance2D(x, z, px, pz)
end

-- Öffentliche API ----------------------------------------------------------

function TerrainHeight.heightAt(x: number, z: number): number
	local natural = naturalHeight(x, z)
	local bestMask = 0
	local bestTarget = natural

	for _, pad in discPads do
		local distance = distance2D(x, z, pad.x, pad.z)
		if distance < pad.radius + PAD_FEATHER then
			local mask = 1 - smoothstep(pad.radius, pad.radius + PAD_FEATHER, distance)
			if mask > bestMask then
				bestMask = mask
				bestTarget = pad.target
				if bestMask >= 1 then
					break
				end
			end
		end
	end

	for _, corridor in corridors do
		local px, pz, distance = projectOnSegment(x, z, corridor)
		local flatEdge = corridor.halfWidth + ROAD_FLAT
		if distance < flatEdge + ROAD_FEATHER then
			local mask = 1 - smoothstep(flatEdge, flatEdge + ROAD_FEATHER, distance)
			if mask > bestMask then
				bestMask = mask
				bestTarget = valleyHeight(px, pz)
			end
		end
	end

	if bestMask <= 0 then
		return natural
	end
	if bestMask >= 1 then
		return bestTarget
	end
	return lerp(natural, bestTarget, bestMask)
end

function TerrainHeight.slopeAt(x: number, z: number): number
	local e = 2
	local hx1 = TerrainHeight.heightAt(x + e, z)
	local hx0 = TerrainHeight.heightAt(x - e, z)
	local hz1 = TerrainHeight.heightAt(x, z + e)
	local hz0 = TerrainHeight.heightAt(x, z - e)
	local dx = (hx1 - hx0) / (2 * e)
	local dz = (hz1 - hz0) / (2 * e)
	return math.sqrt(dx * dx + dz * dz)
end

local function rectContains(
	px: number,
	pz: number,
	center: any,
	sizeX: number,
	sizeZ: number,
	yawDegrees: number,
	margin: number
): boolean
	local yaw = math.rad(yawDegrees)
	local cosYaw = math.cos(yaw)
	local sinYaw = math.sin(yaw)
	local dx = px - center.x
	local dz = pz - center.z
	local localX = dx * cosYaw + dz * sinYaw
	local localZ = -dx * sinYaw + dz * cosYaw
	return math.abs(localX) <= sizeX / 2 + margin and math.abs(localZ) <= sizeZ / 2 + margin
end

function TerrainHeight.isBuildPad(position: Vector3): boolean
	local raw: any = position
	local px: number = raw.x
	if px == nil then
		px = raw.X
	end
	local pz: number = raw.z
	if pz == nil then
		pz = raw.Z
	end

	if distance2D(px, pz, donerPosition.x, donerPosition.z) <= donerRadius + 4 then
		return true
	end

	for _, village in WorldLayout.VILLAGES do
		for _, slot in village.slots do
			if rectContains(px, pz, slot.position, slot.footprint.x, slot.footprint.z, slot.yaw, 6) then
				return true
			end
		end
	end

	local church = WorldLayout.CHURCH
	if rectContains(px, pz, church.position, church.footprint.x, church.footprint.z, church.yaw, 6) then
		return true
	end

	for _, garage in WorldLayout.GARAGES do
		if distance2D(px, pz, garage.position.x, garage.position.z) <= 18 then
			return true
		end
	end

	return false
end

return TerrainHeight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">TrafficSignBuilder</string>
            <string name="Source">--!strict
-- TrafficSignBuilder: Schweizer Verkehrszeichen als Roblox-Modelle.
-- Keine Platzierung, keine externen Assets, keine Gameplay-Logik.

local TrafficSignBuilder = {}

local SIGN_DIAMETER = 4.0
local SIGN_THICKNESS = 0.25
local BORDER_WIDTH = 0.25
local POLE_HEIGHT = 6.0
local POLE_DIAMETER = 0.25

local function makePart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	canCollide: boolean
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = canCollide
	return part
end

local function makeCylinder(
	name: string,
	diameter: number,
	height: number,
	cframe: CFrame,
	color: Color3
): Part
	-- Roblox-Zylinderachse liegt auf X; Rotation bringt die Kreisflaechen
	-- in die Front/Back-Richtung (Z).
	local part = makePart(name, Vector3.new(height, diameter, diameter), cframe, color, nil, false)
	part.Shape = Enum.PartType.Cylinder
	return part
end

local function makeSurfaceText(parent: Part, text: string, color: Color3): ()
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignText"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(300, 300)
	gui.Parent = parent

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
end

local function makePole(mountCFrame: CFrame): Part
	local pole = makePart(
		"Pole",
		Vector3.new(POLE_DIAMETER, POLE_HEIGHT, POLE_DIAMETER),
		mountCFrame * CFrame.new(0, -POLE_HEIGHT / 2, 0),
		Color3.fromRGB(120, 120, 125),
		nil,
		true
	)
	pole.Shape = Enum.PartType.Cylinder
	return pole
end

local function makeOctagon(size: number, thickness: number, color: Color3): Part
	local base = makePart("OctagonBase", Vector3.new(size, size, thickness), CFrame.new(), color, nil, false)
	local cut = size * 0.293
	local half = size / 2
	local positions = {
		Vector3.new(half, half, 0),
		Vector3.new(half, -half, 0),
		Vector3.new(-half, half, 0),
		Vector3.new(-half, -half, 0),
	}
	local cutters: { Part } = {}
	for _, pos in positions do
		local cutter = makePart("Cutter", Vector3.new(cut * 1.5, cut * 1.5, thickness + 1), CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(45)), Color3.new(1, 0, 0), nil, false)
		table.insert(cutters, cutter)
	end
	local ok, result = pcall(function()
		return base:SubtractAsync(cutters)
	end)
	for _, cutter in cutters do
		cutter:Destroy()
	end
	if ok and result ~= nil then
		base:Destroy()
		local part = result :: Part
		part.Name = "Octagon"
		part.Color = color
		part.Material = Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = false
		return part
	end
	base:Destroy()
	local fallback = makePart("Octagon", Vector3.new(size, size, thickness), CFrame.new(), color, nil, false)
	return fallback
end

function TrafficSignBuilder.createSpeedLimit(limit: number): Model
	local model = Instance.new("Model")
	model.Name = "SpeedLimitSign"

	local center = CFrame.new(0, POLE_HEIGHT + SIGN_DIAMETER / 2 + 0.5, 0)
	local orientation = CFrame.Angles(0, math.rad(90), 0)

	-- Roter Rand (hinter der weissen Scheibe).
	local redDiameter = SIGN_DIAMETER + BORDER_WIDTH * 2
	local redDisc = makeCylinder(
		"RedBorder",
		redDiameter,
		SIGN_THICKNESS + 0.05,
		center * orientation * CFrame.new(-0.05, 0, 0),
		Color3.fromRGB(220, 30, 30)
	)
	redDisc.Parent = model

	-- Weisse Scheibe.
	local whiteDisc = makeCylinder(
		"WhiteFace",
		SIGN_DIAMETER,
		SIGN_THICKNESS,
		center * orientation,
		Color3.fromRGB(250, 250, 250)
	)
	whiteDisc.Parent = model

	makeSurfaceText(whiteDisc, tostring(limit), Color3.fromRGB(20, 20, 20))

	-- Befestigungspunkt.
	local mount = makePart(
		"Attachment",
		Vector3.new(0.4, 0.4, 0.4),
		center * CFrame.new(0, -SIGN_DIAMETER / 2 - 0.2, 0),
		Color3.fromRGB(180, 180, 180),
		nil,
		false
	)
	mount.Parent = model

	local pole = makePole(CFrame.new(0, 0, 0))
	pole.Parent = model

	model.PrimaryPart = whiteDisc
	model:SetAttribute("SignType", "SpeedLimit")
	model:SetAttribute("SpeedLimit", limit)

	return model
end

function TrafficSignBuilder.createStopSign(): Model
	local model = Instance.new("Model")
	model.Name = "StopSign"

	local size = SIGN_DIAMETER + 0.5
	local center = CFrame.new(0, POLE_HEIGHT + size / 2 + 0.5, 0)

	-- Weisser Rand (groesseres Oktogon hinten).
	local whiteOctagon = makeOctagon(size + BORDER_WIDTH * 2, SIGN_THICKNESS + 0.05, Color3.fromRGB(250, 250, 250))
	whiteOctagon.CFrame = center
	whiteOctagon.Parent = model

	-- Rotes Oktogon (vorne).
	local redOctagon = makeOctagon(size, SIGN_THICKNESS, Color3.fromRGB(220, 30, 30))
	redOctagon.CFrame = center * CFrame.new(0, 0, (SIGN_THICKNESS + 0.05) / 2 + SIGN_THICKNESS / 2 + 0.02)
	redOctagon.Parent = model

	makeSurfaceText(redOctagon, "STOP", Color3.fromRGB(250, 250, 250))

	-- Befestigungspunkt.
	local mount = makePart(
		"Attachment",
		Vector3.new(0.4, 0.4, 0.4),
		center * CFrame.new(0, -size / 2 - 0.2, 0),
		Color3.fromRGB(180, 180, 180),
		nil,
		false
	)
	mount.Parent = model

	local pole = makePole(CFrame.new(0, 0, 0))
	pole.Parent = model

	model.PrimaryPart = redOctagon
	model:SetAttribute("SignType", "Stop")

	return model
end

return TrafficSignBuilder</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">TrafficSignPlacer</string>
            <string name="Source"><![CDATA[--!strict
-- TrafficSignPlacer: rein berechnete, deterministische Platzierung von
-- Schweizer Verkehrszeichen im Strassennetz. Vor jeder Stopstrasse steht genau
-- ein Stoppschild; Tempolimits stehen fahrtrichtungsbezogen am rechten
-- Fahrbahnrand. Die reinen Platzierungen sind ohne Roblox-Instanzen testbar,
-- die Modelle entstehen erst in `build` ueber TrafficSignBuilder.
-- Keine anderen Schildtypen, keine globalen Variablen.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldZones = requireSibling("WorldZones")
local TerrainHeight = requireSibling("TerrainHeight")
local TrafficSignBuilder = requireSibling("TrafficSignBuilder")

local TrafficSignPlacer = {}

export type PlacementPosition = { x: number, y: number, z: number }

export type Placement = {
	signType: string, -- "Stop" | "SpeedLimit"
	position: PlacementPosition,
	rotation: number, -- Yaw in Grad; Vorderseite (Roblox-Forward = -Z) zeigt zum Verkehr.
	roadId: string,
	limit: number?, -- nur bei "SpeedLimit"
	travel: { x: number, z: number }, -- Fahrtrichtung, fuer die das Schild gilt.
}

-- Zulaessige Tempolimits (km/h) je Strassenart.
TrafficSignPlacer.RING_LIMIT = 60
TrafficSignPlacer.ACCESS_LIMIT = 30
TrafficSignPlacer.TRUNK_LIMIT = 80
-- Abstand der Stoppschilder vor der Haltelinie in Fahrtrichtung (Studs).
TrafficSignPlacer.STOP_SETBACK = 5
-- Abstand vom Fahrbahnrand zum Schildfuss (Studs); blockiert weder Fahrbahn
-- noch Fussweg.
TrafficSignPlacer.EDGE_CLEARANCE = 2
-- Nur jedes n-te Ringsegment erhaelt ein Tempolimit.
TrafficSignPlacer.RING_SIGN_INTERVAL = 4

-- Geometrie-Helfer (rein, deterministisch) ------------------------------

local function distance2D(ax: number, az: number, bx: number, bz: number): number
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end

local function normalize2D(x: number, z: number): (number, number)
	local length = math.sqrt(x * x + z * z)
	if length < 1e-6 then
		return 0, 0
	end
	return x / length, z / length
end

-- Yaw, mit dem die Vorderseite (-Z) in Richtung (targetX, targetZ) zeigt.
local function facingYaw(targetX: number, targetZ: number): number
	return math.deg(math.atan2(-targetX, -targetZ))
end

local function groundHeight(x: number, z: number): number
	return TerrainHeight.heightAt(x, z)
end

local function isRoundaboutPoint(x: number, z: number): boolean
	for _, roundabout in WorldZones.ROUNDABOUTS do
		if distance2D(x, z, roundabout.center.x, roundabout.center.z) <= roundabout.radius + 2 then
			return true
		end
	end
	return false
end

-- Schildfuss darf weder im Wasser noch auf der Fahrbahn oder im Kreisel stehen.
local function isFreeSpot(x: number, z: number): boolean
	local point = { x = x, y = 0, z = z }
	if WorldZones.containsWater(point) then
		return false
	end
	if WorldZones.isRoad(point, 1) then
		return false
	end
	return not isRoundaboutPoint(x, z)
end

local function centerPoint(road: any, t: number): (number, number)
	return road.from.x + (road.to.x - road.from.x) * t, road.from.z + (road.to.z - road.from.z) * t
end

local function makePlacement(
	signType: string,
	x: number,
	z: number,
	travelX: number,
	travelZ: number,
	roadId: string,
	limit: number?
): Placement
	return {
		signType = signType,
		position = { x = x, y = groundHeight(x, z), z = z },
		rotation = facingYaw(-travelX, -travelZ),
		roadId = roadId,
		limit = limit,
		travel = { x = travelX, z = travelZ },
	}
end

-- Stoppschilder ----------------------------------------------------------

local function collectStopSigns(): { Placement }
	local placements: { Placement } = {}

	for _, road in WorldZones.STOP_ROADS do
		local stopLine = road.stopLinePosition
		if stopLine then
			-- Der Verkehr faehrt vom Dorf (to) in den Ring (from) und haelt vor
			-- der Haltelinie. Rechts der Fahrtrichtung steht das Schild.
			local travelX, travelZ = normalize2D(road.from.x - road.to.x, road.from.z - road.to.z)
			local rightX, rightZ = -travelZ, travelX
			local outwardX, outwardZ = normalize2D(road.to.x - road.from.x, road.to.z - road.from.z)
			local offset = road.width / 2 + TrafficSignPlacer.EDGE_CLEARANCE
			local length = distance2D(road.from.x, road.from.z, road.to.x, road.to.z)
			local lineDistance = (stopLine.x - road.from.x) * outwardX + (stopLine.z - road.from.z) * outwardZ
			-- Mindestens hinter der Haltelinie und ausserhalb des Kreisels, der
			-- am Ringende der Stopstrasse liegt.
			local along = math.max(lineDistance + TrafficSignPlacer.STOP_SETBACK, WorldZones.ROUNDABOUT_RADIUS + 4)

			while along <= length - 2 do
				local centerX = road.from.x + outwardX * along
				local centerZ = road.from.z + outwardZ * along
				local x = centerX + rightX * offset
				local z = centerZ + rightZ * offset

				if isFreeSpot(x, z) then
					table.insert(placements, makePlacement("Stop", x, z, travelX, travelZ, road.id))
					break
				end

				along += 2
			end
		end
	end

	return placements
end

-- Tempolimits ------------------------------------------------------------

local function addSpeedLimit(
	placements: { Placement },
	road: any,
	t: number,
	travelX: number,
	travelZ: number,
	limit: number
): boolean
	local rightX, rightZ = -travelZ, travelX
	local offset = road.width / 2 + TrafficSignPlacer.EDGE_CLEARANCE
	local centerX, centerZ = centerPoint(road, t)
	local x = centerX + rightX * offset
	local z = centerZ + rightZ * offset

	if not isFreeSpot(x, z) then
		return false
	end

	table.insert(placements, makePlacement("SpeedLimit", x, z, travelX, travelZ, road.id, limit))
	return true
end

-- Platziert ein Tempolimit mit Rueckfallpositionen, damit Kreisel und
-- Wasserflaechen den Schildfuss nicht verdecken.
local function addSpeedLimitWithFallback(
	placements: { Placement },
	road: any,
	candidates: { number },
	travelX: number,
	travelZ: number,
	limit: number
): ()
	for _, t in candidates do
		if addSpeedLimit(placements, road, t, travelX, travelZ, limit) then
			return
		end
	end
end

local function collectSpeedLimits(): { Placement }
	local placements: { Placement } = {}
	local ringIndex = 0

	for _, road in WorldZones.ROAD_SEGMENTS do
		local forwardX, forwardZ = normalize2D(road.to.x - road.from.x, road.to.z - road.from.z)

		if road.kind == "ring" then
			ringIndex += 1
			if ringIndex % TrafficSignPlacer.RING_SIGN_INTERVAL == 1 then
				-- Ring wird im Uhrzeigersinn befahren; das Schild steht damit am
				-- aeusseren Rand und nicht vor den Garagen.
				local travelX, travelZ = normalize2D(road.from.x - road.to.x, road.from.z - road.to.z)
				addSpeedLimitWithFallback(
					placements,
					road,
					{ 0.5, 0.3, 0.7 },
					travelX,
					travelZ,
					TrafficSignPlacer.RING_LIMIT
				)
			end
		elseif road.kind == "access" then
			addSpeedLimitWithFallback(placements, road, { 0.35 }, forwardX, forwardZ, TrafficSignPlacer.ACCESS_LIMIT)
			addSpeedLimitWithFallback(placements, road, { 0.65 }, -forwardX, -forwardZ, TrafficSignPlacer.ACCESS_LIMIT)
		elseif road.kind == "trunk" then
			addSpeedLimitWithFallback(placements, road, { 0.3 }, forwardX, forwardZ, TrafficSignPlacer.TRUNK_LIMIT)
			addSpeedLimitWithFallback(placements, road, { 0.7 }, -forwardX, -forwardZ, TrafficSignPlacer.TRUNK_LIMIT)
		end
	end

	return placements
end

-- Oeffentliche API -------------------------------------------------------

-- Alle Schilder in fester Reihenfolge: erst Stoppschilder, dann Tempolimits.
function TrafficSignPlacer.calculatePlacements(): { Placement }
	local placements: { Placement } = {}

	for _, placement in collectStopSigns() do
		table.insert(placements, placement)
	end
	for _, placement in collectSpeedLimits() do
		table.insert(placements, placement)
	end

	return placements
end

-- Erzeugt die Schildmodelle unter einem benannten Ordner.
function TrafficSignPlacer.build(parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = "TrafficSigns"

	local counters: { [string]: number } = {}

	for _, placement in TrafficSignPlacer.calculatePlacements() do
		local model: Model
		if placement.signType == "Stop" then
			model = TrafficSignBuilder.createStopSign()
		else
			model = TrafficSignBuilder.createSpeedLimit(placement.limit or 50)
		end

		counters[placement.signType] = (counters[placement.signType] or 0) + 1
		model.Name = string.format("%s_%02d", placement.signType, counters[placement.signType])
		model:PivotTo(
			CFrame.new(placement.position.x, placement.position.y, placement.position.z)
				* CFrame.Angles(0, math.rad(placement.rotation), 0)
		)
		model:SetAttribute("RoadId", placement.roadId)
		model:SetAttribute("SignType", placement.signType)

		model.Parent = folder
	end

	folder.Parent = parent
	return folder
end

return TrafficSignPlacer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">ValleyWorld</string>
            <string name="Source"><![CDATA[--!strict
-- ValleyWorld: idempotente Weltgenerierung fuer das Toeffli-Tal.
-- Layoutdaten stammen ausschliesslich aus WorldLayout; dieses Modul erzeugt
-- nur Instanzen und bietet die stabilen Abfrage- und Cleanup-APIs.
-- Keine globalen Variablen, keine Greybox-Reste, keine Client-Abhaengigkeiten.

local ValleyWorld = {}

local ROOT_NAME = "ValleyWorld"

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldLayout = requireSibling("WorldLayout")

local TerrainBuilder = requireSibling("TerrainBuilder")
local WaterBuilder = requireSibling("WaterBuilder")
local RoadBuilder = requireSibling("RoadBuilder")
local IntersectionBuilder = requireSibling("IntersectionBuilder")
local BridgeBuilder = requireSibling("BridgeBuilder")
local TrafficSignPlacer = requireSibling("TrafficSignPlacer")
local DonerShopBuilder = requireSibling("DonerShopBuilder")
local ChurchBuilder = requireSibling("ChurchBuilder")
local VillageBuilder = requireSibling("VillageBuilder")
local PastureBuilder = requireSibling("PastureBuilder")
local VegetationBuilder = requireSibling("VegetationBuilder")
local GrassFieldBuilder = requireSibling("GrassFieldBuilder")
local AtmosphereBuilder = requireSibling("AtmosphereBuilder")
local GarageWorldBuilder = requireSibling("GarageWorldBuilder")

ValleyWorld.MAX_PLAYERS = 15

-- Konvertiert die reinen Layoutdaten in die von diesem Modul gewohnten Vektoren.
local function toVector3(position: { x: number, y: number, z: number }): Vector3
	return Vector3.new(position.x, position.y, position.z)
end

function ValleyWorld.getBounds(): (number, number)
	local bounds = WorldLayout.BOUNDS
	return (bounds.maxX - bounds.minX) / 2, (bounds.maxZ - bounds.minZ) / 2
end

function ValleyWorld.isInsideBounds(position: Vector3): boolean
	return WorldLayout.isInsideBounds({ x = position.X, y = position.Y, z = position.Z })
end

function ValleyWorld.getDeliveryPoints(): { { Name: string, Position: Vector3 } }
	local points = WorldLayout.getDeliveryPoints()
	local copy: { { Name: string, Position: Vector3 } } = {}
	for _, point in points do
		table.insert(copy, { Name = point.id, Position = toVector3(point.position) })
	end
	return copy
end

function ValleyWorld.getGarageAnchors(): { { Name: string, Position: Vector3 } }
	local anchors = WorldLayout.getGarageAnchors()
	local copy: { { Name: string, Position: Vector3 } } = {}
	for _, anchor in anchors do
		table.insert(copy, { Name = anchor.id, Position = toVector3(anchor.position) })
	end
	return copy
end

function ValleyWorld.getPointsOfInterest(): { { Name: string, Kind: string, Position: Vector3, Size: Vector3 } }
	local points = WorldLayout.getPointsOfInterest()
	local copy: { { Name: string, Kind: string, Position: Vector3, Size: Vector3 } } = {}
	for _, point in points do
		local diameter = point.radius * 2
		table.insert(copy, {
			Name = point.id,
			Kind = point.kind,
			Position = toVector3(point.position),
			Size = Vector3.new(diameter, point.radius, diameter),
		})
	end
	return copy
end

-- Entfernt ausschliesslich die zuvor generierte Welt unter `parent`.
function ValleyWorld.cleanup(parent: Instance): ()
	for _, child in parent:GetChildren() do
		if child.Name == ROOT_NAME then
			child:Destroy()
		end
	end
end

-- Feste Reihenfolge: Terrain, Wasser, Strassen, Kreuzungen, Bruecken, Gebaeude,
-- Garagen, Vegetation inkl. Gras, Weiden, Schilder, Atmosphaere.
local function buildWorld(root: Instance): ()
	TerrainBuilder.build(root)

	WaterBuilder.build(root)

	RoadBuilder.build(root)
	IntersectionBuilder.build(root)
	BridgeBuilder.build(root)

	DonerShopBuilder.build(root)
	ChurchBuilder.build(root)
	VillageBuilder.build(root)

	GarageWorldBuilder.build(root)

	VegetationBuilder.build(root)
	GrassFieldBuilder.build(root)

	PastureBuilder.build(root)

	TrafficSignPlacer.build(root)

	AtmosphereBuilder.apply()
end

-- Erzeugt die Welt unter `parent`. Ein erneuter Aufruf entfernt zuerst genau
-- die bisher generierte Welt und baut sie anschliessend vollstaendig neu auf.
function ValleyWorld.build(parent: Instance): Instance
	ValleyWorld.cleanup(parent)

	local root = Instance.new("Folder")
	root.Name = ROOT_NAME

	local ok, err = pcall(buildWorld, root)
	if not ok then
		root:Destroy()
		error(err, 0)
	end

	root.Parent = parent
	return root
end

return ValleyWorld
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">VegetationBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- VegetationBuilder: deterministische Low-Poly-Waelder und Baumgruppen.
-- Die reine Platzierungsfunktion `calculatePlacements` liefert Baumdaten ohne
-- Roblox-Instanzen und ist damit in Studio und Lune testbar. Die Instanzen
-- entstehen erst in `build` ueber ConiferFactory.
-- Baeume stehen nur ausserhalb von Strassen, Wasser, Gebaeuden, Garagen,
-- Lieferpunkten und Weiden. Keine globalen Variablen, keine externen Assets.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldZones = requireSibling("WorldZones")
local TerrainHeight = requireSibling("TerrainHeight")
local ConiferFactory = requireSibling("ConiferFactory")

local VegetationBuilder = {}

export type PlacementPosition = { x: number, y: number, z: number }

export type Placement = {
	position: PlacementPosition,
	scale: number,
	seed: number,
	group: string,
}

-- Obergrenze fuer 15 Spieler: begrenzt Teilezahl und Streaming-Last.
VegetationBuilder.MAX_TREES = 240
-- Mindestabstand zwischen zwei Baumstaemmen (Studs).
VegetationBuilder.MIN_SPACING = 7
-- Sicherheitsabstand zu Fahrbahnen, Wasser, Weiden und Gebaeuden (Studs).
VegetationBuilder.CLEARANCE = 5

-- Deterministischer Pseudozufall (Lehmer-LCG), unabhaengig von Roblox.
local function createRandom(seed: number): () -> number
	local state = seed % 2147483647
	if state <= 0 then
		state += 2147483646
	end
	return function(): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
end

local function distance2D(ax: number, az: number, bx: number, bz: number): number
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end

-- Punkt in einem gedrehten Rechteck (yaw um die Y-Achse in Grad).
local function rectContains(
	px: number,
	pz: number,
	center: PlacementPosition,
	sizeX: number,
	sizeZ: number,
	yawDegrees: number,
	margin: number
): boolean
	local yaw = math.rad(yawDegrees)
	local cosYaw = math.cos(yaw)
	local sinYaw = math.sin(yaw)
	local dx = px - center.x
	local dz = pz - center.z
	local localX = dx * cosYaw + dz * sinYaw
	local localZ = -dx * sinYaw + dz * cosYaw
	return math.abs(localX) <= sizeX / 2 + margin and math.abs(localZ) <= sizeZ / 2 + margin
end

local function forestAt(px: number, pz: number, margin: number): any
	for _, forest in WorldZones.FORESTS do
		if distance2D(px, pz, forest.center.x, forest.center.z) <= forest.radius + margin then
			return forest
		end
	end
	return nil
end

-- Wasser hat keine Margin-API: Kandidat plus vier Randpunkte pruefen.
local function waterNear(px: number, pz: number, margin: number): boolean
	if WorldZones.containsWater({ x = px, y = 0, z = pz }) then
		return true
	end
	local probes = {
		{ margin, 0 },
		{ -margin, 0 },
		{ 0, margin },
		{ 0, -margin },
	}
	for _, probe in probes do
		if WorldZones.containsWater({ x = px + probe[1], y = 0, z = pz + probe[2] }) then
			return true
		end
	end
	return false
end

local function pastureNear(px: number, pz: number, margin: number): boolean
	for _, pasture in WorldZones.PASTURES do
		if
			rectContains(
				px,
				pz,
				pasture.center,
				pasture.size.x,
				pasture.size.z,
				pasture.yaw,
				margin
			)
		then
			return true
		end
	end
	return false
end

-- Ausschlusszonen. Innerhalb eines Waldes wuerde `isReserved` durch den Wald
-- selbst blockieren; dort greifen die expliziten Strassen-, Wasser- und
-- Weidenpruefungen. Gebaeude, Garagen und Lieferpunkte liegen laut den
-- validierten Zonendaten (WorldZones.spec) ausserhalb der Waldradien und
-- werden ausserhalb der Waelder zusaetzlich ueber `isReserved` abgedeckt.
local function isExcluded(px: number, pz: number, margin: number): boolean
	local point = { x = px, y = 0, z = pz }
	if WorldZones.isRoad(point, margin) then
		return true
	end
	if waterNear(px, pz, margin) then
		return true
	end
	if pastureNear(px, pz, margin) then
		return true
	end
	if forestAt(px, pz, margin) == nil and WorldZones.isReserved(point, margin) then
		return true
	end
	return false
end

local function tooClose(placements: { Placement }, px: number, pz: number, spacing: number): boolean
	for _, placement in placements do
		if distance2D(px, pz, placement.position.x, placement.position.z) < spacing then
			return true
		end
	end
	return false
end

-- Reine Platzierungsdaten: deterministisch, ohne Roblox-Instanzen.
function VegetationBuilder.calculatePlacements(): { Placement }
	local placements: { Placement } = {}

	local function addTree(px: number, pz: number, scale: number, group: string): boolean
		if #placements >= VegetationBuilder.MAX_TREES then
			return false
		end
		if tooClose(placements, px, pz, VegetationBuilder.MIN_SPACING) then
			return false
		end
		placements[#placements + 1] = {
			position = {
				x = px,
				y = TerrainHeight.heightAt(px, pz),
				z = pz,
			},
			scale = scale,
			seed = 7000 + (#placements + 1) * 37,
			group = group,
		}
		return true
	end

	-- Waelder: deterministisch gestreute Gruppen statt identischer Baumreihen.
	for forestIndex, forest in WorldZones.FORESTS do
		local random = createRandom(WorldZones.SEED + forestIndex * 211)
		local density = 0.35 + random() * 0.25
		local target = math.clamp(math.round(forest.radius * density), 14, 48)
		local maxRadius = forest.radius * 0.92
		local placed = 0
		local attempts = 0
		local maxAttempts = target * 10

		while placed < target and attempts < maxAttempts do
			attempts += 1
			local angle = random() * math.pi * 2
			local radius = math.sqrt(random()) * maxRadius
			local px = forest.center.x + math.cos(angle) * radius
			local pz = forest.center.z + math.sin(angle) * radius
			if not isExcluded(px, pz, VegetationBuilder.CLEARANCE) then
				local scale = 0.7 + random() * 0.65
				if addTree(px, pz, scale, forest.id) then
					placed += 1
				end
			end
		end
	end

	-- Kleine Baumgruppen ausserhalb der Waelder, deterministisch verteilt.
	for groveIndex = 1, 6 do
		local random = createRandom(WorldZones.SEED + 900 + groveIndex * 131)
		local centerX = 0
		local centerZ = 0
		local found = false

		for _ = 1, 120 do
			local candidateX = (random() * 2 - 1) * 520
			local candidateZ = (random() * 2 - 1) * 520
			if not isExcluded(candidateX, candidateZ, 20) then
				centerX = candidateX
				centerZ = candidateZ
				found = true
				break
			end
		end

		if found then
			local groveRadius = 6 + random() * 6
			local groveTarget = 3 + math.floor(random() * 3)
			local placed = 0

			for _ = 1, groveTarget * 12 do
				if placed >= groveTarget then
					break
				end
				local angle = random() * math.pi * 2
				local radius = math.sqrt(random()) * groveRadius
				local px = centerX + math.cos(angle) * radius
				local pz = centerZ + math.sin(angle) * radius
				if not isExcluded(px, pz, VegetationBuilder.CLEARANCE) then
					local scale = 0.7 + random() * 0.65
					if addTree(px, pz, scale, string.format("Grove_%02d", groveIndex)) then
						placed += 1
					end
				end
			end
		end
	end

	return placements
end

-- Setzt den Stammfuss exakt auf die Gelaendehoehe am Platzierungspunkt.
local function placeOnGround(model: Model, position: PlacementPosition): ()
	local pivot = model:GetPivot()
	local boundsCFrame, boundsSize = model:GetBoundingBox()
	local baseOffset = pivot.Y - (boundsCFrame.Y - boundsSize.Y / 2)
	model:PivotTo(CFrame.new(Vector3.new(position.x, position.y + baseOffset, position.z)))
end

-- Erzeugt alle Baeume unter einem benannten Ordner und gibt ihn zurueck.
function VegetationBuilder.build(parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = "Vegetation"

	for index, placement in VegetationBuilder.calculatePlacements() do
		local model = ConiferFactory.create(placement.seed, placement.scale)
		model.Name = string.format("Conifer_%03d", index)
		model:SetAttribute("IsVegetation", true)
		model:SetAttribute("VegetationGroup", placement.group)
		placeOnGround(model, placement.position)
		model.Parent = folder
	end

	folder.Parent = parent
	return folder
end

return VegetationBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">VillageBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- VillageBuilder: erzeugt beide Doerfer mit je 10 Haeusern aus dem Katalog.
-- Keine Greyboxen, keine Kirche, keine Garagen. Eingangstueren bleiben frei.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local BuildingCatalog: any
do
	local ok, module = pcall(require, "./data/BuildingCatalog")
	if ok then
		BuildingCatalog = module
	else
		BuildingCatalog = require(script.Parent.data.BuildingCatalog)
	end
end
local WorldLayout = requireSibling("WorldLayout")
local TerrainHeight = requireSibling("TerrainHeight")
local BuildingFactory = requireSibling("BuildingFactory")

local VillageBuilder = {}

local function villageIdOf(definition: { [string]: any }): string
	local value = definition.VillageId
	if type(value) == "string" then
		return value
	end
	value = definition.villageId
	if type(value) == "string" then
		return value
	end
	return ""
end

local function houseIdOf(definition: { [string]: any }): string
	local value = definition.Id
	if type(value) == "string" and value ~= "" then
		return value
	end
	value = definition.id
	if type(value) == "string" then
		return value
	end
	return ""
end

function VillageBuilder.build(parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = "Villages"

	local villages: any = WorldLayout.VILLAGES
	for _, village in villages do
		local villageId: string = village.id
		local houses: { { [string]: any } } = {}
		for _, definition in BuildingCatalog.HOUSES do
			if villageIdOf(definition) == villageId then
				table.insert(houses, definition)
			end
		end
		table.sort(houses, function(a, b)
			return houseIdOf(a) < houseIdOf(b)
		end)

		local slots: any = village.slots
		for index, slot in slots do
			local definition = houses[index]
			if definition == nil then
				continue
			end
			local model: Model = BuildingFactory.create(definition)
			model:SetAttribute("SlotId", slot.id)
			model.Parent = folder
			local groundY: number = TerrainHeight.heightAt(slot.position.x, slot.position.z)
			local ground = Vector3.new(slot.position.x, groundY, slot.position.z)
			local rigid = CFrame.new(ground) * CFrame.Angles(0, math.rad(slot.yaw), 0)
			local pivot: CFrame = model:GetPivot()
			model:PivotTo(rigid * pivot)
		end
	end

	folder.Parent = parent
	return folder
end

return VillageBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">WaterBuilder</string>
            <string name="Source">--!strict
-- WaterBuilder: See und drei Bergbaeche als Roblox-Terrain-Wasser.
-- Erzeugt genau einen See und drei durchgehende Baeche von den Bergquellen
-- bis zur Muendung in den See. Keine Strassen, Bruecken oder Schilder.
-- Keine globalen Variablen.

local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldZones = requireSibling("WorldZones")
local TerrainHeight = requireSibling("TerrainHeight")

local WaterBuilder = {}

local CELL_SIZE = 4
local LAKE_DEPTH = 12
local STREAM_DEPTH = 3

local function fillColumn(terrain: Terrain, cx: number, cz: number, bottomY: number, topY: number)
	if topY &lt;= bottomY then
		return
	end
	local height = topY - bottomY
	local center = Vector3.new(cx, bottomY + height / 2, cz)
	local size = Vector3.new(CELL_SIZE, height, CELL_SIZE)
	terrain:FillBlock(CFrame.new(center), size, Enum.Material.Water)
end

function WaterBuilder.build(parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = "Water"

	local terrain = workspace.Terrain

	-- See: kreisfoermige Wasserflaeche, Oberflaeche auf Uferhoehe.
	local lake = WorldZones.LAKE
	local lakeCx = lake.center.x
	local lakeCz = lake.center.z
	local lakeRadius = lake.radius
	local shoreSurface = TerrainHeight.heightAt(lakeCx, lakeCz + lakeRadius)

	local minX = lakeCx - lakeRadius - CELL_SIZE
	local maxX = lakeCx + lakeRadius + CELL_SIZE
	local minZ = lakeCz - lakeRadius - CELL_SIZE
	local maxZ = lakeCz + lakeRadius + CELL_SIZE

	local x = minX
	while x &lt; maxX do
		local cx = x + CELL_SIZE / 2
		local z = minZ
		while z &lt; maxZ do
			local cz = z + CELL_SIZE / 2
			local dist = math.sqrt((cx - lakeCx) ^ 2 + (cz - lakeCz) ^ 2)
			if dist &lt;= lakeRadius then
				fillColumn(terrain, cx, cz, shoreSurface - LAKE_DEPTH, shoreSurface)
			end
			z += CELL_SIZE
		end
		x += CELL_SIZE
	end

	-- Drei Baeche: durchgehende Wasserstreifen entlang der definierten Punkte.
	for _, stream in WorldZones.STREAMS do
		local halfWidth = stream.width / 2
		for segIndex = 1, #stream.points - 1 do
			local a = stream.points[segIndex]
			local b = stream.points[segIndex + 1]

			local minSegX = math.min(a.x, b.x) - halfWidth - CELL_SIZE
			local maxSegX = math.max(a.x, b.x) + halfWidth + CELL_SIZE
			local minSegZ = math.min(a.z, b.z) - halfWidth - CELL_SIZE
			local maxSegZ = math.max(a.z, b.z) + halfWidth + CELL_SIZE

			local segDx = b.x - a.x
			local segDz = b.z - a.z
			local lenSq = segDx * segDx + segDz * segDz

			local sx = minSegX
			while sx &lt; maxSegX do
				local cx = sx + CELL_SIZE / 2
				local sz = minSegZ
				while sz &lt; maxSegZ do
					local cz = sz + CELL_SIZE / 2
					local t = 0
					if lenSq &gt; 0 then
						t = ((cx - a.x) * segDx + (cz - a.z) * segDz) / lenSq
						if t &lt; 0 then
							t = 0
						elseif t &gt; 1 then
							t = 1
						end
					end
					local projX = a.x + segDx * t
					local projZ = a.z + segDz * t
					local d = math.sqrt((cx - projX) ^ 2 + (cz - projZ) ^ 2)
					if d &lt;= halfWidth then
						local surfaceY = TerrainHeight.heightAt(cx, cz)
						fillColumn(terrain, cx, cz, surfaceY - STREAM_DEPTH, surfaceY)
					end
					sz += CELL_SIZE
				end
				sx += CELL_SIZE
			end
		end
	end

	folder.Parent = parent
	return folder
end

return WaterBuilder</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">WorldLayout</string>
            <string name="Source"><![CDATA[--!strict
-- WorldLayout: reine, deterministische Layoutdaten fuer das Toeffli-Tal.
-- Keine Roblox-Instanzen, keine Preise, keine Gameplaylogik.
-- Positionen sind schlichte Tabellen ({ x, y, z }), damit die Daten auch ohne
-- Roblox-Laufzeit (Lune-Tests) geprueft werden koennen. `yaw` ist eine
-- Roblox-Yaw-Rotation in Grad um die Y-Achse.

export type Position = { x: number, y: number, z: number }

export type Footprint = { x: number, z: number }

export type HouseSlot = {
	id: string,
	name: string,
	villageId: string,
	position: Position,
	yaw: number,
	footprint: Footprint,
}

export type Village = {
	id: string,
	name: string,
	center: Position,
	radius: number,
	slots: { HouseSlot },
}

export type DonerPlace = {
	id: string,
	name: string,
	kind: string,
	position: Position,
	radius: number,
	pickupPosition: Position,
}

export type Church = {
	id: string,
	name: string,
	kind: string,
	villageId: string,
	position: Position,
	yaw: number,
	footprint: Footprint,
}

export type GarageAnchor = {
	id: string,
	name: string,
	position: Position,
	yaw: number,
	angleDegrees: number,
}

export type DeliveryPoint = {
	id: string,
	name: string,
	kind: string,
	villageId: string?,
	position: Position,
}

export type PointOfInterest = {
	id: string,
	name: string,
	kind: string,
	position: Position,
	radius: number,
}

local WorldLayout = {}

-- Fester Seed: identische Daten in Server, Studio und Tests.
WorldLayout.SEED = 20260101

-- Grenzen des Tals (einschliesslich), keine offene unendliche Flaeche.
WorldLayout.BOUNDS = {
	minX = -600,
	maxX = 600,
	minZ = -600,
	maxZ = 600,
	minY = 0,
	maxY = 240,
}

-- Zentraler Doenerplatz im Taltzentrum.
WorldLayout.DONER = {
	id = "DonerPlace",
	name = "Dönerplatz",
	kind = "doner",
	position = { x = 0, y = 0, z = 0 },
	radius = 36,
	pickupPosition = { x = 0, y = 0, z = 18 },
}

-- Zwei Doerfer; jedes erhaelt exakt 10 Haus-Slots.
local VILLAGE_PLAN: { { id: string, name: string, center: Position } } = {
	{ id = "Village_Alpenblick", name = "Alpenblick", center = { x = -320, y = 0, z = -280 } },
	{ id = "Village_Seeblick", name = "Seeblick", center = { x = 340, y = 0, z = 300 } },
}

local SLOTS_PER_VILLAGE = 10
local SLOT_RADIUS = 100
local SLOT_RADIUS_JITTER = 8
local SLOT_ANGLE_JITTER = 4
local SLOT_FOOTPRINT: Footprint = { x = 20, z = 16 }
local DELIVERY_OFFSET = 14

local GARAGE_COUNT = 15
local GARAGE_RING_RADIUS = 200

-- Deterministischer Pseudozufall (Lehmer-LCG). Der Zustand bleibt lokal,
-- damit ein erneutes Laden immer dieselben Layoutdaten erzeugt.
local function createRandom(seed: number): () -> number
	local state = seed % 2147483647
	if state <= 0 then
		state += 2147483646
	end
	return function(): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
end

local function jitter(random: () -> number, amount: number): number
	return (random() * 2 - 1) * amount
end

local function copyPosition(position: Position): Position
	return { x = position.x, y = position.y, z = position.z }
end

-- Yaw, mit dem die Vorderseite (Roblox-Forward = -Z) auf `to` zeigt.
local function yawTowards(from: Position, to: Position): number
	local deltaX = to.x - from.x
	local deltaZ = to.z - from.z
	return math.deg(math.atan2(-deltaX, -deltaZ))
end

local random = createRandom(WorldLayout.SEED)

local villages: { Village } = {}
local deliveryPoints: { DeliveryPoint } = {}

for _, plan in VILLAGE_PLAN do
	local slots: { HouseSlot } = {}
	local startAngle = random() * 360

	for slotIndex = 0, SLOTS_PER_VILLAGE - 1 do
		local angleDegrees = startAngle
			+ slotIndex * (360 / SLOTS_PER_VILLAGE)
			+ jitter(random, SLOT_ANGLE_JITTER)
		local radius = SLOT_RADIUS + jitter(random, SLOT_RADIUS_JITTER)
		local angleRadians = math.rad(angleDegrees)

		local position: Position = {
			x = plan.center.x + math.cos(angleRadians) * radius,
			y = plan.center.y,
			z = plan.center.z + math.sin(angleRadians) * radius,
		}

		local slot: HouseSlot = {
			id = string.format("%s_Slot_%02d", plan.id, slotIndex + 1),
			name = string.format("%s Haus %02d", plan.name, slotIndex + 1),
			villageId = plan.id,
			position = position,
			yaw = yawTowards(position, plan.center),
			footprint = { x = SLOT_FOOTPRINT.x, z = SLOT_FOOTPRINT.z },
		}
		table.insert(slots, slot)

		-- Lieferpunkt liegt zur Dorfmitte hin vor dem Haus (Eingangsseite).
		local deltaX = plan.center.x - position.x
		local deltaZ = plan.center.z - position.z
		local length = math.sqrt(deltaX * deltaX + deltaZ * deltaZ)
		table.insert(deliveryPoints, {
			id = string.format("Delivery_%s", slot.id),
			name = string.format("Lieferung %s", slot.name),
			kind = "address",
			villageId = plan.id,
			position = {
				x = position.x + (deltaX / length) * DELIVERY_OFFSET,
				y = position.y,
				z = position.z + (deltaZ / length) * DELIVERY_OFFSET,
			},
		})
	end

	table.insert(villages, {
		id = plan.id,
		name = plan.name,
		center = copyPosition(plan.center),
		radius = 150,
		slots = slots,
	})
end

WorldLayout.VILLAGES = villages

-- Genau eine Kirche: im Zentrum des ersten Dorfes.
WorldLayout.CHURCH = {
	id = "Church_Alpenblick",
	name = "Dorfkirche Alpenblick",
	kind = "church",
	villageId = VILLAGE_PLAN[1].id,
	position = copyPosition(VILLAGE_PLAN[1].center),
	yaw = yawTowards(VILLAGE_PLAN[1].center, WorldLayout.DONER.position),
	footprint = { x = 22, z = 30 },
}

-- 15 Garagen auf einem gemeinsamen Ring: gleicher Abstand zum Doenerplatz,
-- gleichmaessig verteilt und damit mit Mindestabstand zueinander.
local garages: { GarageAnchor } = {}
local garageStartAngle = random() * 360

for garageIndex = 1, GARAGE_COUNT do
	local angleDegrees = garageStartAngle + (garageIndex - 1) * (360 / GARAGE_COUNT)
	local angleRadians = math.rad(angleDegrees)

	local position: Position = {
		x = math.cos(angleRadians) * GARAGE_RING_RADIUS,
		y = 0,
		z = math.sin(angleRadians) * GARAGE_RING_RADIUS,
	}

	table.insert(garages, {
		id = string.format("Garage_%02d", garageIndex),
		name = string.format("Garage %02d", garageIndex),
		position = position,
		yaw = yawTowards(position, WorldLayout.DONER.position),
		angleDegrees = angleDegrees,
	})
end

WorldLayout.GARAGES = garages

table.insert(deliveryPoints, {
	id = "Delivery_DonerPickup",
	name = "Döner Laden Abholung",
	kind = "pickup",
	position = copyPosition(WorldLayout.DONER.pickupPosition),
})

local function copySlot(slot: HouseSlot): HouseSlot
	return {
		id = slot.id,
		name = slot.name,
		villageId = slot.villageId,
		position = copyPosition(slot.position),
		yaw = slot.yaw,
		footprint = { x = slot.footprint.x, z = slot.footprint.z },
	}
end

function WorldLayout.getVillages(): { Village }
	local copy: { Village } = {}
	for _, village in WorldLayout.VILLAGES do
		local slots: { HouseSlot } = {}
		for _, slot in village.slots do
			table.insert(slots, copySlot(slot))
		end
		table.insert(copy, {
			id = village.id,
			name = village.name,
			center = copyPosition(village.center),
			radius = village.radius,
			slots = slots,
		})
	end
	return copy
end

function WorldLayout.getDeliveryPoints(): { DeliveryPoint }
	local copy: { DeliveryPoint } = {}
	for _, point in deliveryPoints do
		table.insert(copy, {
			id = point.id,
			name = point.name,
			kind = point.kind,
			villageId = point.villageId,
			position = copyPosition(point.position),
		})
	end
	return copy
end

function WorldLayout.getGarageAnchors(): { GarageAnchor }
	local copy: { GarageAnchor } = {}
	for _, garage in WorldLayout.GARAGES do
		table.insert(copy, {
			id = garage.id,
			name = garage.name,
			position = copyPosition(garage.position),
			yaw = garage.yaw,
			angleDegrees = garage.angleDegrees,
		})
	end
	return copy
end

function WorldLayout.getPointsOfInterest(): { PointOfInterest }
	local points: { PointOfInterest } = {
		{
			id = WorldLayout.DONER.id,
			name = WorldLayout.DONER.name,
			kind = WorldLayout.DONER.kind,
			position = copyPosition(WorldLayout.DONER.position),
			radius = WorldLayout.DONER.radius,
		},
		{
			id = WorldLayout.CHURCH.id,
			name = WorldLayout.CHURCH.name,
			kind = WorldLayout.CHURCH.kind,
			position = copyPosition(WorldLayout.CHURCH.position),
			radius = 18,
		},
	}
	for _, village in WorldLayout.VILLAGES do
		table.insert(points, {
			id = village.id,
			name = village.name,
			kind = "village",
			position = copyPosition(village.center),
			radius = village.radius,
		})
	end
	return points
end

function WorldLayout.isInsideBounds(position: Position): boolean
	local bounds = WorldLayout.BOUNDS
	return position.x >= bounds.minX
		and position.x <= bounds.maxX
		and position.z >= bounds.minZ
		and position.z <= bounds.maxZ
		and position.y >= bounds.minY
		and position.y <= bounds.maxY
end

return WorldLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">WorldZones</string>
            <string name="Source"><![CDATA[--!strict
-- WorldZones: reine, deterministische Zonendaten fuer das Toeffli-Tal.
-- Enthaelt zweispurige Hauptstrassen, Stopstrassen, Kreisel, genau einen See,
-- drei Bergbaeche mit Quelle und Muendung, alle Brueckenkreuzungen, Weiden und
-- Waelder. Keine Roblox-Instanzen, keine Terrain-Erzeugung, keine Gameplaylogik.
-- Alle Hoehen (y) sind hier 0; die Gelaendemodellierung folgt in TerrainHeight.

export type Position = { x: number, y: number, z: number }

export type RoadSegment = {
	id: string,
	name: string,
	kind: string, -- "ring" | "access" | "trunk" | "stop"
	from: Position,
	to: Position,
	width: number,
	lanes: number,
	laneWidth: number,
	hasCenterLine: boolean,
	stopLinePosition: Position?,
}

export type Roundabout = {
	id: string,
	name: string,
	center: Position,
	radius: number,
	roadIds: { string },
}

export type LakeZone = {
	id: string,
	name: string,
	kind: "lake",
	center: Position,
	radius: number,
}

export type StreamZone = {
	id: string,
	name: string,
	kind: "stream",
	width: number,
	source: Position,
	mouth: Position,
	points: { Position },
}

export type WaterCourse = LakeZone | StreamZone

export type BridgeCrossing = {
	id: string,
	name: string,
	roadId: string,
	waterId: string,
	position: Position,
	yaw: number,
	length: number,
	width: number,
}

export type PastureZone = {
	id: string,
	name: string,
	kind: string, -- "pasture"
	center: Position,
	size: { x: number, z: number },
	yaw: number,
}

export type ForestZone = {
	id: string,
	name: string,
	kind: string, -- "forest"
	center: Position,
	radius: number,
}

-- Roblox- und Lune-taugliche Modulaufloesung (Relativpfad bzw. Script-Parent).
local function requireSibling(name: string): any
	local ok, module = pcall(require, "./" .. name)
	if ok then
		return module
	end
	return require(script.Parent[name])
end

local WorldLayout = requireSibling("WorldLayout")

local WorldZones = {}

-- Abmessungen und Mindestabstaende -------------------------------------

-- Radius der Ringstrasse um den Doenerplatz.
WorldZones.RING_RADIUS = 240
-- Breite einer zweispurigen Hauptstrasse (Studs).
WorldZones.MAIN_ROAD_WIDTH = 16
-- Breite einer Stopstrasse bzw. Dorfzufahrt (Studs).
WorldZones.STOP_ROAD_WIDTH = 12
-- Aussenradius eines Kreisels (Studs).
WorldZones.ROUNDABOUT_RADIUS = 16
-- Angenommener Ankerradius einer Garage (Studs); groessere Garagen sind
-- unzulaessig, sonst kollidieren sie mit Ringstrasse und Kreiseln.
WorldZones.GARAGE_RADIUS = 12
-- Mindestabstand zwischen Zonen und Garagen, Gebaeuden bzw. Doerfern.
WorldZones.MIN_CLEARANCE = 8

local RING_RADIUS = WorldZones.RING_RADIUS
local RING_SEGMENT_COUNT = 16
local MAIN_ROAD_WIDTH = WorldZones.MAIN_ROAD_WIDTH
local STOP_ROAD_WIDTH = WorldZones.STOP_ROAD_WIDTH
local ROUNDABOUT_RADIUS = WorldZones.ROUNDABOUT_RADIUS
local GARAGE_RADIUS = WorldZones.GARAGE_RADIUS
local BRIDGE_OVERHANG = 10

WorldZones.SEED = WorldLayout.SEED
WorldZones.BOUNDS = WorldLayout.BOUNDS

-- Geometrie-Helfer (nur 2D: x/z) ---------------------------------------

local function position(x: number, z: number): Position
	return { x = x, y = 0, z = z }
end

local function distance2D(ax: number, az: number, bx: number, bz: number): number
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end

local function distanceToSegment(point: Position, a: Position, b: Position): number
	local dx = b.x - a.x
	local dz = b.z - a.z
	local lengthSquared = dx * dx + dz * dz
	if lengthSquared == 0 then
		return distance2D(point.x, point.z, a.x, a.z)
	end
	local t = math.clamp(((point.x - a.x) * dx + (point.z - a.z) * dz) / lengthSquared, 0, 1)
	return distance2D(point.x, point.z, a.x + dx * t, a.z + dz * t)
end

local function segmentIntersection(a: Position, b: Position, c: Position, d: Position): number?
	local rx = b.x - a.x
	local rz = b.z - a.z
	local sx = d.x - c.x
	local sz = d.z - c.z
	local denominator = rx * sz - rz * sx
	if math.abs(denominator) < 1e-9 then
		return nil
	end
	local qpx = c.x - a.x
	local qpz = c.z - a.z
	local t = (qpx * sz - qpz * sx) / denominator
	local u = (qpx * rz - qpz * rx) / denominator
	if t < 0 or t > 1 or u < 0 or u > 1 then
		return nil
	end
	return t
end

-- Punkt in einem gedrehten Rechteck (yaw um die Y-Achse in Grad).
local function rectContains(
	point: Position,
	center: Position,
	sizeX: number,
	sizeZ: number,
	yawDegrees: number,
	margin: number
): boolean
	local yaw = math.rad(yawDegrees)
	local cosYaw = math.cos(yaw)
	local sinYaw = math.sin(yaw)
	local dx = point.x - center.x
	local dz = point.z - center.z
	local localX = dx * cosYaw + dz * sinYaw
	local localZ = -dx * sinYaw + dz * cosYaw
	return math.abs(localX) <= sizeX / 2 + margin and math.abs(localZ) <= sizeZ / 2 + margin
end

-- Hauptstrassen --------------------------------------------------------

local roadSegments: { RoadSegment } = {}

-- Ringstrasse: 16 Segmente, zweispurig, mit durchgehendem Mittelstreifen.
for index = 1, RING_SEGMENT_COUNT do
	local startAngle = math.rad((index - 1) * 360 / RING_SEGMENT_COUNT)
	local endAngle = math.rad(index * 360 / RING_SEGMENT_COUNT)
	table.insert(roadSegments, {
		id = string.format("Road_Ring_%02d", index),
		name = string.format("Ringstrasse %02d", index),
		kind = "ring",
		from = position(math.cos(startAngle) * RING_RADIUS, math.sin(startAngle) * RING_RADIUS),
		to = position(math.cos(endAngle) * RING_RADIUS, math.sin(endAngle) * RING_RADIUS),
		width = MAIN_ROAD_WIDTH,
		lanes = 2,
		laneWidth = MAIN_ROAD_WIDTH / 2,
		hasCenterLine = true,
	})
end

-- Doenerplatzzufahrt: laeuft genau zwischen zwei benachbarten Garagen
-- hindurch (Mittelwinkel), damit keine Garage angefahren wird.
local garages = WorldLayout.GARAGES
local accessAngleDegrees = 270
if #garages >= 2 then
	accessAngleDegrees = (garages[1].angleDegrees + garages[2].angleDegrees) / 2
end
local accessAngle = math.rad(accessAngleDegrees)
local accessDirectionX = math.cos(accessAngle)
local accessDirectionZ = math.sin(accessAngle)

table.insert(roadSegments, {
	id = "Road_DonerAccess",
	name = "Doenerplatz-Zufahrt",
	kind = "access",
	from = position(accessDirectionX * (RING_RADIUS - 8), accessDirectionZ * (RING_RADIUS - 8)),
	to = position(accessDirectionX * WorldLayout.DONER.radius, accessDirectionZ * WorldLayout.DONER.radius),
	width = MAIN_ROAD_WIDTH,
	lanes = 2,
	laneWidth = MAIN_ROAD_WIDTH / 2,
	hasCenterLine = true,
})

-- Seestrasse: vom Ring nach Suedosten, quert genau einen Bergbach.
local trunkAngle = math.rad(315)
table.insert(roadSegments, {
	id = "Road_Seestrasse",
	name = "Seestrasse",
	kind = "trunk",
	from = position(math.cos(trunkAngle) * RING_RADIUS, math.sin(trunkAngle) * RING_RADIUS),
	to = position(500, -430),
	width = MAIN_ROAD_WIDTH,
	lanes = 2,
	laneWidth = MAIN_ROAD_WIDTH / 2,
	hasCenterLine = true,
})

WorldZones.ROAD_SEGMENTS = roadSegments

-- Stopstrassen: Dorfzufahrten, die mit Haltelinie in den Ring muenden.
local stopRoads: { RoadSegment } = {}

for _, village in WorldLayout.VILLAGES do
	local center = village.center
	local centerDistance = distance2D(center.x, center.z, 0, 0)
	local directionX = center.x / centerDistance
	local directionZ = center.z / centerDistance
	local from = position(directionX * RING_RADIUS, directionZ * RING_RADIUS)
	local toRadius = centerDistance - village.radius
	local to = position(directionX * toRadius, directionZ * toRadius)

	table.insert(stopRoads, {
		id = string.format("StopRoad_%s", village.id),
		name = string.format("Dorfzufahrt %s", village.name),
		kind = "stop",
		from = from,
		to = to,
		width = STOP_ROAD_WIDTH,
		lanes = 1,
		laneWidth = STOP_ROAD_WIDTH,
		hasCenterLine = false,
		stopLinePosition = position(
			from.x + (to.x - from.x) * 0.15,
			from.z + (to.z - from.z) * 0.15
		),
	})
end

WorldZones.STOP_ROADS = stopRoads

-- Kreisel --------------------------------------------------------------

local roundabouts: { Roundabout } = {}

local function addRoundabout(id: string, name: string, angleDegrees: number, extraRoadId: string)
	local angle = math.rad(angleDegrees)
	local normalized = angleDegrees % 360
	local segmentIndex = math.floor(normalized / (360 / RING_SEGMENT_COUNT)) + 1
	local previousIndex = ((segmentIndex - 2) % RING_SEGMENT_COUNT) + 1

	table.insert(roundabouts, {
		id = id,
		name = name,
		center = position(math.cos(angle) * RING_RADIUS, math.sin(angle) * RING_RADIUS),
		radius = ROUNDABOUT_RADIUS,
		roadIds = {
			string.format("Road_Ring_%02d", previousIndex),
			string.format("Road_Ring_%02d", segmentIndex),
			extraRoadId,
		},
	})
end

addRoundabout("Roundabout_Donerplatz", "Kreisel Doenerplatz", accessAngleDegrees, "Road_DonerAccess")

for _, village in WorldLayout.VILLAGES do
	local center = village.center
	local angleDegrees = math.deg(math.atan2(center.z, center.x))
	addRoundabout(
		string.format("Roundabout_%s", village.id),
		string.format("Kreisel %s", village.name),
		angleDegrees,
		string.format("StopRoad_%s", village.id)
	)
end

WorldZones.ROUNDABOUTS = roundabouts

-- Gewaesser ------------------------------------------------------------

local lake: LakeZone = {
	id = "Lake_Toefflisee",
	name = "Toefflisee",
	kind = "lake",
	center = position(0, -480),
	radius = 80,
}

-- Muendungspunkt exakt auf dem Seeufer in Richtung der jeweiligen Quelle.
local function lakeShoreTowards(source: Position): Position
	local dx = source.x - lake.center.x
	local dz = source.z - lake.center.z
	local length = math.sqrt(dx * dx + dz * dz)
	return position(lake.center.x + (dx / length) * lake.radius, lake.center.z + (dz / length) * lake.radius)
end

local streamSources: { { id: string, name: string, width: number, source: Position, bend: { Position } } } = {
	{
		id = "Stream_West",
		name = "Westbach",
		width = 14,
		source = position(-560, -520),
		bend = { position(-400, -505), position(-220, -520) },
	},
	{
		id = "Stream_East",
		name = "Ostbach",
		width = 14,
		source = position(560, -520),
		bend = { position(380, -540), position(200, -525) },
	},
	{
		id = "Stream_Northeast",
		name = "Nordostbach",
		width = 14,
		source = position(560, -240),
		bend = { position(430, -310), position(280, -350), position(150, -395) },
	},
}

local streams: { StreamZone } = {}

for _, plan in streamSources do
	local mouth = lakeShoreTowards(plan.source)
	local points: { Position } = { plan.source }
	for _, point in plan.bend do
		table.insert(points, point)
	end
	table.insert(points, mouth)

	table.insert(streams, {
		id = plan.id,
		name = plan.name,
		kind = "stream",
		width = plan.width,
		source = plan.source,
		mouth = mouth,
		points = points,
	})
end

WorldZones.LAKE = lake
WorldZones.STREAMS = streams
WorldZones.WATER_COURSES = { lake, streams[1], streams[2], streams[3] }

-- Brueckenkreuzungen: jede Ueberschneidung Strasse x Bach wird ermittelt.

local allRoads: { RoadSegment } = {}
for _, road in roadSegments do
	table.insert(allRoads, road)
end
for _, road in stopRoads do
	table.insert(allRoads, road)
end

local bridgeCrossings: { BridgeCrossing } = {}

for _, road in allRoads do
	for _, course in WorldZones.WATER_COURSES do
		if course.kind == "stream" then
			for index = 1, #course.points - 1 do
				local t = segmentIntersection(road.from, road.to, course.points[index], course.points[index + 1])
				if t then
					local crossing = position(
						road.from.x + (road.to.x - road.from.x) * t,
						road.from.z + (road.to.z - road.from.z) * t
					)
					table.insert(bridgeCrossings, {
						id = string.format("Bridge_%02d", #bridgeCrossings + 1),
						name = string.format("Bruecke %s", road.name),
						roadId = road.id,
						waterId = course.id,
						position = crossing,
						yaw = math.deg(math.atan2(
							-(road.to.x - road.from.x),
							-(road.to.z - road.from.z)
						)),
						length = course.width + BRIDGE_OVERHANG * 2,
						width = road.width + 2,
					})
				end
			end
		end
	end
end

WorldZones.BRIDGE_CROSSINGS = bridgeCrossings

-- Weiden und Waelder (ausserhalb von Ring, Doerfern und Gewaessern) -----

WorldZones.PASTURES = {
	{
		id = "Pasture_Nordwest",
		name = "Weide Nordwest",
		kind = "pasture",
		center = position(-520, 250),
		size = { x = 100, z = 70 },
		yaw = 0,
	},
	{
		id = "Pasture_Ost",
		name = "Weide Ost",
		kind = "pasture",
		center = position(310, 110),
		size = { x = 110, z = 80 },
		yaw = 12,
	},
	{
		id = "Pasture_Sued",
		name = "Weide Sued",
		kind = "pasture",
		center = position(-150, 470),
		size = { x = 120, z = 70 },
		yaw = -8,
	},
}

WorldZones.FORESTS = {
	{
		id = "Forest_West",
		name = "Wald West",
		kind = "forest",
		center = position(-420, 60),
		radius = 90,
	},
	{
		id = "Forest_Ost",
		name = "Wald Ost",
		kind = "forest",
		center = position(450, -80),
		radius = 85,
	},
	{
		id = "Forest_See",
		name = "Wald am See",
		kind = "forest",
		center = position(60, -320),
		radius = 60,
	},
	{
		id = "Forest_Sued",
		name = "Wald Sued",
		kind = "forest",
		center = position(-360, 380),
		radius = 80,
	},
}

-- Abfragen -------------------------------------------------------------

local function waterContains(point: Position, margin: number): boolean
	for _, course in WorldZones.WATER_COURSES do
		if course.kind == "lake" then
			if distance2D(point.x, point.z, course.center.x, course.center.z) <= course.radius + margin then
				return true
			end
		else
			for index = 1, #course.points - 1 do
				local distance = distanceToSegment(point, course.points[index], course.points[index + 1])
				if distance <= course.width / 2 + margin then
					return true
				end
			end
		end
	end
	return false
end

function WorldZones.containsWater(point: Position): boolean
	return waterContains(point, 0)
end

function WorldZones.isRoad(point: Position, margin: number?): boolean
	local required = margin or 0
	for _, road in allRoads do
		if distanceToSegment(point, road.from, road.to) <= road.width / 2 + required then
			return true
		end
	end
	for _, roundabout in WorldZones.ROUNDABOUTS do
		if distance2D(point.x, point.z, roundabout.center.x, roundabout.center.z) <= roundabout.radius + required then
			return true
		end
	end
	return false
end

function WorldZones.isReserved(point: Position, margin: number?): boolean
	local required = margin or 0

	if WorldZones.isRoad(point, required) then
		return true
	end
	if waterContains(point, required) then
		return true
	end

	for _, pasture in WorldZones.PASTURES do
		if rectContains(point, pasture.center, pasture.size.x, pasture.size.z, pasture.yaw, required) then
			return true
		end
	end

	for _, forest in WorldZones.FORESTS do
		if distance2D(point.x, point.z, forest.center.x, forest.center.z) <= forest.radius + required then
			return true
		end
	end

	for _, garage in WorldLayout.GARAGES do
		if distance2D(point.x, point.z, garage.position.x, garage.position.z) <= GARAGE_RADIUS + required then
			return true
		end
	end

	local doner = WorldLayout.DONER
	if distance2D(point.x, point.z, doner.position.x, doner.position.z) <= doner.radius + required then
		return true
	end

	for _, village in WorldLayout.VILLAGES do
		for _, slot in village.slots do
			if rectContains(point, slot.position, slot.footprint.x, slot.footprint.z, slot.yaw, required) then
				return true
			end
		end
	end

	local church = WorldLayout.CHURCH
	return rectContains(point, church.position, church.footprint.x, church.footprint.z, church.yaw, required)
end

return WorldZones
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="57">
          <Properties>
            <string name="Name">data</string>
          </Properties>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">BuildingCatalog</string>
              <string name="Source">--!strict
-- BuildingCatalog: 20 einzigartige Haeuser fuer die zwei Doerfer des Toeffli-Tals.
-- Reine Daten, keine Roblox-Instanzen, keine globalen Variablen.
-- Jede Kombination aus Grundriss, Dach, Farbe, Fenster, Tuer und Dekoration ist
-- eindeutig; keine sichtbaren Duplikate. Die Kirche ist nicht Teil dieses Katalogs.

export type HouseDefinition = { [string]: any }

local BuildingCatalog = {}

-- Optionen fuer die sechs Gestaltungsmerkmale.
local FOOTPRINTS: { string } = { "rectangular", "L_shape", "T_shape", "square", "wide_rect" }
local FOOTPRINT_SIZES: { { x: number, z: number } } = {
	{ x = 20, z = 16 },
	{ x = 18, z = 18 },
	{ x = 22, z = 14 },
	{ x = 16, z = 16 },
	{ x = 24, z = 12 },
}
local ROOFS: { string } = { "gable", "hip", "flat", "mansard" }
local COLORS: { string } = { "white", "cream", "yellow", "gray", "brown" }
local WINDOWS: { string } = { "shuttered", "plain", "arched", "bay" }
local DOORS: { string } = { "front", "left", "right", "center" }
local DECORATIONS: { string } = { "flowers", "balcony", "shutters", "garden", "none" }
local HEIGHTS: { number } = { 6.0, 7.5, 9.0, 5.5, 8.0 }

local VILLAGE_IDS: { string } = { "Village_Alpenblick", "Village_Seeblick" }
local VILLAGE_SHORT: { string } = { "Alpenblick", "Seeblick" }

local function makeHouse(
	id: string,
	name: string,
	villageId: string,
	footprint: string,
	footprintSize: { x: number, z: number },
	height: number,
	roof: string,
	colors: { string },
	windowStyle: string,
	doorSide: string,
	decoration: string
): HouseDefinition
	local signature = footprint .. "|" .. roof .. "|" .. table.concat(colors, ",") .. "|" .. windowStyle .. "|" .. doorSide .. "|" .. decoration
	local house: HouseDefinition = {}
	house.Id = id
	house.id = id
	house.Name = name
	house.name = name
	house.VillageId = villageId
	house.villageId = villageId
	house.Footprint = footprint
	house.footprint = footprint
	house.Grundriss = footprint
	house.grundriss = footprint
	house.FootprintSize = { x = footprintSize.x, z = footprintSize.z }
	house.footprintSize = { x = footprintSize.x, z = footprintSize.z }
	house.Size = { x = footprintSize.x, z = footprintSize.z }
	house.size = { x = footprintSize.x, z = footprintSize.z }
	house.Height = height
	house.height = height
	house.Hoehe = height
	house.hoehe = height
	house.RoofShape = roof
	house.roofShape = roof
	house.RoofType = roof
	house.roofType = roof
	house.Roof = roof
	house.roof = roof
	house.Dachform = roof
	house.dachform = roof
	house.FacadeColors = colors
	house.facadeColors = colors
	house.Colors = colors
	house.colors = colors
	house.FacadeColor = colors[1]
	house.facadeColor = colors[1]
	house.Fassadenfarben = colors
	house.fassadenfarben = colors
	house.WindowStyle = windowStyle
	house.windowStyle = windowStyle
	house.Windows = windowStyle
	house.windows = windowStyle
	house.Fensterstil = windowStyle
	house.fensterstil = windowStyle
	house.DoorSide = doorSide
	house.doorSide = doorSide
	house.DoorDirection = doorSide
	house.doorDirection = doorSide
	house.Door = doorSide
	house.door = doorSide
	house.Tuerseite = doorSide
	house.tuerseite = doorSide
	house.Decoration = decoration
	house.decoration = decoration
	house.DecorationSignature = decoration
	house.decorationSignature = decoration
	house.DecorationSignatur = decoration
	house.decorationSignatur = decoration
	house.Dekorationssignatur = decoration
	house.dekorationssignatur = decoration
	house.Signature = signature
	house.signature = signature
	house.DesignSignature = signature
	house.designSignature = signature
	house.Gestaltungssignatur = signature
	house.gestaltungssignatur = signature
	house.Signatur = signature
	house.signatur = signature
	return house
end

-- 20 Haeuser generieren: gemischte Basis sorgt fuer eindeutige 6-Tupel.
local houses: { HouseDefinition } = {}
for i = 0, 19 do
	-- Dorfzuordnung: erste 10 / zweite 10
	local villageIndex = 0
	if i &gt;= 10 then
		villageIndex = 1
	end
	local villageId = VILLAGE_IDS[villageIndex + 1]
	local villageShort = VILLAGE_SHORT[villageIndex + 1]
	local localIndex = (i % 10) + 1

	local n = i
	local fi = n % 5
	n = math.floor(n / 5)
	local ri = n % 4
	n = math.floor(n / 4)
	local ci = n % 5
	n = math.floor(n / 5)
	local wi = n % 4
	n = math.floor(n / 4)
	local di = n % 4
	n = math.floor(n / 4)
	local ei = n % 5

	local footprint = FOOTPRINTS[fi + 1]
	local footprintSize = FOOTPRINT_SIZES[fi + 1]
	local roof = ROOFS[ri + 1]
	local color = COLORS[ci + 1]
	local trimColor = COLORS[(ci + 2) % 5 + 1]
	local colors = { color, trimColor }
	local windowStyle = WINDOWS[wi + 1]
	local doorSide = DOORS[di + 1]
	local decoration = DECORATIONS[ei + 1]
	local height = HEIGHTS[fi + 1] + (di * 0.3)

	local id = string.format("House_%s_%02d", villageShort, localIndex)
	local name = string.format("%s Haus %02d", villageShort, localIndex)

	table.insert(
		houses,
		makeHouse(id, name, villageId, footprint, footprintSize, height, roof, colors, windowStyle, doorSide, decoration)
	)
end

BuildingCatalog.HOUSES = houses
BuildingCatalog.Houses = houses

-- Lookup-Index.
local BY_ID: { [string]: HouseDefinition } = {}
for _, house in houses do
	BY_ID[house.Id] = house
end

function BuildingCatalog.getById(id: string): HouseDefinition?
	return BY_ID[id]
end

function BuildingCatalog.GetById(id: string): HouseDefinition?
	return BY_ID[id]
end

function BuildingCatalog.getHouse(id: string): HouseDefinition?
	return BY_ID[id]
end

function BuildingCatalog.GetHouse(id: string): HouseDefinition?
	return BY_ID[id]
end

function BuildingCatalog.validate(): (boolean, string?)
	if type(BuildingCatalog.HOUSES) ~= "table" then
		return false, "HOUSES must be a table"
	end
	if #BuildingCatalog.HOUSES ~= 20 then
		return false, string.format("expected 20 houses, found %d", #BuildingCatalog.HOUSES)
	end

	local ids: { [string]: boolean } = {}
	local signatures: { [string]: boolean } = {}
	local perVillage: { [string]: number } = {}

	for index, house in BuildingCatalog.HOUSES do
		if type(house) ~= "table" then
			return false, string.format("house #%d is not a table", index)
		end
		if type(house.Id) ~= "string" or house.Id == "" then
			return false, string.format("house #%d has invalid Id", index)
		end
		if ids[house.Id] then
			return false, "duplicate Id: " .. house.Id
		end
		ids[house.Id] = true

		if type(house.VillageId) ~= "string" or (house.VillageId ~= "Village_Alpenblick" and house.VillageId ~= "Village_Seeblick") then
			return false, string.format("house '%s' has invalid VillageId", tostring(house.Id))
		end
		perVillage[house.VillageId] = (perVillage[house.VillageId] or 0) + 1

		if type(house.Signature) ~= "string" or house.Signature == "" then
			return false, string.format("house '%s' has invalid Signature", tostring(house.Id))
		end
		if signatures[house.Signature] then
			return false, "duplicate Signature: " .. house.Signature
		end
		signatures[house.Signature] = true
	end

	if perVillage["Village_Alpenblick"] ~= 10 then
		return false, string.format("expected 10 houses for Village_Alpenblick, found %d", perVillage["Village_Alpenblick"] or 0)
	end
	if perVillage["Village_Seeblick"] ~= 10 then
		return false, string.format("expected 10 houses for Village_Seeblick, found %d", perVillage["Village_Seeblick"] or 0)
	end

	local signatureCount = 0
	for _ in signatures do
		signatureCount += 1
	end
	if signatureCount ~= 20 then
		return false, string.format("expected 20 unique signatures, found %d", signatureCount)
	end

	return true, nil
end

local ok, err = BuildingCatalog.validate()
assert(ok, "BuildingCatalog invalid: " .. tostring(err))

return BuildingCatalog</string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="59">
      <Properties>
        <string name="Name">shared</string>
      </Properties>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Töffli Tal: unveränderliche Spielkonstanten.
-- Server-autoritativ: 15 Spieler, Startfahrrad, einmaliger Mofa-Startrabatt, Speicherintervall.

local GameConfig = {
	MAX_PLAYERS = 15,
	START_VEHICLE_ID = "bicycle",
	STARTER_MOPED_IDS = { "puch_maxi_s", "piaggio_ciao" },
	STARTER_DISCOUNT_PERCENT = 30,
	STARTER_DISCOUNT_ONCE = true,
	START_CASH = 0,
	AUTOSAVE_INTERVAL_SECONDS = 120,
	PROFILE_VERSION = 1,
}

table.freeze(GameConfig.STARTER_MOPED_IDS)
return table.freeze(GameConfig)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="61">
        <Properties>
          <string name="Name">data</string>
        </Properties>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">PartsCatalog</string>
            <string name="Source"><![CDATA[--!strict
-- PartsCatalog: Platzhalter-Tuningteile für TöffliTal.
-- Modell-IDs ("bicycle", "puch_maxi_s", "piaggio_ciao") spiegeln die
-- stabilen IDs aus VehicleCatalog. Motor-Teile sind bewusst nicht mit dem
-- Fahrrad kompatibel (kein Motor, keine Tuning-Schnittstelle).

export type StatChanges = {
	powerDelta: number,
	torqueDelta: number,
	topSpeedDelta: number,
	accelerationDelta: number,
	brakingDelta: number,
	gripDelta: number,
	consumptionDelta: number,
}

export type PartDefinition = {
	id: string,
	name: string,
	slot: string,
	compatibleModels: { string },
	price: number,
	statChanges: StatChanges,
	mountPoint: string,
	paintableAreas: { string },
}

local PartsCatalog = {}

PartsCatalog.SLOTS = {
	"cylinder",
	"cylinderHead",
	"carburetor",
	"exhaust",
	"airFilter",
	"intakeManifold",
	"handlebar",
	"brakes",
	"wheels",
	"rims",
	"lamp",
}

PartsCatalog.MODELS = {
	"bicycle",
	"puch_maxi_s",
	"piaggio_ciao",
}

local MOPEDS: { string } = { "puch_maxi_s", "piaggio_ciao" }
local ALL_MODELS: { string } = { "bicycle", "puch_maxi_s", "piaggio_ciao" }

local function stats(
	powerDelta: number,
	torqueDelta: number,
	topSpeedDelta: number,
	accelerationDelta: number,
	brakingDelta: number,
	gripDelta: number,
	consumptionDelta: number
): StatChanges
	return {
		powerDelta = powerDelta,
		torqueDelta = torqueDelta,
		topSpeedDelta = topSpeedDelta,
		accelerationDelta = accelerationDelta,
		brakingDelta = brakingDelta,
		gripDelta = gripDelta,
		consumptionDelta = consumptionDelta,
	}
end

local function copyModels(source: { string }): { string }
	local result: { string } = {}
	for _, modelId in source do
		table.insert(result, modelId)
	end
	return result
end

PartsCatalog.Parts = {
	{
		id = "cylinder_stock_50",
		name = "Serienzylinder 50ccm",
		slot = "cylinder",
		compatibleModels = copyModels(MOPEDS),
		price = 0,
		statChanges = stats(0, 0, 0, 0, 0, 0, 0),
		mountPoint = "Engine.CylinderMount",
		paintableAreas = {},
	},
	{
		id = "cylinder_sport_70",
		name = "Sportzylinder 70ccm (Platzhalter)",
		slot = "cylinder",
		compatibleModels = copyModels(MOPEDS),
		price = 450,
		statChanges = stats(0.35, 0.25, 8, 0.2, 0, 0, 0.3),
		mountPoint = "Engine.CylinderMount",
		paintableAreas = { "Cylinder" },
	},
	{
		id = "head_stock",
		name = "Serien-Zylinderkopf",
		slot = "cylinderHead",
		compatibleModels = copyModels(MOPEDS),
		price = 0,
		statChanges = stats(0, 0, 0, 0, 0, 0, 0),
		mountPoint = "Engine.HeadMount",
		paintableAreas = {},
	},
	{
		id = "head_sport",
		name = "Sport-Zylinderkopf (Platzhalter)",
		slot = "cylinderHead",
		compatibleModels = copyModels(MOPEDS),
		price = 220,
		statChanges = stats(0.12, 0.08, 2, 0.05, 0, 0, 0.1),
		mountPoint = "Engine.HeadMount",
		paintableAreas = { "Head" },
	},
	{
		id = "carb_stock_12",
