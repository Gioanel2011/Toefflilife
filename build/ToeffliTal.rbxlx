		price = 120,
		statChanges = stats(0, 0, 0, 0, 0, 0, -0.02),
		mountPoint = "Frame.LampMount",
		paintableAreas = { "LampHousing" },
	},
}

PartsCatalog.ById = {}
for _, part in PartsCatalog.Parts do
	PartsCatalog.ById[part.id] = part
end

local STAT_KEYS: { string } = {
	"powerDelta",
	"torqueDelta",
	"topSpeedDelta",
	"accelerationDelta",
	"brakingDelta",
	"gripDelta",
	"consumptionDelta",
}

function PartsCatalog.getPartById(id: string): PartDefinition?
	return PartsCatalog.ById[id]
end

function PartsCatalog.getPartsForSlot(slot: string): { PartDefinition }
	local result: { PartDefinition } = {}
	for _, part in PartsCatalog.Parts do
		if part.slot == slot then
			table.insert(result, part)
		end
	end
	return result
end

function PartsCatalog.getPartsForModel(modelId: string): { PartDefinition }
	local result: { PartDefinition } = {}
	for _, part in PartsCatalog.Parts do
		for _, compatible in part.compatibleModels do
			if compatible == modelId then
				table.insert(result, part)
				break
			end
		end
	end
	return result
end

function PartsCatalog.isCompatible(partOrId: PartDefinition | string, modelId: string): boolean
	local part: PartDefinition?
	if type(partOrId) == "string" then
		part = PartsCatalog.ById[partOrId :: string]
	else
		part = partOrId :: PartDefinition
	end
	if part == nil then
		return false
	end
	for _, compatible in (part :: PartDefinition).compatibleModels do
		if compatible == modelId then
			return true
		end
	end
	return false
end

function PartsCatalog.validate(): (boolean, string?)
	local slotSet: { [string]: boolean } = {}
	for _, slot in PartsCatalog.SLOTS do
		if type(slot) ~= "string" or slot == "" then
			return false, "invalid slot entry"
		end
		if slotSet[slot] then
			return false, "duplicate slot: " .. slot
		end
		slotSet[slot] = true
	end

	local seenIds: { [string]: boolean } = {}
	for index, part in PartsCatalog.Parts do
		if type(part.id) ~= "string" or part.id == "" then
			return false, string.format("part #%d has invalid id", index)
		end
		if seenIds[part.id] then
			return false, "duplicate part id: " .. part.id
		end
		seenIds[part.id] = true

		if type(part.name) ~= "string" or part.name == "" then
			return false, "part has invalid name: " .. part.id
		end
		if not slotSet[part.slot] then
			return false, "part has unknown slot: " .. part.id
		end
		if type(part.compatibleModels) ~= "table" or #part.compatibleModels == 0 then
			return false, "part has no compatible models: " .. part.id
		end
		local seenModels: { [string]: boolean } = {}
		for _, modelId in part.compatibleModels do
			if type(modelId) ~= "string" or modelId == "" then
				return false, "part has invalid model entry: " .. part.id
			end
			if seenModels[modelId] then
				return false, "part lists model twice: " .. part.id
			end
			seenModels[modelId] = true
		end
		if type(part.price) ~= "number" or part.price < 0 or part.price ~= math.floor(part.price) then
			return false, "part has invalid price: " .. part.id
		end
		if type(part.statChanges) ~= "table" then
			return false, "part has invalid statChanges: " .. part.id
		end
		for _, key in STAT_KEYS do
			local value = (part.statChanges :: { [string]: any })[key]
			if type(value) ~= "number" then
				return false, "part has invalid stat " .. key .. ": " .. part.id
			end
		end
		if type(part.mountPoint) ~= "string" or part.mountPoint == "" then
			return false, "part has invalid mountPoint: " .. part.id
		end
		if type(part.paintableAreas) ~= "table" then
			return false, "part has invalid paintableAreas: " .. part.id
		end
		for _, area in part.paintableAreas do
			if type(area) ~= "string" or area == "" then
				return false, "part has invalid paintable area: " .. part.id
			end
		end
	end

	for _, slot in PartsCatalog.SLOTS do
		if #PartsCatalog.getPartsForSlot(slot) == 0 then
			return false, "slot without parts: " .. slot
		end
	end

	return true, nil
end

local ok, err = PartsCatalog.validate()
assert(ok, "PartsCatalog invalid: " .. tostring(err))

return PartsCatalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">PlayerDataSchema</string>
            <string name="Source"><![CDATA[--!strict
-- Töffli Tal: versioniertes Spielerprofil-Schema.
-- Geld, Fahrzeuge, Inventar, Teile, Lacke, Missionen und Rabattstatus.
-- Server-autoritativ; keine globalen Variablen.

local PlayerDataSchema = {}

PlayerDataSchema.VERSION = 1
PlayerDataSchema.START_VEHICLE_ID = "bicycle"

local function isNonNegativeInteger(value: any): boolean
	return type(value) == "number" and value >= 0 and math.floor(value) == value
end

local function isStringArray(value: any): boolean
	if type(value) ~= "table" then
		return false
	end
	for key, item in pairs(value) do
		if type(key) ~= "number" or type(item) ~= "string" then
			return false
		end
	end
	return true
end

local function isCountMap(value: any): boolean
	if type(value) ~= "table" then
		return false
	end
	for key, count in pairs(value) do
		if type(key) ~= "string" or not isNonNegativeInteger(count) then
			return false
		end
	end
	return true
end

local function contains(array: { string }, needle: string): boolean
	for _, item in ipairs(array) do
		if item == needle then
			return true
		end
	end
	return false
end

function PlayerDataSchema.createDefault(): any
	return {
		version = PlayerDataSchema.VERSION,
		cash = 0,
		vehicles = {
			owned = { PlayerDataSchema.START_VEHICLE_ID },
			selected = PlayerDataSchema.START_VEHICLE_ID,
		},
		inventory = {},
		parts = {
			installed = {},
		},
		paints = {},
		missions = {
			completed = {},
			progress = {},
		},
		starterDiscountUsed = false,
	}
end

function PlayerDataSchema.validate(profile: any): (boolean, string?)
	if type(profile) ~= "table" then
		return false, "profile must be a table"
	end
	if profile.version ~= PlayerDataSchema.VERSION then
		return false, "unsupported profile version"
	end
	if not isNonNegativeInteger(profile.cash) then
		return false, "cash must be a non-negative integer"
	end
	if type(profile.vehicles) ~= "table" then
		return false, "vehicles must be a table"
	end
	if not isStringArray(profile.vehicles.owned) then
		return false, "vehicles.owned must be a string array"
	end
	if type(profile.vehicles.selected) ~= "string" then
		return false, "vehicles.selected must be a string"
	end
	if not contains(profile.vehicles.owned, profile.vehicles.selected) then
		return false, "vehicles.selected must be owned"
	end
	if not isCountMap(profile.inventory) then
		return false, "inventory must map item id to count"
	end
	if type(profile.parts) ~= "table" or type(profile.parts.installed) ~= "table" then
		return false, "parts.installed must be a table"
	end
	if type(profile.paints) ~= "table" then
		return false, "paints must be a table"
	end
	if type(profile.missions) ~= "table" then
		return false, "missions must be a table"
	end
	if not isStringArray(profile.missions.completed) then
		return false, "missions.completed must be a string array"
	end
	if type(profile.missions.progress) ~= "table" then
		return false, "missions.progress must be a table"
	end
	if type(profile.starterDiscountUsed) ~= "boolean" then
		return false, "starterDiscountUsed must be a boolean"
	end
	return true, nil
end

function PlayerDataSchema.migrate(profile: any): any
	if type(profile) ~= "table" then
		return PlayerDataSchema.createDefault()
	end
	local defaults: any = PlayerDataSchema.createDefault()
	for key, value in pairs(defaults) do
		if profile[key] == nil then
			profile[key] = value
		end
	end
	if type(profile.vehicles) ~= "table" then
		profile.vehicles = defaults.vehicles
	end
	if not isStringArray(profile.vehicles.owned) or #profile.vehicles.owned == 0 then
		profile.vehicles.owned = { PlayerDataSchema.START_VEHICLE_ID }
	end
	if type(profile.vehicles.selected) ~= "string" or not contains(profile.vehicles.owned, profile.vehicles.selected) then
		profile.vehicles.selected = profile.vehicles.owned[1]
	end
	if type(profile.inventory) ~= "table" then
		profile.inventory = {}
	end
	if type(profile.parts) ~= "table" then
		profile.parts = { installed = {} }
	end
	if type(profile.parts.installed) ~= "table" then
		profile.parts.installed = {}
	end
	if type(profile.paints) ~= "table" then
		profile.paints = {}
	end
	if type(profile.missions) ~= "table" then
		profile.missions = { completed = {}, progress = {} }
	end
	if not isStringArray(profile.missions.completed) then
		profile.missions.completed = {}
	end
	if type(profile.missions.progress) ~= "table" then
		profile.missions.progress = {}
	end
	if type(profile.starterDiscountUsed) ~= "boolean" then
		profile.starterDiscountUsed = false
	end
	if not isNonNegativeInteger(profile.cash) then
		profile.cash = 0
	end
	profile.version = PlayerDataSchema.VERSION
	return profile
end

function PlayerDataSchema.isStarterDiscountAvailable(profile: any): boolean
	return type(profile) == "table" and profile.starterDiscountUsed == false
end

return PlayerDataSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">VehicleCatalog</string>
            <string name="Source"><![CDATA[--!strict
-- VehicleCatalog: statische Definitionen für Fahrrad, Puch Maxi S und Piaggio Ciao.
-- Preis-/Rabattdaten (Pricing) sind strikt von Fahrphysik (Physics) getrennt.
-- Der Katalog wird beim Laden validiert.

export type VehicleClass = "bicycle" | "moped"

export type VehiclePricing = {
	Price: number,
	StarterDiscountEligible: boolean,
	Currency: string,
}

export type VehiclePhysics = {
	TopSpeedKmh: number,
	Acceleration: number,
	Braking: number,
	Handling: number,
	WeightKg: number,
}

export type VehicleFuel = {
	HasEngine: boolean,
	TankLiters: number,
	FuelType: string,
}

export type VehicleDefinition = {
	Id: string,
	Name: string,
	Class: VehicleClass,
	Pricing: VehiclePricing,
	Physics: VehiclePhysics,
	Fuel: VehicleFuel,
	Mounts: { string },
	StockParts: { [string]: string },
	Tunable: boolean,
}

local VehicleCatalog = {}

VehicleCatalog.VERSION = 1

VehicleCatalog.BICYCLE_ID = "bicycle"
VehicleCatalog.PUCH_MAXI_S_ID = "puch_maxi_s"
VehicleCatalog.PIAGGIO_CIAO_ID = "piaggio_ciao"

local BICYCLE_MOUNTS: { string } = {
	"BrakeFront",
	"BrakeRear",
	"WheelFront",
	"WheelRear",
	"LightFront",
}

local MOPED_MOUNTS: { string } = {
	"Cylinder",
	"CylinderHead",
	"Carburetor",
	"Exhaust",
	"AirFilter",
	"IntakeManifold",
	"Handlebar",
	"BrakeFront",
	"BrakeRear",
	"WheelFront",
	"WheelRear",
	"RimFront",
	"RimRear",
	"LightFront",
	"LightRear",
}

local function makeStockParts(mounts: { string }, prefix: string): { [string]: string }
	local parts: { [string]: string } = {}
	for _, slot in mounts do
		parts[slot] = string.format("%s_stock_%s", prefix, string.lower(slot))
	end
	return parts
end

local VEHICLES: { [string]: VehicleDefinition } = {
	bicycle = {
		Id = "bicycle",
		Name = "Startfahrrad",
		Class = "bicycle",
		Pricing = {
			Price = 0,
			StarterDiscountEligible = false,
			Currency = "CHF",
		},
		Physics = {
			TopSpeedKmh = 25,
			Acceleration = 3.0,
			Braking = 6.0,
			Handling = 9.0,
			WeightKg = 15,
		},
		Fuel = {
			HasEngine = false,
			TankLiters = 0,
			FuelType = "none",
		},
		Mounts = BICYCLE_MOUNTS,
		StockParts = makeStockParts(BICYCLE_MOUNTS, "bicycle"),
		Tunable = false,
	},
	puch_maxi_s = {
		Id = "puch_maxi_s",
		Name = "Puch Maxi S",
		Class = "moped",
		Pricing = {
			Price = 1799,
			StarterDiscountEligible = true,
			Currency = "CHF",
		},
		Physics = {
			TopSpeedKmh = 45,
			Acceleration = 6.5,
			Braking = 7.0,
			Handling = 7.5,
			WeightKg = 68,
		},
		Fuel = {
			HasEngine = true,
			TankLiters = 3.8,
			FuelType = "petrol",
		},
		Mounts = MOPED_MOUNTS,
		StockParts = makeStockParts(MOPED_MOUNTS, "puch_maxi_s"),
		Tunable = true,
	},
	piaggio_ciao = {
		Id = "piaggio_ciao",
		Name = "Piaggio Ciao",
		Class = "moped",
		Pricing = {
			Price = 1899,
			StarterDiscountEligible = true,
			Currency = "CHF",
		},
		Physics = {
			TopSpeedKmh = 42,
			Acceleration = 5.8,
			Braking = 6.8,
			Handling = 8.0,
			WeightKg = 55,
		},
		Fuel = {
			HasEngine = true,
			TankLiters = 2.8,
			FuelType = "petrol",
		},
		Mounts = MOPED_MOUNTS,
		StockParts = makeStockParts(MOPED_MOUNTS, "piaggio_ciao"),
		Tunable = true,
	},
}

local function isNonEmptyString(value: unknown): boolean
	return typeof(value) == "string" and (value :: string) ~= ""
end

local function isPositiveNumber(value: unknown): boolean
	return typeof(value) == "number" and (value :: number) > 0
end

local function isNonNegativeNumber(value: unknown): boolean
	return typeof(value) == "number" and (value :: number) >= 0
end

function VehicleCatalog.validate(): boolean
	local count = 0
	for key, vehicle in VEHICLES do
		count += 1
		assert(key == vehicle.Id, string.format("vehicle key '%s' must match Id '%s'", tostring(key), tostring(vehicle.Id)))
		assert(isNonEmptyString(vehicle.Id), "vehicle Id must be a non-empty string")
		assert(isNonEmptyString(vehicle.Name), string.format("vehicle '%s' needs a name", tostring(vehicle.Id)))
		assert(vehicle.Class == "bicycle" or vehicle.Class == "moped", string.format("vehicle '%s' has invalid class", tostring(vehicle.Id)))

		-- Pricing getrennt von Physics prüfen.
		assert(vehicle.Pricing ~= nil, string.format("vehicle '%s' needs Pricing", tostring(vehicle.Id)))
		assert(vehicle.Physics ~= nil, string.format("vehicle '%s' needs Physics", tostring(vehicle.Id)))
		assert((vehicle.Pricing :: any).TopSpeedKmh == nil, string.format("vehicle '%s': physics must not leak into Pricing", tostring(vehicle.Id)))
		assert((vehicle.Physics :: any).Price == nil, string.format("vehicle '%s': price must not leak into Physics", tostring(vehicle.Id)))
		assert(isNonNegativeNumber(vehicle.Pricing.Price), string.format("vehicle '%s' needs Price >= 0", tostring(vehicle.Id)))
		assert(typeof(vehicle.Pricing.StarterDiscountEligible) == "boolean", string.format("vehicle '%s' needs StarterDiscountEligible flag", tostring(vehicle.Id)))
		assert(isNonEmptyString(vehicle.Pricing.Currency), string.format("vehicle '%s' needs Currency", tostring(vehicle.Id)))

		assert(isPositiveNumber(vehicle.Physics.TopSpeedKmh), string.format("vehicle '%s' needs TopSpeedKmh > 0", tostring(vehicle.Id)))
		assert(isPositiveNumber(vehicle.Physics.Acceleration), string.format("vehicle '%s' needs Acceleration > 0", tostring(vehicle.Id)))
		assert(isPositiveNumber(vehicle.Physics.Braking), string.format("vehicle '%s' needs Braking > 0", tostring(vehicle.Id)))
		assert(isPositiveNumber(vehicle.Physics.Handling), string.format("vehicle '%s' needs Handling > 0", tostring(vehicle.Id)))
		assert(isPositiveNumber(vehicle.Physics.WeightKg), string.format("vehicle '%s' needs WeightKg > 0", tostring(vehicle.Id)))

		assert(vehicle.Fuel ~= nil, string.format("vehicle '%s' needs Fuel", tostring(vehicle.Id)))
		assert(typeof(vehicle.Fuel.HasEngine) == "boolean", string.format("vehicle '%s' needs Fuel.HasEngine", tostring(vehicle.Id)))
		assert(isNonNegativeNumber(vehicle.Fuel.TankLiters), string.format("vehicle '%s' needs TankLiters >= 0", tostring(vehicle.Id)))

		if vehicle.Class == "bicycle" then
			assert(vehicle.Fuel.HasEngine == false, "bicycle must not have an engine")
			assert(vehicle.Fuel.TankLiters == 0, "bicycle must have TankLiters == 0")
			assert(vehicle.Pricing.Price == 0, "bicycle must be free")
			assert(vehicle.Tunable == false, "bicycle must not expose a tuning interface")
		else
			assert(vehicle.Fuel.HasEngine == true, string.format("moped '%s' needs an engine", tostring(vehicle.Id)))
			assert(vehicle.Fuel.TankLiters > 0, string.format("moped '%s' needs TankLiters > 0", tostring(vehicle.Id)))
			assert(vehicle.Pricing.Price > 0, string.format("moped '%s' needs Price > 0", tostring(vehicle.Id)))
			assert(vehicle.Tunable == true, string.format("moped '%s' must be tunable", tostring(vehicle.Id)))
		end

		assert(typeof(vehicle.Mounts) == "table", string.format("vehicle '%s' needs Mounts", tostring(vehicle.Id)))
		assert(#vehicle.Mounts > 0, string.format("vehicle '%s' needs at least one mount", tostring(vehicle.Id)))
		assert(typeof(vehicle.StockParts) == "table", string.format("vehicle '%s' needs StockParts", tostring(vehicle.Id)))
		for _, slot in vehicle.Mounts do
			assert(isNonEmptyString(slot), string.format("vehicle '%s' has invalid mount slot", tostring(vehicle.Id)))
			assert(isNonEmptyString(vehicle.StockParts[slot]), string.format("vehicle '%s' misses stock part for slot '%s'", tostring(vehicle.Id), tostring(slot)))
		end
	end
	assert(count == 3, string.format("catalog must contain exactly 3 vehicles, found %d", count))
	assert(VEHICLES.bicycle ~= nil, "catalog misses 'bicycle'")
	assert(VEHICLES.puch_maxi_s ~= nil, "catalog misses 'puch_maxi_s'")
	assert(VEHICLES.piaggio_ciao ~= nil, "catalog misses 'piaggio_ciao'")
	return true
end

function VehicleCatalog.get(vehicleId: string): VehicleDefinition?
	return VEHICLES[vehicleId]
end

function VehicleCatalog.list(): { VehicleDefinition }
	return { VEHICLES.bicycle, VEHICLES.puch_maxi_s, VEHICLES.piaggio_ciao }
end

function VehicleCatalog.isMoped(vehicleId: string): boolean
	local vehicle = VEHICLES[vehicleId]
	return vehicle ~= nil and vehicle.Class == "moped"
end

function VehicleCatalog.hasEngine(vehicleId: string): boolean
	local vehicle = VEHICLES[vehicleId]
	return vehicle ~= nil and vehicle.Fuel.HasEngine == true
end

assert(VehicleCatalog.validate(), "VehicleCatalog failed validation on load")

return VehicleCatalog
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="65">
        <Properties>
          <string name="Name">net</string>
        </Properties>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[-- RateLimiter: pro Spieler und Aktion begrenzte Anfragefenster
-- plus Schutz gegen doppelt parallel laufende Aktionen.
-- Keine globalen Variablen.

export type LimitConfig = {
	limit: number,
	window: number,
}

export type LimiterOptions = {
	defaultLimit: number?,
	defaultWindow: number?,
}

local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type Limiter = typeof(setmetatable(
	{} :: {
		_defaultLimit: number,
		_defaultWindow: number,
		_limits: { [string]: LimitConfig },
		_hits: { [string]: { number } },
		_locks: { [string]: boolean },
	},
	RateLimiter
))

local function normalizeLimit(limit: any, fallback: number): number
	if type(limit) ~= "number" or limit ~= limit or limit < 1 then
		return fallback
	end
	return math.floor(limit)
end

local function normalizeWindow(window: any, fallback: number): number
	if type(window) ~= "number" or window ~= window or window <= 0 then
		return fallback
	end
	return window
end

local function playerKey(player: any): string
	if type(player) == "table" then
		local userId = (player :: any).UserId
		if type(userId) == "number" and userId > 0 and userId == userId then
			return "user:" .. tostring(math.floor(userId))
		end
	elseif type(player) == "number" then
		if player > 0 and player == player then
			return "user:" .. tostring(math.floor(player))
		end
	elseif type(player) == "string" and player ~= "" then
		return "user:" .. player
	end
	return "user:unknown"
end

local function bucketKey(player: any, action: string): string
	return playerKey(player) .. "|" .. action
end

local function clockNow(): number
	return os.clock()
end

function RateLimiter.new(opts: LimiterOptions?): Limiter
	local o: LimiterOptions = opts or {}
	local self = setmetatable({
		_defaultLimit = normalizeLimit(o.defaultLimit, 30),
		_defaultWindow = normalizeWindow(o.defaultWindow, 1.0),
		_limits = {},
		_hits = {},
		_locks = {},
	}, RateLimiter)
	return self :: any
end

function RateLimiter:getLimit(action: string): LimitConfig
	local configured = self._limits[action]
	if configured ~= nil then
		return { limit = configured.limit, window = configured.window }
	end
	return { limit = self._defaultLimit, window = self._defaultWindow }
end

function RateLimiter:setLimit(action: string, limit: number, window: number): boolean
	if type(action) ~= "string" or action == "" then
		error("setLimit: action must be a non-empty string")
	end
	local cleanLimit = normalizeLimit(limit, 0)
	local cleanWindow = normalizeWindow(window, 0)
	if cleanLimit < 1 then
		error("setLimit: limit must be >= 1")
	end
	if cleanWindow <= 0 then
		error("setLimit: window must be > 0")
	end
	self._limits[action] = { limit = cleanLimit, window = cleanWindow }
	return true
end

function RateLimiter:clearLimit(action: string): boolean
	if type(action) ~= "string" then
		return false
	end
	if self._limits[action] == nil then
		return false
	end
	self._limits[action] = nil
	return true
end

-- Prueft ein Anfragefenster und verbraucht bei Erfolg einen Slot.
-- `nowOverride` ist nur fuer deterministische Tests gedacht.
function RateLimiter:check(player: any, action: any, nowOverride: number?): boolean
	if type(action) ~= "string" or action == "" then
		return false
	end
	if playerKey(player) == "user:unknown" then
		return false
	end
	local now: number
	if type(nowOverride) == "number" and (nowOverride :: number) == (nowOverride :: number) then
		now = nowOverride :: number
	else
		now = clockNow()
	end
	local config = self:getLimit(action)
	local key = bucketKey(player, action)
	local hits = self._hits[key]
	if hits == nil then
		hits = {}
		self._hits[key] = hits
	end
	local kept: { number } = {}
	for _, stamp in hits do
		if type(stamp) == "number" and now - stamp < config.window then
			table.insert(kept, stamp)
		end
	end
	if #kept >= config.limit then
		self._hits[key] = kept
		return false
	end
	table.insert(kept, now)
	self._hits[key] = kept
	return true
end

-- In-Flight-Schutz: verhindert doppelte parallel laufende
-- Kaeufe, Missionen oder Umbauten desselben Spielers.
function RateLimiter:acquire(player: any, action: any): boolean
	if type(action) ~= "string" or action == "" then
		return false
	end
	if playerKey(player) == "user:unknown" then
		return false
	end
	local key = bucketKey(player, action)
	if self._locks[key] == true then
		return false
	end
	self._locks[key] = true
	return true
end

function RateLimiter:release(player: any, action: any): boolean
	if type(action) ~= "string" or action == "" then
		return false
	end
	local key = bucketKey(player, action)
	if self._locks[key] ~= true then
		return false
	end
	self._locks[key] = nil
	return true
end

function RateLimiter:isLocked(player: any, action: any): boolean
	if type(action) ~= "string" or action == "" then
		return false
	end
	return self._locks[bucketKey(player, action)] == true
end

function RateLimiter:reset(): boolean
	self._hits = {}
	self._locks = {}
	return true
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">RemoteProtocol</string>
            <string name="Source"><![CDATA[-- RemoteProtocol: versionierte Remote-Namen und Payload-Schemas.
-- Rein datengetrieben, ohne Roblox-Laufzeit. Keine globalen Variablen.

local RemoteProtocol = {}

RemoteProtocol.PROTOCOL_VERSION = 1

RemoteProtocol.REMOTES = {
	REQUEST = "TT_Request_v1",
	RESPONSE = "TT_Response_v1",
}

RemoteProtocol.ACTIONS = {
	PING = "ping",
	ECHO = "echo",
	DELIVERY_ORDER = "DeliveryOrder",
	DELIVERY_PICKUP = "DeliveryPickup",
	DELIVERY_DELIVER = "DeliveryDeliver",
}

-- Kanonische Remote-Namen für Protokoll v1. Aktion und Remote heissen gleich,
-- damit der RequestRouter ohne Zusatzabbildung dispatchen kann.
local REMOTE_NAMES: { string } = {
	"EconomyGet",
	"EconomyTransfer",
	"VehicleBuy",
	"VehicleSelect",
	"MissionProgress",
	"DeliveryOrder",
	"DeliveryPickup",
	"DeliveryDeliver",
	"GarageEnter",
	"WorkshopInstall",
	"WorkshopPaint",
	"ShopCatalog",
	"ShopBuy",
	"DynoRun",
	"FuelRefill",
}

-- Payloads v1. Nur der Fahrzeugtyp kommt vom Client; `orderId` ist optional,
-- weil ein Spieler genau einen aktiven Auftrag besitzt. Preise, Distanzen,
-- Belohnungen und Zustandswechsel werden nie im Payload übertragen.
local PAYLOAD_SCHEMAS: { [string]: { [string]: { kind: string, required: boolean } } } = {
	ping = {},
	echo = {
		message = { kind = "string", required = true },
	},
	EconomyGet = {},
	EconomyTransfer = {
		targetUserId = { kind = "number", required = false },
	},
	VehicleSelect = {
		action = { kind = "string", required = false },
	},
	VehicleBuy = {
		vehicleId = { kind = "string", required = true },
	},
	MissionProgress = {
		missionKey = { kind = "string", required = false },
		claim = { kind = "boolean", required = false },
	},
	GarageEnter = {},
	WorkshopInstall = {
		vehicleId = { kind = "string", required = true },
		partId = { kind = "string", required = true },
	},
	WorkshopPaint = {
		vehicleId = { kind = "string", required = true },
		surface = { kind = "string", required = true },
		color = { kind = "string", required = true },
	},
	ShopCatalog = {
		modelFilter = { kind = "string", required = false },
	},
	ShopBuy = {
		partId = { kind = "string", required = true },
		source = { kind = "string", required = false },
	},
	DynoRun = {
		vehicleId = { kind = "string", required = true },
	},
	FuelRefill = {
		action = { kind = "string", required = false },
		vehicleId = { kind = "string", required = false },
		liters = { kind = "number", required = false },
	},
	DeliveryOrder = {
		vehicleType = { kind = "string", required = true },
	},
	DeliveryPickup = {
		orderId = { kind = "string", required = false },
	},
	DeliveryDeliver = {
		orderId = { kind = "string", required = false },
	},
}

function RemoteProtocol.getRemoteNames(): { REQUEST: string, RESPONSE: string }
	return {
		REQUEST = RemoteProtocol.REMOTES.REQUEST,
		RESPONSE = RemoteProtocol.REMOTES.RESPONSE,
	}
end

function RemoteProtocol.listRemoteNames(): { string }
	local names: { string } = {}
	for _, name in REMOTE_NAMES do
		table.insert(names, name)
	end
	return names
end

function RemoteProtocol.isKnownAction(action: any): boolean
	if type(action) ~= "string" then
		return false
	end
	return PAYLOAD_SCHEMAS[action] ~= nil
end

function RemoteProtocol.getSchema(action: string): any
	if type(action) ~= "string" then
		return nil
	end
	return PAYLOAD_SCHEMAS[action]
end

function RemoteProtocol.defineAction(action: string, schema: { [string]: { kind: string, required: boolean } }): boolean
	if type(action) ~= "string" or action == "" then
		return false
	end
	if type(schema) ~= "table" then
		return false
	end
	if PAYLOAD_SCHEMAS[action] ~= nil then
		return false
	end
	PAYLOAD_SCHEMAS[action] = schema
	return true
end

function RemoteProtocol.validatePayload(action: any, payload: any): (boolean, string?)
	if type(action) ~= "string" then
		return false, "unknown_action"
	end
	local schema = PAYLOAD_SCHEMAS[action]
	if schema == nil then
		return false, "unknown_action"
	end
	if type(payload) ~= "table" then
		return false, "invalid_payload"
	end
	local typedPayload = payload :: { [string]: any }
	for fieldName, rule in pairs(schema) do
		local value = typedPayload[fieldName]
		if value == nil then
			if rule.required then
				return false, "invalid_payload"
			end
		elseif type(value) ~= rule.kind then
			return false, "invalid_payload"
		end
	end
	return true, nil
end

return RemoteProtocol
]]></string>
          </Properties>
        </Item>
