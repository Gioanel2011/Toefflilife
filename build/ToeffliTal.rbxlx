      <Item class="Folder" referent="68">
        <Properties>
          <string name="Name">vehicle</string>
        </Properties>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">StatsCalculator</string>
            <string name="Source"><![CDATA[--!strict
-- StatsCalculator: gemeinsamer, deterministischer Fahrzeugstatistik-Rechner.
-- Versorgt Fahrphysik (Client) und Pruefstand (Server) mit identischen Werten.
-- Rein datengetrieben: nimmt Basiswerte + Teile entgegen, keine Katalog-Imports,
-- keine globalen Variablen, keine Mutation der Eingaben.

local StatsCalculator = {}

-- Slots mit Motorbezug: duerfen nicht an ein Fahrrad verbaut werden.
StatsCalculator.MOTOR_SLOTS = {
	cylinder = true,
	cylinderHead = true,
	carburetor = true,
	exhaust = true,
	airFilter = true,
	intakeManifold = true,
}

-- Slots, in denen hoechstens ein Teil pro Setup sitzen darf (alle bekannten Slots).
-- Unbekannte Slots werden akzeptiert, solange sie nicht doppelt belegt sind.
StatsCalculator.KNOWN_SLOTS = {
	cylinder = true,
	cylinderHead = true,
	carburetor = true,
	exhaust = true,
	airFilter = true,
	intakeManifold = true,
	handlebar = true,
	brakes = true,
	wheels = true,
	rims = true,
	lamp = true,
}

-- Plausible Arcade-Clamps (deterministisch, Dyno + Physik teilen sie).
StatsCalculator.LIMITS = {
	powerKw = { min = 0.1, max = 30 },
	torqueNm = { min = 0, max = 60 },
	topSpeedKmh = { min = 5, max = 120 },
	acceleration = { min = 0.5, max = 15 },
	braking = { min = 1, max = 30 },
	grip = { min = 0.1, max = 3 },
	consumption = { min = 0, max = 10 },
	weightKg = { min = 5, max = 300 },
}

export type TorquePoint = { rpm: number, torqueNm: number }
export type StatDeltas = {
	powerKw: number?,
	torqueNm: number?,
	topSpeedKmh: number?,
	acceleration: number?,
	braking: number?,
	grip: number?,
	consumption: number?,
	weightKg: number?,
}
export type BaseVehicle = {
	id: string,
	modelId: string?,
	powerKw: number,
	torqueNm: number,
	topSpeedKmh: number,
	acceleration: number,
	braking: number,
	grip: number,
	consumption: number,
	weightKg: number?,
}
export type Part = {
	id: string,
	slot: string,
	compatibleModels: { string }?,
	statDeltas: StatDeltas?,
}
export type VehicleStats = {
	vehicleId: string,
	powerKw: number,
	peakTorqueNm: number,
	torqueCurve: { TorquePoint },
	topSpeedKmh: number,
	acceleration: number,
	braking: number,
	grip: number,
	consumptionPer100Km: number,
	weightKg: number,
	partCount: number,
}

local function round3(value: number): number
	if value >= 0 then
		return math.floor(value * 1000 + 0.5) / 1000
	else
		return math.ceil(value * 1000 - 0.5) / 1000
	end
end

local function clamp(value: number, minValue: number, maxValue: number): number
	if value < minValue then
		return minValue
	elseif value > maxValue then
		return maxValue
	else
		return value
	end
end

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function modelKeyOf(base: BaseVehicle): string
	if type(base.modelId) == "string" and (base.modelId :: string) ~= "" then
		return base.modelId :: string
	end
	return base.id
end

local function isBicycle(base: BaseVehicle): boolean
	local key = string.lower(modelKeyOf(base))
	return key == "bicycle" or key == "bike" or key == "fahrrad" or key == "startfahrrad"
end

-- Drehmomentverlauf aus Spitzenleistung/-moment. Fixe 5-Punkt-Kurve,
-- damit Dyno-Anzeige und Physik exakt dieselbe Kurve sehen.
function StatsCalculator.calculateTorqueCurve(powerKw: number, peakTorqueNm: number): { TorquePoint }
	if not isFiniteNumber(powerKw) or not isFiniteNumber(peakTorqueNm) then
		return {}
	end
	if peakTorqueNm <= 0 or powerKw <= 0 then
		return {}
	end
	local shape = {
		{ rpm = 2000, factor = 0.55 },
		{ rpm = 4000, factor = 0.8 },
		{ rpm = 6000, factor = 1.0 },
		{ rpm = 7500, factor = 0.9 },
		{ rpm = 9000, factor = 0.7 },
	}
	local curve: { TorquePoint } = {}
	for _, point in ipairs(shape) do
		table.insert(curve, {
			rpm = point.rpm,
			torqueNm = round3(peakTorqueNm * point.factor),
		})
	end
	return curve
end

-- Prueft nur die Setup-Gueltigkeit (Slots, Kompatibilitaet), ohne zu rechnen.
function StatsCalculator.validateSetup(base: any, parts: any): (boolean, string?)
	if type(base) ~= "table" then
		return false, "base must be a table"
	end
	local baseVehicle = base :: BaseVehicle
	if type(baseVehicle.id) ~= "string" or baseVehicle.id == "" then
		return false, "base.id must be a non-empty string"
	end
	for _, field in ipairs({ "powerKw", "torqueNm", "topSpeedKmh", "acceleration", "braking", "grip", "consumption" }) do
		local value = (baseVehicle :: any)[field]
		if not isFiniteNumber(value) then
			return false, "base." .. field .. " must be a finite number"
		end
	end
	if baseVehicle.powerKw <= 0 then
		return false, "base.powerKw must be positive"
	end
	if baseVehicle.topSpeedKmh <= 0 then
		return false, "base.topSpeedKmh must be positive"
	end
	if parts ~= nil and type(parts) ~= "table" then
		return false, "parts must be an array table or nil"
	end
	local seenSlots: { [string]: boolean } = {}
	local modelKey = modelKeyOf(baseVehicle)
	local bicycle = isBicycle(baseVehicle)
	for index, partAny in ipairs((parts or {}) :: any) do
		if type(partAny) ~= "table" then
			return false, "parts[" .. tostring(index) .. "] must be a table"
		end
		local part = partAny :: Part
		if type(part.id) ~= "string" or part.id == "" then
			return false, "parts[" .. tostring(index) .. "].id must be a non-empty string"
		end
		if type(part.slot) ~= "string" or part.slot == "" then
			return false, "parts[" .. tostring(index) .. "].slot must be a non-empty string"
		end
		if seenSlots[part.slot] then
			return false, "duplicate slot: " .. part.slot
		end
		seenSlots[part.slot] = true
		if bicycle and StatsCalculator.MOTOR_SLOTS[part.slot] then
			return false, "bicycle has no motor slot: " .. part.slot
		end
		if part.compatibleModels ~= nil then
			if type(part.compatibleModels) ~= "table" then
				return false, "parts[" .. tostring(index) .. "].compatibleModels must be an array"
			end
			local compatible = false
			for _, model in ipairs(part.compatibleModels) do
				if model == modelKey or model == baseVehicle.id then
					compatible = true
					break
				end
			end
			if not compatible then
				return false, "part " .. part.id .. " incompatible with " .. modelKey
			end
		end
		if part.statDeltas ~= nil then
			if type(part.statDeltas) ~= "table" then
				return false, "parts[" .. tostring(index) .. "].statDeltas must be a table"
			end
			for deltaKey, deltaValue in pairs(part.statDeltas :: any) do
				if deltaValue ~= nil and not isFiniteNumber(deltaValue) then
					return false,
						"parts["
							.. tostring(index)
							.. "].statDeltas."
							.. tostring(deltaKey)
							.. " must be a finite number"
				end
			end
		end
	end
	return true, nil
end

-- Hauptfunktion: Basis + Teile -> abgeleitete Stats. Gibt (nil, Fehler) bei
-- ungueltigen oder inkompatiblen Setups zurueck; sonst (Stats, nil).
function StatsCalculator.calculate(base: any, parts: any): (VehicleStats?, string?)
	local ok, err = StatsCalculator.validateSetup(base, parts)
	if not ok then
		return nil, err
	end
	local baseVehicle = base :: BaseVehicle
	local partList: { Part } = (parts or {}) :: { Part }

	local sumPower = 0
	local sumTorque = 0
	local sumTopSpeed = 0
	local sumAccel = 0
	local sumBraking = 0
	local sumGrip = 0
	local sumConsumption = 0
	local sumWeight = 0
	for _, part in ipairs(partList) do
		local deltas: any = part.statDeltas or {}
		if deltas.powerKw ~= nil then
			sumPower += deltas.powerKw
		end
		if deltas.torqueNm ~= nil then
			sumTorque += deltas.torqueNm
		end
		if deltas.topSpeedKmh ~= nil then
			sumTopSpeed += deltas.topSpeedKmh
		end
		if deltas.acceleration ~= nil then
			sumAccel += deltas.acceleration
		end
		if deltas.braking ~= nil then
			sumBraking += deltas.braking
		end
		if deltas.grip ~= nil then
			sumGrip += deltas.grip
		end
		if deltas.consumption ~= nil then
			sumConsumption += deltas.consumption
		end
		if deltas.weightKg ~= nil then
			sumWeight += deltas.weightKg
		end
	end

	local limits = StatsCalculator.LIMITS
	local power = baseVehicle.powerKw + sumPower
	local torque = baseVehicle.torqueNm + sumTorque
	local topSpeed = baseVehicle.topSpeedKmh + sumTopSpeed
	local accel = baseVehicle.acceleration + sumAccel
	local braking = baseVehicle.braking + sumBraking
	local grip = baseVehicle.grip + sumGrip
	local consumption = baseVehicle.consumption + sumConsumption
	local baseWeight = baseVehicle.weightKg or 80
	if not isFiniteNumber(baseWeight) then
		return nil, "base.weightKg must be a finite number"
	end
	local weight = baseWeight + sumWeight

	-- Harte Ablehnung vor dem Clampen: physikalisch unsinnige Ergebnisse.
	if power <= 0 then
		return nil, "resulting power must be positive"
	end
	if topSpeed <= 0 then
		return nil, "resulting topSpeed must be positive"
	end
	if torque < 0 or braking <= 0 or grip <= 0 or weight <= 0 then
		return nil, "resulting stats implausible"
	end
	if consumption < 0 then
		return nil, "resulting consumption must not be negative"
	end
	-- Fahrrad: kein Treibstoff, kein Motordrehmoment.
	if isBicycle(baseVehicle) then
		if consumption ~= 0 then
			return nil, "bicycle must not consume fuel"
		end
		if torque ~= 0 then
			return nil, "bicycle has no engine torque"
		end
	end

	power = clamp(power, limits.powerKw.min, limits.powerKw.max)
	torque = clamp(torque, limits.torqueNm.min, limits.torqueNm.max)
	topSpeed = clamp(topSpeed, limits.topSpeedKmh.min, limits.topSpeedKmh.max)
	accel = clamp(accel, limits.acceleration.min, limits.acceleration.max)
	braking = clamp(braking, limits.braking.min, limits.braking.max)
	grip = clamp(grip, limits.grip.min, limits.grip.max)
	consumption = clamp(consumption, limits.consumption.min, limits.consumption.max)
	weight = clamp(weight, limits.weightKg.min, limits.weightKg.max)

	local stats: VehicleStats = {
		vehicleId = baseVehicle.id,
		powerKw = round3(power),
		peakTorqueNm = round3(torque),
		torqueCurve = StatsCalculator.calculateTorqueCurve(power, torque),
		topSpeedKmh = round3(topSpeed),
		acceleration = round3(accel),
		braking = round3(braking),
		grip = round3(grip),
		consumptionPer100Km = round3(consumption),
		weightKg = round3(weight),
		partCount = #partList,
	}
	return stats, nil
end

return StatsCalculator
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="70">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="71">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="72">
        <Properties>
          <string name="Name">bootstrap</string>
          <string name="Source"><![CDATA[--!strict
-- ToeffliTal Client Bootstrap: verdrahtet Controller und UI in der
-- Reihenfolge Remotes -> Fahrzeugwerte -> Controller -> Terminal -> Spawn/UI.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local localPlayer = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared")
local RemoteProtocol = require(Shared:WaitForChild("net"):WaitForChild("RemoteProtocol"))

local ClientRoot = script.Parent
local BicycleController = require(ClientRoot:WaitForChild("controllers"):WaitForChild("BicycleController"))
local MopedController = require(ClientRoot:WaitForChild("controllers"):WaitForChild("MopedController"))
local GrassController = require(ClientRoot:WaitForChild("controllers"):WaitForChild("GrassController"))
local ShopTerminal = require(ClientRoot:WaitForChild("ui"):WaitForChild("ShopTerminal"))
local DeliveryPrompt = require(ClientRoot:WaitForChild("ui"):WaitForChild("DeliveryPrompt"))

-- Ein Controller pro Client; verdrahtet E-Auf-/Absteigen im BicycleController.
local bicycleController = BicycleController.new()
local grassController = GrassController.new()

local deliveryPrompt: any = nil

local connections: { RBXScriptConnection } = {}

local function getModuleFn(module: any, name: string): any
	local fn = (module :: any)[name]
	if typeof(fn) == "function" then
		return fn
	end
	return nil
end

local function callOptional(module: any, name: string, ...: any): any
	local fn = getModuleFn(module, name)
	if fn then
		return (fn :: any)(module, ...)
	end
	return nil
end

-- 1. Auf versionierte Remotes warten; sendet nur validierte Shop-Anfragen.
local function waitForRemotes(): Folder
	local netFolder = ReplicatedStorage:WaitForChild("ToeffliTalRemotes", 30) :: Instance
	assert(netFolder and netFolder:IsA("Folder"), "ToeffliTalRemotes missing")
	-- Protokollnamen gegen vorhandene Remotes prüfen, ohne Clientwerte zu vertrauen.
	local expected: { string }? = nil
	local listFn = getModuleFn(RemoteProtocol, "listRemoteNames")
	if listFn then
		local ok, result = pcall(listFn, RemoteProtocol)
		if ok and typeof(result) == "table" then
			expected = result :: { string }
		end
	end
	if expected then
		for _, remoteName in expected do
			(netFolder :: Folder):WaitForChild(remoteName, 30)
		end
	end
	return netFolder :: Folder
end

local function requestViaRouter(netFolder: Folder, action: string, payload: any): any
	local remote = netFolder:FindFirstChild(action)
	if remote and remote:IsA("RemoteFunction") then
		local ok, result = pcall(function()
			return (remote :: RemoteFunction):InvokeServer(payload)
		end)
		if ok then
			return result
		end
	end
	return nil
end

-- 2-4. Controller mit serverseitig gelieferten Fahrzeugwerten starten.
local function setupControllers(netFolder: Folder): ()
	-- Fahrzeugauswahl und Werte kommen ausschliesslich vom Server.
	local vehicleSnapshot = requestViaRouter(netFolder, "VehicleSelect", { action = "getActive" })
	callOptional(MopedController, "init", {
		remotes = netFolder,
		vehicle = vehicleSnapshot,
		onFuelEmpty = function()
			requestViaRouter(netFolder, "FuelRefill", { action = "requestRescue" })
		end,
	})
	bicycleController:Start()
	callOptional(MopedController, "start")
	grassController:Start()
end

-- Laptop-Terminal: nur Katalog/Bestellung, kein Einbau oder Lackierung.
local function setupShopTerminal(netFolder: Folder): ()
	callOptional(ShopTerminal, "init", {
		onCatalog = function()
			return requestViaRouter(netFolder, "ShopCatalog", { action = "list" })
		end,
		onBuy = function(partId: string)
			return requestViaRouter(netFolder, "ShopBuy", { action = "buy", partId = partId })
		end,
	})
end

-- Döner-Lieferprompt: kleine, kontrastreiche UI ohne E-Tastenbindung.
local function setupDeliveryPrompt(netFolder: Folder): ()
	local client = {
		request = function(_self: any, action: string, payload: any): any
			return requestViaRouter(netFolder, action, payload)
		end,
		getVehicleType = function(): string
			if bicycleController.IsMounted and bicycleController:IsMounted() then
				return "bicycle"
			end
			return "moped"
		end,
	}
	deliveryPrompt = DeliveryPrompt.new(client)
	local playerGui: Instance? = nil
	if localPlayer ~= nil then
		local player = localPlayer :: Player
		playerGui = player:FindFirstChild("PlayerGui")
		if playerGui == nil then
			playerGui = player:WaitForChild("PlayerGui", 10)
		end
	end
	if playerGui ~= nil then
		callOptional(deliveryPrompt, "buildGui", playerGui)
	end
	callOptional(deliveryPrompt, "open")
end

local function onCharacterAdded(character: Model): ()
	-- Spawn: Controller an neuem Charakter einhängen, UI-Zustand zurücksetzen.
	bicycleController:OnCharacterAdded(character)
	callOptional(MopedController, "onCharacterAdded", character)
	callOptional(ShopTerminal, "onCharacterAdded", character)
	if deliveryPrompt ~= nil then
		callOptional(deliveryPrompt, "onCharacterAdded", character)
	end
end

local function watchSpawn(): ()
	if localPlayer == nil then
		return
	end
	local player = localPlayer :: Player
	local existing = player.Character
	if existing then
		task.spawn(onCharacterAdded, existing)
	end
	table.insert(connections, player.CharacterAdded:Connect(onCharacterAdded))
end

local function shutdown(): ()
	for _, conn in connections do
		conn:Disconnect()
	end
	table.clear(connections)
	callOptional(ShopTerminal, "destroy")
	if deliveryPrompt ~= nil then
		callOptional(deliveryPrompt, "destroy")
	end
	callOptional(MopedController, "stop")
	grassController:Stop()
	bicycleController:Stop()
end

local function init(): ()
	local netFolder = waitForRemotes()
	setupControllers(netFolder)
	setupShopTerminal(netFolder)
	setupDeliveryPrompt(netFolder)
	watchSpawn()
	if localPlayer then
		-- Sauberes Verlassen: Controller stoppen, keine offenen Requests.
		table.insert(
			connections,
			(localPlayer :: Player).AncestryChanged:Connect(function()
				if not (localPlayer :: Player):IsDescendantOf(game) then
					shutdown()
				end
			end)
		)
	end
	local name = "unknown"
	if localPlayer then
		name = (localPlayer :: Player).Name
	end
	print("[ToeffliTal][Client] Bootstrap ready for " .. name .. ": controllers + terminal wired")
end

init()
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="73">
        <Properties>
          <string name="Name">controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">BicycleController</string>
            <string name="Source"><![CDATA[--!strict
-- BicycleController: Arcade-PC-Steuerung fuer das kostenlose Startfahrrad.
-- Kein Motor, kein Treibstoff, keine Tuning-Schnittstelle.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local BicycleController = {}
BicycleController.__index = BicycleController

export type BicycleController = typeof(setmetatable(
	{} :: {
		_mounted: boolean,
		_speed: number,
		_bike: Model?,
		_seat: Seat?,
		_throttle: number,
		_steer: number,
		_brake: boolean,
		_mountDebounceUntil: number,
		_inputBegan: RBXScriptConnection?,
		_inputEnded: RBXScriptConnection?,
		_stepped: RBXScriptConnection?,
		_keys: { [Enum.KeyCode]: boolean },
	},
	BicycleController
))

-- Fahrwerte (studs/s, Arcade-Abstimmung).
local MAX_SPEED = 18
local MAX_REVERSE_SPEED = 4
local ACCELERATION = 12
local BRAKE_DECELERATION = 22
local COAST_FRICTION = 6
local TURN_RATE = 1.9
local MOUNT_DISTANCE = 10
local MOUNT_COOLDOWN = 0.5

-- Auf-/Absteigen per PC-Taste. Es wird nur das eigene Startfahrrad gewaehlt.
local BICYCLE_TAG = "ToeffliBicycle"
local MOUNT_KEY = Enum.KeyCode.E

local function getCharacterRoot(player: Player): BasePart?
	local character = player.Character
	if character == nil then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getCharacterHumanoid(player: Player): Humanoid?
	local character = player.Character
	if character == nil then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

local function findSeat(bike: Model): Seat?
	local seat = bike:FindFirstChild("Seat", true)
	if seat ~= nil and seat:IsA("Seat") then
		return seat
	end
	return nil
end

local function findDrivePart(bike: Model): BasePart?
	local primary = bike.PrimaryPart
	if primary ~= nil then
		return primary
	end
	local root = bike:FindFirstChild("Drive", true)
	if root ~= nil and root:IsA("BasePart") then
		return root
	end
	return bike:FindFirstChildWhichIsA("BasePart", true)
end

-- Naechstes eigenes Fahrrad in Reichweite; fremde Fahrzeuge bleiben unberuehrt.
local function findNearestOwnedBicycle(player: Player, maxDistance: number): Model?
	local root = getCharacterRoot(player)
	if root == nil then
		return nil
	end

	local nearest: Model? = nil
	local nearestDistance = maxDistance
	for _, instance in CollectionService:GetTagged(BICYCLE_TAG) do
		if instance:IsA("Model") and instance:IsDescendantOf(workspace) then
			local bike = instance :: Model
			if bike:GetAttribute("OwnerUserId") == player.UserId then
				local drive = findDrivePart(bike)
				if drive ~= nil then
					local distance = (drive.Position - root.Position).Magnitude
					if distance <= nearestDistance then
						nearest = bike
						nearestDistance = distance
					end
				end
			end
		end
	end
	return nearest
end

function BicycleController.new(): BicycleController
	local self = setmetatable({
		_mounted = false,
		_speed = 0,
		_bike = nil,
		_seat = nil,
		_throttle = 0,
		_steer = 0,
		_brake = false,
		_mountDebounceUntil = 0,
		_inputBegan = nil,
		_inputEnded = nil,
		_stepped = nil,
		_keys = {},
	}, BicycleController)
	return self
end

function BicycleController.IsMounted(self: BicycleController): boolean
	return self._mounted
end

function BicycleController.GetSpeed(self: BicycleController): number
	return self._speed
end

function BicycleController.GetBike(self: BicycleController): Model?
	return self._bike
end

-- Stabile Aufstiegslogik: Naehe, freier Sitz, lebender Humanoid, Entprellung.
function BicycleController.Mount(self: BicycleController, bike: Model): boolean
	local player = Players.LocalPlayer
	if player == nil then
		return false
	end
	if self._mounted then
		return false
	end
	if os.clock() < self._mountDebounceUntil then
		return false
	end

	local root = getCharacterRoot(player)
	if root == nil then
		return false
	end
	local drive = findDrivePart(bike)
	if drive == nil then
		return false
	end
	if (drive.Position - root.Position).Magnitude > MOUNT_DISTANCE then
		return false
	end

	local seat = findSeat(bike)
	if seat == nil then
		return false
	end
	if seat.Occupant ~= nil then
		return false
	end

	local character = player.Character
	local humanoid: Humanoid? = nil
	if character ~= nil then
		humanoid = character:FindFirstChildOfClass("Humanoid")
	end
	if humanoid == nil or humanoid.Health <= 0 then
		return false
	end

	self._bike = bike
	self._seat = seat
	self._mounted = true
	self._speed = 0
	self._mountDebounceUntil = os.clock() + MOUNT_COOLDOWN
	seat:Sit(humanoid)
	return true
end

function BicycleController.Dismount(self: BicycleController): ()
	if not self._mounted then
		return
	end
	self._mounted = false
	self._speed = 0
	self._throttle = 0
	self._steer = 0
	self._brake = false
	self._mountDebounceUntil = os.clock() + MOUNT_COOLDOWN

	local seat = self._seat
	if seat ~= nil then
		seat.Disabled = true
		seat.Disabled = false
	end
	self._bike = nil
	self._seat = nil

	local player = Players.LocalPlayer
	local character: Model? = nil
	if player ~= nil then
		character = player.Character
	end
	if character ~= nil then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid ~= nil and humanoid.SeatPart ~= nil then
			humanoid.Jump = true
		end
	end
end

-- E-Verhalten: aufsteigen, wenn nicht gefahren wird; sonst absteigen.
function BicycleController.ToggleMount(self: BicycleController): boolean
	if self._mounted then
		self:Dismount()
		return false
	end
	if os.clock() < self._mountDebounceUntil then
		return false
	end
	local player = Players.LocalPlayer
	if player == nil then
		return false
	end
	local bike = findNearestOwnedBicycle(player, MOUNT_DISTANCE)
	if bike == nil then
		return false
	end
	return self:Mount(bike)
end

-- Gemeinsamer Ruecksetzpfad ohne Sprung (Respawn, externes Absteigen).
function BicycleController._resetMountState(self: BicycleController, cooldown: boolean): ()
	self._mounted = false
	self._speed = 0
	self._throttle = 0
	self._steer = 0
	self._brake = false
	self._bike = nil
	self._seat = nil
	if cooldown then
		self._mountDebounceUntil = os.clock() + MOUNT_COOLDOWN
	end
end

-- Neuer Charakter: alten Sitzbezug loesen, ohne Sprung zu erzwingen.
function BicycleController.OnCharacterAdded(self: BicycleController, _character: Model?): ()
	if not self._mounted then
		return
	end
	self:_resetMountState(true)
end

-- Roblox setzt Charaktere automatisch auf Sitze. Uebernimmt dieser Sitz zum
-- eigenen getaggten Fahrrad, gilt das als aufgestiegen (sonst blockiert
-- `Mount` wegen belegtem Sitz und E wuerde nie absteigen).
function BicycleController._adoptAutoSeat(self: BicycleController): ()
	local player = Players.LocalPlayer
	if player == nil then
		return
	end
	local character = player.Character
	if character == nil then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil then
		return
	end
	local seat = humanoid.SeatPart
	if seat == nil or not seat:IsA("Seat") then
		return
	end
	local bike = seat:FindFirstAncestorOfClass("Model")
	if bike == nil then
		return
	end
	if bike:GetAttribute("OwnerUserId") ~= player.UserId then
		return
	end
	if not CollectionService:HasTag(bike, BICYCLE_TAG) then
		return
	end
	if findDrivePart(bike) == nil then
		return
	end

	self._bike = bike
	self._seat = seat
	self._mounted = true
	self._speed = 0
end

local function readKeys(self: BicycleController): (number, number, boolean)
	local throttle = 0
	local steer = 0

	if self._keys[Enum.KeyCode.W] or self._keys[Enum.KeyCode.Up] then
		throttle += 1
	end
	if self._keys[Enum.KeyCode.S] or self._keys[Enum.KeyCode.Down] then
		throttle -= 1
	end
	if self._keys[Enum.KeyCode.A] or self._keys[Enum.KeyCode.Left] then
		steer -= 1
	end
	if self._keys[Enum.KeyCode.D] or self._keys[Enum.KeyCode.Right] then
		steer += 1
	end

	local brake = self._keys[Enum.KeyCode.Space] == true
	return throttle, steer, brake
end

function BicycleController._step(self: BicycleController, dt: number): ()
	if not self._mounted then
		self:_adoptAutoSeat()
	end
	if not self._mounted then
		return
	end
	local bike = self._bike
	if bike == nil then
		self:Dismount()
		return
	end
	local drive = findDrivePart(bike)
	if drive == nil then
		self:Dismount()
		return
	end

	-- Sitzbezug pruefen: externes Absteigen (z. B. Sprung) sauber uebernehmen.
	local player = Players.LocalPlayer
	local humanoid = if player ~= nil then getCharacterHumanoid(player) else nil
	if humanoid == nil or humanoid.SeatPart ~= self._seat then
		self:_resetMountState(true)
		return
	end
	-- Space ist Bremse, nicht Sprung: Absprung waehrend der Fahrt unterdruecken.
	if humanoid.Jump then
		humanoid.Jump = false
	end

	local throttle, steer, brake = readKeys(self)
	self._throttle = throttle
	self._steer = steer
	self._brake = brake

	-- Beschleunigung / Bremsen / Ausrollen. Fahrrad: reine Tretphysik.
	if brake then
		if self._speed > 0 then
			self._speed = math.max(0, self._speed - BRAKE_DECELERATION * dt)
		elseif self._speed < 0 then
			self._speed = math.min(0, self._speed + BRAKE_DECELERATION * dt)
		end
	elseif throttle > 0 then
		self._speed = math.min(MAX_SPEED, self._speed + ACCELERATION * throttle * dt)
	elseif throttle < 0 then
		self._speed = math.max(-MAX_REVERSE_SPEED, self._speed + ACCELERATION * throttle * dt)
	else
		-- Ausrollen: Reibung zieht Geschwindigkeit gegen null.
		if self._speed > 0 then
			self._speed = math.max(0, self._speed - COAST_FRICTION * dt)
		elseif self._speed < 0 then
			self._speed = math.min(0, self._speed + COAST_FRICTION * dt)
		end
	end

	-- Lenkung und Vortrieb wirken auf das ganze Model, nicht nur auf `Drive`.
	-- Anchored Parts folgen keinen Welds; erst PivotTo bewegt Sitz, Raeder und
	-- den aufgesessenen Charakter gemeinsam.
	local pivot = bike:GetPivot()
	local rotated = pivot
	local speedFactor = math.clamp(math.abs(self._speed) / MAX_SPEED, 0, 1)
	if speedFactor > 0.01 and steer ~= 0 then
		local direction = if self._speed >= 0 then 1 else -1
		local yaw = -steer * TURN_RATE * (0.35 + 0.65 * speedFactor) * direction * dt
		rotated = pivot * CFrame.Angles(0, yaw, 0)
	end

	local translation = Vector3.zero
	if math.abs(self._speed) > 0.01 then
		local forward = rotated.LookVector
		-- Vertikale Komponente ignorieren, damit das Rad nicht abhebt.
		local flat = Vector3.new(forward.X, 0, forward.Z)
		if flat.Magnitude > 0.001 then
			translation = flat.Unit * self._speed * dt
		end
	end

	if rotated ~= pivot or translation.Magnitude > 0 then
		bike:PivotTo(rotated + translation)
	end
end

function BicycleController.Start(self: BicycleController): ()
	if self._stepped ~= nil then
		return
	end

	self._inputBegan = UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		self._keys[input.KeyCode] = true
		if input.KeyCode == MOUNT_KEY then
			self:ToggleMount()
		end
	end)

	self._inputEnded = UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		self._keys[input.KeyCode] = false
	end)

	self._stepped = RunService.RenderStepped:Connect(function(dt: number)
		-- RenderStepped kann im Studio pausieren; dt clampen.
		local clamped = math.clamp(dt, 0, 1 / 20)
		self:_step(clamped)
	end)
end

function BicycleController.Stop(self: BicycleController): ()
	if self._inputBegan ~= nil then
		self._inputBegan:Disconnect()
		self._inputBegan = nil
	end
	if self._inputEnded ~= nil then
		self._inputEnded:Disconnect()
		self._inputEnded = nil
	end
	if self._stepped ~= nil then
		self._stepped:Disconnect()
		self._stepped = nil
	end
	table.clear(self._keys)
	if self._mounted then
		self:Dismount()
	end
end

return BicycleController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">GrassController</string>
            <string name="Source"><![CDATA[--!strict
-- GrassController: performante clientseitige Grasbewegung.
-- Animiert nur nahe `ToeffliGrass`-Chunks gebuendelt mit fester maximaler
-- Update-Rate. Reine Sway-Funktion `swayOffset` plus Chunk-Auswahl
-- `selectActiveChunks` / `isChunkInRange` sind ohne Roblox-Laufzeit testbar.
-- Die Laufzeit aendert keine Server-CFrames (nur lokale Visual-Offsets),
-- keine Physik (Anchored/Collide bleiben unberuehrt) und nutzt genau einen
-- Heartbeat-Callback statt einem Callback pro Grashalm. Keine globalen Variablen.

local GrassController = {}
GrassController.__index = GrassController

-- Tag muss mit dem Server-Builder uebereinstimmen (Task 28).
GrassController.TAG_NAME = "ToeffliGrass"
-- Feste maximale Update-Rate: ein Sammel-Update alle 0.15 s (~6.7 Hz).
GrassController.UPDATE_INTERVAL = 0.15
-- Begrenzung aktiver Chunks: schuetzt vor Frame-Einbruechen bei 15 Spielern.
GrassController.MAX_ACTIVE_CHUNKS = 24
-- Aktivierungsdistanz (Studs): nur nahe Chunks werden animiert.
GrassController.NEAR_DISTANCE = 120
-- Deaktivierungsdistanz (Studs): Hysterese gegen Flackern an der Grenze.
GrassController.FAR_DISTANCE = 150
-- Kurze, fahrneutrale Bewegung (Radiant, Tilt um Z).
GrassController.SWAY_AMPLITUDE = 0.08
-- Sway-Geschwindigkeit (Radiant pro Sekunde).
GrassController.SWAY_FREQUENCY = 1.6

export type GrassController = typeof(setmetatable(
	{} :: {
		_running: boolean,
		_time: number,
		_accum: number,
		_connection: RBXScriptConnection?,
		_baseFrames: { [BasePart]: CFrame },
		_activeChunks: { [string]: boolean },
	},
	GrassController
))

local function distance2D(ax: number, az: number, bx: number, bz: number): number
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end

local function getGame(): any
	local ok, value = pcall(function(): any
		return (game :: any)
	end)
	if ok then
		return value
	end
	return nil
end

-- Reine, testbare Sway-Funktion: deterministisch, endlich, begrenzt.
function GrassController.swayOffset(seed: number, time: number): number
	if seed ~= seed or time ~= time then
		return 0
	end
	if math.abs(seed) >= 1000000 or math.abs(time) >= 1000000 then
		seed = seed % 100000
		time = time % 100000
	end
	return math.sin(time * GrassController.SWAY_FREQUENCY + seed * 0.37) * GrassController.SWAY_AMPLITUDE
end

-- Hysterese: nahe Chunks starten, aktive bleiben bis zur FAR-Distanz an.
function GrassController.isChunkInRange(distance: number, currentlyActive: boolean): boolean
	if distance ~= distance or distance < 0 then
		return false
	end
	if currentlyActive then
		return distance <= GrassController.FAR_DISTANCE
	end
	return distance <= GrassController.NEAR_DISTANCE
end

export type ChunkAnchor = { chunkId: string, x: number, z: number }

-- Reine Chunk-Auswahl: naechste Chunks innerhalb maxDistance, begrenzt auf
-- maxActive. Gibt Chunk-IDs nach Distanz sortiert zurueck, ohne Eingabe zu mutieren.
function GrassController.selectActiveChunks(
	playerPos: { x: number, z: number },
	chunks: { ChunkAnchor },
	maxActive: number?,
	maxDistance: number?
): { string }
	local limit = maxActive or GrassController.MAX_ACTIVE_CHUNKS
	local radius = maxDistance or GrassController.NEAR_DISTANCE
	if limit <= 0 or radius <= 0 then
		return {}
	end
	local scored: { { id: string, dist: number } } = {}
	for _, chunk in chunks do
		local dist = distance2D(playerPos.x, playerPos.z, chunk.x, chunk.z)
		if dist == dist and dist <= radius then
			scored[#scored + 1] = { id = chunk.chunkId, dist = dist }
		end
	end
	table.sort(scored, function(a, b)
		if a.dist == b.dist then
			return a.id < b.id
		end
		return a.dist < b.dist
	end)
	local result: { string } = {}
	for index = 1, math.min(limit, #scored) do
		result[#result + 1] = scored[index].id
	end
	return result
end

function GrassController.new(): GrassController
	local self = setmetatable({
		_running = false,
		_time = 0,
		_accum = 0,
		_connection = nil,
		_baseFrames = {},
		_activeChunks = {},
	}, GrassController)
	return self
end

function GrassController.IsRunning(self: GrassController): boolean
	return self._running
end

function GrassController.GetActiveChunks(self: GrassController): { string }
	local result: { string } = {}
	for chunkId, _ in self._activeChunks do
		result[#result + 1] = chunkId
	end
	table.sort(result)
	return result
end

-- Stellt alle zwischengespeicherten Basis-CFrames wieder her (Chunk pausiert).
function GrassController._restoreAll(self: GrassController): ()
	for part, base in self._baseFrames do
		local ok, _ = pcall(function()
			(part :: BasePart).CFrame = base
		end)
		if not ok then
			continue
		end
	end
	table.clear(self._baseFrames)
	table.clear(self._activeChunks)
end

function GrassController.Start(self: GrassController): boolean
	if self._running then
		return true
	end
	local gameRef = getGame()
	if gameRef == nil then
		-- Lune/Testumgebung ohne Roblox: kein Laufzeit-Start, aber API bleibt nutzbar.
		return false
	end
	local ok, runService = pcall(function(): any
		return gameRef:GetService("RunService")
	end)
	if not ok or runService == nil then
		return false
	end
	self._running = true
	self._accum = 0
	-- Genau ein Sammel-Callback (Heartbeat), kein Callback pro Grashalm.
	self._connection = (runService :: RunService).Heartbeat:Connect(function(dt: number)
		self:_onHeartbeat(dt)
	end)
	return true
end

function GrassController._onHeartbeat(self: GrassController, dt: number): ()
	if not self._running then
		return
	end
	local clamped = math.clamp(dt, 0, 0.5)
	self._accum += clamped
	if self._accum < GrassController.UPDATE_INTERVAL then
		return
	end
	self._accum = 0
	self._time += GrassController.UPDATE_INTERVAL
	self:updateNow()
end

-- Ein gebuendeltes Update: nur nahe Chunks animieren, ferne pausieren.
function GrassController.updateNow(self: GrassController): ()
	local gameRef = getGame()
	if gameRef == nil then
		return
	end
	local okPlayers, players = pcall(function(): any
		return gameRef:GetService("Players")
	end)
	local okTags, collectionService = pcall(function(): any
		return gameRef:GetService("CollectionService")
	end)
	if not okPlayers or not okTags or players == nil or collectionService == nil then
		return
	end
	local localPlayer = (players :: Players).LocalPlayer
	if localPlayer == nil then
		return
	end
	local character = localPlayer.Character
	if character == nil then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root == nil or not (root :: Instance):IsA("BasePart") then
		return
	end
	local playerPos = (root :: BasePart).Position

	local tagged: { Instance }
	do
		local ok, result = pcall(function(): any
			return (collectionService :: CollectionService):GetTagged(GrassController.TAG_NAME)
		end)
		if not ok or typeof(result) ~= "table" then
			return
		end
		tagged = result :: { Instance }
	end

	-- Chunks buendeln: ein Eintrag je Chunk-ID mit Ankerposition.
	local chunkAnchors: { [string]: { x: number, z: number } } = {}
	local modelsByChunk: { [string]: { Model } } = {}
	for _, instance in tagged do
		if (instance :: Instance):IsA("Model") then
			local model = instance :: Model
			local chunkAttr = model:GetAttribute("ChunkId")
			if typeof(chunkAttr) == "string" and (chunkAttr :: string) ~= "" then
				local chunkId = chunkAttr :: string
				local pivotOk, pivot = pcall(function(): any
					return model:GetPivot()
				end)
				if pivotOk and pivot ~= nil then
					local pos = (pivot :: CFrame).Position
					if chunkAnchors[chunkId] == nil then
						chunkAnchors[chunkId] = { x = pos.X, z = pos.Z }
					end
					if modelsByChunk[chunkId] == nil then
						modelsByChunk[chunkId] = {}
					end
					table.insert(modelsByChunk[chunkId], model)
				end
			end
		end
	end

	local anchors: { ChunkAnchor } = {}
	for chunkId, anchor in chunkAnchors do
		anchors[#anchors + 1] = { chunkId = chunkId, x = anchor.x, z = anchor.z }
	end
	local wanted = GrassController.selectActiveChunks(
		{ x = playerPos.X, z = playerPos.Z },
		anchors
	)
	local wantedSet: { [string]: boolean } = {}
	for _, chunkId in wanted do
		wantedSet[chunkId] = true
	end
	self._activeChunks = wantedSet

	-- Ferne Chunks pausieren: Basis-CFrame wiederherstellen, danach ignorieren.
	-- Aktive Chunks: Tilt um die gespeicherte Basis legen (clientseitig visual only).
	for chunkId, models in modelsByChunk do
		if wantedSet[chunkId] then
			for _, model in models do
				local seedAttr = model:GetAttribute("GrassSeed")
				local seed = if typeof(seedAttr) == "number" then (seedAttr :: number) else 0
				local descendants: { Instance } = model:GetDescendants()
				for _, descendant in descendants do
					if descendant:IsA("BasePart") then
						local blade = descendant :: BasePart
						if self._baseFrames[blade] == nil then
							local ok, current = pcall(function(): any
								return blade.CFrame
							end)
							if ok and current ~= nil then
								self._baseFrames[blade] = current :: CFrame
							else
								continue
							end
						end
						local base = self._baseFrames[blade]
						if base ~= nil then
							local sway = GrassController.swayOffset(seed + blade.Size.Y * 100, self._time)
							-- Nur Rotation um die Basis: keine Positions-/Physik-Aenderung,
							-- keine Auswirkung auf Fahreigenschaften.
							local applyOk, _ = pcall(function()
								blade.CFrame = (base :: CFrame) * CFrame.Angles(0, 0, sway)
							end)
							if not applyOk then
								continue
							end
						end
					end
				end
			end
		else
			for _, model in models do
				for _, descendant in model:GetDescendants() do
					if descendant:IsA("BasePart") then
						local blade = descendant :: BasePart
						local base = self._baseFrames[blade]
						if base ~= nil then
							pcall(function()
								blade.CFrame = base
							end)
							self._baseFrames[blade] = nil
						end
					end
				end
			end
		end
	end
end

function GrassController.Stop(self: GrassController): ()
	self._running = false
	if self._connection ~= nil then
		pcall(function()
			(self._connection :: RBXScriptConnection):Disconnect()
		end)
		self._connection = nil
	end
	-- In Studio: wiederherstellen; in Lune (ohne Parts) ist die Tabelle leer.
	if getGame() ~= nil then
		self:_restoreAll()
	else
		table.clear(self._baseFrames)
		table.clear(self._activeChunks)
	end
	self._accum = 0
end

return GrassController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">MopedController</string>
            <string name="Source"><![CDATA[--!strict
-- MopedController: Arcade-realistische PC-Steuerung fuer Puch Maxi S und Piaggio Ciao.
-- Die Steuerung liest ausschliesslich serverseitig gelieferte Fahrzeugwerte
-- (via SetStats / ApplyServerStats) und nutzt keine hartcodierte Modellphysik.
-- Bietet Hooks fuer Treibstoff (SetFuelLevel / OnOutOfFuel / OnFuelConsumed)
-- sowie Start/Stop (StartEngine / StopEngine / OnEngineChanged).

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

export type VehicleStats = {
	modelId: string,
	acceleration: number,
	topSpeed: number,
	brakeForce: number,
	turnRate: number,
	reverseSpeed: number?,
	dragCoefficient: number?,
	rollingResistance: number?,
	fuelConsumptionPerSecond: number?,
}

export type InputState = {
	throttle: number,
	brake: number,
	steer: number,
	handbrake: boolean,
}

local DEFAULT_STATS: VehicleStats = {
	modelId = "unknown",
	acceleration = 12,
	topSpeed = 28,
	brakeForce = 30,
	turnRate = 1.8,
	reverseSpeed = 4,
	dragCoefficient = 0.35,
	rollingResistance = 2.0,
	fuelConsumptionPerSecond = 0.02,
}

local function clampNumber(value: number, minValue: number, maxValue: number): number
	if value < minValue then
		return minValue
	elseif value > maxValue then
		return maxValue
	else
		return value
	end
end

local function sanitizeStats(raw: VehicleStats?): VehicleStats
	if raw == nil then
		return table.clone(DEFAULT_STATS)
	end
	local stats: VehicleStats = table.clone(DEFAULT_STATS)
	if typeof(raw.modelId) == "string" and raw.modelId ~= "" then
		stats.modelId = raw.modelId
	end
	if typeof(raw.acceleration) == "number" and raw.acceleration > 0 then
		stats.acceleration = clampNumber(raw.acceleration, 1, 120)
	end
	if typeof(raw.topSpeed) == "number" and raw.topSpeed > 0 then
		stats.topSpeed = clampNumber(raw.topSpeed, 1, 150)
	end
	if typeof(raw.brakeForce) == "number" and raw.brakeForce > 0 then
		stats.brakeForce = clampNumber(raw.brakeForce, 1, 200)
	end
	if typeof(raw.turnRate) == "number" and raw.turnRate > 0 then
		stats.turnRate = clampNumber(raw.turnRate, 0.1, 6)
	end
	if typeof(raw.reverseSpeed) == "number" and (raw.reverseSpeed :: number) >= 0 then
		stats.reverseSpeed = clampNumber(raw.reverseSpeed :: number, 0, 20)
	end
	if typeof(raw.dragCoefficient) == "number" and (raw.dragCoefficient :: number) >= 0 then
		stats.dragCoefficient = clampNumber(raw.dragCoefficient :: number, 0, 5)
	end
	if typeof(raw.rollingResistance) == "number" and (raw.rollingResistance :: number) >= 0 then
		stats.rollingResistance = clampNumber(raw.rollingResistance :: number, 0, 30)
	end
	if typeof(raw.fuelConsumptionPerSecond) == "number" and (raw.fuelConsumptionPerSecond :: number) >= 0 then
		stats.fuelConsumptionPerSecond = clampNumber(raw.fuelConsumptionPerSecond :: number, 0, 1)
	end
	return stats
end

local MopedController = {}
MopedController.__index = MopedController

export type MopedController = typeof(setmetatable(
	{} :: {
		_stats: VehicleStats,
		_input: InputState,
		_engineOn: boolean,
		_fuelLevel: number,
		_speed: number,
		_seat: VehicleSeat?,
		_vehicleRoot: BasePart?,
		_connections: { RBXScriptConnection },
		_onEngineChanged: ((boolean) -> ())?,
		_onOutOfFuel: (() -> ())?,
		_onFuelConsumed: ((number) -> ())?,
		_destroyed: boolean,
	},
	MopedController
))

function MopedController.new(initialStats: VehicleStats?): MopedController
	local self = setmetatable({
		_stats = sanitizeStats(initialStats),
		_input = {
			throttle = 0,
			brake = 0,
			steer = 0,
			handbrake = false,
		},
		_engineOn = false,
		_fuelLevel = 1,
		_speed = 0,
		_seat = nil,
		_vehicleRoot = nil,
		_connections = {},
		_onEngineChanged = nil,
		_onOutOfFuel = nil,
		_onFuelConsumed = nil,
		_destroyed = false,
	}, MopedController)
	return self
end

function MopedController.SetStats(self: MopedController, stats: VehicleStats)
	self._stats = sanitizeStats(stats)
	self:_applyStatsToSeat()
end

function MopedController.ApplyServerStats(self: MopedController, stats: VehicleStats)
	self:SetStats(stats)
end

function MopedController.GetStats(self: MopedController): VehicleStats
	return table.clone(self._stats)
end

function MopedController.GetModelId(self: MopedController): string
	return self._stats.modelId
end

function MopedController.SetFuelLevel(self: MopedController, level01: number)
	self._fuelLevel = clampNumber(level01, 0, 1)
	if self._fuelLevel <= 0 and self._engineOn then
		self:StopEngine()
	end
end

function MopedController.GetFuelLevel(self: MopedController): number
	return self._fuelLevel
end

function MopedController.OnOutOfFuel(self: MopedController, callback: (() -> ())?)
	self._onOutOfFuel = callback
end

function MopedController.OnFuelConsumed(self: MopedController, callback: ((number) -> ())?)
	self._onFuelConsumed = callback
end

function MopedController.OnEngineChanged(self: MopedController, callback: ((boolean) -> ())?)
	self._onEngineChanged = callback
end

function MopedController.IsEngineOn(self: MopedController): boolean
	return self._engineOn
end

function MopedController.CanDrive(self: MopedController): boolean
	return self._engineOn and self._fuelLevel > 0
end

function MopedController.StartEngine(self: MopedController): boolean
	if self._destroyed then
		return false
	end
	if self._engineOn then
		return true
	end
	if self._fuelLevel <= 0 then
		return false
	end
	self._engineOn = true
	if self._onEngineChanged ~= nil then
		(self._onEngineChanged :: (boolean) -> ())(true)
	end
	return true
end

function MopedController.StopEngine(self: MopedController)
	if not self._engineOn then
		return
	end
	self._engineOn = false
	self._input.throttle = 0
	self:_applyInputToSeat()
	if self._onEngineChanged ~= nil then
		(self._onEngineChanged :: (boolean) -> ())(false)
	end
end

function MopedController.ToggleEngine(self: MopedController): boolean
	if self._engineOn then
		self:StopEngine()
		return false
	else
		return self:StartEngine()
	end
end

function MopedController.IsRiding(self: MopedController): boolean
	return self._seat ~= nil
end

function MopedController.GetSpeed(self: MopedController): number
	return self._speed
end

function MopedController.GetInput(self: MopedController): InputState
	return table.clone(self._input)
end

function MopedController.CanMount(self: MopedController, seat: VehicleSeat?, maxDistanceStuds: number?): boolean
	assert(self ~= nil, "controller required")
	if seat == nil then
		return false
	end
	local player = Players.LocalPlayer
	if player == nil then
		return false
	end
	local character = player.Character
	if character == nil then
		return false
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root == nil or not (root :: Instance):IsA("BasePart") then
		return false
	end
	local limit = maxDistanceStuds or 10
	local seatPart = seat :: VehicleSeat
	local distance = (seatPart.Position - (root :: BasePart).Position).Magnitude
	return distance <= limit
end

function MopedController.Mount(self: MopedController, seat: VehicleSeat, vehicleRoot: BasePart?)
	if self._destroyed then
		return false
	end
	if seat == nil or not seat:IsA("VehicleSeat") then
		return false
	end
	self:Dismount()
	self._seat = seat
	self._vehicleRoot = vehicleRoot
	self:_applyStatsToSeat()
	self:_bindInput()
	self:_bindPhysics()
	return true
end

function MopedController.Dismount(self: MopedController)
	local player = Players.LocalPlayer
	if player ~= nil then
		local character = player.Character
		if character ~= nil then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid ~= nil and humanoid.SeatPart == self._seat then
				humanoid.Sit = false
			end
		end
	end
	self._seat = nil
	self._vehicleRoot = nil
	self._speed = 0
	self._input.throttle = 0
	self._input.brake = 0
	self._input.steer = 0
	self._input.handbrake = false
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
end

function MopedController.Destroy(self: MopedController)
	if self._destroyed then
		return
	end
	self._destroyed = true
	self:StopEngine()
	self:Dismount()
	self._onEngineChanged = nil
	self._onOutOfFuel = nil
	self._onFuelConsumed = nil
end

function MopedController._applyStatsToSeat(self: MopedController)
	local seat = self._seat
	if seat == nil then
		return
	end
	seat.MaxSpeed = self._stats.topSpeed
	seat.TurnSpeed = self._stats.turnRate * 20
end

function MopedController._applyInputToSeat(self: MopedController)
	local seat = self._seat
	if seat == nil then
		return
	end
	local throttleValue = 0
	if self:CanDrive() then
		throttleValue = self._input.throttle - self._input.brake
		if self._input.handbrake then
			throttleValue = -math.sign(self._speed)
		end
	end
	seat.ThrottleFloat = clampNumber(throttleValue, -1, 1)
	seat.SteerFloat = clampNumber(self._input.steer, -1, 1)
end

function MopedController._consumeFuel(self: MopedController, dt: number)
	if not self._engineOn then
		return
	end
	local rate = self._stats.fuelConsumptionPerSecond or 0
	local burn = (0.2 + 0.8 * self._input.throttle) * rate * dt
	if burn <= 0 then
		return
	end
	self._fuelLevel = math.max(0, self._fuelLevel - burn)
	if self._onFuelConsumed ~= nil then
		(self._onFuelConsumed :: (number) -> ())(self._fuelLevel)
	end
	if self._fuelLevel <= 0 then
		self:StopEngine()
		if self._onOutOfFuel ~= nil then
			(self._onOutOfFuel :: () -> ())()
		end
	end
end

function MopedController._stepSpeed(self: MopedController, dt: number): number
	local stats = self._stats
	local reverseSpeed = stats.reverseSpeed or DEFAULT_STATS.reverseSpeed :: number
	local drag = stats.dragCoefficient or 0
	local rolling = stats.rollingResistance or 0

	local driveAccel = 0
	if self:CanDrive() then
		driveAccel = stats.acceleration * self._input.throttle
	end

	local brakeDecel = stats.brakeForce * self._input.brake
	if self._input.handbrake then
		brakeDecel += stats.brakeForce * 0.8
	end

	local direction = 1
	if self._speed < 0 then
		direction = -1
	end

	local dragForce = self._speed * drag + direction * rolling * math.min(1, math.abs(self._speed) / 2)
	local nextSpeed = self._speed + (driveAccel - direction * brakeDecel - dragForce) * dt

	if self._input.brake <= 0 and self._input.throttle <= 0 and math.abs(nextSpeed) < 0.4 then
		nextSpeed = 0
	end

	if nextSpeed > 0 and self._input.brake > 0 and driveAccel <= 0 then
		nextSpeed = math.max(0, nextSpeed)
	end

	self._speed = clampNumber(nextSpeed, -1 * (reverseSpeed :: number), stats.topSpeed)
	return self._speed
end

function MopedController._bindInput(self: MopedController)
	local began = UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.Up then
			self._input.throttle = 1
		elseif input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.Down then
			self._input.brake = 1
		elseif input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then
			self._input.steer = -1
		elseif input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then
			self._input.steer = 1
		elseif input.KeyCode == Enum.KeyCode.Space then
			self._input.handbrake = true
		elseif input.KeyCode == Enum.KeyCode.F then
			self:ToggleEngine()
			return
		else
			return
		end
		self:_applyInputToSeat()
	end)
	table.insert(self._connections, began)

	local ended = UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.Up then
			self._input.throttle = 0
		elseif input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.Down then
			self._input.brake = 0
		elseif input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then
			if self._input.steer < 0 then
				self._input.steer = 0
			end
		elseif input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then
			if self._input.steer > 0 then
				self._input.steer = 0
			end
		elseif input.KeyCode == Enum.KeyCode.Space then
			self._input.handbrake = false
		else
			return
		end
		self:_applyInputToSeat()
	end)
	table.insert(self._connections, ended)
end

function MopedController._bindPhysics(self: MopedController)
	local heartbeat = RunService.Heartbeat:Connect(function(dt: number)
		if self._seat == nil then
			return
		end
		local clampedDt = clampNumber(dt, 0, 1 / 20)
		self:_consumeFuel(clampedDt)
		self:_stepSpeed(clampedDt)
		self:_applyInputToSeat()
	end)
	table.insert(self._connections, heartbeat)
end

return MopedController
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="77">
        <Properties>
          <string name="Name">ui</string>
        </Properties>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">DeliveryPrompt</string>
            <string name="Source">--!strict
-- DeliveryPrompt: kleines PC-Lieferprompt für Döner-Aufträge.
-- Sendet ausschliesslich die versionierten Delivery-Remote-Anfragen.
-- Keine Preise, Distanzen, Belohnungen oder Erfolge werden clientseitig entschieden.
-- Keine Tastenbindung für E, damit das Fahrrad-Aufsteigen ungestört bleibt.

export type DeliveryClient = {
	request: (self: DeliveryClient, action: string, payload: any) -&gt; any,
	getVehicleType: (() -&gt; string)?,
}

export type DeliveryPrompt = {
	_client: DeliveryClient?,
	_getVehicleType: (() -&gt; string)?,
	_remotes: Instance?,
	_vehicleType: string,
	_state: string,
	_orderId: string?,
	_addressId: string?,
	_isOpen: boolean,
	_gui: GuiObject?,
	_statusLabel: TextLabel?,
	_actionButton: TextButton?,
	open: (self: DeliveryPrompt) -&gt; (),
	close: (self: DeliveryPrompt) -&gt; (),
	isOpen: (self: DeliveryPrompt) -&gt; boolean,
	setStatus: (self: DeliveryPrompt, text: string) -&gt; (),
	reset: (self: DeliveryPrompt) -&gt; (),
	onCharacterAdded: (self: DeliveryPrompt, character: Model?) -&gt; (),
	destroy: (self: DeliveryPrompt) -&gt; (),
	buildGui: (self: DeliveryPrompt, parent: Instance) -&gt; GuiObject,
}

local DeliveryPrompt = {} :: any
DeliveryPrompt.__index = DeliveryPrompt

local STATE_NONE = "none"
local STATE_ACCEPTED = "accepted"
local STATE_PICKED_UP = "pickedUp"

local function getClientRequest(self: any): ((string, any) -&gt; any)?
	if self._client ~= nil then
		local client: any = self._client
		if type(client.request) == "function" then
			return function(action: string, payload: any): any
				local ok, result = pcall(function()
					return client.request(client, action, payload)
				end)
				if ok then
					return result
				end
				return nil
			end
		end
	end
	if self._remotes ~= nil then
		local remotes: Instance = self._remotes :: Instance
		return function(action: string, payload: any): any
			local remote = remotes:FindFirstChild(action)
			if remote ~= nil and remote:IsA("RemoteFunction") then
				local ok, result = pcall(function()
					return (remote :: RemoteFunction):InvokeServer(payload)
				end)
				if ok then
					return result
				end
			end
			return nil
		end
	end
	return nil
end

local function unwrap(result: any): ({ [string]: any }?, string?)
	if type(result) ~= "table" then
		return nil, "noResponse"
	end
	local t = result :: { [string]: any }
	if t.ok == false then
		local code = t.code
		if type(code) ~= "string" then
			code = t.message
		end
		if type(code) ~= "string" then
			code = "requestFailed"
		end
		return nil, code :: string
	end
	local data = t.data
	if type(data) == "table" then
		local dt = data :: { [string]: any }
		if dt.ok == false then
			local code = dt.code
			if type(code) ~= "string" then
				code = "requestFailed"
			end
			return nil, code :: string
		end
		return dt, nil
	end
	return t, nil
end

local function currentVehicleType(self: any): string
	if self._getVehicleType ~= nil then
		local ok, value = pcall(self._getVehicleType)
		if ok and type(value) == "string" and value ~= "" then
			return value
		end
	end
	if type(self._vehicleType) == "string" and self._vehicleType ~= "" then
		return self._vehicleType
	end
	return "bicycle"
end

local function refreshUi(self: any): ()
	local button = self._actionButton
	local status = self._statusLabel
	if self._state == STATE_ACCEPTED then
		if button ~= nil then
			button.Text = "Döner abholen"
		end
		if status ~= nil then
			status.Text = "Auftrag angenommen. Döner abholen."
		end
	elseif self._state == STATE_PICKED_UP then
		if button ~= nil then
			button.Text = "Ausliefern"
		end
		if status ~= nil then
			status.Text = "Döner abgeholt. Ziel anfahren."
		end
	else
		if button ~= nil then
			button.Text = "Auftrag annehmen"
		end
		if status ~= nil then
			status.Text = "Kein aktiver Auftrag"
		end
	end
end

local function doAction(self: any): ()
	local req = getClientRequest(self)
	if req == nil then
		local status = self._statusLabel
		if status ~= nil then
			status.Text = "Keine Verbindung"
		end
		return
	end

	if self._state == STATE_NONE then
		local result = req("DeliveryOrder", { vehicleType = currentVehicleType(self) })
		local data, err = unwrap(result)
		if data ~= nil then
			self._state = STATE_ACCEPTED
			self._orderId = data.orderId
			self._addressId = data.addressId
			refreshUi(self)
		else
			local status = self._statusLabel
			if status ~= nil then
				status.Text = "Fehler: " .. tostring(err)
			end
		end
	elseif self._state == STATE_ACCEPTED then
		local payload: { [string]: any } = {}
		if type(self._orderId) == "string" and self._orderId ~= "" then
			payload.orderId = self._orderId
		end
		local result = req("DeliveryPickup", payload)
		local data, err = unwrap(result)
		if data ~= nil then
			self._state = STATE_PICKED_UP
			refreshUi(self)
		else
			local status = self._statusLabel
			if status ~= nil then
				status.Text = "Fehler: " .. tostring(err)
			end
		end
	elseif self._state == STATE_PICKED_UP then
		local payload: { [string]: any } = {}
		if type(self._orderId) == "string" and self._orderId ~= "" then
			payload.orderId = self._orderId
		end
		local result = req("DeliveryDeliver", payload)
		local data, err = unwrap(result)
		if data ~= nil then
			self._state = STATE_NONE
			self._orderId = nil
			self._addressId = nil
			refreshUi(self)
			local status = self._statusLabel
			if status ~= nil then
				local payoutText = ""
				if type(data.payout) == "number" then
					payoutText = " (+" .. tostring(data.payout) .. ")"
				end
				status.Text = "Ausgeliefert" .. payoutText
			end
		else
			local status = self._statusLabel
			if status ~= nil then
				status.Text = "Fehler: " .. tostring(err)
			end
		end
	end
end

function DeliveryPrompt.new(...): DeliveryPrompt
	local args = { ... }
	local self = setmetatable({
		_client = nil,
		_getVehicleType = nil,
		_remotes = nil,
		_vehicleType = "bicycle",
		_state = STATE_NONE,
		_orderId = nil,
		_addressId = nil,
		_isOpen = false,
		_gui = nil,
		_statusLabel = nil,
		_actionButton = nil,
	}, DeliveryPrompt)

	local first = args[1]
	if type(first) == "table" then
		local t: any = first
		if type(t.request) == "function" then
			self._client = t :: DeliveryClient
		elseif t.remotes ~= nil then
			self._remotes = t.remotes
		elseif t.netFolder ~= nil then
			self._remotes = t.netFolder
		end
		if type(t.getVehicleType) == "function" then
			self._getVehicleType = t.getVehicleType
		end
		if type(t.vehicleType) == "string" then
			self._vehicleType = t.vehicleType
		end
	elseif type(first) == "userdata" then
		self._remotes = first
	end

	local second = args[2]
	if type(second) == "string" then
		self._vehicleType = second
	elseif type(second) == "function" then
		self._getVehicleType = second
	end

	local third = args[3]
	if type(third) == "string" then
		self._vehicleType = third
	end

	return self :: DeliveryPrompt
end

function DeliveryPrompt:open()
	self._isOpen = true
	local gui = self._gui
	if gui ~= nil then
		gui.Visible = true
	end
end

function DeliveryPrompt:close()
	self._isOpen = false
	local gui = self._gui
	if gui ~= nil then
		gui.Visible = false
	end
end

function DeliveryPrompt:isOpen(): boolean
	return self._isOpen
end

function DeliveryPrompt:setStatus(text: string)
	local label = self._statusLabel
	if label ~= nil then
		label.Text = text
	end
end

function DeliveryPrompt:reset()
	self._state = STATE_NONE
	self._orderId = nil
	self._addressId = nil
	refreshUi(self)
end

function DeliveryPrompt:onCharacterAdded(_character: Model?)
	self:reset()
end

function DeliveryPrompt:destroy()
	self:close()
	self._gui = nil
	self._statusLabel = nil
	self._actionButton = nil
end

function DeliveryPrompt:buildGui(parent: Instance): GuiObject
	if self._gui ~= nil then
		return self._gui :: GuiObject
	end

	local frame = Instance.new("Frame")
	frame.Name = "DeliveryPrompt"
	frame.Size = UDim2.fromOffset(220, 96)
	frame.Position = UDim2.new(1, -236, 1, -112)
	frame.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
	frame.BorderSizePixel = 0
	frame.Active = false
	frame.Visible = self._isOpen
	frame.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.Size = UDim2.new(1, -12, 0, 36)
	status.Position = UDim2.fromOffset(6, 6)
	status.BackgroundTransparency = 1
	status.Text = "Kein aktiver Auftrag"
	status.TextColor3 = Color3.fromRGB(235, 235, 235)
	status.TextSize = 14
	status.Font = Enum.Font.Gotham
	status.TextWrapped = true
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.TextYAlignment = Enum.TextYAlignment.Top
	status.Parent = frame

	local button = Instance.new("TextButton")
	button.Name = "Action"
	button.Size = UDim2.new(1, -12, 0, 34)
	button.Position = UDim2.fromOffset(6, 52)
	button.BackgroundColor3 = Color3.fromRGB(200, 60, 40)
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextSize = 15
	button.Font = Enum.Font.GothamBold
	button.Text = "Auftrag annehmen"
	button.AutoButtonColor = true
	button.Parent = frame

	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(0, 6)
	buttonCorner.Parent = button

	button.Activated:Connect(function()
		doAction(self)
	end)

	self._gui = frame
	self._statusLabel = status
	self._actionButton = button
	refreshUi(self)
	return frame
end

return DeliveryPrompt</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">ShopTerminal</string>
            <string name="Source"><![CDATA[--!strict
-- ShopTerminal: PC-Laptop-Terminal fuer Teilebestellungen.
-- Sendet ausschliesslich Shop-Anfragen (Katalog, Inventar, Bestellung).
-- Kein Einbau, keine Lackierung, keine Werkstattfunktionen.

export type PartEntry = {
	id: string,
	name: string,
	category: string,
	price: number,
	compatibleModels: { string },
	mountPoint: string?,
}

export type ShopClient = {
	request: (self: ShopClient, action: string, payload: any) -> any,
}

export type ShopTerminal = {
	_shopClient: ShopClient,
	_catalog: { PartEntry },
	_inventory: { [string]: number },
	_modelFilter: string?,
	_categoryFilter: string?,
	_pendingConfirmation: string?,
	_isOpen: boolean,
	_gui: GuiObject?,
	open: (self: ShopTerminal) -> (),
	close: (self: ShopTerminal) -> (),
	isOpen: (self: ShopTerminal) -> boolean,
	setCatalog: (self: ShopTerminal, catalog: { PartEntry }) -> (),
	setInventory: (self: ShopTerminal, inventory: { [string]: number }) -> (),
	setModelFilter: (self: ShopTerminal, modelId: string?) -> (),
	setCategoryFilter: (self: ShopTerminal, category: string?) -> (),
	getCategories: (self: ShopTerminal) -> { string },
	getVisibleParts: (self: ShopTerminal) -> { PartEntry },
	requestOrder: (self: ShopTerminal, partId: string) -> (boolean, string),
	confirmOrder: (self: ShopTerminal) -> (boolean, string),
	cancelConfirmation: (self: ShopTerminal) -> (),
	refreshCatalog: (self: ShopTerminal) -> (),
	refreshInventory: (self: ShopTerminal) -> (),
	buildGui: (self: ShopTerminal, parent: Instance) -> GuiObject,
}

local ShopTerminal = {} :: any
ShopTerminal.__index = ShopTerminal

local ALLOWED_SHOP_ACTIONS: { [string]: boolean } = {
	GetCatalog = true,
	GetInventory = true,
	OrderPart = true,
}

local function isCompatible(part: PartEntry, modelId: string?): boolean
	if modelId == nil or modelId == "" then
		return true
	end
	for _, model in ipairs(part.compatibleModels) do
		if model == modelId then
			return true
		end
	end
	return false
end

local function findPart(catalog: { PartEntry }, partId: string): PartEntry?
	for _, part in ipairs(catalog) do
		if part.id == partId then
			return part
		end
	end
	return nil
end

function ShopTerminal.new(shopClient: ShopClient): ShopTerminal
	assert(shopClient ~= nil, "ShopTerminal.new benoetigt einen ShopClient")
	assert(type(shopClient.request) == "function", "ShopClient muss request(action, payload) anbieten")
	local self: ShopTerminal = setmetatable({}, ShopTerminal) :: ShopTerminal
	self._shopClient = shopClient
	self._catalog = {}
	self._inventory = {}
	self._modelFilter = nil
	self._categoryFilter = nil
	self._pendingConfirmation = nil
	self._isOpen = false
	self._gui = nil
	return self
end

function ShopTerminal:open()
	self._isOpen = true
	self:refreshCatalog()
	self:refreshInventory()
	local gui = self._gui
	if gui ~= nil then
		gui.Visible = true
	end
end

function ShopTerminal:close()
	self._isOpen = false
	self._pendingConfirmation = nil
	local gui = self._gui
	if gui ~= nil then
		gui.Visible = false
	end
end

function ShopTerminal:isOpen(): boolean
	return self._isOpen
end

function ShopTerminal:setCatalog(catalog: { PartEntry })
	assert(type(catalog) == "table", "Katalog muss eine Liste sein")
	self._catalog = catalog
end

function ShopTerminal:setInventory(inventory: { [string]: number })
	assert(type(inventory) == "table", "Inventar muss eine Map sein")
	self._inventory = inventory
end

function ShopTerminal:setModelFilter(modelId: string?)
	self._modelFilter = modelId
	self._pendingConfirmation = nil
end

function ShopTerminal:setCategoryFilter(category: string?)
	self._categoryFilter = category
	self._pendingConfirmation = nil
end

function ShopTerminal:getCategories(): { string }
	local seen: { [string]: boolean } = {}
	local result: { string } = {}
	for _, part in ipairs(self._catalog) do
		if not seen[part.category] then
			seen[part.category] = true
			table.insert(result, part.category)
		end
	end
	table.sort(result)
	return result
end

function ShopTerminal:getVisibleParts(): { PartEntry }
	local result: { PartEntry } = {}
	for _, part in ipairs(self._catalog) do
		local categoryOk = self._categoryFilter == nil
			or self._categoryFilter == ""
			or part.category == self._categoryFilter
		if categoryOk and isCompatible(part, self._modelFilter) then
			table.insert(result, part)
		end
	end
	table.sort(result, function(a: PartEntry, b: PartEntry): boolean
		if a.category == b.category then
			if a.price == b.price then
				return a.id < b.id
			end
			return a.price < b.price
		end
		return a.category < b.category
	end)
	return result
end

function ShopTerminal:_sendShopRequest(action: string, payload: any): any
	assert(ALLOWED_SHOP_ACTIONS[action] == true, "Nur Shop-Anfragen erlaubt: " .. tostring(action))
	return self._shopClient:request(action, payload)
end

function ShopTerminal:refreshCatalog()
	self:_sendShopRequest("GetCatalog", {
		modelFilter = self._modelFilter,
	})
end

function ShopTerminal:refreshInventory()
	self:_sendShopRequest("GetInventory", {})
end

function ShopTerminal:requestOrder(partId: string): (boolean, string)
	local part = findPart(self._catalog, partId)
	if part == nil then
		return false, "Teil nicht im Katalog."
	end
	if not isCompatible(part, self._modelFilter) then
		return false, "Teil ist mit dem gewaehlten Modell nicht kompatibel."
	end
	self._pendingConfirmation = partId
	return true, ("Bestellung bestaetigen: %s (%d CHF)?"):format(part.name, part.price)
end

function ShopTerminal:confirmOrder(): (boolean, string)
	local partId = self._pendingConfirmation
	if partId == nil or partId == "" then
		return false, "Keine offene Bestellbestaetigung."
	end
	local part = findPart(self._catalog, partId)
	if part == nil then
		self._pendingConfirmation = nil
		return false, "Teil nicht mehr verfuegbar."
	end
	self._pendingConfirmation = nil
	self:_sendShopRequest("OrderPart", {
		partId = part.id,
	})
	return true, ("Bestellt: %s (%d CHF)."):format(part.name, part.price)
end

function ShopTerminal:cancelConfirmation()
	self._pendingConfirmation = nil
end

local function makeLabel(text: string, size: UDim2): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Text = text
	label.Size = size
	label.Font = Enum.Font.SourceSans
	label.TextSize = 16
	label.TextColor3 = Color3.fromRGB(230, 230, 230)
	label.TextXAlignment = Enum.TextXAlignment.Left
	return label
end

function ShopTerminal:buildGui(parent: Instance): GuiObject
	local frame = Instance.new("Frame")
	frame.Name = "ShopTerminal"
	frame.Size = UDim2.fromScale(0.6, 0.7)
	frame.Position = UDim2.fromScale(0.2, 0.15)
	frame.BackgroundColor3 = Color3.fromRGB(30, 32, 38)
	frame.Visible = self._isOpen
	frame.Parent = parent

	local title = makeLabel("Töffli-Laden: Laptop-Bestellung", UDim2.fromScale(1, 0.08))
	title.Name = "Title"
	title.Parent = frame

	local hint = makeLabel(
		"Kategorien und Modellfilter waehlen, dann bestellen. Kein Einbau hier.",
		UDim2.fromScale(1, 0.06)
	)
	hint.Name = "Hint"
	hint.Position = UDim2.fromScale(0, 0.08)
	hint.TextSize = 13
	hint.TextColor3 = Color3.fromRGB(170, 175, 185)
	hint.Parent = frame

	local list = Instance.new("ScrollingFrame")
	list.Name = "PartsList"
	list.Position = UDim2.fromScale(0, 0.16)
	list.Size = UDim2.fromScale(1, 0.84)
	list.CanvasSize = UDim2.fromScale(0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.BackgroundTransparency = 1
	list.Parent = frame

	self._gui = frame
	return frame
end

return ShopTerminal
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
